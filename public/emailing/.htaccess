# ===========================================================================
# /emailing/ — obrázky pro e-mailové kampaně
# Datum: 2026-08-17
#
# PROČ TENHLE SOUBOR EXISTUJE
# Kořenový public/.htaccess dává VŠEM obrázkům na webu
#   Cache-Control: public, max-age=31536000, immutable
# což je správně pro buildované assety, které mají hash v názvu a při změně
# se přejmenují. Emailingové obrázky ale mají stabilní ručně volená jména —
# a `immutable` klientům i proxy serverům (hlavně Gmail Image Proxy) VÝSLOVNĚ
# zakazuje se ptát na novější verzi. Nahrazení `banner.png` novým souborem
# by se tedy k příjemcům prakticky nikdy nepropsalo.
#
# Proto se tu cache přepisuje na 7 dní BEZ `immutable`, takže revalidace
# funguje a výměna obrázku se propíše.
# ===========================================================================

# POZOR na pořadí slučování v Apache — tady se to poprvé pokazilo.
# Kořenový .htaccess nastavuje cache uvnitř `<FilesMatch>`. Apache zpracovává
# sekce <Files>/<FilesMatch> AŽ PO direktivách na úrovni adresáře, takže
# override zapsaný tady volně (mimo FilesMatch) rodičovské pravidlo NEPŘEBIJE
# — i když je tenhle soubor hlouběji v cestě. Ověřeno na produkci: obrázky
# dál vracely `max-age=31536000, immutable`.
#
# Řešení: dát override do <FilesMatch> taky. Pak jsou obě pravidla ve stejné
# fázi slučování a vyhraje to hlubší, tedy tenhle soubor.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(png|jpe?g|gif|pdf)$">
    ExpiresDefault "access plus 7 days"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|gif|pdf)$">
    # Bez `immutable` — to je celý smysl téhle složky. S ním by se výměna
    # obrázku pod stejným názvem k příjemcům nikdy nedostala.
    Header set Cache-Control "public, max-age=604800"

    # Emailingové obrázky se načítají z cizích domén (webmail klienti,
    # náhledy v prohlížeči). Kořenový .htaccess hotlink protection nemá,
    # ale explicitní povolení je pojistka do budoucna.
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Dokumentaci nemá smysl servírovat návštěvníkům.
# Zápis je schválně verzově odolný: `Require` je Apache 2.4, `Order/Deny`
# je 2.2. Nepodmíněné použití té špatné varianty shodí CELOU složku do
# HTTP 500 — a verzi Apache na WebGlobe nemáme jak spolehlivě zjistit.
<Files "README.md">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Výpis složky nechceme — kdo nezná název souboru, nemá co hledat.
Options -Indexes
