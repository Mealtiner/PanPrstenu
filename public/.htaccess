# WebGlobe Apache config — Pán Prstenů 2026
# Datum: 2026-05-04

# Vynucená HTTPS (server-side, bez bílého blesku)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Root → /cs/ — okamžité server-side přesměrování (žádný 2s meta-refresh)
RewriteRule ^$ /cs/ [R=301,L]

# 404 + 500 + 403 stránky
ErrorDocument 404 /404.html
ErrorDocument 500 /cs/500/index.html
ErrorDocument 403 /cs/403/index.html

# UTF-8 default
AddDefaultCharset UTF-8

# Cache controls — assets long-lived, HTML krátké
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — krátké TTL kvůli rychlému deploy nových verzí
  ExpiresByType text/html "access plus 5 minutes"

  # Assets s hashem v názvu — long-lived
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf|eot|webp|avif|svg|png|jpg|jpeg|gif|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Brotli komprese (lepší než gzip pro web texty) — pokud server podporuje
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml application/atom+xml image/svg+xml font/woff font/woff2
</IfModule>

# gzip komprese (fallback pro klienty bez Brotli)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml application/atom+xml image/svg+xml font/woff font/woff2
</IfModule>

# Bezpečnostní hlavičky
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  # HSTS — vynucené HTTPS po dobu 1 roku, includeSubDomains.
  # `preload` přidat až ~2 týdny po přepnutí DNS na panprstenu.cz (téměř nevratné).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Cross-Origin Opener Policy — izoluje top-level browsing context
  Header set Cross-Origin-Opener-Policy "same-origin"

  # Content Security Policy — Report-Only mód (od 2026-05-09)
  # Nic neblokuje, jen do DevTools console loguje porušení. Po 5–7 dnech
  # bezchybného běhu na new.panprstenu.cz a po stabilizaci panprstenu.cz
  # (~2 týdny po DNS přepnutí) přepnout na enforce: smazat `-Report-Only`
  # a nechat jen `Content-Security-Policy`.
  #
  # 'unsafe-inline' u script-src je nutné kvůli inline <script is:inline>
  # v BaseLayout (theme init, JSON-LD). Pro plnou bezpečnost by chtělo
  # nahradit za nonce/hash — větší refactor, odloženo.
  Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://www.youtube-nocookie.com https://s.ytimg.com https://js.hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.hcaptcha.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://i.ytimg.com https://*.ytimg.com https://www.google.com https://maps.gstatic.com https://*.hcaptcha.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://newassets.hcaptcha.com https://*.hcaptcha.com; connect-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://api.web3forms.com https://*.hcaptcha.com; object-src 'none'; base-uri 'self'; form-action 'self' https://www.registracka.cz https://api.web3forms.com; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Preload klíčových self-hosted fontů řešíme přes <link rel="preload"> v <head>
# (BaseLayout.astro). Dynamické názvy s hash by jinak zde plýtvaly Link headery.

# Charset hint pro správné CT u JS/CSS/JSON
AddCharset UTF-8 .css .js .json .svg .xml

# Disable ETags (preferujeme Last-Modified + Cache-Control)
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
