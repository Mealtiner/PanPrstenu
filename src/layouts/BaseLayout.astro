---
/**
 * BaseLayout — bázový layout
 * Datum: 2026-04-29
 *
 * Obsahuje:
 *   - <head> s meta, OG, Twitter Card, hreflang
 *   - Header
 *   - <slot /> pro obsah
 *   - Footer
 */

import '@styles/global.css';

import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import AccessibilityToolbar from '@components/layout/AccessibilityToolbar.astro';
import type { Lang } from '@i18n/ui';
import { getLangFromUrl, getTranslation, getPathWithoutLang } from '@i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
  noIndex?: boolean;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = getTranslation(lang);

const {
  title,
  description = t('site.description'),
  image = '/images/og-default.jpg',
  noIndex = false,
} = Astro.props;

// PUBLIC_NOINDEX=true v ENV → globální noindex pro celé prostředí (NEW preprod).
// Po DNS přepnutí na ostrou doménu se v GitHub workflow nastaví false a redeployne.
// Per-page `noIndex` propu má přednost (může být `true` i když env je `false`).
const envNoIndex = import.meta.env.PUBLIC_NOINDEX === 'true';
const shouldNoIndex = noIndex || envNoIndex;

const isHome = title === t('page.home.title');
const fullTitle = isHome ? t('site.title') : `${title} | Pán Prstenů`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

// Hreflang — pathname bez jazyka
const pathWithoutLang = getPathWithoutLang(Astro.url.pathname);
const hreflangs = [
  { code: 'cs', locale: 'cs-CZ' },
  { code: 'en', locale: 'en-US' },
  { code: 'de', locale: 'de-DE' },
  { code: 'sk', locale: 'sk-SK' },
];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  {shouldNoIndex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0F1A14" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : lang === 'sk' ? 'sk_SK' : lang === 'de' ? 'de_DE' : 'en_US'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Hreflang -->
  {hreflangs.map(({ code }) => (
    <link
      rel="alternate"
      hreflang={code}
      href={new URL(`/${code}${pathWithoutLang}`, Astro.site)}
    />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(`/cs${pathWithoutLang}`, Astro.site)} />

  <!-- Preconnect Google Fonts + Atkinson Hyperlegible (A11Y readable font) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://rsms.me" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap"
  />

  <!-- A11Y init — aplikuje uložené preference před renderem (proti FOUC) -->
  <script is:inline>
    (function () {
      try {
        var P = 'pp.a11y.';
        var html = document.documentElement;
        var size = localStorage.getItem(P + 'text-size');
        if (size === 'large') html.classList.add('a11y-text-large');
        if (size === 'xlarge') html.classList.add('a11y-text-xlarge');
        ['contrast', 'readable-font', 'reduce-motion', 'line-height'].forEach(function (k) {
          if (localStorage.getItem(P + k) === '1') html.classList.add('a11y-' + k);
        });
      } catch (_) { /* localStorage může být zakázané */ }
    })();
  </script>
</head>

<body class="font-[family-name:var(--font-body)] bg-[var(--color-bg-dark)] text-[var(--color-text-on-dark)] min-h-screen flex flex-col">

  <!-- Skip link — první v pořadí pro klávesnici, plus odkaz do hlavního obsahu pro čtečky.
       Splňuje WCAG 2.4.1 (Bypass Blocks). -->
  <a href="#main" class="skip-link">Přejít na hlavní obsah</a>

  <Header lang={lang} />

  <main class="flex-1" id="main" tabindex="-1">
    <slot />
  </main>

  <Footer lang={lang} />

  <!-- A11Y toolbar — plovoucí panel přístupnosti -->
  <AccessibilityToolbar />

  <script>
    import '@scripts/accessibility.ts';
  </script>

</body>
</html>
