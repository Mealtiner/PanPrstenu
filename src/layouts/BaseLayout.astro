---
/**
 * BaseLayout — bázový layout
 * Datum: 2026-04-29
 *
 * Obsahuje:
 *   - <head> s meta, OG, Twitter Card, hreflang
 *   - Header
 *   - <slot /> pro obsah
 *   - Footer
 */

import '@styles/global.css';

import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import AccessibilityToolbar from '@components/layout/AccessibilityToolbar.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import SideDrawers from '@components/layout/SideDrawers.astro';
import LanguageSwitcher from '@components/layout/LanguageSwitcher.astro';
import TranslationInProgressNotice from '@components/blocks/TranslationInProgressNotice.astro';
import type { Lang } from '@i18n/ui';
import { getLangFromUrl, getTranslation, getPathWithoutLang } from '@i18n/ui';
import { getEvent } from '@data/event';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
  noIndex?: boolean;
  /** Drobečky pro JSON-LD BreadcrumbList. Pokud nezadané, generujeme jen Home. */
  breadcrumbs?: Array<{ name: string; href: string }>;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = getTranslation(lang);

const {
  title,
  description = t('site.description'),
  image = '/images/og-default.jpg',
  noIndex = false,
  breadcrumbs,
} = Astro.props;

// PUBLIC_NOINDEX=true v ENV → globální noindex pro celé prostředí (NEW preprod).
// Po DNS přepnutí na ostrou doménu se v GitHub workflow nastaví false a redeployne.
// Per-page `noIndex` propu má přednost (může být `true` i když env je `false`).
const envNoIndex = import.meta.env.PUBLIC_NOINDEX === 'true';
const shouldNoIndex = noIndex || envNoIndex;

const isHome = Astro.url.pathname === `/${lang}/` || Astro.url.pathname === '/';
// Smart title — pokud page title už obsahuje brand 'Pán Prstenů', nepřidáváme
// suffix (zabraňuje duplicitě „Hobité — Pán Prstenů 2026 | Pán Prstenů").
// Branding v page meta.title je validní (lepší SEO pro long-tail dotazy),
// ale ne 2×. Detekce case-insensitive na klíčové slovo „prstenů" / „rings".
const hasBrandInTitle = /(p[áa]n prsten[uů]|lord of the rings|herr der ringe|pán prsteňov|володар перснів)/i.test(title);
const fullTitle = isHome ? t('site.title') : (hasBrandInTitle ? title : `${title} | Pán Prstenů`);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

// JSON-LD Organization (pořadatel) — sdílené napříč webem
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site}#organization`,
  name: 'Moravian LARP, z. s.',
  url: Astro.site?.toString(),
  email: 'info@panprstenu.cz',
  description: 'Spolek pořádající larpovou akci Pán Prstenů — Bitva o Středozem.',
  // POZOR: Google pro Organization.logo NEAKCEPTUJE SVG — musí být raster
  // (PNG/JPG/GIF), jinak logo v Knowledge Panelu / rich resultu vypadne.
  // PNG generuje scripts/generate-social-assets.mjs. Datum: 2026-08-14
  logo: {
    '@type': 'ImageObject',
    url: new URL('/images/logo/pan-prstenu.png', Astro.site).toString(),
    width: 600,
    height: 424,
  },
  sameAs: [
    'https://www.facebook.com/MoravianLARP',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'info@panprstenu.cz',
    contactType: 'customer support',
    availableLanguage: ['cs', 'en', 'de', 'sk', 'uk'],
  },
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'IČO',
    value: '22669167',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Starobrněnská 289/7',
    addressLocality: 'Brno',
    postalCode: '602 00',
    addressCountry: 'CZ',
  },
};

// JSON-LD Event — pouze na úvodní stránce (lang index)
// Revize 2026-08-14:
//   - `offers` rozšířeno na 3 cenová pásma (Google vyžaduje `price` +
//     `priceCurrency` + `availability` + `url`, jinak Offer u Eventu ignoruje
//     a v rich resultu chybí cena),
//   - přidán `maximumAttendeeCapacity`, `typicalAgeRange`, `inLanguage`,
//     `isAccessibleForFree`, `subEvent` pro hlavní sobotní bitvu,
//     `location.hasMap` + `Place.@id` (stabilní identita místa),
//   - opraven popis (dřív „700+ účastníků, 7 armád" — reálně ~500 účastníků
//     a 9 veřejných armád).
//
// Ceny podle src/content/pages/registrace/cs.json → payment.details_items.
//
// Fakta (místo, GPS, počty) čteme z `@data/event` (src/content/site/event/*),
// aby JSON-LD nemohlo znovu zestárnout oproti zbytku webu — přesně to se
// stalo do 08/2026, kdy strukturovaná data držela už neplatné číslo armád.
const ev = getEvent('cs');
const [evLat, evLon] = ev.gps.split(',').map((n) => Number(n.trim()));
const evCapacity = Number(String(ev.participants).replace(/\D/g, '')) || undefined;

const eventPlace = {
  '@type': 'Place',
  '@id': `${Astro.site}#venue-${ev.year}`,
  name: ev.place,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Pulkovský mlýn',
    addressLocality: 'Rozkoš',
    // Rozkoš leží v okrese Znojmo, tedy Jihomoravský kraj — shodně s
    // `region: "jižní Morava"` v src/content/site/event/cs.json. Louka je sice
    // na pomezí Znojemska a Třebíčska, ale addressRegion musí odpovídat
    // uvedené obci, jinak si Google protiřečí s addressLocality.
    addressRegion: 'Jihomoravský kraj',
    addressCountry: 'CZ',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: evLat,
    longitude: evLon,
  },
  hasMap: `https://www.google.com/maps?q=${evLat},${evLon}`,
};

/** Registrační poplatek hrajícího účastníka — 3 cenová pásma. */
const registrationOffers = [
  { price: '850', validFrom: '2026-05-18T12:00', validThrough: '2026-06-30T23:59' },
  { price: '950', validFrom: '2026-07-01T00:00', validThrough: '2026-08-17T23:59' },
  { price: '1100', validFrom: '2026-08-18T00:00', validThrough: '2026-08-22T23:59' },
].map((o) => ({
  '@type': 'Offer',
  name: 'Registrační poplatek — hrající účastník',
  url: new URL(`/${lang}/registrace/`, Astro.site).toString(),
  price: o.price,
  priceCurrency: 'CZK',
  availability: 'https://schema.org/InStock',
  validFrom: o.validFrom,
  validThrough: o.validThrough,
  category: 'primary',
}));

const isHomePage = Astro.url.pathname === `/${lang}/` || Astro.url.pathname === '/';
const eventJsonLd = isHomePage
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      '@id': `${Astro.site}#event-${ev.year}`,
      name: `Pán Prstenů — Bitva o Středozem ${ev.year}`,
      startDate: '2026-08-20T14:00+02:00',
      endDate: '2026-08-23T12:00+02:00',
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: eventPlace,
      organizer: { '@id': `${Astro.site}#organization` },
      performer: {
        '@type': 'PerformingGroup',
        name: 'Účastníci larpu Pán Prstenů',
      },
      image: ogImageURL.toString(),
      description: `Velká vícedenní larpová bitva inspirovaná Tolkienovou Středozemí. ${ev.participants} účastníků, ${ev.armies} armád svobodných národů i sil Temna, čtyři dny táborového programu a hlavní bitva v sobotu.`,
      url: new URL(`/${lang}/`, Astro.site).toString(),
      inLanguage: ['cs', 'en', 'de', 'sk', 'uk'],
      isAccessibleForFree: false,
      maximumAttendeeCapacity: evCapacity,
      typicalAgeRange: '12-',
      offers: registrationOffers,
      audience: {
        '@type': 'PeopleAudience',
        suggestedMinAge: 12,
      },
      subEvent: {
        '@type': 'Event',
        name: 'Hlavní bitva o Středozem',
        startDate: '2026-08-22T13:00+02:00',
        endDate: '2026-08-22T18:00+02:00',
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: { '@id': `${Astro.site}#venue-2026` },
        organizer: { '@id': `${Astro.site}#organization` },
      },
    }
  : null;

// JSON-LD FAQPage — pouze na úvodní stránce, čerpá ze 4 Q&A v FAQTeaseru.
// Klíče faq.q1..q4 / faq.a1..a4 jsou v src/i18n/ui.ts pro každý jazyk.
const faqJsonLd = isHomePage
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [1, 2, 3, 4].map((i) => ({
        '@type': 'Question',
        name: t(`faq.q${i}` as `faq.q${1 | 2 | 3 | 4}`),
        acceptedAnswer: {
          '@type': 'Answer',
          text: t(`faq.a${i}` as `faq.a${1 | 2 | 3 | 4}`),
        },
      })),
    }
  : null;

// JSON-LD WebPage — strojově čitelné metadata stránky
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  description,
  url: canonicalURL.toString(),
  inLanguage: lang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Pán Prstenů — Bitva o Středozem',
    url: Astro.site?.toString(),
    publisher: { '@id': `${Astro.site}#organization` },
  },
};

// JSON-LD BreadcrumbList — pokud má stránka drobečky
const breadcrumbJsonLd =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: t('nav.home'),
            item: new URL(`/${lang}/`, Astro.site).toString(),
          },
          ...breadcrumbs.map((b, idx) => ({
            '@type': 'ListItem',
            position: idx + 2,
            name: b.name,
            item: new URL(b.href, Astro.site).toString(),
          })),
        ],
      }
    : null;

// Hreflang — pathname bez jazyka
const pathWithoutLang = getPathWithoutLang(Astro.url.pathname);
const hreflangs = [
  { code: 'cs', locale: 'cs-CZ' },
  { code: 'en', locale: 'en-US' },
  { code: 'de', locale: 'de-DE' },
  { code: 'sk', locale: 'sk-SK' },
  { code: 'uk', locale: 'uk-UA' },
];

// og:locale — dřív mapováno ručně a `uk` spadalo na `en_US`.
// Datum: 2026-08-14
const ogLocale =
  (hreflangs.find((h) => h.code === lang)?.locale ?? 'cs-CZ').replace('-', '_');
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  {shouldNoIndex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!--
    Browser UI / theme color — splynutí adresního řádku se stránkou.
    Web je dark-first, tak dáváme stejnou tmavou hodnotu pro oba režimy.
    `#0A130D` = --color-bg-darkest (header bg po scroll).
  -->
  <!-- Dynamický theme-color — aktualizuje se z init scriptu níže podle data-theme.
       Dark = #0A130D (bg-darkest tmavá), Light = #e6e9dd (sage soft).
       Ovlivňuje status bar Androidu, URL bar Chrome, Dynamic Island iOS. -->
  <meta name="theme-color" content="#0A130D" id="meta-theme-color" />

  <!-- iOS Safari / PWA — status bar styling (Dynamic Island, výřez) -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Pán Prstenů" />

  <!-- Open Graph
       Revize 2026-08-14: doplněn og:site_name, og:locale:alternate a rozměry
       obrázku (bez nich si FB/LinkedIn musí obrázek stáhnout, než náhled
       vykreslí — u prvního sdílení odkazu se náhled často nezobrazí vůbec).
       Opraven i og:locale pro `uk`, které dřív spadalo na `en_US`. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Pán Prstenů — Bitva o Středozem" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={ogLocale} />
  {hreflangs
    .filter(({ code }) => code !== lang)
    .map(({ locale }) => <meta property="og:locale:alternate" content={locale.replace('-', '_')} />)}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={fullTitle} />

  <!-- Hreflang -->
  {hreflangs.map(({ code }) => (
    <link
      rel="alternate"
      hreflang={code}
      href={new URL(`/${code}${pathWithoutLang}`, Astro.site)}
    />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(`/cs${pathWithoutLang}`, Astro.site)} />

  <!-- RSS feed pro novinky — per jazyk; vede na /{lang}/novinky/rss.xml -->
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`Pán Prstenů — ${t('nav.news')}`}
    href={new URL(`/${lang}/novinky/rss.xml`, Astro.site)}
  />

  <!-- JSON-LD strukturovaná data — WebPage + BreadcrumbList (pokud zadané)
       Splňuje Schema.org pro strojovou čitelnost a Google rich results. -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
  {breadcrumbJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  )}
  {faqJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}
  {eventJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  )}

  <!-- Preload klíčových self-hosted fontů (latin) — first-paint bez FOUT.
       Webfonty jsou v /fonts/, fonts.css je @import z global.css. -->
  <link rel="preload" href="/fonts/sora-v17-xMQ9uFFYT72X5wkB_18qmnndmSdSnh2BAfO5mnuyOo1lfiQwV6-xo6eeIw.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/sourcesans3-v19-nwpStKy2OAdR1K-IwhWudF-R3w8aZejf5Hc.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Preconnect YouTube — POUZE 2 hosty (Lighthouse warning při >4 preconnects).
       www.youtube.com → iframe_api script (loop v Hero.astro),
       youtube-nocookie.com → samotný iframe embed (Hero + VideoGallery dialog).
       i.ytimg.com / s.ytimg.com odebrány — připojení proběhne až při skutečném
       přehrání videa (overhead ~50 ms je akceptovatelný, ušetříme 2 TLS handshake
       na first paint). -->
  {isHome && (
    <>
      <link rel="preconnect" href="https://www.youtube.com" />
      <link rel="preconnect" href="https://www.youtube-nocookie.com" />
      {/* Preload Hero LCP poster — responsive (mobile sm/desktop full).
          Bez něj prohlížeč objeví obrázek až po HTML parsingu → LCP +200–400 ms. */}
      <link
        rel="preload"
        as="image"
        href="/images/hero-poster.webp"
        imagesrcset="/images/hero-poster-sm.webp 768w, /images/hero-poster.webp 1920w"
        imagesizes="100vw"
        fetchpriority="high"
      />
    </>
  )}

  <!-- A11Y readable font (Atkinson Hyperlegible) z Google Fonts načítáme
       až po klientském přepnutí toggle v accessibility.ts. Pro 99 %
       návštěvníků žádný blokující CSS request. -->

  {/* Google Analytics 4 — jen v produkci (PUBLIC_NOINDEX != 'true').
      Consent Mode v2: GA loadne, ale `analytics_storage` je `denied` defaultně.
      Granted až po souhlasu uživatele v cookie consent banneru
      (event `pp-consent-change` z cookie-consent.ts).

      GDPR (CZ + EU): bez consentu se NEUKLÁDAJÍ žádné cookies ani identifikátory.
      Google používá "cookieless pings" pro hrubé modelování konverzí.

      Měřicí ID: G-MS0YG5PXGE */}
  {!envNoIndex && (
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;

        // Consent Mode v2 — denied defaults musí být ZAREGISTROVÁNY před GTM scriptem.
        // Voláme synchronně v head; když pak gtag.js doběhne (po window.load),
        // přečte si dataLayer a respektuje tento default.
        gtag('consent', 'default', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });

        gtag('js', new Date());
        gtag('config', 'G-MS0YG5PXGE', { anonymize_ip: true });

        // Aplikovat dříve uložený souhlas (vrací se uživatel)
        try {
          var raw = localStorage.getItem('pp.cookie.consent');
          if (raw) {
            var c = JSON.parse(raw);
            gtag('consent', 'update', {
              analytics_storage: c.analytics ? 'granted' : 'denied',
              ad_storage: c.marketing ? 'granted' : 'denied',
              ad_user_data: c.marketing ? 'granted' : 'denied',
              ad_personalization: c.marketing ? 'granted' : 'denied'
            });
          }
        } catch (_) { /* localStorage zakázaný */ }

        // Reaktivně aktualizovat při změně souhlasu z cookie-consent.ts
        document.addEventListener('pp-consent-change', function (e) {
          var c = e.detail;
          gtag('consent', 'update', {
            analytics_storage: c.analytics ? 'granted' : 'denied',
            ad_storage: c.marketing ? 'granted' : 'denied',
            ad_user_data: c.marketing ? 'granted' : 'denied',
            ad_personalization: c.marketing ? 'granted' : 'denied'
          });
        });

        // Defer samotného gtag.js (155 KiB, ~170 ms long task) za window.load
        // + requestIdleCallback. Dokud nedoběhne, hits sedí v dataLayer queue
        // a GTM je všechny zpracuje až přijde — žádná data se neztratí.
        // První user interaction (click/scroll/keydown) přebije load,
        // abychom o eventy nepřišli i kdyby load trval moc dlouho.
        var gtmLoaded = false;
        function loadGtm() {
          if (gtmLoaded) return;
          gtmLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-MS0YG5PXGE';
          document.head.appendChild(s);
        }
        function scheduleGtm() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadGtm, { timeout: 4000 });
          } else {
            setTimeout(loadGtm, 1500);
          }
        }
        if (document.readyState === 'complete') {
          scheduleGtm();
        } else {
          window.addEventListener('load', scheduleGtm, { once: true });
        }
        // Fallback: pokud user interaguje dřív než load, načti hned
        var trigger = function () { loadGtm(); };
        ['pointerdown', 'keydown', 'scroll'].forEach(function (ev) {
          window.addEventListener(ev, trigger, { once: true, passive: true });
        });
      })();
    </script>
  )}

  <!-- A11Y + theme init — aplikuje uložené preference před renderem (proti FOUC).
       Pořadí: téma → font size → toggles. Vše čistě synchronně. -->
  <script is:inline>
    (function () {
      try {
        var html = document.documentElement;

        // Theme: vždy 'dark' jako default (atmosféra Středozemě).
        // Pokud uživatel explicitně nezvolí 'light' přes a11y toolbar,
        // ignorujeme prefers-color-scheme — web má pevnou tmavou identitu.
        var theme = localStorage.getItem('pp.theme');
        if (theme !== 'dark' && theme !== 'light') {
          theme = 'dark';
        }
        html.setAttribute('data-theme', theme);

        // Sync meta theme-color s aktuální variantou (status bar mobilů)
        var metaTheme = document.getElementById('meta-theme-color');
        if (metaTheme) {
          metaTheme.setAttribute('content', theme === 'light' ? '#e6e9dd' : '#0A130D');
        }

        // A11Y preferences
        var P = 'pp.a11y.';
        var size = localStorage.getItem(P + 'text-size');
        if (size === 'large') html.classList.add('a11y-text-large');
        if (size === 'xlarge') html.classList.add('a11y-text-xlarge');
        ['contrast', 'readable-font', 'reduce-motion', 'line-height'].forEach(function (k) {
          if (localStorage.getItem(P + k) === '1') html.classList.add('a11y-' + k);
        });
      } catch (_) { /* localStorage může být zakázané (private mode) */ }
    })();
  </script>
</head>

<body class="font-[family-name:var(--font-body)] bg-[var(--color-bg-dark)] text-[var(--color-text-on-dark)] min-h-screen flex flex-col">

  <!-- Skip link — první v pořadí pro klávesnici, plus odkaz do hlavního obsahu pro čtečky.
       Splňuje WCAG 2.4.1 (Bypass Blocks). -->
  <a href="#main" class="skip-link">{t('a11y.skip_to_main')}</a>

  <Header lang={lang} />

  {/* Translation status notice — chytrá verze (2026-05-11 revize):
      Zobrazí se POUZE pokud aktuální stránka × lang má < 90 % přeloženého
