---
/**
 * Novinky — výpis blogových článků
 * URL: /cs/novinky/, …
 * Datum: 2026-04-29
 *
 * Načítá z content collection `news` per jazyk.
 * Stránkování přidáme, až bude víc článků.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import InfoCard from '@components/blocks/InfoCard.astro';
import Tag from '@components/ui/Tag.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.news') },
];

const allNews = await getCollection('news');
const langNews = allNews
  .filter((n) => n.data.lang === lang && n.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'cs' ? 'cs-CZ' : lang === 'sk' ? 'sk-SK' : lang === 'de' ? 'de-DE' : 'en-US', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const categoryLabels: Record<string, string> = {
  pribeh: 'Příběh',
  organizace: 'Organizace',
  reporty: 'Reporty',
};
---

<BaseLayout
  title={t('nav.news')}
  description="Aktuality z příprav Bitvy o Středozem 2026."
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('nav.news')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Aktuality z příprav letošního ročníku.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-base">

      {langNews.length === 0 ? (
        <AlertBox variant="info" title="Zatím žádné novinky">
          První článek se objeví, jakmile dorazí. Pro průběžné novinky sleduj
          <a href="https://www.facebook.com/MoravianLARP" class="underline" target="_blank" rel="noopener noreferrer">Facebook stránku Moravian LARP</a>.
        </AlertBox>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {langNews.map((article) => (
            <InfoCard
              href={`/${lang}/novinky/${article.id.replace(/\.(md|mdx)$/, '').replace(/^[a-z]{2}\//, '')}/`}
              title={article.data.title}
              description={article.data.excerpt}
              tone="dark"
              cta={t('cta.read_more')}
            >
              <div class="mt-3 flex items-center gap-2 flex-wrap text-xs text-[var(--color-text-on-dark-muted)]">
                <span>{formatDate(article.data.date)}</span>
                <span class="opacity-50">•</span>
                <Tag variant="gold" size="sm">{categoryLabels[article.data.category] ?? article.data.category}</Tag>
              </div>
            </InfoCard>
          ))}
        </div>
      )}

      <Divider variant="line-diamond" tone="dark" class="mt-16" />

    </div>
  </section>

</BaseLayout>
