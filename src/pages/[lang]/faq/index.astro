---
/**
 * FAQ — Časté dotazy
 * URL: /cs/faq/, /en/faq/, /de/faq/, /sk/faq/, /uk/faq/
 * Datum: 2026-05-03
 *
 * Layout shodný s /pravidla/ a /pro-novacky/:
 *   - vlevo sticky sidebar s 17 kategoriemi (toc-spy.ts zvýrazňuje aktivní)
 *   - vpravo otázky jako accordion (<details>) v rámci kategorií
 *   - JSON-LD FAQPage (vybrané otázky pro snippet)
 *
 * Data jsou v src/data/faq.ts (per jazyk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Accordion from '@components/blocks/Accordion.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageContent } from '@lib/content/pages';
import { getFaqGroups } from '@data/faq';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const tp = getPageContent('faq', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: tp('title') },
];

const groups = getFaqGroups(lang);

// JSON-LD FAQPage — pouze otázky označené faqSnippet:true (~7 nejdůležitějších)
function stripHtml(s: string): string {
  return s.replace(/<[^>]+>/g, '');
}
const snippetItems = groups.flatMap((g) => g.items.filter((i) => i.faqSnippet));
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: snippetItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: stripHtml(item.a) },
  })),
};
---

<BaseLayout
  title={tp('title')}
  description={tp('description')}
  lang={lang}
  breadcrumbs={[{ name: tp('title'), href: `/${lang}/faq/` }]}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />

  <!-- Hero -->
  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {tp('title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-3xl">
        {tp('subtitle_pre')}<a href={`/${lang}/pro-novacky/`} class="underline">{tp('subtitle_link_newcomer')}</a>{tp('subtitle_sep1')}<a href={`/${lang}/organizacni-informace/`} class="underline">{tp('subtitle_link_practical')}</a>{tp('subtitle_sep2')}<a href={`/${lang}/organizacni-informace/`} class="underline">{tp('subtitle_link_org')}</a>{tp('subtitle_sep3')}<a href={`/${lang}/pravidla/`} class="underline">{tp('subtitle_link_rules')}</a>{tp('subtitle_post')}
      </p>
    </div>
  </section>

  <!-- Fulltextové vyhledávání -->
  <section class="py-6 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base max-w-5xl">
      <details class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)]/60 group bg-[var(--color-bg-medium)]/20">
        <summary class="flex items-center gap-3 px-4 py-3 cursor-pointer list-none font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]">
          <Icon name="lucide:search" class="w-5 h-5 text-[var(--color-gold)] flex-shrink-0" />
          <span class="flex-1">Hledat ve FAQ</span>
          <Icon name="lucide:plus" class="w-4 h-4 text-[var(--color-gold)] transition-transform group-open:rotate-45 flex-shrink-0" />
        </summary>
        <div class="p-4 border-t border-[var(--color-gold-darkest)]">
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none">
              <Icon name="lucide:search" class="w-5 h-5 text-[var(--color-gold)]" />
            </span>
            <input
              type="search"
              data-faq-search
              placeholder='např. „registrace", „dítě", „zbraň"…'
              aria-label="Hledat ve FAQ"
              class="w-full pl-12 pr-4 py-3 bg-[var(--color-bg-medium)]/50 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] focus:border-[var(--color-gold)] focus:outline-none text-[var(--color-text-on-dark)] placeholder:text-[var(--color-text-on-dark-muted)] transition-colors"
            />
          </div>
          <div class="text-xs text-[var(--color-text-on-dark-muted)] mt-2 px-1">
            Nalezeno <span data-faq-counter>—</span> otázek. Esc vymaže hledání.
          </div>

          <div data-faq-empty hidden class="mt-4 p-6 border border-[var(--color-gold-darkest)] bg-[var(--color-bg-medium)]/30 text-center">
            <Icon name="lucide:search-x" class="w-8 h-8 text-[var(--color-gold)] mx-auto mb-2" />
            <p class="text-[var(--color-text-on-dark-muted)]">
              Žádná otázka neodpovídá hledanému slovu. Zkus jiný výraz nebo nám napiš na <a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a>.
            </p>
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- Hlavní obsah s levým sticky sidebarem -->
  <section class="py-12" data-toc-root data-faq-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">

        <!-- LEVÝ STICKY SIDEBAR (mobile drawer + desktop sticky) -->
        <MobileSidebarShell tabLabel={tp('sidebar.tab_label')} tabIcon="lucide:help-circle" ariaLabel={tp('sidebar.aria_label')}>
          <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-2">
            <span class="text-[var(--color-gold)] text-xs" aria-hidden="true">◆</span>
            {tp('sidebar.heading')}
          </h3>
          <ul class="space-y-1 border-l border-[var(--color-gold-darkest)] text-sm" role="list">
            {groups.map((g) => (
              <li>
                <a
                  href={`#${g.id}`}
                  data-toc-link={g.id}
                  class="toc-spy-link -ml-px flex items-center gap-2 pl-3 py-2 border-l-2 border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)] hover:bg-[var(--color-gold)]/5 transition-all leading-tight"
                >
                  <Icon name={g.icon} class="w-3.5 h-3.5 opacity-70 shrink-0" aria-hidden="true" />
                  <span class="flex-1">{g.label}</span>
                </a>
              </li>
            ))}
            <li class="border-t border-[var(--color-gold-darkest)]/40 mt-3 pt-3"></li>
            <li>
              <a
                href="#nenasel-jsi"
                data-toc-link="nenasel-jsi"
                class="toc-spy-link -ml-px flex items-center gap-2 pl-3 py-2 border-l-2 border-transparent text-[var(--color-text-on-dark-muted)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)] hover:bg-[var(--color-gold)]/5 transition-all leading-tight text-xs uppercase tracking-wider"
              >
                <Icon name="lucide:mail" class="w-3.5 h-3.5 opacity-70 shrink-0" aria-hidden="true" />
                {tp('sidebar.not_found')}
              </a>
            </li>
          </ul>
        </MobileSidebarShell>

        <!-- PRAVÝ OBSAH — 17 kategorií FAQ -->
        <article class="min-w-0 max-w-3xl">

          {groups.map((g, idx) => (
            <section id={g.id} class="scroll-mt-24 mb-12">
              <h2 class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-3">
                <Icon name={g.icon} class="w-6 h-6 text-[var(--color-gold)] shrink-0" aria-hidden="true" />
                {g.label}
              </h2>
              <Divider variant="line-diamond" tone="dark" class="mb-4" />
              <div class="[&_summary]:text-base [&_summary]:py-4 [&_summary]:font-semibold">
                {g.items.map((item) => (
                  <Accordion question={item.q} tone="dark">
                    <p set:html={item.a} />
                  </Accordion>
                ))}
              </div>
              {idx < groups.length - 1 && (
                <Divider variant="line-diamond" tone="dark" class="mt-10" />
              )}
            </section>
          ))}

          <!-- Nenašel jsi odpověď? -->
          <section id="nenasel-jsi" class="scroll-mt-24">
            <AlertBox variant="info" title={tp('notfound.title')}>
              {tp('notfound.body_pre')}<a href={`mailto:${tp('notfound.body_email')}`} class="underline">{tp('notfound.body_email')}</a>{tp('notfound.body_post')}
            </AlertBox>
          </section>

        </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
    import '@scripts/faq-search.ts';
  </script>

</BaseLayout>

<style>
  /* Skrýt default šipku <details> ve Webkitu (konzistence s ostatními accordiony) */
  details > summary::-webkit-details-marker { display: none; }
  details > summary::marker { content: ''; }
</style>
