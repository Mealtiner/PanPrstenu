---
/**
 * Svět Středozemě — landing / rozcestník
 * URL: /cs/svet-stredozeme/, …
 * Datum: 2026-05-04
 *
 * Rozcestník pro lore a setting Pána Prstenů. Sedm hlavních podstránek:
 * úvod do světa, národy, časová linka, místopis, království, specifické
 * jednotky, slovníček. Texty parafrázované, bez přímých citací z Tolkiena.
 *
 * 2026-05-04: kompletní překlad UI textů do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang, TranslationKey } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.world.title') },
];

type Card = { icon: string; titleKey: TranslationKey; descKey: TranslationKey; href: string };

const kategorie: Card[] = [
  {
    icon: 'lucide:sparkles',
    titleKey: 'page.world.cat1_title',
    descKey: 'page.world.cat1_desc',
    href: `/${lang}/svet-stredozeme/uvod-do-sveta/`,
  },
  {
    icon: 'lucide:users',
    titleKey: 'page.world.cat2_title',
    descKey: 'page.world.cat2_desc',
    href: `/${lang}/svet-stredozeme/narody/`,
  },
  {
    icon: 'lucide:hourglass',
    titleKey: 'page.world.cat3_title',
    descKey: 'page.world.cat3_desc',
    href: `/${lang}/svet-stredozeme/casova-linka/`,
  },
  {
    icon: 'lucide:map',
    titleKey: 'page.world.cat4_title',
    descKey: 'page.world.cat4_desc',
    href: `/${lang}/svet-stredozeme/mistopis/`,
  },
  {
    icon: 'lucide:landmark',
    titleKey: 'page.world.cat5_title',
    descKey: 'page.world.cat5_desc',
    href: `/${lang}/svet-stredozeme/kralovstvi-a-rise/`,
  },
  {
    icon: 'lucide:swords',
    titleKey: 'page.world.cat6_title',
    descKey: 'page.world.cat6_desc',
    href: `/${lang}/svet-stredozeme/specificke-jednotky/`,
  },
  {
    icon: 'lucide:book-open',
    titleKey: 'page.world.cat7_title',
    descKey: 'page.world.cat7_desc',
    href: `/${lang}/svet-stredozeme/slovnicek/`,
  },
];

type Tag = { labelKey: TranslationKey; descKey: TranslationKey };
const tags: Tag[] = [
  { labelKey: 'page.world.tag1_label', descKey: 'page.world.tag1_desc' },
  { labelKey: 'page.world.tag2_label', descKey: 'page.world.tag2_desc' },
  { labelKey: 'page.world.tag3_label', descKey: 'page.world.tag3_desc' },
  { labelKey: 'page.world.tag4_label', descKey: 'page.world.tag4_desc' },
  { labelKey: 'page.world.tag5_label', descKey: 'page.world.tag5_desc' },
];
---

<BaseLayout
  title={t('page.world.meta_title')}
  description={t('page.world.description')}
  lang={lang}
  breadcrumbs={[{ name: t('page.world.title'), href: `/${lang}/svet-stredozeme/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.world.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {t('page.world.subtitle')}
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-5xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4 max-w-3xl">
        {t('page.world.intro')}
      </p>

      <AlertBox variant="info" title={t('page.world.alert_lore_title')} class="mb-6 max-w-3xl">
        {t('page.world.alert_lore_pre')}<a href={`/${lang}/pravidla/`} class="underline">{t('page.world.alert_lore_l1')}</a>{t('page.world.alert_lore_mid1')}<a href={`/${lang}/prakticke-info/`} class="underline">{t('page.world.alert_lore_l2')}</a>{t('page.world.alert_lore_mid2')}<a href={`/${lang}/registrace/`} class="underline">{t('page.world.alert_lore_l3')}</a>{t('page.world.alert_lore_post')}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6">
        {t('page.world.h_what')}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {kategorie.map((k) => (
          <a
            href={k.href}
            class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] flex flex-col"
          >
            <div class="flex items-center gap-3 mb-3">
              <Icon name={k.icon} class="w-6 h-6 text-[var(--color-gold)] group-hover:text-[var(--color-gold-light)] transition-colors" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)]">
                {t(k.titleKey)}
              </h3>
            </div>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3 flex-1">
              {t(k.descKey)}
            </p>
            <span class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] group-hover:underline inline-flex items-center gap-1 mt-auto">
              {t('page.world.read_more')} <span class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- Kanon vs. herní pojetí -->
      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        {t('page.world.h_kanon')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3 max-w-3xl">
        {t('page.world.kanon_p')}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-6 max-w-3xl">
        {tags.map((tg) => (
          <li class="flex items-start gap-3">
            <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-on-dark-muted)] border border-[var(--color-gold-darkest)] px-2 py-0.5 mt-0.5 shrink-0">
              {t(tg.labelKey)}
            </span>
            <span class="text-sm">{t(tg.descKey)}</span>
          </li>
        ))}
      </ul>
      <AlertBox variant="warning" title={t('page.world.alert_rules_title')} class="mb-10 max-w-3xl">
        {t('page.world.alert_rules_pre')}<strong>{t('page.world.alert_rules_strong')}</strong>{t('page.world.alert_rules_mid1')}<a href={`/${lang}/pravidla/`} class="underline">{t('page.world.alert_rules_l1')}</a>{t('page.world.alert_rules_mid2')}<a href={`/${lang}/frakce/`} class="underline">{t('page.world.alert_rules_l2')}</a>{t('page.world.alert_rules_post')}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        {t('page.world.h_year')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4 max-w-3xl">
        {t('page.world.year_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 max-w-3xl italic">
        {t('page.world.year_p2_pre')}<a href={`/${lang}/pribeh/`} class="underline text-[var(--color-gold-light)]">{t('page.world.year_p2_link')}</a>{t('page.world.year_p2_post')}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <div class="text-center">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          {t('page.world.cta_h')}
        </h2>
        <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-6">
          {t('page.world.cta_p')}
        </p>
        <Button href={`/${lang}/frakce/`} variant="primary" size="md">{t('page.world.cta_btn')}</Button>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] text-center mt-10 italic">
        {t('page.world.footer_note')}
      </p>

    </article>
  </section>

</BaseLayout>
