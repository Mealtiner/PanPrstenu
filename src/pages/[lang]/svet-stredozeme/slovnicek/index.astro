---
/**
 * Svět Středozemě — Slovníček pojmů
 * URL: /cs/svet-stredozeme/slovnicek/, …
 * Datum: 2026-08-03
 *
 * Abecední přehled klíčových pojmů, které se objevují v textech sekce
 * Svět Středozemě i ve hře Pán Prstenů. Texty jsou parafrázované,
 * nikoli přímé citace z Tolkienových knih.
 *
 * 2026-05-03: UI texty (titulek, intro, alert, related links, footnote)
 * přeloženy do 5 jazyků (cs/en/de/sk/uk). Popisy jednotlivých termínů
 * zůstávají zatím v CS — pro non-CS prohlížeče se zobrazí notice
 * `glossary.lang_notice`. Plný překlad slovníčku je oddělený ticket.
 *
 * 2026-08-03: přepsáno podle encyklopedického auditu slovníčku.
 *   - hesla přesunuta z hardcoded pole do `cs.json` → pole `terms`
 *     (přeložitelné, per-klíč fallback na CS jako u /kralovstvi-a-rise/),
 *   - opraveno 24 věcně nepřesných hesel podle §5 auditu
 *     (Anduina, Arda, Avari, Bílá ruka, Dúnadan/Dúnedain, Eä, Elessar,
 *     Imladris, Maiar, Moria, Mûmakil, Nazgûlové, Númenor, Oko Saurona,
 *     Palantíry, Prsteny moci, Rohirové, Rohan, Saruman, Skřet, Třetí věk,
 *     Uruk-hai, Valar, Valinor),
 *   - rozšířeno na 188 hesel, každé s kategorií (`cat`), úrovní jistoty
 *     (`canon`), ASCII kebab-case `id` (anchor pro budoucí tooltipy)
 *     a volitelnými aliasy,
 *   - přidána abecední navigace (TocSidebar + scrollspy).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import StructuredData from '@components/seo/StructuredData.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('svet-stredozeme/slovnicek', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('breadcrumb.world_intro'), href: `/${lang}/svet-stredozeme/` },
  { label: p.bc_self },
];

type Term = {
  /** ASCII kebab-case anchor — navigace, přímé odkazy a budoucí tooltipy. */
  id: string;
  /** Kanonický tvar hesla. */
  term: string;
  /** Klíč kategorie — viz `cat_labels` v JSONu. */
  cat: string;
  /** Klíč úrovně jistoty — viz `canon_labels` v JSONu. */
  canon: string;
  /** Doporučené varianty názvu (Rohirrim, Isengard, Moria, …). */
  aliases?: string[];
  /** Tvary, které se nemají používat (např. „Rohirim“). */
  discouraged?: string[];
  desc: string;
};

// Hesla se načítají z obsahových JSONů (src/content/pages/svet-stredozeme/
// slovnicek/{lang}.json → pole `terms`), aby byla přeložitelná.
// `getPageData` dělá fallback na úrovni celého souboru, ne jednotlivých klíčů,
// proto per-klíč fallback na CS řešíme tady — jazyk bez přeložených `terms`
// zobrazí české položky (+ `lang_notice`) místo prázdné stránky.
const csPage = getPageData<PageContent>('svet-stredozeme/slovnicek', 'cs');
const terms: Term[] = ((p.terms ?? csPage.terms) as unknown as Term[]) ?? [];

// Popisky kategorií a úrovní jistoty — CS základ přepsaný přeloženými hodnotami.
const catLabels: Record<string, string> = {
  ...((csPage.cat_labels ?? {}) as Record<string, string>),
  ...((p.cat_labels ?? {}) as Record<string, string>),
};
const canonLabels: Record<string, string> = {
  ...((csPage.canon_labels ?? {}) as Record<string, string>),
  ...((p.canon_labels ?? {}) as Record<string, string>),
};
// „Herní pojetí PP" má v každém jazyce už přeložený string (`tag_herni`),
// tak ho použijeme i pro stejnojmennou kategorii a úroveň jistoty.
if (p.tag_herni) {
  catLabels.herni = p.tag_herni;
  canonLabels.herni = p.tag_herni;
}

const labelAlias: string = p.label_alias ?? csPage.label_alias;
const labelDiscouraged: string = p.label_discouraged ?? csPage.label_discouraged;

const sortedTerms = [...terms].sort((a, b) => a.term.localeCompare(b.term, 'cs'));

// Abecední skupiny. Písmeno bereme bez diakritiky (Č → C, Ř → R, Š → S, Ž → Z),
// takže česká kolace řadí hesla uvnitř skupiny správně (Cirith Ungol → Čtvrtý věk).
const groupLetter = (name: string) =>
  name
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .charAt(0)
    .toUpperCase();

const grouped = new Map<string, Term[]>();
for (const term of sortedTerms) {
  const letter = groupLetter(term.term);
  const bucket = grouped.get(letter);
  if (bucket) bucket.push(term);
  else grouped.set(letter, [term]);
}
const groups = [...grouped.entries()].map(([letter, items]) => ({
  letter,
  id: `skupina-${letter.toLowerCase()}`,
  items,
}));

// Boční menu = abecední rejstřík (na mobilu vyjížděcí drawer).
const tocItems = groups.map((g) => ({ id: g.id, label: g.letter }));

// Úroveň jistoty ukazujeme jen tam, kde přináší informaci — „Knižní základ"
// je výchozí stav a u herních pojmů by badge zdvojoval kategorii.
const showCanon = (s: Term) => s.canon !== 'knizni' && s.canon !== s.cat;

const langNotice = p.lang_notice;

/**
 * JSON-LD DefinedTermSet — strojová podoba slovníčku.
 * Datum: 2026-08-14
 *
 * Proč: 188 hesel je nejhodnotnější „encyklopedická" část webu, ale v HTML
 * jsou to jen `<dt>`/`<dd>` uvnitř abecedních skupin. DefinedTermSet dá
 * vyhledávačům i AI asistentům explicitní signál „tohle je slovník pojmů
 * a tady je jeho 188 definic", takže se z něj dá odpovídat na dotazy typu
 * „co je palantír" bez toho, aby si model musel parsovat celou stránku.
 * Google pro DefinedTermSet nedělá rich result — jde čistě o strojovou
 * čitelnost, proto ho neduplikujeme do viditelného obsahu.
 *
 * Každé heslo má stabilní anchor (`#<id>`), takže odkaz míří přímo na definici.
 */
const glossaryUrl = new URL(`/${lang}/svet-stredozeme/slovnicek/`, Astro.site).toString();
const glossaryJsonLd = sortedTerms.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'DefinedTermSet',
      '@id': `${glossaryUrl}#glossary`,
      name: p.title,
      description: p.description,
      url: glossaryUrl,
      inLanguage: lang,
      hasDefinedTerm: sortedTerms.map((s) => ({
        '@type': 'DefinedTerm',
        '@id': `${glossaryUrl}#${s.id}`,
        name: s.term,
        description: s.desc,
        url: `${glossaryUrl}#${s.id}`,
        alternateName: s.aliases?.length ? s.aliases : undefined,
        termCode: s.id,
        inDefinedTermSet: { '@id': `${glossaryUrl}#glossary` },
      })),
    }
  : null;
---

<BaseLayout
  title={p.meta_title}
  description={p.description}
  lang={lang}
  breadcrumbs={[
    { name: p.bc_world, href: `/${lang}/svet-stredozeme/` },
    { name: p.bc_self, href: `/${lang}/svet-stredozeme/slovnicek/` },
  ]}
>

  <StructuredData data={glossaryJsonLd} />

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.title}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {p.subtitle}
      </p>
    </div>
  </section>

  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
      <TocSidebar items={tocItems} title={t('toc.title')} ariaLabel={t('toc.aria')} />
      <article class="min-w-0 max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.intro_pre}<span class="text-[10px] uppercase tracking-widest border border-[var(--color-gold-darkest)] px-1.5 py-0.5 text-[var(--color-text-on-dark-muted)]">{p.intro_tag}</span>{p.intro_post}
      </p>

      {langNotice && (
        <AlertBox variant="warning" class="mb-6">
          {langNotice}
        </AlertBox>
      )}

      <AlertBox variant="info" class="mb-10">
        {p.alert_lore}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      {groups.map((g) => (
        <section class="mb-10">
          <h2
            id={g.id}
            class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold)] border-b border-[var(--color-gold-darkest)] pb-2 mb-5 scroll-mt-24"
          >
            {g.letter}
          </h2>
          <dl class="space-y-5">
            {g.items.map((s) => (
              <div id={s.id} class="border-l-2 border-[var(--color-gold-darkest)] pl-4 scroll-mt-24">
                <dt class="font-[family-name:var(--font-display)] uppercase tracking-wider text-base text-[var(--color-gold-light)] flex items-center gap-2 flex-wrap">
                  {s.term}
                  {catLabels[s.cat] && (
                    <span
                      class:list={[
                        'text-[10px] uppercase tracking-widest border px-1.5 py-0.5 normal-case',
                        s.cat === 'herni'
                          ? 'border-[var(--color-gold)] text-[var(--color-gold-light)]'
                          : 'border-[var(--color-gold-darkest)] text-[var(--color-text-on-dark-muted)]',
                      ]}
                    >
                      {catLabels[s.cat]}
                    </span>
                  )}
                  {showCanon(s) && canonLabels[s.canon] && (
                    <span class="text-[10px] uppercase tracking-widest border border-dashed border-[var(--color-gold-darkest)] text-[var(--color-text-on-dark-muted)] px-1.5 py-0.5 normal-case">
                      {canonLabels[s.canon]}
                    </span>
                  )}
                </dt>
                {s.aliases && s.aliases.length > 0 && (
                  <p class="font-[family-name:var(--font-serif)] italic text-xs text-[var(--color-text-on-dark-muted)] mt-1">
                    {labelAlias} {s.aliases.join(', ')}
                  </p>
                )}
                {s.discouraged && s.discouraged.length > 0 && (
                  <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-1">
                    {labelDiscouraged} <s>{s.discouraged.join(', ')}</s>
                  </p>
                )}
                <dd class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mt-1">{s.desc}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mb-2">
        {p.footer_note}
      </p>
      <div class="flex flex-wrap gap-3 mt-4">
        <a href={`/${lang}/svet-stredozeme/`} class="text-sm uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">{p.link_back_world}</a>
        <a href={`/${lang}/svet-stredozeme/narody/`} class="text-sm uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">{p.link_narody}</a>
      </div>

      </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

</BaseLayout>
