---
/**
 * Svět Středozemě — Místopis
 * URL: /cs/svet-stredozeme/mistopis/, …
 * Datum: 2026-04-30
 *
 * Místopis členěný po regionech: Rohan, Mlžné hory, lesy a elfské říše,
 * pevnosti a mocenská centra, severozápad / Eriador, Mordor a okolí, jih.
 * Texty parafrázované, bez přímých citací z Tolkienových knih.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Svět Středozemě', href: `/${lang}/svet-stredozeme/` },
  { label: 'Místopis' },
];

type Place = {
  name: string;
  alt?: string;
  region: string;
  desc: string;
  faction?: string;
  factionLabel?: string;
};
---

<BaseLayout
  title="Místopis Středozemě — Rohan, Gondor, Moria, Lothlórien"
  description="Přehled míst Středozemě po regionech: Rohan a okolí, Mlžné hory a Moria, lesy a elfské říše, pevnosti, severozápad, Mordor, jih a východ."
  lang={lang}
  breadcrumbs={[
    { name: 'Svět Středozemě', href: `/${lang}/svet-stredozeme/` },
    { name: 'Místopis', href: `/${lang}/svet-stredozeme/mistopis/` },
  ]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        Místopis Středozemě
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        Mapa po regionech — od Eriadoru po Mordor.
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Tato stránka shrnuje hlavní místa Středozemě tak, jak je popisuje
        Tolkien. Členíme je po regionech, aby se v nich dalo orientovat
        i bez mapy. U každého místa najdeš krátký popis, jeho roli ve Válce
        o Prsten a případnou vazbu na herní armádu.
      </p>

      <AlertBox variant="info" class="mb-10">
        Mapa do tohoto výpisu zatím není zařazena. Plánujeme ji přidat až jako
        samostatnou interaktivní vrstvu, kde se bude moct filtrovat podle
        národa, věku a strany konfliktu.
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <!-- ROHAN A OKOLÍ -->
      <h2 id="rohan" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Rohan a okolí
      </h2>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Rohan / Riddermark / Mark</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Země jezdců, ležící mezi Bílými horami, řekami Anduinou a Želízem.
        Druhotně osídlena Eorlovými lidmi za pomoc Gondoru. Stovky let drží
        Rohirim koně, kopí a přísahu Gondoru.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Calenardhon</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Staré jméno pro tutéž zemi v dobách, kdy patřila Gondoru. Po Eorlově
        příchodu se Calenardhon stal Rohanem.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Rohanská brána</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Široký průchod mezi Bílými horami a Mlžnými horami. Brána mezi
        Eriadorem a jihem; klíčový strategický bod.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Brody přes Želíz</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Mělčiny, kterými se přes řeku přechází z Rohanu do Eriadoru. Bod
        opakovaných bitev — také zde Saruman zaútočil na Rohan předtím, než
        Helmův žleb rozhodne.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Edoras a Meduseld</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Hlavní město Rohanu na kopci ve východním kraji země. V čele zlatá
        síň <strong>Meduseld</strong> — sídlo krále.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Helmův žleb / Hornburg</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Pevnost v rohu Bílých hor. Útočiště rohanského lidu před nepřítelem,
        který nedokáže dobýt otevřenou bitvu. Místo, kde se rozhodlo
        o Sarumanově porážce.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <!-- MLŽNÉ HORY -->
      <h2 id="mlzne-hory" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Mlžné hory a podzemí
      </h2>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Mlžné hory</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Dlouhý hřeben táhnoucí se Středozemí od severu na jih. Hlavní bariéra
        mezi Eriadorem a Rhovanionem. V jejich hlubinách žijí skřeti, draci
        a stará temnota.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Khazad-dûm / Moria</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Pradávná trpasličí říše vytesaná v hlubinách hor. Po probuzení Balroga
        a pádu krále Durina opuštěná. Po staletích pokus o návrat Balina končí
        vyhlazením celé výpravy. Pro Společenstvo Prstenu cesta, kterou nikdo
        nechtěl projít.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Caradhras (Krutohor)</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Vysoký vrchol Mlžných hor, jehož průsmyk Společenstvo Prstenu odmítl —
        sám Caradhras se postavil proti.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <!-- LESY A ELFSKÉ ŘÍŠE -->
      <h2 id="elfske-rise" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Lesy a elfské říše
      </h2>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Fangorn</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Pradávný les pod východními svahy Mlžných hor. Domov entů, kteří
        v něm dlouho dřímají. Setkání Smíška a Pipina s Stromovousem rozhýbe
        celou jejich Sněm — a ve výsledku zničí Železný pas.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Lothlórien (Zlatý les)</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Říše Galadriel a Celeborna — chráněná Nenyou, jedním ze Tří elfských
        prstenů. Středisko mallornů — zlatě zářících stromů. Pro Společenstvo
        místo odpočinku a darů, které jim později pomohou.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Caras Galadhon</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Hlavní město Lothlórienu — město na stromech, vystavěné kolem nejvyšších
        mallornů. Sídlo Galadriel a Celeborna.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Temný hvozd</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Dříve zvaný Velký zelený les, později zatažený stínem Dol Gulduru.
        Domov Thranduila a lesních elfů. Po zničení Jednoho prstenu se mu
        navrací světlo.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Imladris (Roklinka)</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Skrytá elfská říše v severozápadní Středozemi, sídlo Elronda. Místo
        Rady, na které vzniká Společenstvo Prstenu.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Šedé přístavy (Mithlond)</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Přístav v ústí řeky Lhûny, sídlo Círdana Loďaře. Odsud elfové vyplouvají
        na Západ. Na konci příběhu odplouvá tudy i Frodo, Bilbo a držitelé
        Tří elfských prstenů.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <!-- PEVNOSTI A MOCENSKÁ CENTRA -->
      <h2 id="pevnosti" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Pevnosti a mocenská centra
      </h2>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Železný pas / Angrenost / Orthank</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Údolí pod jižním koncem Mlžných hor. V jeho středu stojí černá věž
        <strong>Orthank</strong> z dávných časů. Sarumanovo sídlo, později jeho
        kovárna, kde se rodí Uruk-hai. Pád Železného pasu přijde, když enti
        prolomí jeho hráze a Saruman zůstane uvězněný v Orthanku.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Minas Tirith</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Hlavní město Gondoru — Věž stráže pod Bílou horou Mindolluinou. Sedm
        soustředných úrovní vytesaných do svahu, oddělené hradbami.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Osgiliath</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Stará hlavní město Gondoru, dnes z velké části ruina. Strategický most
        přes Anduinu — ten, kdo drží Osgiliath, drží přístup k Minas Tirith.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Dol Amroth</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Pobřežní knížectví na jihu Gondoru. Sídlo prince Imrahila, z rodu, který
        nese ve své krvi vzpomínku na elfské spojenectví.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Dol Guldur</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Pevnost na jihu Temného hvozdu. Po dlouhá staletí ovládaná stínem,
        dokud se její pán neukázal jako navrácený Sauron. Po Válce o Prsten
        ji srovná Galadriel.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Erebor</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Osamělá hora ve východním Rhovanionu. Pradávné trpasličí království.
        Po pádu draka Smauga je obnoveno a ve Válce o Prsten se účastní bitvy
        u Dolu.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <!-- SEVEROZÁPAD -->
      <h2 id="severozapad" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Severozápad / Eriador
      </h2>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Eriador</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Široký kraj mezi Mlžnými horami a Modrými horami. Kdysi srdce Severního
        království Arnoru; dnes téměř liduprázdný, kromě Kraje, Hůrky
        a několika dalších zbytků.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Arnor</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Severní lidské království. Po staletích postupně rozpadlé v bratrovražedných
        sporech a nakonec zničené Angmarem. Z jeho potomků se stávají Putující
        — Hraničáři Severu.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Kraj</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Země hobitů. Klidný, plodný, dobře hospodařený kout severozápadní
        Středozemě. Hraničáři ho dlouho chrání zpovzdálí, aniž by o tom hobiti
        věděli.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Hůrka (Bree)</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Lidsko-hobití městečko na křižovatce Východní cesty a staré Severní
        cesty. Hostinec U Skákavého poníka — místo, kde se osudy začínají
        proplétat.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <!-- MORDOR -->
      <h2 id="mordor" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Mordor a okolí
      </h2>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Mordor — Černá země</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Sídlo Saurona. Obklopena horami Ephel Dúath na západě, Ered Lithui
        na severu. Vnitřek tvoří Gorgoroth (oheň a popel) a Núrn (otrocká
        políčka, kterými se Sauronova vojska živí).
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Hora osudu (Orodruin)</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Vulkán, ve kterém Sauron ukoval Jeden prsten. Jediné místo, kde lze
        Prsten zničit.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Barad-dûr</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Sauronova Černá věž. Stojí, dokud existuje Jeden prsten. S jeho
        zničením se hroutí.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Cirith Ungol a Černá brána</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        <strong>Cirith Ungol</strong> — průsmyk se Šelobinou a věží na jeho
        druhé straně. <strong>Morannon (Černá brána)</strong> — hlavní vstup
        do Mordoru ze severu, místo závěrečné bitvy.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Minas Morgul</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Dříve gondorská věž Minas Ithil, později obsazená Nazgûly. Sídlo
        Černokněžného krále, dokud nevyrazí na Pelennorská pole.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <!-- JIH A VÝCHOD -->
      <h2 id="jih-vychod" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Jih a východ
      </h2>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Harad</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Široký pás teplých zemí jižně od Gondoru. Dělí se na Bližší a Vzdálený
        Harad. Kmeny Haradrim a obrovská zvířata mûmakil.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Umbar</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Velký jižní přístav. Po pádu Númenoru sídlo Černých Númenorejců,
        v Třetím věku korzárská základna ohrožující gondorské pobřeží.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">Rhûn</h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Rozsáhlé pláně východně od Mordoru. Domov Východňanů — různorodých
        kmenů, které ve známém příběhu nejčastěji slouží Sauronovi.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <div class="mt-10 pt-6 border-t border-[var(--color-gold-darkest)]">
        <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
          Související
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] space-y-1">
          <li>› <a href={`/${lang}/svet-stredozeme/narody/`} class="underline hover:text-[var(--color-gold-light)]">Národy</a></li>
          <li>› <a href={`/${lang}/svet-stredozeme/casova-linka/`} class="underline hover:text-[var(--color-gold-light)]">Časová linka</a></li>
          <li>› <a href={`/${lang}/svet-stredozeme/kralovstvi-a-rise/`} class="underline hover:text-[var(--color-gold-light)]">Království a říše</a></li>
          <li>› <a href={`/${lang}/frakce/`} class="underline hover:text-[var(--color-gold-light)]">Armády na akci</a></li>
        </ul>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-8 italic">
        Texty jsou parafrázované, bez přímých citací z Tolkienových knih.
      </p>

    </article>
  </section>

</BaseLayout>
