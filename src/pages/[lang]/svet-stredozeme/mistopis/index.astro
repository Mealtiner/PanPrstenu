---
/**
 * Svět Středozemě — Místopis
 * URL: /cs/svet-stredozeme/mistopis/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah načítán z src/content/pages/svet-stredozeme/mistopis/{lang}.json.
 * Strukturovaná data: regions[].places[] = opakované entity (CMS-friendly).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';

interface Place { name: string; desc: string }
interface Region { id: string; h2: string; places: Place[] }
interface Mistopis {
  meta: { title: string; description: string };
  breadcrumb: string;
  hero: { h1: string; subtitle: string };
  intro: string;
  alert_map: string;
  lang_notice: string;
  regions: Region[];
  related: { h: string; links: { label: string; path: string }[] };
  footnote: string;
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<Mistopis>('svet-stredozeme/mistopis', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('breadcrumb.world'), href: `/${lang}/svet-stredozeme/` },
  { label: p.breadcrumb },
];

// Render markdown-style **bold** v popisech (jednoduché split, jen pro <strong>)
function renderBold(text: string): string {
  return text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  lang={lang}
  breadcrumbs={[
    { name: t('breadcrumb.world'), href: `/${lang}/svet-stredozeme/` },
    { name: p.breadcrumb, href: `/${lang}/svet-stredozeme/mistopis/` },
  ]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.hero.h1}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {p.hero.subtitle}
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.intro}
      </p>

      <AlertBox variant="info" class="mb-10">
        {p.alert_map}
      </AlertBox>

      {lang !== 'cs' && (
        <AlertBox variant="warning" class="mb-10">
          {p.lang_notice}
        </AlertBox>
      )}

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      {p.regions.map((region, idx) => (
        <>
          {idx > 0 && <Divider variant="line-diamond" tone="dark" class="my-8" />}
          <h2 id={region.id} class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
            {region.h2}
          </h2>
          {region.places.map((place) => (
            <>
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">{place.name}</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3" set:html={renderBold(place.desc)}></p>
            </>
          ))}
        </>
      ))}

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <div class="mt-10 pt-6 border-t border-[var(--color-gold-darkest)]">
        <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
          {p.related.h}
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] space-y-1">
          {p.related.links.map((link) => (
            <li>› <a href={`/${lang}${link.path}`} class="underline hover:text-[var(--color-gold-light)]">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-8 italic">
        {p.footnote}
      </p>

    </article>
  </section>

</BaseLayout>
