---
/**
 * Svět Středozemě — Království a říše
 * URL: /cs/svet-stredozeme/kralovstvi-a-rise/, …
 * Datum: 2026-05-04
 *
 * Politicko-mocenský přehled. Komplementární k /narody/ (etnografie)
 * a /mistopis/ (geografie) — tady jde o struktury moci.
 * Texty parafrázované, bez přímých citací z Tolkienových knih.
 *
 * 2026-05-04: UI texty přeloženy do 5 jazyků; položky říší (name, era,
 * ruler, capital, fate, desc) zůstávají v CS s lang_notice.
 * 2026-08-03: rozšířeno ze 14 na 38 útvarů podle encyklopedického podkladu;
 * přidáno boční menu (TocSidebar + scrollspy) a `id` jako anchor u každé říše.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import StructuredData from '@components/seo/StructuredData.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('svet-stredozeme/kralovstvi-a-rise', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('breadcrumb.world'), href: `/${lang}/svet-stredozeme/` },
  { label: p.bc_self },
];

type Realm = {
  // `id` = anchor pro boční navigační menu (ASCII kebab-case, bez diakritiky)
  id: string;
  name: string;
  era: string;
  ruler: string;
  capital: string;
  fate: string;
  side: 'free' | 'evil' | 'mixed';
  desc: string;
};

// Říše se načítají z obsahových JSONů (src/content/pages/svet-stredozeme/
// kralovstvi-a-rise/{lang}.json → pole `realms`), aby byly přeložitelné.
// `getPageData` dělá fallback na úrovni celého souboru, ne jednotlivých klíčů,
// proto per-klíč fallback na CS řešíme tady — jazyk bez přeloženého `realms`
// tak zobrazí české položky místo prázdné stránky.
const csPage = getPageData<PageContent>('svet-stredozeme/kralovstvi-a-rise', 'cs');
const realms: Realm[] = ((p.realms ?? csPage.realms) as unknown as Realm[]) ?? [];

const sideLabel = (s: Realm['side']) => {
  if (s === 'free') return p.side_free;
  if (s === 'evil') return p.side_evil;
  return p.side_mixed;
};
const sideClass = (s: Realm['side']) => {
  if (s === 'free') return 'border-[var(--color-side-free-text)]';
  if (s === 'evil') return 'border-[var(--color-side-evil-text)]';
  return 'border-[var(--color-gold-darkest)]';
};

const langNotice = p.lang_notice;

// Položky bočního menu — generované z `realms`, aby menu vždy odpovídalo obsahu.
// V labelu odřízneme přívlastek za pomlčkou („Arnor — Severní království" → „Arnor"),
// aby se do 260px sloupce vešel jeden řádek.
const tocItems = [
  ...realms.map((r) => ({
    id: r.id,
    label: r.name.replace(/\s+[—–-]\s.*$/, '').trim(),
  })),
  { id: 'chybi', label: p.h_missing },
];

/**
 * JSON-LD ItemList — strojový rejstřík říší a království.
 * Datum: 2026-08-14
 *
 * Stejná logika jako u /mistopis/ a /narody/: dát AI nástrojům explicitní
 * výčet 38 útvarů s kotvami místo toho, aby si je musely tahat z HTML.
 * Fiktivní entity vědomě nemarkujeme jako `Place` ani `Organization`.
 */
const realmsUrl = new URL(`/${lang}/svet-stredozeme/kralovstvi-a-rise/`, Astro.site).toString();
const realmsJsonLd = realms.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      '@id': `${realmsUrl}#realms`,
      name: p.meta_title,
      description: p.description,
      url: realmsUrl,
      inLanguage: lang,
      numberOfItems: realms.length,
      itemListOrder: 'https://schema.org/ItemListUnordered',
      itemListElement: realms.map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: r.name,
        description: r.desc,
        url: `${realmsUrl}#${r.id}`,
      })),
    }
  : null;
---

<BaseLayout
  title={p.meta_title}
  description={p.description}
  lang={lang}
  breadcrumbs={[
    { name: t('breadcrumb.world'), href: `/${lang}/svet-stredozeme/` },
    { name: p.bc_self, href: `/${lang}/svet-stredozeme/kralovstvi-a-rise/` },
  ]}
>

  <StructuredData data={realmsJsonLd} />

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.title}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {p.subtitle}
      </p>
    </div>
  </section>

  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
      <TocSidebar items={tocItems} title={t('toc.title')} ariaLabel={t('toc.aria')} />
      <article class="min-w-0 max-w-4xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.intro_pre}<a href={`/${lang}/svet-stredozeme/narody/`} class="underline">{p.intro_l1}</a>{p.intro_mid}<a href={`/${lang}/svet-stredozeme/mistopis/`} class="underline">{p.intro_l2}</a>{p.intro_mid2}<strong>{p.intro_strong}</strong>{p.intro_post}
      </p>

      <AlertBox variant="info" class="mb-10">
        {p.alert_intro}
      </AlertBox>

      {langNotice && (
        <AlertBox variant="warning" class="mb-10">
          {langNotice}
        </AlertBox>
      )}

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <div class="space-y-6">
        {realms.map((r) => (
          <article id={r.id} class={`bg-[var(--color-bg-medium)] border-l-4 ${sideClass(r.side)} border-y border-r border-[var(--color-gold-darkest)] p-5 scroll-mt-24`}>
            <div class="flex items-start justify-between flex-wrap gap-3 mb-3">
              <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)]">
                {r.name}
              </h2>
              <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-on-dark-muted)] border border-[var(--color-gold-darkest)] px-2 py-0.5">
                {sideLabel(r.side)}
              </span>
            </div>
            <dl class="grid grid-cols-1 md:grid-cols-3 gap-x-4 gap-y-1 text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)] mb-3">
              <div><dt class="text-[var(--color-gold)]">{p.field_era}</dt><dd class="text-[var(--color-text-on-dark)] normal-case tracking-normal">{r.era}</dd></div>
              <div><dt class="text-[var(--color-gold)]">{p.field_ruler}</dt><dd class="text-[var(--color-text-on-dark)] normal-case tracking-normal">{r.ruler}</dd></div>
              <div><dt class="text-[var(--color-gold)]">{p.field_capital}</dt><dd class="text-[var(--color-text-on-dark)] normal-case tracking-normal">{r.capital}</dd></div>
            </dl>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-2">
              {r.desc}
            </p>
            <p class="text-xs text-[var(--color-text-on-dark-muted)] italic">
              <strong class="text-[var(--color-gold-light)]">{p.field_fate}</strong> {r.fate}
            </p>
          </article>
        ))}
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <h2 id="chybi" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        {p.h_missing}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {p.missing_p}
      </p>

      <div class="mt-10 pt-6 border-t border-[var(--color-gold-darkest)]">
        <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
          {p.related_h}
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] space-y-1">
          <li>› <a href={`/${lang}/svet-stredozeme/narody/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l1}</a></li>
          <li>› <a href={`/${lang}/svet-stredozeme/mistopis/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l2}</a></li>
          <li>› <a href={`/${lang}/svet-stredozeme/casova-linka/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l3}</a></li>
          <li>› <a href={`/${lang}/frakce/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l4}</a></li>
        </ul>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-8 italic">
        {p.footnote}
      </p>

      </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

</BaseLayout>
