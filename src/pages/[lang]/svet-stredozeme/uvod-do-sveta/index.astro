---
/**
 * Svět Středozemě — Úvod do světa
 * URL: /cs/svet-stredozeme/uvod-do-sveta/, …
 * Datum: 2026-05-03
 *
 * Krátká parafrázovaná kosmologie: Eru, Ainur, Valar, Maiar, Arda, Eä,
 * Melkor a Sauron. Žádné přímé citace z Tolkienových knih.
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('svet-stredozeme/uvod-do-sveta', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: p.bc_world, href: `/${lang}/svet-stredozeme/` },
  { label: p.bc_self },
];
---

<BaseLayout
  title={p.meta_title}
  description={p.description}
  lang={lang}
  breadcrumbs={[
    { name: p.bc_world, href: `/${lang}/svet-stredozeme/` },
    { name: p.bc_self, href: `/${lang}/svet-stredozeme/uvod-do-sveta/` },
  ]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.title}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {p.subtitle}
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-3xl">

      <h2 class="font-[family-name:var(--font-display)] text-base uppercase tracking-widest text-[var(--color-gold)] mb-2">
        {p.h_summary}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6 italic">
        {p.summary}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 id="eru" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        {p.h_eru}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.eru_p1_pre}<strong>{p.eru_p1_strong}</strong>{p.eru_p1_post}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.eru_p2}
      </p>

      <h2 id="ainur" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        {p.h_ainur}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.ainur_p1_pre}<strong>{p.ainur_p1_strong}</strong>{p.ainur_p1_mid}<em>{p.ainur_p1_em}</em>{p.ainur_p1_mid2}<em>{p.ainur_p1_em2}</em>{p.ainur_p1_post}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.ainur_p2_pre}<strong>{p.ainur_p2_s1}</strong>{p.ainur_p2_mid}<strong>{p.ainur_p2_s2}</strong>{p.ainur_p2_post}
      </p>

      <h2 id="arda" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        {p.h_arda}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.arda_p1_pre}<strong>{p.arda_p1_s1}</strong>{p.arda_p1_mid}<strong>{p.arda_p1_s2}</strong>{p.arda_p1_mid2}<strong>{p.arda_p1_s3}</strong>{p.arda_p1_post}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.arda_p2}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 id="zlo" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        {p.h_evil}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.evil_p1_pre}<strong>{p.evil_p1_s1}</strong>{p.evil_p1_mid}<strong>{p.evil_p1_s2}</strong>{p.evil_p1_post}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.evil_p2_pre}<strong>{p.evil_p2_s1}</strong>{p.evil_p2_post}
      </p>

      <h2 id="rasy" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        {p.h_races}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.races_p1_pre}<strong>{p.races_p1_s1}</strong>{p.races_p1_mid}<strong>{p.races_p1_s2}</strong>{p.races_p1_post}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.races_p2_pre}<strong>{p.races_p2_s1}</strong>{p.races_p2_post}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <AlertBox variant="info" title={p.alert_title} class="mb-8">
        {p.alert_p_pre}<strong>{p.alert_p_strong}</strong>{p.alert_p_post}
      </AlertBox>

      <div class="mt-10 pt-6 border-t border-[var(--color-gold-darkest)]">
        <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
          {p.related_h}
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] space-y-1">
          <li>› <a href={`/${lang}/svet-stredozeme/slovnicek/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l1}</a></li>
          <li>› <a href={`/${lang}/svet-stredozeme/narody/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l2}</a></li>
          <li>› <a href={`/${lang}/svet-stredozeme/casova-linka/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l3}</a></li>
          <li>› <a href={`/${lang}/svet-stredozeme/mistopis/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l4}</a></li>
          <li>› <a href={`/${lang}/frakce/`} class="underline hover:text-[var(--color-gold-light)]">{p.related_l5}</a></li>
        </ul>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-8 italic">
        {p.footnote}
      </p>

    </article>
  </section>

</BaseLayout>
