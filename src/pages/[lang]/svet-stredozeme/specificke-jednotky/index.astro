    origin: 'Lothlórien — říše Galadriel a Celeborna.',
    shortDesc: 'Lesní elfové se zlatým laděním a tichou silou.',
    whyInStory: 'V některých ročnících přicházejí jako záloha Svobodným, jindy zajišťují bezpečí cest Středozemí.',
    look: 'Bílé, šedé a zlaté tóny, mallornové motivy, lehčí výzbroj, elegantní silueta.',
  },
  {
    name: 'Elfové z Temného hvozdu',
    side: 'free',
    origin: 'Lesní elfové Thranduila ze severního Hvozdu.',
    shortDesc: 'Drsnější lesní větev — stínové barvy, lov, hluboké hvozdy.',
    whyInStory: 'Bojují s pavouky a stínem z Dol Gulduru. V některých letech přicházejí na jih, aby pomohli proti vojskům Mordoru.',
    look: 'Tmavá zeleň, hnědá, kožené prvky, luky, krátké meče, lesní kapuce.',
  },
  {
    name: 'Trpaslíci — Glóinovy sbory',
    side: 'free',
    origin: 'Erebor pod Osamělou horou; rod Durina.',
    shortDesc: 'Disciplinovaná trpasličí jednotka pod velením staršího pána Glóina.',
    whyInStory: 'Hájí zájmy Severu před skřety z Mlžných hor a před hrozbou z Dol Gulduru.',
    look: 'Vrstvené tuniky, vousy, sekery, kladiva, štíty s runami, plné kožené opasky.',
  },
  {
    name: 'Rohirim od Západních úvalů',
    side: 'free',
    origin: 'Rohan — pohraniční oblasti u Brodů přes Želíz.',
    shortDesc: 'Lehká jízda a pěchota Rohanu hlídající západní hranici.',
    whyInStory: 'V naší tradici drží frontu proti Sarumanovi a první nesou zprávu o jeho zradě.',
    look: 'Plášť, kožená vyšívaná tunika, koňské motivy, oštěpy, sekery, kulaté štíty.',
  },
  {
    name: 'Arnorští / Eriadorští Dúnedainové',
    side: 'free',
    origin: 'Hraničáři Severu — potomci Arnoru.',
    shortDesc: 'Skrytí strážci Eriadoru a Kraje, dědicové padlého Severního království.',
    whyInStory: 'V našich příbězích občas sestoupí na jih, aby pomohli Gondoru — nebo aby ochránili konkrétní cíl, který nesmí padnout.',
    look: 'Šedý plášť, zelené a hnědé tóny, znak hvězdy, dlouhé meče, luky, žádné okázalé znaky.',
  },
  {
    name: 'Boromirova družina',
    side: 'free',
    origin: 'Gondor — Bílá společnost před Válkou o Prsten.',
    shortDesc: 'Vybraná stráž Boromira, syna Správce Denethora.',
    whyInStory: 'V herních rocích, kde se odehrávají události před Pelennorem, se objevuje jako gondorské jádro vyslané na sever.',
    look: 'Stříbrná, černá, modrá. Bílý strom, sedm hvězd. Plný brnění, dlouhé meče, dlouhé štíty.',
  },
];

