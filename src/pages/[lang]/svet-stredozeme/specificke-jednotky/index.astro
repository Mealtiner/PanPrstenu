---
/**
 * Svět Středozemě — Specifické jednotky
 * URL: /cs/svet-stredozeme/specificke-jednotky/, …
 * Datum: 2026-04-30
 *
 * Herně-loreové jednotky z historie PP. NEJSOU automaticky registrační
 * frakce a NEMUSEJÍ se objevit v každém ročníku — jde o tematické vrstvy
 * a družiny, které se v naší tradici objevily.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Svět Středozemě', href: `/${lang}/svet-stredozeme/` },
  { label: 'Specifické jednotky' },
];

type Unit = {
  name: string;
  side: 'free' | 'evil';
  origin: string;
  shortDesc: string;
  whyInStory: string;
  look: string;
};

const freeUnits: Unit[] = [
  {
    name: 'Elfové ze Zlatého lesa',
