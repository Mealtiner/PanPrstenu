  },
  {
    name: 'Poslední Horalé / Vrchovci',
    side: 'evil',
    origin: 'Hory za Železným pasem.',
    shortDesc: 'Lidský kmen, který se k Sarumanovi připojil ze starých nepřátelství s Rohanem.',
    whyInStory: 'V ročnících zaměřených na Železný pas tvoří lidskou složku Sarumanova vojska — vedle skřetů a Uruk-hai.',
    look: 'Hnědé a šedé barvy, kožešiny, hrubé sekery, krátké meče, kotouče, prvky starší kultury.',
  },
];
---

<BaseLayout
  title="Specifické jednotky — historie PP"
  description="Specifické jednotky a družiny, které se objevily v dějinách Pána Prstenů. Lore vrstva, ne registrační frakce — některé se vracejí, jiné jsou tematické pro konkrétní ročník."
  lang={lang}
  breadcrumbs={[
    { name: 'Svět Středozemě', href: `/${lang}/svet-stredozeme/` },
    { name: 'Specifické jednotky', href: `/${lang}/svet-stredozeme/specificke-jednotky/` },
  ]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        Specifické jednotky
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        Družiny, které se objevily v dějinách Pána Prstenů — od Glóinových
        sbor po posádku Hlubiny.
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        V průběhu let se na našem larpu objevilo několik tematických jednotek.
        Některé vznikly z příběhů organizátorů, jiné přinesli sami hráči a my
        je zapojili do hry. <strong>Neobjevují se každý ročník</strong>, ale
        tvoří důležitou vrstvu světa Pána Prstenů.
      </p>

      <AlertBox variant="warning" title="Není to registrační frakce" class="mb-10">
        Jednotky níže nejsou samostatné registrační frakce. Většina z nich
        spadá pod některou z hlavních <a href={`/${lang}/frakce/`} class="underline">frakcí</a>,
        nebo se zapojuje pod jinou cestou. Pokud tě zaujmou, ozvi se
        organizátorům na <a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a>.
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <!-- SVOBODNÉ -->
      <h2 id="svobodne" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-side-free-text)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="game-icons:crossed-swords" class="w-7 h-7" aria-hidden="true" />
        Síly Svobodných národů
      </h2>

      <div class="space-y-6 mb-10">
        {freeUnits.map((u) => (
          <article class="bg-[var(--color-bg-medium)] border-l-4 border-[var(--color-side-free-text)] border-y border-r border-[var(--color-gold-darkest)] p-5">
            <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2">
              {u.name}
            </h3>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              {u.shortDesc}
            </p>
            <dl class="text-xs text-[var(--color-text-on-dark)] space-y-2">
              <div><dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-[var(--color-gold)]">Původ</dt><dd>{u.origin}</dd></div>
              <div><dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-[var(--color-gold)]">Proč se objevuje v příběhu</dt><dd>{u.whyInStory}</dd></div>
              <div><dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-[var(--color-gold)]">Vzhled a styl</dt><dd>{u.look}</dd></div>
            </dl>
          </article>
        ))}
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- TEMNÉ -->
      <h2 id="temne" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-side-evil-text)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="game-icons:dread-skull" class="w-7 h-7" aria-hidden="true" />
        Síly Temného pána
      </h2>

      <div class="space-y-6 mb-10">
        {darkUnits.map((u) => (
          <article class="bg-[var(--color-bg-medium)] border-l-4 border-[var(--color-side-evil-text)] border-y border-r border-[var(--color-gold-darkest)] p-5">
            <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2">
              {u.name}
            </h3>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              {u.shortDesc}
            </p>
            <dl class="text-xs text-[var(--color-text-on-dark)] space-y-2">
              <div><dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-[var(--color-gold)]">Původ</dt><dd>{u.origin}</dd></div>
              <div><dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-[var(--color-gold)]">Proč se objevuje v příběhu</dt><dd>{u.whyInStory}</dd></div>
              <div><dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-[var(--color-gold)]">Vzhled a styl</dt><dd>{u.look}</dd></div>
            </dl>
          </article>
        ))}
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        Chceš přivézt vlastní družinu?
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pokud máš nápad na tematickou družinu — kupecký karavan, žoldnéřskou
        četu, klan, nebo malou tematickou jednotku ve stylu některé z hlavních
        frakcí — ozvi se organizátorům. Některé z výše uvedených družin vznikly
        právě tak, že je přinesli sami hráči.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Vlastní družina <strong>nenahrazuje pravidla frakce</strong>. Stále se
        registruje pod některou z existujících frakcí a její členové dodržují
        kostýmová a bojová pravidla této frakce.
      </p>

      <div class="mt-10 pt-6 border-t border-[var(--color-gold-darkest)]">
        <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
          Související
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] space-y-1">
          <li>› <a href={`/${lang}/frakce/`} class="underline hover:text-[var(--color-gold-light)]">Herní frakce</a></li>
          <li>› <a href={`/${lang}/svet-stredozeme/narody/`} class="underline hover:text-[var(--color-gold-light)]">Národy Středozemě</a></li>
          <li>› <a href={`/${lang}/pribeh/`} class="underline hover:text-[var(--color-gold-light)]">Příběh ročníku</a></li>
          <li>› <a href={`/${lang}/kontakt/`} class="underline hover:text-[var(--color-gold-light)]">Kontakt na organizátory</a></li>
        </ul>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-8 italic">
        Texty jsou v herním pojetí PP. Některé jednotky vycházejí z Tolkiena,
        jiné jsou v dějinách našeho larpu specifické. Bez záruky, že se objeví
        v každém ročníku.
      </p>

    </article>
  </section>

</BaseLayout>
