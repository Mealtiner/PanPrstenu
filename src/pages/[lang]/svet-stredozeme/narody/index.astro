---
/**
 * Svět Středozemě — Národy
 * URL: /cs/svet-stredozeme/narody/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah načítán z src/content/pages/svet-stredozeme/narody/{lang}.json
 * Strukturovaná data: peoples[].paragraphs[] + in_game block, more_beings.items[].
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import Button from '@components/ui/Button.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import StructuredData from '@components/seo/StructuredData.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';

interface InGameSingle {
  type: 'in_game' | 'in_game_pp';
  pre?: string;
  link_text?: string;
  link_path?: string;
  post?: string;
  text?: string;
}
interface InGameDual {
  type: 'in_game_dual';
  pre: string;
  link1_text: string;
  link1_path: string;
  mid: string;
  link2_text: string;
  link2_path: string;
  post: string;
}
type InGame = InGameSingle | InGameDual;

interface People {
  id: string;
  h2: string;
  paragraphs: string[];
  // Volitelné — jen u národů, které mají na akci odpovídající armádu nebo roli.
  // Encyklopedická hesla (Vanyar, Avari, Lossoth, …) ho nemají.
  in_game?: InGame;
}

interface Narody {
  meta: { title: string; description: string };
  breadcrumb: string;
  hero: { h1: string; subtitle: string };
  intro: string;
  alert: { pre: string; l1: string; mid: string; l2: string; post: string };
  lang_notice: string;
  in_game_label: string;
  in_game_pp_label: string;
  peoples: People[];
  more_beings: { h2: string; intro: string; items: { name: string; desc: string }[] };
  buttons: { armies: string; back: string };
  footnote: string;
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<Narody>('svet-stredozeme/narody', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('breadcrumb.world'), href: `/${lang}/svet-stredozeme/` },
  { label: p.breadcrumb },
];

function renderBold(text: string): string {
  return text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}

// Položky bočního menu — generované z dat, aby menu vždy odpovídalo obsahu.
// V labelu odřízneme závorkový přívlastek („Noldor (Vznešení elfové)" → „Noldor"),
// aby se do 260px sloupce vešel jeden řádek.
const tocItems = [
  ...p.peoples.map((person) => ({
    id: person.id,
    label: person.h2.replace(/\s*[（(].*$/, '').trim(),
  })),
  { id: 'dalsi', label: p.more_beings.h2 },
];

/**
 * JSON-LD ItemList — strojový rejstřík národů a bytostí.
 * Datum: 2026-08-14
 *
 * Encyklopedická hesla jsou v HTML jen `<h2>` + odstavce; ItemList z nich
 * udělá explicitní výčet, takže AI asistent umí odpovědět „jaké národy
 * Středozemě web popisuje" bez čtení celé stránky. Každá položka odkazuje
 * na svou kotvu (`#<id>`). Jako popis bereme první odstavec hesla.
 */
const narodyUrl = new URL(`/${lang}/svet-stredozeme/narody/`, Astro.site).toString();
const stripMd = (s: string) => s.replace(/\*\*?([^*]+)\*\*?/g, '$1').trim();

const narodyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${narodyUrl}#peoples`,
  name: p.meta.title,
  description: p.meta.description,
  url: narodyUrl,
  inLanguage: lang,
  numberOfItems: p.peoples.length + p.more_beings.items.length,
  itemListOrder: 'https://schema.org/ItemListUnordered',
  itemListElement: [
    ...p.peoples.map((person) => ({
      '@type': 'ListItem',
      name: person.h2,
      description: person.paragraphs?.[0] ? stripMd(person.paragraphs[0]) : undefined,
      url: `${narodyUrl}#${person.id}`,
    })),
    ...p.more_beings.items.map((b) => ({
      '@type': 'ListItem',
      name: b.name,
      description: stripMd(b.desc),
      url: `${narodyUrl}#dalsi`,
    })),
  ].map((el, i) => ({ ...el, position: i + 1 })),
};
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  lang={lang}
  breadcrumbs={[
    { name: t('breadcrumb.world'), href: `/${lang}/svet-stredozeme/` },
    { name: p.breadcrumb, href: `/${lang}/svet-stredozeme/narody/` },
  ]}
>

  <StructuredData data={narodyJsonLd} />

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.hero.h1}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {p.hero.subtitle}
      </p>
    </div>
  </section>

  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
      <TocSidebar items={tocItems} title={t('toc.title')} ariaLabel={t('toc.aria')} />
      <article class="min-w-0 max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.intro}
      </p>

      <AlertBox variant="info" class="mb-10">
        {p.alert.pre}<a href={`/${lang}/frakce/`} class="underline">{p.alert.l1}</a>{p.alert.mid}<a href={`/${lang}/pravidla/`} class="underline">{p.alert.l2}</a>{p.alert.post}
      </AlertBox>

      {lang !== 'cs' && (
        <AlertBox variant="warning" class="mb-10">
          {p.lang_notice}
        </AlertBox>
      )}

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      {p.peoples.map((person, idx) => {
        // `in_game` je volitelné — encyklopedická hesla bez armády na akci ho nemají.
        // Pro discriminated-union narrowing potřebujeme non-optional referenci,
        // proto `hasIg` + `ig` (uvnitř bloku se renderuje jen když hasIg === true).
        const hasIg = person.in_game !== undefined;
        const ig = person.in_game as InGame;
        const labelKey = hasIg && ig.type === 'in_game_pp' ? p.in_game_pp_label : p.in_game_label;
        return (
          <>
            {idx > 0 && idx % 2 === 0 && <Divider variant="line-diamond" tone="dark" class="my-8" />}
            <h2 id={person.id} class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
              {person.h2}
            </h2>
            {person.paragraphs.map((para) => (
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3" set:html={renderBold(para)}></p>
            ))}
            {hasIg ? (
              <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-4 mb-8 text-sm">
                <strong class="text-[var(--color-gold-light)]">{labelKey}</strong>{' '}
                {ig.type === 'in_game_dual' ? (
                  <>{ig.pre}<a href={`/${lang}${ig.link1_path}`} class="underline">{ig.link1_text}</a>{ig.mid}<a href={`/${lang}${ig.link2_path}`} class="underline">{ig.link2_text}</a>{ig.post}</>
                ) : ig.text ? (
                  <span set:html={renderBold(ig.text)} />
                ) : (
                  <>{ig.pre}<a href={`/${lang}${ig.link_path}`} class="underline">{ig.link_text}</a>{ig.post}</>
                )}
              </div>
            ) : (
              <div class="mb-8"></div>
            )}
          </>
        );
      })}

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 id="dalsi" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        {p.more_beings.h2}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {p.more_beings.intro}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
        {p.more_beings.items.map((item) => (
          <li><strong>{item.name}</strong>{item.desc}</li>
        ))}
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <div class="text-center mb-6">
        <Button href={`/${lang}/frakce/`} variant="primary" size="md">{p.buttons.armies}</Button>
        <Button href={`/${lang}/svet-stredozeme/`} variant="ghost" size="sm" class="ml-2">{p.buttons.back}</Button>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic">
        {p.footnote}
      </p>

      </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

</BaseLayout>
