---
/**
 * Role — Stánkaři
 * URL: /cs/role/stankari/, …
 * Datum: 2026-05-01
 *
 * Stručná role-stránka pro stánkaře. Detailní přihláška a podmínky jsou
 * na /cs/pro-stankare/, seznam přihlášených na /cs/stanky-a-prodejci/.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title'), href: `/${lang}/frakce/` },
  { label: 'Stánkaři' },
];
---

<BaseLayout
  title="Stánkaři — Pán Prstenů 2026"
  description="Stánkaři a prodejci na Pánu Prstenů: kdo se může přihlásit, co zajišťujeme, kostýmová atmosféra a jak se přihlásit."
  lang={lang}
  breadcrumbs={[
    { name: t('page.factions.title'), href: `/${lang}/frakce/` },
    { name: 'Stánkaři', href: `/${lang}/role/stankari/` },
  ]}
>

  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="🏪" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">Další role</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            Stánkaři
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            Řemeslo, jarmark a věci, které do Středozemě patří.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug="stankari"
          currentSection="role"
        />

        <article class="max-w-3xl">

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Kdo je stánkař?
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            Stánkař je <strong>prodejce nebo řemeslník</strong>, který na akci
            přiveze stánek s tematickým zbožím nebo službou. Patří do prostoru
            jarmarku a do tábořiště — atmosféricky, kostýmově i obchodně.
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            Vítáme prodejce kostýmů, látek, zbraní pro larp, kožených výrobků,
            opasků a taštic, karetkovaných pásek, šperků, zbrojí, tábornického
            vybavení a dalších věcí vhodných do fantasy / historizujícího
            prostředí.
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Co od tebe čekáme
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
            <li><strong>Tematický sortiment</strong> — věci, které sedí
              do Středozemě nebo do fantasy / historizujícího prostředí.</li>
            <li><strong>Atmosférický stánek</strong> — nemusí být dokonalý
              středověký krám, ale plachta, dřevo a látka udělá hodně.
              Křiklavé moderní prvky maskuj.</li>
            <li><strong>Obsluha v kostýmu nebo nenápadném oděvu</strong>
              — ne hi-vis vestě, ne v ladovém tričku.</li>
            <li><strong>Vlastní zázemí</strong> — stánek, vybavení, pokladna,
              obsluha, výrobky.</li>
            <li><strong>Předchozí domluva</strong> s organizátory přes
              <a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>.</li>
          </ul>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Co zajišťujeme my
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>Místo pro stánek v jarmarku.</li>
            <li>Základní zařazení do prostoru tábořiště.</li>
            <li>Komunikaci před akcí.</li>
            <li>Možnost být uveden v
              <a href={`/${lang}/stanky-a-prodejci/`} class="underline text-[var(--color-gold-light)]">seznamu prodejců</a>
              na webu.</li>
          </ul>

          <AlertBox variant="info" class="mb-8">
            Hospoda <strong>U Zeleného draka</strong> je samostatný partner
            mimo systém stánků a má vlastní organizační dohodu. Pokud chceš
            nabízet vlastní jídlo nebo nápoje, ozvi se předem — kvůli koordinaci
            s hospodou.
          </AlertBox>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Jak se přihlásit
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Detailní postup, formulář a podmínky najdeš na stránce
            <a href={`/${lang}/pro-stankare/`} class="underline text-[var(--color-gold-light)]"><strong>Pro stánkaře</strong></a>.
            Stručně:
          </p>
          <ol class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-8">
            <li>1. Napiš na <a href="mailto:info@panprstenu.cz?subject=Stánkař%20—%20přihláška" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>
              s názvem stánku, popisem sortimentu, odkazem na web/sociální sítě
              a kontaktem.</li>
            <li>2. Domluvíme detaily (velikost stánku, zázemí, logistika).</li>
            <li>3. Po potvrzení tě uvedeme v
              <a href={`/${lang}/stanky-a-prodejci/`} class="underline text-[var(--color-gold-light)]">seznamu prodejců</a>.</li>
          </ol>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <div class="flex flex-wrap gap-3">
            <Button href={`/${lang}/pro-stankare/`} variant="primary" size="md" icon="lucide:arrow-right">
              Pro stánkaře — detail
            </Button>
            <Button href={`/${lang}/stanky-a-prodejci/`} variant="secondary" size="md">
              Seznam prodejců
            </Button>
            <Button href="mailto:info@panprstenu.cz?subject=Stánkař%20—%20přihláška" variant="ghost" size="md">
              Napsat organizátorům
            </Button>
          </div>

        </article>
      </div>
    </div>
  </section>

</BaseLayout>
