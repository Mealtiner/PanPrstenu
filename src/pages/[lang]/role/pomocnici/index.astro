---
/**
 * Role — Pomocníci
 * URL: /cs/role/pomocnici/, …
 * Datum: 2026-05-03
 *
 * Obsah verze v2 (z balíčku „Další role v2"). Klíč: pomoc dle domluvy,
 * pomocník není automaticky organizátor, možná odměna (sleva, odpuštění
 * registračního poplatku, jídlo a pití) podle rozsahu pomoci.
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('role/pomocnici', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('breadcrumb.factions'), href: `/${lang}/frakce/` },
  { label: p.title },
];

const mailto = 'mailto:info@panprstenu.cz?subject=Chci%20pom%C3%A1hat%20%E2%80%94%20P%C3%A1n%20Prsten%C5%AF%202026';
---

<BaseLayout
  title={p.meta_title}
  description={p.description}
  lang={lang}
  breadcrumbs={[
    { name: t('breadcrumb.factions'), href: `/${lang}/frakce/` },
    { name: p.title, href: `/${lang}/role/pomocnici/` },
  ]}
>

  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion iconSlug="pomocnici" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">{p.tag}</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            {p.title}
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            {p.subtitle}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug="pomocnici"
          currentSection="role"
        />

        <article class="max-w-3xl">

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_who}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.who_p1}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.who_p2_pre}<strong>{p.who_p2_strong}</strong>{p.who_p2_post}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.who_p3}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>{p.who_l1}</li>
            <li>{p.who_l2}</li>
            <li>{p.who_l3}</li>
            <li>{p.who_l4}</li>
            <li>{p.who_l5}</li>
            <li>{p.who_l6}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <!-- 60 sekund box -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-6 mb-10">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:clock" class="w-5 h-5" aria-hidden="true" />
              {p.h_60s}
            </h2>
            <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1.5">
              <li>{p.s60_l1}</li>
              <li>{p.s60_l2}</li>
              <li>{p.s60_l3}</li>
              <li>{p.s60_l4}</li>
              <li>{p.s60_l5}</li>
              <li>{p.s60_l6}</li>
              <li>{p.s60_l7}</li>
            </ul>
          </div>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_what}
          </h2>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-4">
            {p.what1_h}
          </h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.what1_p}
          </p>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-4">
            {p.what2_h}
          </h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.what2_p}
          </p>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-4">
            {p.what3_h}
          </h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.what3_p}
          </p>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-4">
            {p.what4_h}
          </h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.what4_p}
          </p>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-4">
            {p.what5_h}
          </h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.what5_p}
          </p>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-4">
            {p.what6_h}
          </h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            {p.what6_p}
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_engagement}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.eng_intro}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
            <li>{p.eng_l1}</li>
            <li>{p.eng_l2}</li>
            <li>{p.eng_l3}</li>
            <li>{p.eng_l4}</li>
            <li>{p.eng_l5}</li>
          </ul>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 italic">
            {p.eng_note}
          </p>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_reward}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.reward_intro}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
            <li>{p.reward_l1}</li>
            <li>{p.reward_l2}</li>
            <li>{p.reward_l3}</li>
            <li>{p.reward_l4}</li>
          </ul>
          <AlertBox variant="info" class="mb-8">
            {p.reward_alert}
          </AlertBox>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_from_us}
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>{p.from_us_l1}</li>
            <li>{p.from_us_l2}</li>
            <li>{p.from_us_l3}</li>
            <li>{p.from_us_l4}</li>
            <li>{p.from_us_l5}</li>
            <li>{p.from_us_l6}</li>
          </ul>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_from_you}
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
            <li>{p.from_you_l1}</li>
            <li>{p.from_you_l2}</li>
            <li>{p.from_you_l3}</li>
            <li>{p.from_you_l4}</li>
            <li>{p.from_you_l5}</li>
            <li>{p.from_you_l6}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_reg}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.reg_p1}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            {p.reg_p2}
          </p>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_apply}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.apply_intro_pre}<a href={mailto} class="underline text-[var(--color-gold-light)]"><strong>info@panprstenu.cz</strong></a>{p.apply_intro_mid}<em>{p.apply_intro_subject}</em>{p.apply_intro_post}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>{p.apply_l1}</li>
            <li>{p.apply_l2}</li>
            <li>{p.apply_l3}</li>
            <li>{p.apply_l4}</li>
            <li>{p.apply_l5}</li>
            <li>{p.apply_l6}</li>
            <li>{p.apply_l7}</li>
            <li>{p.apply_l8}</li>
          </ul>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_links}
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li><a href={`/${lang}/organizacni-informace/`} class="underline text-[var(--color-gold-light)]">{p.link1_label}</a>{p.link1_post}</li>
            <li><a href={`/${lang}/pravidla/`} class="underline text-[var(--color-gold-light)]">{p.link2_label}</a>{p.link2_post}</li>
            <li><a href={`/${lang}/detska-hra/`} class="underline text-[var(--color-gold-light)]">{p.link3_label}</a>{p.link3_post}</li>
            <li><a href={`/${lang}/hra-v-tabore/`} class="underline text-[var(--color-gold-light)]">{p.link4_label}</a>{p.link4_post}</li>
            <li><a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">{p.link5_label}</a>{p.link5_post}</li>
            <li><a href={`/${lang}/kontakt/`} class="underline text-[var(--color-gold-light)]">{p.link6_label}</a>{p.link6_post}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <!-- Závěrečné CTA -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
              {p.cta_heading}
            </h2>
            <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
              {p.cta_body}
            </p>
            <div class="flex flex-wrap gap-3 justify-center">
              <Button href={mailto} variant="primary" size="md" icon="lucide:arrow-right">
                {p.cta_btn_help}
              </Button>
              <Button href={`/${lang}/registrace/`} variant="secondary" size="md">
                {p.cta_btn_register}
              </Button>
            </div>
          </div>

        </article>
      </div>
    </div>
  </section>

</BaseLayout>
