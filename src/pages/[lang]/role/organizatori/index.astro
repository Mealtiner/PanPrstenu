---
/**
 * Role — Organizátoři
 * URL: /cs/role/organizatori/, …
 * Datum: 2026-05-01
 *
 * Detail organizačního týmu. Není to role, za kterou se přihlašuje —
 * je to představení lidí, kteří akci připravují. Konkrétní jména
 * a fotky doplníme postupně.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title'), href: `/${lang}/frakce/` },
  { label: 'Organizátoři' },
];

// Týmové role — placeholder, postupně doplníme konkrétní jména a fotky
const teamRoles = [
  {
    icon: 'lucide:crown',
    title: 'Hlavní organizátor',
    description: 'Vedení akce, koordinace celého týmu, kontakt s pořadatelem (Moravian LARP, z. s.).',
  },
  {
    icon: 'lucide:scroll-text',
    title: 'Příběh a herní design',
    description: 'Tvorba ročního příběhu, motivací stran, questů a herních pravidel.',
  },
  {
    icon: 'lucide:swords',
    title: 'Bezpečnost a schvalování',
    description: 'Kontrola zbraní a kostýmů, bezpečnostní brief, koordinace zdravotníků.',
  },
  {
    icon: 'lucide:tent',
    title: 'Tábořiště a logistika',
    description: 'Areál, voda, dřevo, parkování, koordinace s majitelem pozemku a obcí.',
  },
  {
    icon: 'lucide:users',
    title: 'Registrace a komunikace',
    description: 'Registrační systém, e-maily, komunikace s účastníky, sociální sítě.',
  },
  {
    icon: 'lucide:sparkles',
    title: 'Dětská hra',
    description: 'Program pro malé dobrodruhy, dohled nad bezpečností a zázemí pro rodiče.',
  },
  {
    icon: 'lucide:store',
    title: 'Stánky a jarmark',
    description: 'Domluva se stánkaři, koordinace s hospodou U Zeleného draka, jarmareční atmosféra.',
  },
  {
    icon: 'lucide:camera',
    title: 'Foto, video a média',
    description: 'Oficiální fotograf/kameraman, mediální spolupráce, galerie po akci.',
  },
];
---

<BaseLayout
  title="Organizátoři — Pán Prstenů 2026"
  description="Tým, který Pána Prstenů 2026 připravuje. Lidé, kteří Středozem stavějí — od příběhu přes bezpečnost po dětskou hru a jarmark."
  lang={lang}
  breadcrumbs={[
    { name: t('page.factions.title'), href: `/${lang}/frakce/` },
    { name: 'Organizátoři', href: `/${lang}/role/organizatori/` },
  ]}
>

  <!-- Hero -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="👑" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">Tým akce</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            Organizátoři
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            Lidé, kteří Středozem stavějí.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug="organizatori"
          currentSection="role"
        />

        <article class="max-w-3xl">

          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4 italic">
            Tahle stránka představuje tým, který akci Pán Prstenů 2026 připravuje
            a celý víkend vede. Není to role, za kterou se účastníci registrují —
            organizátorský tým se utváří dlouhodobou domluvou v komunitě.
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            Pokud se chceš zapojit do organizace, začni jako
            <a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">pomocník</a>
            nebo nám napiš na
            <a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a> —
            tým rád přivítá další ruce.
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Pořadatel
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Akci pořádá spolek <strong>Moravian LARP, z. s.</strong> Jméno
            se mihne v zápatí každé stránky a stojí za ním tým, který už několik
            ročníků staví Pán Prstenů, ale i další larpové akce.
          </p>
          <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
            <li>IČO: <strong class="text-[var(--color-gold-light)]">22669167</strong></li>
            <li>Spisová značka: L 12656 (KS Brno)</li>
            <li>Sídlo: Starobrněnská 289/7, 602 00 Brno</li>
            <li>E-mail: <a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a></li>
            <li>Web: <a href="https://www.panprstenu.cz" class="underline text-[var(--color-gold-light)]">www.panprstenu.cz</a></li>
          </ul>
          <Button href={`/${lang}/poradatel/`} variant="secondary" size="sm">
            Detail pořadatele
          </Button>

          <Divider variant="line-diamond" tone="dark" class="my-10" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Role v týmu
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
            Tým je rozdělený do několika oblastí. Konkrétní jména a tváře doplníme
            postupně, jak se připravujeme na ročník 2026.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            {teamRoles.map((r) => (
              <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 hover:border-[var(--color-gold)] transition-colors">
                <div class="flex items-center gap-3 mb-2">
                  <Icon name={r.icon} class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
                  <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)]">
                    {r.title}
                  </h3>
                </div>
                <p class="text-xs text-[var(--color-text-on-dark)] leading-relaxed">
                  {r.description}
                </p>
                <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mt-2">
                  Konkrétní jméno: <em>bude doplněno</em>
                </p>
              </div>
            ))}
          </div>

          <AlertBox variant="info" class="mb-10">
            Týmové role se mohou v jednotlivých ročnících mírně lišit. Některé
            části (např. dětská hra, mediální koordinace) zajišťují stejní
            lidé opakovaně, jiné se rotují podle dostupnosti.
          </AlertBox>

          <Divider variant="line-diamond" tone="dark" class="my-10" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Jak nás kontaktovat
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Obecné dotazy směřuj prosím na hlavní e-mail:
          </p>
          <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-6">
            <li>Registrace, platba, logistika: <a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a></li>
            <li>Média a tisk: <a href={`/${lang}/pro-media/`} class="underline text-[var(--color-gold-light)]">Pro média</a></li>
            <li>Stánkaři a obchodní spolupráce: <a href={`/${lang}/pro-stankare/`} class="underline text-[var(--color-gold-light)]">Pro stánkaře</a></li>
            <li>Bezpečnost a krizové situace: <a href={`/${lang}/bezpecnost/`} class="underline text-[var(--color-gold-light)]">Bezpečnost</a></li>
          </ul>
          <p class="text-[var(--color-text-on-dark-muted)] leading-relaxed mb-8 italic">
            Konkrétní kontakty na jednotlivé organizátory přidáme postupně,
            jakmile budou připravené veřejné představení.
          </p>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Chceš se přidat?
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Tým není uzavřený klub. Lidi, kteří se chtějí dlouhodobě podílet
            na přípravě, vítáme. Začni většinou takhle:
          </p>
          <ol class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-8">
            <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">1</span> <span>Přijeď na akci jako účastník — poznej, jak to funguje uvnitř.</span></li>
            <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">2</span> <span>V dalším ročníku se nabídni jako <a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">pomocník</a> v konkrétní oblasti.</span></li>
            <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">3</span> <span>Po akci se domluvíme, jestli a jak má smysl pokračovat dál.</span></li>
          </ol>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <!-- Závěrečné CTA -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
              Středozem nestaví jeden člověk
            </h2>
            <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
              Konkrétní jména a tváře doplníme. Mezitím — pokud chceš pomoct
              připravit ročník 2026, ozvi se.
            </p>
            <div class="flex flex-wrap gap-3 justify-center">
              <Button href={`/${lang}/role/pomocnici/`} variant="primary" size="md" icon="lucide:arrow-right">
                Stát se pomocníkem
              </Button>
              <Button href="mailto:info@panprstenu.cz?subject=Chci%20se%20p%C5%99idat%20do%20t%C3%BDmu" variant="secondary" size="md">
                Napsat týmu
              </Button>
            </div>
          </div>

        </article>
      </div>
    </div>
  </section>

</BaseLayout>
