---
/**
 * Role — Organizátoři
 * URL: /cs/role/organizatori/, /en/role/organizatori/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah načítán z src/content/pages/role/organizatori/{lang}.json
 * (jeden soubor = jedna jazyková mutace = jeden CMS dokument).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';

interface OrganizatoriPage {
  meta: { title: string; description: string };
  breadcrumb: string;
  hero: { tag: string; h1: string; subtitle: string };
  intro: {
    p1: string;
    p2: { pre: string; link_text: string; mid: string; post: string };
  };
  organizer: {
    h2: string;
    p: string;
    ico_label: string;
    ico_value: string;
    register_label: string;
    register_value: string;
    address_label: string;
    address_value: string;
    email_label: string;
    web_label: string;
    btn: string;
  };
  roles: {
    h2: string;
    intro: string;
    name_placeholder: string;
    items: { icon: string; title: string; desc: string }[];
    alert_rotate: string;
  };
  contact: {
    h2: string;
    intro: string;
    links: { prefix: string; label?: string; type: string; path?: string }[];
    note: string;
  };
  join: {
    h2: string;
    intro: string;
    steps: ({ text: string } | { pre: string; link_text: string; post: string })[];
  };
  cta: { h2: string; body: string; btn_helper: string; btn_write: string };
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<OrganizatoriPage>('role/organizatori', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('breadcrumb.factions'), href: `/${lang}/frakce/` },
  { label: p.breadcrumb },
];
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  lang={lang}
  breadcrumbs={[
    { name: t('breadcrumb.factions'), href: `/${lang}/frakce/` },
    { name: p.breadcrumb, href: `/${lang}/role/organizatori/` },
  ]}
>

  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="👑" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">{p.hero.tag}</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            {p.hero.h1}
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            {p.hero.subtitle}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar lang={lang} currentSlug="organizatori" currentSection="role" />

        <article class="max-w-3xl">

          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4 italic">
            {p.intro.p1}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            {p.intro.p2.pre}<a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">{p.intro.p2.link_text}</a>{p.intro.p2.mid}<a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>{p.intro.p2.post}
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.organizer.h2}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.organizer.p}
          </p>
          <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
            <li>{p.organizer.ico_label}: <strong class="text-[var(--color-gold-light)]">{p.organizer.ico_value}</strong></li>
            <li>{p.organizer.register_label}: {p.organizer.register_value}</li>
            <li>{p.organizer.address_label}: {p.organizer.address_value}</li>
            <li>{p.organizer.email_label}: <a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a></li>
            <li>{p.organizer.web_label}: <a href="https://www.panprstenu.cz" class="underline text-[var(--color-gold-light)]">www.panprstenu.cz</a></li>
          </ul>
          <Button href={`/${lang}/poradatel/`} variant="secondary" size="sm">
            {p.organizer.btn}
          </Button>

          <Divider variant="line-diamond" tone="dark" class="my-10" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.roles.h2}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
            {p.roles.intro}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            {p.roles.items.map((r) => (
              <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 hover:border-[var(--color-gold)] transition-colors">
                <div class="flex items-center gap-3 mb-2">
                  <Icon name={r.icon} class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
                  <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)]">
                    {r.title}
                  </h3>
                </div>
                <p class="text-xs text-[var(--color-text-on-dark)] leading-relaxed">
                  {r.desc}
                </p>
                <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mt-2">
                  {p.roles.name_placeholder}
                </p>
              </div>
            ))}
          </div>

          <AlertBox variant="info" class="mb-10">
            {p.roles.alert_rotate}
          </AlertBox>

          <Divider variant="line-diamond" tone="dark" class="my-10" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.contact.h2}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.contact.intro}
          </p>
          <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-6">
            {p.contact.links.map((link) => (
              <li>
                {link.prefix}: {link.type === 'email' ? (
                  <a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>
                ) : (
                  <a href={`/${lang}${link.path}`} class="underline text-[var(--color-gold-light)]">{link.label}</a>
                )}
              </li>
            ))}
          </ul>
          <p class="text-[var(--color-text-on-dark-muted)] leading-relaxed mb-8 italic">
            {p.contact.note}
          </p>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.join.h2}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.join.intro}
          </p>
          <ol class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-8">
            {p.join.steps.map((step, i) => (
              <li class="flex gap-3">
                <span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">{i + 1}</span>
                <span>
                  {'text' in step ? step.text : (
                    <>{step.pre}<a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">{step.link_text}</a>{step.post}</>
                  )}
                </span>
              </li>
            ))}
          </ol>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
              {p.cta.h2}
            </h2>
            <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
              {p.cta.body}
            </p>
            <div class="flex flex-wrap gap-3 justify-center">
              <Button href={`/${lang}/role/pomocnici/`} variant="primary" size="md" icon="lucide:arrow-right">
                {p.cta.btn_helper}
              </Button>
              <Button href="mailto:info@panprstenu.cz?subject=Chci%20se%20p%C5%99idat%20do%20t%C3%BDmu" variant="secondary" size="md">
                {p.cta.btn_write}
              </Button>
            </div>
          </div>

        </article>
      </div>
    </div>
  </section>

</BaseLayout>
