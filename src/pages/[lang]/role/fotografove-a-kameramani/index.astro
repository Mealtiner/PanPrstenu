---
/**
 * Role — Fotografové a kameramani
 * URL: /cs/role/fotografove-a-kameramani/, …
 * Datum: 2026-05-03
 *
 * Obsah verze v2 (z balíčku „Další role v2"). Hlavní rozdíl: kostýmová
 * povinnost stejně jako pro ostatní + box „60 sekund" + pravidlo
 * „pokud nevypadáš jako ze Středozemě, nelez do záběru ostatním".
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title'), href: `/${lang}/frakce/` },
  { label: t('page.photographers.title') },
];
---

<BaseLayout
  title={t('page.photographers.meta_title')}
  description={t('page.photographers.description')}
  lang={lang}
  breadcrumbs={[
    { name: t('page.factions.title'), href: `/${lang}/frakce/` },
    { name: t('page.photographers.title'), href: `/${lang}/role/fotografove-a-kameramani/` },
  ]}
>

  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="📷" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">{t('page.photographers.tag')}</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            {t('page.photographers.title')}
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            {t('page.photographers.subtitle')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug="fotografove-a-kameramani"
          currentSection="role"
        />

        <article class="max-w-3xl">

          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6 italic">
            {t('page.photographers.intro_lead')}
          </p>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_who')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.photographers.who_intro')}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6">
            <li>{t('page.photographers.who_l1')}</li>
            <li>{t('page.photographers.who_l2')}</li>
            <li>{t('page.photographers.who_l3')}</li>
            <li>{t('page.photographers.who_l4')}</li>
          </ul>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            {t('page.photographers.who_note')}
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <!-- 60 sekund box -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-6 mb-10">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:clock" class="w-5 h-5" aria-hidden="true" />
              {t('page.photographers.h_60s')}
            </h2>
            <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1.5">
              <li>{t('page.photographers.s60_l1_pre')}<strong>{t('page.photographers.s60_l1_strong')}</strong>{t('page.photographers.s60_l1_post')}</li>
              <li>{t('page.photographers.s60_l2_pre')}<strong>{t('page.photographers.s60_l2_strong')}</strong>{t('page.photographers.s60_l2_post')}</li>
              <li>{t('page.photographers.s60_l3')}</li>
              <li>{t('page.photographers.s60_l4_pre')}<strong>{t('page.photographers.s60_l4_strong')}</strong>{t('page.photographers.s60_l4_post')}</li>
              <li>{t('page.photographers.s60_l5')}</li>
              <li>{t('page.photographers.s60_l6')}</li>
              <li>{t('page.photographers.s60_l7')}</li>
              <li>{t('page.photographers.s60_l8')}</li>
            </ul>
          </div>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_costume')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {t('page.photographers.cost_p1')}
          </p>
          <AlertBox variant="warning" class="mb-6">
            <strong>{t('page.photographers.cost_alert_strong')}</strong>{t('page.photographers.cost_alert_post')}
          </AlertBox>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
            {t('page.photographers.h_recommend')}
          </h3>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6">
            <li>{t('page.photographers.cos_l1')}</li>
            <li>{t('page.photographers.cos_l2')}</li>
            <li>{t('page.photographers.cos_l3')}</li>
            <li>{t('page.photographers.cos_l4')}</li>
            <li>{t('page.photographers.cos_l5')}</li>
            <li>{t('page.photographers.cos_l6')}</li>
          </ul>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
            {t('page.photographers.h_no_costume')}
          </h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.photographers.no_p1')}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            {t('page.photographers.no_p2')}
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_what')}
          </h2>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-side-free-text)] mb-3">
            {t('page.photographers.h_what_yes')}
          </h3>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6">
            <li>{t('page.photographers.yes_l1')}</li>
            <li>{t('page.photographers.yes_l2')}</li>
            <li>{t('page.photographers.yes_l3')}</li>
            <li>{t('page.photographers.yes_l4')}</li>
            <li>{t('page.photographers.yes_l5')}</li>
            <li>{t('page.photographers.yes_l6')}</li>
            <li>{t('page.photographers.yes_l7')}</li>
            <li>{t('page.photographers.yes_l8')}</li>
          </ul>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-side-evil-text)] mb-3">
            {t('page.photographers.h_what_no')}
          </h3>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>{t('page.photographers.no_l1')}</li>
            <li>{t('page.photographers.no_l2')}</li>
            <li>{t('page.photographers.no_l3')}</li>
            <li>{t('page.photographers.no_l4')}</li>
            <li>{t('page.photographers.no_l5')}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_move')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.photographers.move_intro')}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
            <li>{t('page.photographers.move_l1')}</li>
            <li>{t('page.photographers.move_l2')}</li>
            <li>{t('page.photographers.move_l3')}</li>
            <li>{t('page.photographers.move_l4')}</li>
            <li>{t('page.photographers.move_l5')}</li>
            <li>{t('page.photographers.move_l6')}</li>
          </ul>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 italic">
            {t('page.photographers.move_note')}
          </p>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_rule')}
          </h2>
          <AlertBox variant="info" class="mb-4">
            <strong>{t('page.photographers.rule_alert_strong')}</strong>
          </AlertBox>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.photographers.rule_intro')}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>{t('page.photographers.rule_l1')}</li>
            <li>{t('page.photographers.rule_l2')}</li>
            <li>{t('page.photographers.rule_l3')}</li>
            <li>{t('page.photographers.rule_l4')}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_use')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.photographers.use_intro')}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>{t('page.photographers.use_l1')}</li>
            <li>{t('page.photographers.use_l2')}</li>
            <li>{t('page.photographers.use_l3')}</li>
            <li>{t('page.photographers.use_l4')}</li>
            <li>{t('page.photographers.use_l5')}</li>
          </ul>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_expect')}
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>{t('page.photographers.exp_l1')}</li>
            <li>{t('page.photographers.exp_l2')}</li>
            <li>{t('page.photographers.exp_l3')}</li>
            <li>{t('page.photographers.exp_l4')}</li>
            <li>{t('page.photographers.exp_l5')}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_reg')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {t('page.photographers.reg_p1')}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.photographers.reg_intro')}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
            <li>{t('page.photographers.reg_l1')}</li>
            <li>{t('page.photographers.reg_l2')}</li>
            <li>{t('page.photographers.reg_l3')}</li>
            <li>{t('page.photographers.reg_l4')}</li>
            <li>{t('page.photographers.reg_l5')}</li>
            <li>{t('page.photographers.reg_l6')}</li>
          </ul>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {t('page.photographers.reg_p3_pre')}<a href="mailto:info@panprstenu.cz?subject=Fotograf%20%2F%20kameraman" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>{t('page.photographers.reg_p3_post')}
          </p>
          <AlertBox variant="warning" class="mb-8">
            <strong>{t('page.photographers.reg_alert_strong')}</strong>{t('page.photographers.reg_alert_post')}
          </AlertBox>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.photographers.h_links')}
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li><a href={`/${lang}/pravidla/`} class="underline text-[var(--color-gold-light)]">{t('page.photographers.link1_label')}</a>{t('page.photographers.link1_post')}</li>
            <li><a href={`/${lang}/prakticke-info/`} class="underline text-[var(--color-gold-light)]">{t('page.photographers.link2_label')}</a>{t('page.photographers.link2_post')}</li>
            <li><a href={`/${lang}/pro-media/`} class="underline text-[var(--color-gold-light)]">{t('page.photographers.link3_label')}</a>{t('page.photographers.link3_post')}</li>
            <li><a href={`/${lang}/frakce/`} class="underline text-[var(--color-gold-light)]">{t('page.photographers.link4_label')}</a>{t('page.photographers.link4_post')}</li>
            <li><a href={`/${lang}/kontakt/`} class="underline text-[var(--color-gold-light)]">{t('page.photographers.link5_label')}</a>{t('page.photographers.link5_post')}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <!-- Závěrečné CTA -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
              {t('page.photographers.cta_heading')}
            </h2>
            <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
              {t('page.photographers.cta_body')}
            </p>
            <div class="flex flex-wrap gap-3 justify-center">
              <Button href="mailto:info@panprstenu.cz?subject=Fotograf%20%2F%20kameraman" variant="primary" size="md" icon="lucide:arrow-right">
                {t('page.photographers.cta_btn_contact')}
              </Button>
              <Button href={`/${lang}/pravidla/`} variant="secondary" size="md">
                {t('page.photographers.cta_btn_rules')}
              </Button>
            </div>
          </div>

        </article>
      </div>
    </div>
  </section>

</BaseLayout>
