---
/**
 * Role — Nebojový doprovod
 * URL: /cs/role/nebojovy-doprovod/, …
 * Datum: 2026-05-01
 *
 * Stránka pro nebojové účastníky. Layout shodný s detailem frakce
 * (sidebar FactionRolesSidebar + content article).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title'), href: `/${lang}/frakce/` },
  { label: 'Nebojový doprovod' },
];
---

<BaseLayout
  title="Nebojový doprovod — Pán Prstenů 2026"
  description="Jsi ve hře, pomáháš atmosféře, ale nebojuješ. Nebojový doprovod na Pánu Prstenů: kostýmová povinnost, role v táboře a jak se zapojit."
  lang={lang}
  breadcrumbs={[
    { name: t('page.factions.title'), href: `/${lang}/frakce/` },
    { name: 'Nebojový doprovod', href: `/${lang}/role/nebojovy-doprovod/` },
  ]}
>

  <!-- Hero -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="🤝" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">
            Další role
          </Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            Nebojový doprovod
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            Jsi ve hře, pomáháš atmosféře, ale nebojuješ.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug="nebojovy-doprovod"
          currentSection="role"
        />

        <article class="max-w-3xl">

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Pro koho je tahle role?
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            Nebojový doprovod je pro účastníky, kteří chtějí být <strong>součástí
            světa a tábořiště</strong>, ale <strong>nechtějí se účastnit boje</strong>.
            Může jít o doprovod bojovníků, markytány, vlajkonoše, pomocné postavy,
            řemeslníky, posly, táborové role nebo atmosférické postavy.
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
            Hodí se ti to, pokud:
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>chceš zažít atmosféru Středozemě bez bojové zátěže,</li>
            <li>chceš jet jako rodič nebo doprovod hrajícího účastníka,</li>
            <li>chceš hrát výrazného „civila" — kuchaře, písaře, věštkyni, kupce,</li>
            <li>chceš podporovat svou frakci v zázemí a v tábořišti,</li>
            <li>jdeš na akci poprvé a chceš to vyzkoušet bez bojové výbavy.</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Co od tebe čekáme
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
            <li><strong>Kostýmová povinnost</strong> — celý víkend zapadáš do
              světa hry. Nemusíš mít zbroj, ale civilní oblečení nepatří
              do Středozemě.</li>
            <li><strong>Respektování pravidel akce</strong> — bezpečnost,
              instrukce organizátorů, fair-play.</li>
            <li><strong>Pohyb mimo bojové situace</strong> — během hlavní bitvy
              v sobotu se držíš stranou, nebo na k tomu určených místech
              (např. zázemí, lazaret, jarmark).</li>
            <li><strong>Domluva s frakcí</strong> nebo organizátory, pokud
              chceš mít aktivní RP roli (kupec, vlajkonoš, posel apod.).</li>
            <li><strong>Žádné zasahování do boje</strong>, pokud k tomu nejsi
              výslovně určen v rámci scénáře.</li>
          </ul>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Kostým — jak na to
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Pro nebojový doprovod platí stejný princip jako pro hrající
            účastníky — kostým má být <strong>tematický a nerušivý</strong>,
            ne nutně dokonalý. Vyber si frakci nebo neutrální vrstvenou variantu:
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li>jednoduchá tunika nebo halenice,</li>
            <li>kalhoty nebo dlouhá sukně v zemitých tónech,</li>
            <li>opasek, taštice nebo vak,</li>
            <li>plášť nebo šátek,</li>
            <li>nerušivá obuv (klidně maskovaná moderní),</li>
            <li>případně barvy konkrétní frakce, pokud k ní patříš.</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Zapojení do tábora
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            Nebojový doprovod je pro <a href={`/${lang}/hra-v-tabore/`} class="underline text-[var(--color-gold-light)]">hru v táboře</a>
            ideální. Pomáháš tvořit atmosféru, můžeš nabízet drobné služby,
            zapojit se do hospodských her a mikro questů. Bez vás by tábor
            byl jen louka se stany.
          </p>
          <AlertBox variant="info" class="mb-8">
            Páteční program, jarmark, arény a dětská hra — to všechno žije
            i z práce nebojových účastníků. Pokud máš nápad na vlastní stánek,
            službu nebo malou hru, dej organizátorům vědět.
          </AlertBox>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Jak se přihlásit
          </h2>
          <ol class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-8">
            <li>1. Otevři <a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">stránku Registrace</a>.</li>
            <li>2. V Registračce.cz vyber typ účasti <strong>Nebojový doprovod</strong>.</li>
            <li>3. Doplň, ke které frakci se hlásíš (nebo zvol „bez frakce").</li>
            <li>4. Zaplať registrační poplatek podle pokynů.</li>
          </ol>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <div class="flex flex-wrap gap-3">
            <Button href={`/${lang}/registrace/`} variant="primary" size="md" icon="lucide:arrow-right">
              Registruj se
            </Button>
            <Button href={`/${lang}/pravidla/`} variant="secondary" size="md">
              Pravidla
            </Button>
            <Button href={`/${lang}/hra-v-tabore/`} variant="ghost" size="md">
              Hra v táboře
            </Button>
          </div>

        </article>
      </div>
    </div>
  </section>

</BaseLayout>
