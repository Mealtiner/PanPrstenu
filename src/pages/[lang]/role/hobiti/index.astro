---
/**
 * Role — Hobité
 * URL: /cs/role/hobiti/, …
 * Datum: 2026-05-03
 *
 * Atmosférická role pro hospodské, obchodníky, stánkaře, CP postavy
 * a pozorovatele dění. Hobité nebojují, ale jsou srdcem tábořiště,
 * hospody a jarmarku. Layout shodný s ostatními role stránkami.
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('role/hobiti', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('breadcrumb.factions'), href: `/${lang}/frakce/` },
  { label: p.title },
];
---

<BaseLayout
  title={p.meta_title}
  description={p.description}
  lang={lang}
  breadcrumbs={[
    { name: t('breadcrumb.factions'), href: `/${lang}/frakce/` },
    { name: p.title, href: `/${lang}/role/hobiti/` },
  ]}
>

  <!-- Hero -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion iconSlug="hobite" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">{p.tag}</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            {p.title}
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            {p.subtitle}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug="hobiti"
          currentSection="role"
        />

        <article class="max-w-3xl">

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_who}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.who_p1_pre}<strong>{p.who_p1_strong}</strong>{p.who_p1_post}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.who_examples}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6">
            <li>{p.who_l1}</li>
            <li>{p.who_l2}</li>
            <li>{p.who_l3}</li>
            <li>{p.who_l4}</li>
            <li>{p.who_l5}</li>
            <li>{p.who_l6}</li>
          </ul>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 italic">
            {p.who_note}
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <!-- 60 sekund box -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-6 mb-10">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:clock" class="w-5 h-5" aria-hidden="true" />
              {p.h_60s}
            </h2>
            <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1.5">
              <li>{p.s60_l1_pre}<strong>{p.s60_l1_strong}</strong>{p.s60_l1_post}</li>
              <li>{p.s60_l2}</li>
              <li>{p.s60_l3}</li>
              <li>{p.s60_l4}</li>
              <li>{p.s60_l5}</li>
              <li>{p.s60_l6}</li>
              <li>{p.s60_l7}</li>
            </ul>
          </div>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_what}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.what_intro}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
            <li><strong>{p.w_l1_strong}</strong>{p.w_l1_post}</li>
            <li><strong>{p.w_l2_strong}</strong>{p.w_l2_mid}<a href={`/${lang}/role/stankari/`} class="underline text-[var(--color-gold-light)]">{p.w_l2_link}</a>{p.w_l2_post}</li>
            <li><strong>{p.w_l3_strong}</strong>{p.w_l3_post}</li>
            <li><strong>{p.w_l4_strong}</strong>{p.w_l4_post}</li>
            <li><strong>{p.w_l5_strong}</strong>{p.w_l5_mid}<a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">{p.w_l5_link}</a>{p.w_l5_post}</li>
            <li><strong>{p.w_l6_strong}</strong>{p.w_l6_post}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_expect}
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
            <li>{p.exp_l1}</li>
            <li>{p.exp_l2}</li>
            <li>{p.exp_l3}</li>
            <li>{p.exp_l4}</li>
            <li>{p.exp_l5}</li>
            <li>{p.exp_l6}</li>
          </ul>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_costume}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {p.cos_intro_pre}<strong>{p.cos_intro_strong}</strong>{p.cos_intro_post}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
            <li>{p.cos_l1}</li>
            <li>{p.cos_l2}</li>
            <li>{p.cos_l3}</li>
            <li>{p.cos_l4}</li>
            <li>{p.cos_l5}</li>
            <li>{p.cos_l6}</li>
          </ul>
          <AlertBox variant="info" class="mb-8">
            {p.cos_alert}
          </AlertBox>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_reg}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {p.reg_p1_pre}<strong>{p.reg_p1_strong}</strong>{p.reg_p1_post}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            {p.reg_p2}
          </p>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {p.h_links}
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li><a href={`/${lang}/role/nebojovy-doprovod/`} class="underline text-[var(--color-gold-light)]">{p.link1_label}</a>{p.link1_post}</li>
            <li><a href={`/${lang}/role/stankari/`} class="underline text-[var(--color-gold-light)]">{p.link2_label}</a>{p.link2_post}</li>
            <li><a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">{p.link3_label}</a>{p.link3_post}</li>
            <li><a href={`/${lang}/hra-v-tabore/`} class="underline text-[var(--color-gold-light)]">{p.link4_label}</a>{p.link4_post}</li>
            <li><a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">{p.link5_label}</a>{p.link5_post}</li>
            <li><a href={`/${lang}/kontakt/`} class="underline text-[var(--color-gold-light)]">{p.link6_label}</a>{p.link6_post}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-10" />

          <!-- Plný popis role — z podkladů /grafika/armady/popisy/Hobiti_druzina.docx -->
          <h2 id="plny-popis" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 scroll-mt-24 flex items-center gap-3">
            <span aria-hidden="true" class="text-[var(--color-gold)]">◆</span>
            {p.h_full}
          </h2>

          <div class="space-y-8 mb-10">
            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">{p.full1_h}</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full1_p1}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full1_p2}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">{p.full1_p3}</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">{p.full2_h}</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full2_p1}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full2_p2}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">{p.full2_p3}</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">{p.full3_h}</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full3_p1}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full3_p2}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">{p.full3_p3}</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">{p.full4_h}</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full4_p1}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full4_p2}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">{p.full4_p3}</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">{p.full5_h}</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full5_p1}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p.full5_p2}</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">{p.full5_p3}</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">{p.full6_h}</h3>
              <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5">
                <li>{p.full6_l1}</li>
                <li>{p.full6_l2}</li>
                <li>{p.full6_l3}</li>
                <li>{p.full6_l4}</li>
                <li>{p.full6_l5}</li>
                <li>{p.full6_l6}</li>
              </ul>
            </section>
          </div>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <!-- Závěrečné CTA -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
              {p.cta_heading}
            </h2>
            <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
              {p.cta_body}
            </p>
            <div class="flex flex-wrap gap-3 justify-center">
              <Button href={`/${lang}/registrace/`} variant="primary" size="md" icon="lucide:arrow-right">
                {p.cta_btn_register}
              </Button>
              <Button href="mailto:info@panprstenu.cz?subject=Hobit%20%E2%80%94%20zaji%C5%A1t%C4%9Bn%C3%AD%20role" variant="secondary" size="md">
                {p.cta_btn_ask}
              </Button>
            </div>
          </div>

        </article>
      </div>
    </div>
  </section>

</BaseLayout>
