---
/**
 * Role — Hobité
 * URL: /cs/role/hobiti/, …
 * Datum: 2026-05-01
 *
 * Atmosférická role pro hospodské, obchodníky, stánkaře, CP postavy
 * a pozorovatele dění. Hobité nebojují, ale jsou srdcem tábořiště,
 * hospody a jarmarku. Layout shodný s ostatními role stránkami.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title'), href: `/${lang}/frakce/` },
  { label: 'Hobité' },
];
---

<BaseLayout
  title="Hobité — Pán Prstenů 2026"
  description="Atmosférická role pro obchodníky, hospodské, stánkaře, CP postavy a pozorovatele dění. Hobité nebojují, ale jsou srdcem Středozemě."
  lang={lang}
  breadcrumbs={[
    { name: t('page.factions.title'), href: `/${lang}/frakce/` },
    { name: 'Hobité', href: `/${lang}/role/hobiti/` },
  ]}
>

  <!-- Hero -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="🌾" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">Další role</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            Hobité
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            Druhá snídaně, dýmka a pohled jiných očí.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug="hobiti"
          currentSection="role"
        />

        <article class="max-w-3xl">

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Pro koho je tahle role?
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            Hobité jsou <strong>atmosférická role</strong> pro účastníky, kteří
            chtějí být součástí Středozemě, ale ne v bojové linii. Hobit
            v hospodě, hobit s vozíkem na jarmarku, hobit jako CP postava
            v páteční hře — všichni patří do tábořiště a tvoří měkčí, klidnější
            tvář akce.
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Může jít například o:
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6">
            <li>obsluhu hospody U Zeleného draka,</li>
            <li>obchodníky, stánkaře a jarmareční postavy,</li>
            <li>CP postavy v páteční táborové hře a sobotních questech,</li>
            <li>pozorovatele dění, kronikáře a vypravěče,</li>
            <li>rodinné role pro účastníky, kteří jedou s dětmi a chtějí hrát ladněji,</li>
            <li>atmosférický doprovod jarmarku, ohně, hudby a vyprávění.</li>
          </ul>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 italic">
            Hobité nebojují. Ale bez nich by Středozem byla jen bojiště.
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <!-- 60 sekund box -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-6 mb-10">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:clock" class="w-5 h-5" aria-hidden="true" />
              Nejdůležitější v 60 sekundách
            </h2>
            <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1.5">
              <li>Hobité <strong>nebojují</strong> a nevstupují do bojových střetů.</li>
              <li>Atmosférická role pro hospodu, jarmark, CP, vyprávění.</li>
              <li>Kostým je z přírodních materiálů — vlna, len, kůže, žádné lesklé moderní prvky.</li>
              <li>Vhodné pro účastníky, kteří chtějí klidnější hru a roleplay.</li>
              <li>Pohyb po tábořišti a v okolí hospody, mimo bojovou linii.</li>
              <li>Domluva s organizátory pomáhá najít konkrétní zařazení (CP, obsluha, kupec).</li>
              <li>Pravidla akce, bezpečnost a pokyny organizátorů platí stejně jako pro ostatní.</li>
            </ul>
          </div>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Co můžeš na akci dělat
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            Hobit má v Pánu Prstenů hodně tváří — záleží na tom, co tě baví:
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
            <li><strong>Hospoda U Zeleného draka</strong> — pomoc s obsluhou, atmosféra,
              vyprávění, vybírání mincí. (Domluva přes hospodu i organizátory.)</li>
            <li><strong>Jarmark a stánky</strong> — hobitní obchodník nebo pomocník
              u stánku. Pokud máš vlastní zboží, viz role
              <a href={`/${lang}/role/stankari/`} class="underline text-[var(--color-gold-light)]">Stánkaři</a>.</li>
            <li><strong>CP postavy</strong> — cizí postavy v táborovém programu, mikro questech
              i sobotních scénách. Domluva s organizátory.</li>
            <li><strong>Atmosféra tábořiště</strong> — hra v civilu, vaření, zpěv, hra na hudební
              nástroje, povídání u ohně.</li>
            <li><strong>Pomoc s dětskou hrou</strong> — pokud máš rád/a děti, hobitní postava
              je ideální průvodce malým dobrodruhem (viz role
              <a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">Pomocníci</a>).</li>
            <li><strong>Kronikář</strong> — zaznamenávej, vyprávěj, sbírej historky.
              Po akci můžeš hrát roli ve veřejných reportech komunity.</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Co od tebe čekáme
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
            <li>Respekt k hráčům i bojové části akce.</li>
            <li>Pohyb mimo bojovou linii během sobotní hlavní hry.</li>
            <li>Tematický kostým bez moderních rušivých prvků.</li>
            <li>Dodržování pravidel tábořiště, ohně, nočního klidu a bezpečnosti.</li>
            <li>Když si nejsi jistý, kde smíš být, zeptej se organizátorů.</li>
            <li>Když hraješ CP, drž se domluveného briefingu a respektuj pokyny organizátora,
              který tě zařadil.</li>
          </ul>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Kostým a vzhled
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Hobitní kostým je o <strong>přírodních materiálech a domáckém vzhledu</strong>:
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
            <li>vlněné nebo lněné košile, vesta s knoflíky,</li>
            <li>krátké kalhoty pod kolena (bryčesy) nebo dlouhé sukně,</li>
            <li>přírodní barvy — zelená, hnědá, žlutá, krémová, vínová,</li>
            <li>kožený opasek, taštička, vak,</li>
            <li>dýmka, kapesní hodinky, žádné moderní logo,</li>
            <li>zástěra při obsluze v hospodě nebo u stánku.</li>
          </ul>
          <AlertBox variant="info" class="mb-8">
            Bosé hobitní nohy nejsou povinné — pevné boty jsou bezpečnější
            a hra se odehrává v lese a na louce. Kdo chce, může si na nohy
            navléknout látkové návleky s „chlupy".
          </AlertBox>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Registrace a registrační poplatek
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            Hobité se registrují stejně jako ostatní účastníci — typicky
            jako <strong>nehrající doprovod</strong>, případně jako stánkař,
            pokud provozuješ stánek. Pokud hraješ CP, domluv se předem
            s organizátory — stávajícím pomocníkům a CP umíme řešit registrační
            poplatek individuálně.
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            Po dokončení registrace dostaneš informace k platbě. Zaplatit
            můžeš přes QR kód nebo bankovním převodem. Registrační poplatek
            je potřeba zaplatit do 10 dnů od registrace.
          </p>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            Důležité odkazy
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li><a href={`/${lang}/role/nebojovy-doprovod/`} class="underline text-[var(--color-gold-light)]">Nebojový doprovod</a> — pokud chceš jen být v atmosféře bez RP role.</li>
            <li><a href={`/${lang}/role/stankari/`} class="underline text-[var(--color-gold-light)]">Stánkaři</a> — pokud chceš provozovat vlastní stánek.</li>
            <li><a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">Pomocníci</a> — pokud chceš pomáhat organizaci nebo dětské hře.</li>
            <li><a href={`/${lang}/hra-v-tabore/`} class="underline text-[var(--color-gold-light)]">Hra v táboře</a> — páteční program, mince, jarmark, hospoda.</li>
            <li><a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">Registrace</a> — přihlášení a registrační poplatek.</li>
            <li><a href={`/${lang}/kontakt/`} class="underline text-[var(--color-gold-light)]">Kontakt</a> — domluva CP role nebo specifického zapojení.</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-10" />

          <!-- Plný popis role — z podkladů /grafika/armady/popisy/Hobiti_druzina.docx -->
          <h2 id="plny-popis" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 scroll-mt-24 flex items-center gap-3">
            <span aria-hidden="true" class="text-[var(--color-gold)]">◆</span>
            Plný popis role
          </h2>

          <div class="space-y-8 mb-10">
            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">Základní stylizace</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Hobiti nejsou přirozeně bitevní národ. O to zajímavější jsou pro hru. Jejich síla není v těžké zbroji, velkých štítech a hromovém nástupu, ale v pospolitosti, odvaze z donucení, zásobách, zprávách, lehkém pohybu, zdravém rozumu a schopnosti přežít i tam, kde je velkým národům příliš těsno pro jejich pýchu.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Pro potřeby hry je možné hobity pojmout jako doprovodnou, lehkou a komunitní armádu Svobodných národů. Mohou být poslové, kuchaři, zásobovači, zvědové, nosiči vody, opatrní střelci, správci táborového pohodlí, sběrači zpráv i malí bojovníci, kteří se do bitvy dostali spíše proto, že někdo musel držet poslední cestu domů.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">Hobití kostým má být na první pohled jiný než lidský. Není nutné být skutečně malý. Důležité jsou proporce, vrstvení, měkkost, venkovský střih, barevnost, kulatost a drobné civilní detaily: vesta, košile, krátké kalhoty, šle, kapsy, hrnek, dýmka bez kouření, svačina, mapa, lucerna, pytlík s tabákem nebo sušené jablko.</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">O hobitech ve Středozemi</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Hobiti jsou drobný lid příbuzný lidem, známý především z Kraje, Rádovska a okolí Hůrky. Bývají menšího vzrůstu, mají chlupatá chodidla s tvrdou kůží, často chodí bosí a mívají kudrnaté vlasy. Nejsou velkým historickým národem králů a válek, ale právě jejich nenápadnost se v dějinách Středozemě ukázala jako nečekaná síla.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Většina hobitů dává přednost jídlu, zahradám, řemeslu, hospodám, písničkám, narozeninám, výměně dárků a pohodlnému domovu před dobrodružstvím. To ale neznamená, že by byli zbabělí. Spíše jsou opatrní, praktičtí a dlouho nevěří, že se velké dějiny opravdu týkají i jejich políček a spíží.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">Pro herní pojetí lze rozlišit hobity z poklidnějšího Kraje, odvážnější Brandorády a Braly, vodomilnější Pálavy a praktičtější hobity od Hůrky. Není nutné kopírovat přesné rodové dělení. Stačí, když se v kostýmu a chování objeví drobný venkovský lid, který na válku hledí s nedůvěrou, ale na kamarády se nevykašle.</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">Odění, vzhled a výbava</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Hobití oděv vychází z pohodlného venkovského oblečení. Hodí se lněné nebo bavlněné košile, vlněné vesty, krátké kalhoty pod kolena, šle, široké opasky, barevné šátky, měkké kabátky, pláštěnky, kapuce a jednoduché čepice. Barvy mohou být zemitější, ale hobiti snesou více barev než vojáci: zelená, hnědá, béžová, žlutá, vínová, tmavě modrá a tlumená červená.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Nejdůležitější je nepůsobit moderně. Tričko, mikina, sportovní kalhoty a tenisky bez zakrytí hobita okamžitě zničí. Moderní boty je možné schovat pod návleky, omotávky nebo kožešinové návleky tak, aby vznikl dojem hobitích nohou. Bosá chůze v terénu se nedoporučuje kvůli bezpečnosti.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">K hobitům patří drobné rekvizity. Dřevěná lžíce, hrnek, ubrousek, malá pánev, košík, pytlík s jídlem, lucerna, knížka receptů, mapa, dopis, klubko provázku nebo malá lopatka udělají víc než přezbrojení do těžké zbroje. Hobit má vypadat, že si původně šel jen něco zařídit, ale někdo ho omylem zatáhl do dějin.</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">Výzbroj a herní zařazení</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Hobit v první řadě není těžkooděnec. Pokud bojuje, hodí se krátký meč, dýka podle pravidel, hůl, malý kulatý štít, praková stylizace podle pravidel, lehký luk nebo jednoduché kopí. Výzbroj má být malá, praktická a spíše obranná. Těžké obouruční zbraně a velké kovové zbroje k hobitovi většinou nesedí.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Výborně funguje role táborového zázemí. Hobiti mohou pomáhat s vodou, jídlem, drobnými úkoly, hlášením zpráv, doprovodem nováčků, obchodem, mincemi, hlídkami a herní atmosférou v táboře. Pokud se účastní bitvy, mohou držet druhou linii, chránit prapor, doprovázet zraněné, předávat zprávy nebo podporovat větší bojovníky.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">Hobití skupina by měla hrát na soudržnost. Jednotlivec může být komický, ale skupina hobitů má být malý ostrov domova uprostřed války. Společná snídaně, pravidelné svačiny, „zásadní" debaty o koláčích a klidný odpor k velkým proslovům mohou být velmi silnou součástí atmosféry.</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">Kultura, chování a roleplay</h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Hobiti obvykle nepřicházejí na akci proto, aby vyhráli soutěž o nejhrůznější pohled. Jejich tón je přátelský, všetečný, trochu opatrný a trochu drzý. Mohou se ptát, proč se všichni tváří tak vážně, jestli už bude oběd a zda je opravdu nutné jít do bitvy právě teď.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Dobře funguje kontrast: hobit se bojí, ale jde. Nechce být hrdina, ale udělá správnou věc. Nechce opustit tábor, ale když jde kamarád, jde s ním. Nezná velkou strategii, ale přesně ví, kde je voda, kdo má poslední obvaz a komu se ztratil hrnek.</p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">Pro nováčky je hobit velmi příjemná role. Kostým se dá začít jednoduše a postupně rozvíjet. Není potřeba drahá zbroj. Hlavní je pohodlný venkovský vzhled, zakryté moderní prvky a chuť hrát drobné situace s ostatními.</p>
            </section>

            <section>
              <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">Rychlá doporučení pro kostým</h3>
              <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5">
                <li>Košile, vesta, krátké kalhoty, šle a plášť vytvoří základ během jednoho večera.</li>
                <li>Používej zemité a tlumeně veselé barvy: zelenou, hnědou, béžovou, žlutou, vínovou.</li>
                <li>Moderní boty zakryj návleky, kožešinou nebo omotávkami. Neběhej bosý v nebezpečném terénu.</li>
                <li>Přidej civilní rekvizity: hrnek, lžíci, košík, mapu, lucernu, svačinu.</li>
                <li>Výzbroj drž malou a praktickou. Hobit má působit chytře, ne jako rytíř v poloviční velikosti.</li>
                <li>Ve skupině sjednoťte nějaký rodový nebo obecní prvek: šátky, knoflíky, nášivku, barvu vest nebo znak kulatých dveří.</li>
              </ul>
            </section>
          </div>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

