---
/**
 * Prohlášení o přístupnosti
 * URL: /cs/pristupnost/, /en/pristupnost/, /de/pristupnost/, /sk/pristupnost/, /uk/pristupnost/
 * Datum: 2026-05-03
 *
 * Splňuje legislativní rámec dle směrnice EU 2016/2102 (ve znění European
 * Accessibility Act 2025) a zákona č. 99/2019 Sb., o přístupnosti
 * internetových stránek a mobilních aplikací.
 *
 * Web cílí na WCAG 2.1 úroveň AA.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.a11y.title') },
];

const chapters = [
  { id: 'stav-souladu', label: t('page.a11y.ch_compliance'), icon: 'lucide:check-circle' },
  { id: 'omezeni',      label: t('page.a11y.ch_limitations'), icon: 'lucide:alert-circle' },
  { id: 'vypracovani',  label: t('page.a11y.ch_preparation'), icon: 'lucide:file-text' },
  { id: 'hlaseni',      label: t('page.a11y.ch_reporting'), icon: 'lucide:mail' },
  { id: 'pravo',        label: t('page.a11y.ch_enforcement'), icon: 'lucide:scale' },
];
---

<BaseLayout
  title={t('page.a11y.title')}
  description={t('page.a11y.description')}
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.a11y.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {t('page.a11y.subtitle')}
      </p>
    </div>
  </section>

  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title={t('page.a11y.toc_title')} ariaLabel={t('page.a11y.toc_aria')} />
        <article class="min-w-0 max-w-3xl prose-readable">

      {lang !== 'cs' && (
        <AlertBox variant="info" class="mb-6">
          {t('legal.jurisdiction_notice')}
        </AlertBox>
      )}

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        {t('page.a11y.intro_p1_pre')}<strong>{t('page.a11y.intro_p1_strong')}</strong>{t('page.a11y.intro_p1_post')}
      </p>

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {t('page.a11y.intro_p2')}
      </p>

      <h2 id="stav-souladu" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4 scroll-mt-24">
        {t('page.a11y.ch_compliance')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.a11y.compliance_p')}
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mt-6 mb-3">
        {t('page.a11y.compliance_h')}
      </h3>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        <li>{t('page.a11y.compliance_l1')}</li>
        <li>{t('page.a11y.compliance_l2')}</li>
        <li>{t('page.a11y.compliance_l3')}</li>
        <li>{t('page.a11y.compliance_l4')}</li>
        <li>{t('page.a11y.compliance_l5')}</li>
        <li>{t('page.a11y.compliance_l6')}</li>
        <li>{t('page.a11y.compliance_l7_intro')}
          <ul class="list-disc list-inside ml-6 mt-2 space-y-1">
            <li>{t('page.a11y.compliance_l7_a')}</li>
            <li>{t('page.a11y.compliance_l7_b')}</li>
            <li>{t('page.a11y.compliance_l7_c')}</li>
            <li>{t('page.a11y.compliance_l7_d')}</li>
            <li>{t('page.a11y.compliance_l7_e')}</li>
          </ul>
        </li>
        <li>{t('page.a11y.compliance_l8')}</li>
        <li>{t('page.a11y.compliance_l9')}</li>
        <li>{t('page.a11y.compliance_l10')}</li>
        <li>{t('page.a11y.compliance_l11')}</li>
        <li>{t('page.a11y.compliance_l12')}</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <h2 id="omezeni" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4 scroll-mt-24">
        {t('page.a11y.ch_limitations')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.a11y.lim_p')}
      </p>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        <li>
          {t('page.a11y.lim_l1_pre')}<a href={`/${lang}/organizacni-informace/#doprava`} class="underline">{t('page.a11y.lim_l1_link')}</a>{t('page.a11y.lim_l1_post')}
        </li>
        <li>{t('page.a11y.lim_l2')}</li>
        <li>{t('page.a11y.lim_l3')}</li>
      </ul>

      <h2 id="vypracovani" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4 scroll-mt-24">
        {t('page.a11y.ch_preparation')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.a11y.prep_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        {t('page.a11y.prep_p2')}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <h2 id="hlaseni" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4 scroll-mt-24">
        {t('page.a11y.report_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.a11y.report_p')}
      </p>

      <div class="border border-[var(--color-gold)] bg-[var(--color-bg-medium)]/40 p-6 my-6">
        <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
          <Icon name="lucide:mail" class="w-5 h-5" aria-hidden="true" />
          {t('page.a11y.contact_h')}
        </h3>
        <ul class="space-y-2">
          <li>
            <strong>{t('page.a11y.contact_provider_label')}:</strong> Moravian LARP, z. s.
          </li>
          <li>
            <strong>{t('page.a11y.contact_email_label')}:</strong>
            <a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a>
          </li>
          <li>
            <strong>{t('page.a11y.contact_subject_label')}:</strong> {t('page.a11y.contact_subject_value')}
          </li>
        </ul>
        <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-4">
          {t('page.a11y.contact_response')}
        </p>
      </div>

      <h2 id="pravo" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4 scroll-mt-24">
        {t('page.a11y.enf_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.a11y.enf_p_pre')}<strong>{t('page.a11y.enf_p_strong')}</strong>{t('page.a11y.enf_p_post')}
      </p>
      <ul class="list-disc list-inside space-y-1 text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        <li>{t('page.a11y.enf_address_label')}: {t('page.a11y.enf_address_value')}</li>
        <li>{t('page.a11y.enf_email_label')}: <a href="mailto:pristupnost@mvcr.cz" class="underline">pristupnost@mvcr.cz</a></li>
      </ul>

      <AlertBox variant="info" title={t('page.a11y.help_title')}>
        {t('page.a11y.help_pre')}<a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a>{t('page.a11y.help_post')}
      </AlertBox>

        </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

</BaseLayout>
