---
/**
 * Pravidla a bezpečnost
 * URL: /cs/pravidla/, /en/pravidla/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah načítán z src/content/pages/pravidla/{lang}.json.
 * Strukturovaná data: chapters[].body_html (rich-text WYSIWYG-friendly).
 *
 * Funkce:
 *   - Rozbalovací <details>/<summary> (Accordion) — JS-less fallback
 *   - Quick-access ikony nad obsahem
 *   - Fulltextové vyhledávání (vanilla JS, client-side)
 *   - Křížové odkazy: kliknutí na #sekce-X → otevře cíl, scroll, flash highlight
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Accordion from '@components/blocks/Accordion.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Quote from '@components/blocks/Quote.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';

interface RulesChapter {
  id: string;
  title: string;
  open: boolean;
  icon: string;
  description: string;
  body_html: string;
}

interface RulesPage {
  meta: { title: string; description: string };
  breadcrumb: string;
  hero: { h1: string; subtitle: string };
  must_know: { h2: string; items: string[] };
  quick_access: {
    h2: string;
    search_label: string;
    search_placeholder: string;
    search_results_label: string;
    search_results_suffix: string;
    search_empty: string;
  };
  sidebar: {
    h3: string;
    expand_all: string;
    collapse_all: string;
    expand_all_aria: string;
    collapse_all_aria: string;
  };
  quote: { author: string; text: string };
  chapters: RulesChapter[];
  footer_alert: { title: string; body_html: string };
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<RulesPage>('pravidla', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: p.breadcrumb },
];

const quickTiles = p.chapters.slice(1);

function md(text: string): string {
  return text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.hero.h1}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {p.hero.subtitle}
      </p>
    </div>
  </section>

  {lang !== 'cs' && (
    <section class="py-6 bg-[var(--color-bg-medium)]/30">
      <div class="container-base max-w-4xl">
        <AlertBox variant="info">
          {t('legal.lang_notice_pending')}
        </AlertBox>
      </div>
    </section>
  )}

  <section class="py-10 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base max-w-4xl">
      <div class="border-2 border-[var(--color-gold)] bg-[var(--color-bg-medium)]/40 p-6 md:p-8">
        <h2 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
          <Icon name="lucide:zap" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
          {p.must_know.h2}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-[var(--color-text-on-dark)]">
          {p.must_know.items.map((item) => (
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span>
              <span set:html={md(item)} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-12 bg-[var(--color-bg-darkest)]">
    <div class="container-base max-w-5xl" data-rules-root>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-6 text-center">
        {p.quick_access.h2}
      </h2>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-10">
        {quickTiles.map((tile) => (
          <a
            href={`#${tile.id}`}
            class="group flex flex-col items-center text-center gap-2 p-4 border bg-[var(--color-bg-medium)]/30 border-[var(--color-gold)]/40 hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 transition-all no-underline"
          >
            <span class="w-10 h-10 shrink-0 flex items-center justify-center rounded-full bg-[var(--color-bg-darkest)] border border-[var(--color-gold)]/40 group-hover:border-[var(--color-gold)] transition-colors">
              <Icon name={tile.icon} class="w-5 h-5 text-[var(--color-gold)]" />
            </span>
            <div class="flex-1 min-w-0">
              <div class="font-[family-name:var(--font-display)] text-xs md:text-sm uppercase tracking-wider text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)] transition-colors leading-tight">
                {tile.title}
              </div>
              <p class="text-[10px] md:text-xs text-[var(--color-text-on-dark-muted)] mt-1 leading-snug hidden sm:block">
                {tile.description}
              </p>
            </div>
          </a>
        ))}
      </div>

      <details class="mb-8 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)]/60 group bg-[var(--color-bg-medium)]/20">
        <summary class="flex items-center gap-3 px-4 py-3 cursor-pointer list-none font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]">
          <Icon name="lucide:search" class="w-5 h-5 text-[var(--color-gold)] flex-shrink-0" />
          <span class="flex-1">{p.quick_access.search_label}</span>
          <Icon name="lucide:plus" class="w-4 h-4 text-[var(--color-gold)] transition-transform group-open:rotate-45 flex-shrink-0" />
        </summary>
        <div class="p-4 border-t border-[var(--color-gold-darkest)]">
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none">
              <Icon name="lucide:search" class="w-5 h-5 text-[var(--color-gold)]" />
            </span>
            <input
              type="search"
              data-rules-search
              placeholder={p.quick_access.search_placeholder}
              aria-label={p.quick_access.search_label}
              class="w-full pl-12 pr-4 py-3 bg-[var(--color-bg-medium)]/50 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] focus:border-[var(--color-gold)] focus:outline-none text-[var(--color-text-on-dark)] placeholder:text-[var(--color-text-on-dark-muted)] transition-colors"
            />
          </div>
          <div class="text-xs text-[var(--color-text-on-dark-muted)] mt-2 px-1">
            {p.quick_access.search_results_label}<span data-rules-counter>—</span>{p.quick_access.search_results_suffix}
          </div>

          <div data-rules-empty hidden class="mt-4 p-6 border border-[var(--color-gold-darkest)] bg-[var(--color-bg-medium)]/30 text-center">
            <Icon name="lucide:search-x" class="w-8 h-8 text-[var(--color-gold)] mx-auto mb-2" />
            <p class="text-[var(--color-text-on-dark-muted)]">
              {p.quick_access.search_empty}
            </p>
          </div>
        </div>
      </details>

      <Quote author={p.quote.author} tone="dark" class="my-10">
        {p.quote.text}
      </Quote>

      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">

        <MobileSidebarShell tabLabel={p.sidebar.h3} tabIcon="lucide:book-open" ariaLabel={p.sidebar.h3}>
          <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-2">
            <span class="text-[var(--color-gold)] text-xs" aria-hidden="true">◆</span>
            {p.sidebar.h3}
          </h3>
          <ul class="space-y-1 border-l border-[var(--color-gold-darkest)] text-sm" role="list">
            {p.chapters.map((c) => (
              <li>
                <a
                  href={`#${c.id}`}
                  data-toc-link={c.id}
                  class="rules-toc-link -ml-px flex items-center gap-2 pl-3 py-2 border-l-2 border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)] hover:bg-[var(--color-gold)]/5 transition-all leading-tight"
                >
                  <Icon name={c.icon} class="w-3.5 h-3.5 opacity-70 flex-shrink-0" aria-hidden="true" />
                  {c.title}
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-6 pt-4 border-t border-[var(--color-gold-darkest)] space-y-2">
            <button
              type="button"
              data-rules-expand-all
              class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors"
              aria-label={p.sidebar.expand_all_aria}
            >
              <Icon name="lucide:chevrons-down" class="w-3.5 h-3.5" aria-hidden="true" />
              {p.sidebar.expand_all}
            </button>
            <button
              type="button"
              data-rules-collapse-all
              class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors"
              aria-label={p.sidebar.collapse_all_aria}
            >
              <Icon name="lucide:chevrons-up" class="w-3.5 h-3.5" aria-hidden="true" />
              {p.sidebar.collapse_all}
            </button>
          </div>
        </MobileSidebarShell>

        <div class="space-y-3 [&_summary]:text-lg [&_summary]:py-5 [&_summary]:font-semibold min-w-0">
          {p.chapters.map((ch) => (
            <Accordion id={ch.id} question={ch.title} tone="dark" open={ch.open}>
              <div data-rules-section set:html={ch.body_html}></div>
            </Accordion>
          ))}
        </div>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-12" />

      <AlertBox variant="info" title={p.footer_alert.title}>
        <span set:html={p.footer_alert.body_html} />
      </AlertBox>

    </div>
  </section>

</BaseLayout>

<script>
  import '@scripts/rules.ts';
</script>

<style is:global>
  details.rules-flash {
    animation: rules-flash-anim 1.5s ease-out;
  }

  @keyframes rules-flash-anim {
    0%   { background-color: rgba(201, 167, 94, 0.18); }
    100% { background-color: transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    details.rules-flash { animation: none; }
  }

  details[hidden] { display: none; }
</style>
