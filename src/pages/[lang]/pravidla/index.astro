---
/**
 * Pravidla a bezpečnost
 * URL: /cs/pravidla/, /en/pravidla/, …
 * Datum: 2026-04-30
 *
 * Obsah pravidel je závazný a faktická čísla se nemění (zdrojové MD).
 * Zachovává:
 *   - Rozbalovací <details>/<summary> (Accordion) — JS-less fallback
 *   - Quick-access ikony nad obsahem (Kostýmy / Zbraně / Životy & oživování)
 *   - Fulltextové vyhledávání (vanilla JS, client-side)
 *   - Křížové odkazy: kliknutí na #sekce-X → otevře cíl, scroll, flash highlight
 *
 * Texty pravidel jsou v češtině (zdrojové MD soubory). Pro non-cs jazyky
 * zobrazujeme upozornění + CS fallback (CLAUDE.md §6).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Accordion from '@components/blocks/Accordion.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Quote from '@components/blocks/Quote.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.rules.title') },
];

// Quick-access dlaždice nad obsahem — vedou na konkrétní sekce přes #anchor.
// Cross-link skript je zachytí stejně jako kterýkoli jiný interní odkaz.
const quickTiles = [
  {
    icon: 'lucide:shirt',
    title: 'Kostýmy',
    description: 'Hodnocení, 2–4 životy, příklady',
    href: '#hodnoceni-kostymu',
    color: 'free',
  },
  {
    icon: 'game-icons:crossed-swords',
    title: 'Zbraně',
    description: 'Rozměry, bezpečnost, luky a šípy',
    href: '#zbrane-povolene',
    color: 'gold',
  },
  {
    icon: 'lucide:heart-pulse',
    title: 'Životy & oživování',
    description: 'Zásahové plochy, smrt, oživení',
    href: '#zasahove-plochy',
    color: 'evil',
  },
];

const tileColorMap: Record<string, string> = {
  free: 'border-[var(--color-side-free)]/40 hover:border-[var(--color-side-free)] hover:bg-[var(--color-side-free)]/5',
  gold: 'border-[var(--color-gold)]/40 hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5',
  evil: 'border-[var(--color-side-evil)]/40 hover:border-[var(--color-side-evil)] hover:bg-[var(--color-side-evil)]/5',
};
---

<BaseLayout
  title={t('page.rules.title')}
  description="Pravidla boje, bezpečnostní pokyny, zbraně, hodnocení kostýmů a zásady fair play pro Bitvu o Středozem."
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.rules.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Pravidla boje, bezpečnost, zbraně, kostýmy a fair play. Bezpečnost je na prvním místě.
      </p>
    </div>
  </section>

  {lang !== 'cs' && (
    <section class="py-6 bg-[var(--color-bg-medium)]/30">
      <div class="container-base max-w-4xl">
        <AlertBox variant="info" title="Translation in progress">
          The full ruleset is currently maintained in Czech. Translations to
          English, German, and Slovak are in progress. Below is the original
          Czech version — feel free to use a browser translator in the meantime.
        </AlertBox>
      </div>
    </section>
  )}

  <!-- Quick-access tiles + search box + main accordion -->
  <section class="py-12 bg-[var(--color-bg-darkest)]">
    <div class="container-base max-w-5xl" data-rules-root>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-6 text-center">
        Rychlý přístup
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        {quickTiles.map((tile) => (
          <a
            href={tile.href}
            class={`group flex items-start gap-4 p-5 border bg-[var(--color-bg-medium)]/30 transition-all ${tileColorMap[tile.color]}`}
          >
            <span class="w-12 h-12 shrink-0 flex items-center justify-center rounded-full bg-[var(--color-bg-darkest)] border border-[var(--color-gold)]/40 group-hover:border-[var(--color-gold)] transition-colors">
              <Icon name={tile.icon} class="w-6 h-6 text-[var(--color-gold)]" />
            </span>
            <div class="flex-1 min-w-0">
              <div class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)] transition-colors">
                {tile.title}
              </div>
              <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-1">
                {tile.description}
              </p>
            </div>
          </a>
        ))}
      </div>

      <!-- Fulltextové vyhledávání -->
      <div class="relative mb-2">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none">
          <Icon name="lucide:search" class="w-5 h-5 text-[var(--color-gold)]" />
        </span>
        <input
          type="search"
          data-rules-search
          placeholder='Hledat v pravidlech… (např. „šíp", „štít", „oživení")'
          aria-label="Hledat v pravidlech"
          class="w-full pl-12 pr-4 py-3 bg-[var(--color-bg-medium)]/50 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] focus:border-[var(--color-gold)] focus:outline-none text-[var(--color-text-on-dark)] placeholder:text-[var(--color-text-on-dark-muted)] transition-colors"
        />
      </div>
      <div class="text-xs text-[var(--color-text-on-dark-muted)] mb-8 px-1">
        Zobrazeno: <span data-rules-counter>—</span> sekcí. Esc vymaže hledání.
      </div>

      <div data-rules-empty hidden class="my-8 p-6 border border-[var(--color-gold-darkest)] bg-[var(--color-bg-medium)]/30 text-center">
        <Icon name="lucide:search-x" class="w-8 h-8 text-[var(--color-gold)] mx-auto mb-2" />
        <p class="text-[var(--color-text-on-dark-muted)]">
          Pro tento dotaz nebyla nalezena žádná sekce. Zkus jiný výraz.
        </p>
      </div>

      <Quote author="Bezpečnostní zásada" tone="dark" class="my-10">
        Hraje se fair-play. Hlavní slovo má organizátor. Bezpečnost je na prvním místě.
      </Quote>

      <div class="space-y-0">

        <!-- Základní zásady -->
        <Accordion id="zakladni-zasady" question="Základní zásady akce" tone="dark" open={true}>
          <div data-rules-section>
            <p class="mb-4">
              Pán Prstenů je larpová bitva ve světě J. R. R. Tolkiena (doba „Války o Prsten").
              Akce je hra, nikoliv simulace skutečného boje. Posláním hry je zábava
              a příjemné strávení volného času.
            </p>
            <ul class="list-disc list-inside space-y-2 mb-4">
              <li><strong>Tématičnost:</strong> zasazením do světa J. R. R. Tolkiena.</li>
              <li><strong>Reálnost:</strong> nereálné a nesettingové vybavení nebude povoleno.</li>
              <li>Neznalost pravidel neomlouvá.</li>
              <li>Přijel ses bavit, ne se hádat.</li>
              <li>Buď ohleduplný k přírodě a lidem okolo sebe.</li>
              <li>Hraje se fair-play. Kdo neví, co to je, zůstane doma.</li>
              <li><strong>Hlavní slovo má organizátor.</strong> Nehádejte se s ním.</li>
              <li>Hráči jsou povinni si přečíst pravidla a řídit se jimi. Za jejich porušování nebo nedodržování pokynů organizátorů můžete být z bitvy vyřazeni.</li>
              <li>Zákony ČR zavazují a jejich neznalost taktéž neomlouvá.</li>
              <li><strong>Ne znamená ne!</strong></li>
              <li>Organizátor může před i během akce zakázat jakoukoliv zbraň a případně ji i do konce hry zabavit, když uzná za vhodné.</li>
              <li>Dodržujte prosím pravidla slušného táboření (viz <a href="#ucast-a-chovani">Účast na akci a chování v táboře</a>).</li>
              <li>Oheň lze rozdělávat jen na místech k tomu určených a připravených organizátorem.</li>
              <li>V lese se nekouří. Během hry je tedy zákaz kouření.</li>
              <li>Hráči mají povinnost starat se především o <strong>SVOJE</strong> bojové kvality, <strong>SVOJE</strong> uznávání zásahů, <strong>SVOJI</strong> úroveň kostýmu atd. Chcete si stěžovat na jiného hráče? Každá armáda má svoje hlavní org CP — obraťte se na něj a bude to řešeno.</li>
              <li>Bitvy se lze účastnit pouze ve stavu, který nebude budit pochybnosti o fyzické a mentální svěžesti hráče. Objektivním důvodem může být trvající intoxikace alkoholem či jinými látkami, ale i subjektivní zhodnocení organizátora (např. výrazná kocovina, nemoc, neovladatelné výbuchy agresivity).</li>
              <li>Účastníci pod vlivem alkoholu nebudou vpuštěni do žádné z částí akce.</li>
              <li>Pokud se v bitvě o čemkoliv vyskytne spor, vždy platí rozhodnutí organizátora. Není-li přítomen organizátor, obraťte se na nejbližšího libovolného panovníka, aby spornou záležitost prozatímně rozsekl.</li>
              <li><strong>Bezpečnost je na prvním místě!</strong></li>
            </ul>

            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mt-6 mb-3">
              Ve hře — rychlý přehled
            </h4>
            <ul class="list-disc list-inside space-y-2">
              <li>Minimum životů je 2, maximum 4 (viz <a href="#hodnoceni-kostymu">Hodnocení kostýmů</a>). Životy se přidělují v sobotu ráno před bitvou při schvalování kostýmů.</li>
              <li>Všechny údery zbraní berou za 1 život.</li>
              <li>Lučištník bere šípem za 2 životy.</li>
              <li>Zásahové plochy jsou tzv. „velké": trup, nohy od trupu ke kotníkům a ruce od trupu k zápěstí (viz <a href="#zasahove-plochy">Zásahové plochy a životy</a>).</li>
              <li>Zásah uznává zasažený.</li>
              <li>Smrt se hraje. Pokud to jde, lehněte si. Oživuje se u standarty (viz <a href="#smrt-a-oziveni">Smrt a oživování</a>).</li>
              <li>Zbraně musí být bezpečné, mít realistické rozměry a zpracování, být z vhodného materiálu a estetické — jsou součástí kostýmu (viz <a href="#zbrane-povolene">Zbraně</a>).</li>
              <li>Všechny šípy musí mít schválené bezpečné bambule, zářez na dříku a letky.</li>
            </ul>
          </div>
        </Accordion>

        <!-- Účast a chování -->
        <Accordion id="ucast-a-chovani" question="Účast na akci a chování v táboře" tone="dark">
          <div data-rules-section>
            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
              Chování, bezpečnost a respekt
            </h4>
            <ul class="list-disc list-inside space-y-2 mb-6">
              <li><strong>Co řekne organizátor, to platí!</strong></li>
              <li>Jestliže něco libovolný organizátor zakáže (založit ohniště, neschválí zbraň), může to později povolit pouze on, nebo hlavní organizátor. Pokusy o obcházení tohoto pravidla budou odměněny nezvratností daného zákazu.</li>
              <li>Na akci platí právní řád České republiky. Výslovně nedoporučujeme porušovat zejména předpisy práva přestupkového a trestního (cizí šípy nepokradeš, na zdraví neublížíš, mladistvému nenaleješ) a práva na ochranu přírody (oheň v lese, sběr dřeva, ochrana vod).</li>
              <li>Na akci respektujte osobní hranice každého z vás a chovejte se k sobě s respektem. Veškerý fyzický kontakt by měl být postaven na konsentu (souhlasu) obou/všech zúčastněných. <strong>Ne prostě znamená ne.</strong> Pokud si budete potřebovat s někým promluvit, na akci bude přítomen důvěrník a důvěrnice.</li>
              <li>Akce se koná v lokalitě podléhající zákonu o ochraně přírody. Závažné nebo opakované porušování pravidel je důvodem k vyloučení z akce bez možnosti náhrady (vrácení registračního poplatku).</li>
              <li>Každý účastník potřebuje vlastní kostým, zbraň a čutoru s vodou do bitvy. Berte si raději zbraní více, kdyby vám náhodou nějaká nebyla povolena při schvalování. Táboření probíhá pod vlastními stany.</li>
            </ul>

            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
              Táboření, oheň, odpad a látky
            </h4>
            <ul class="list-disc list-inside space-y-2 mb-6">
              <li>Po celou dobu akce trvá <strong>kostýmová povinnost</strong>. Producírování „v civilu" bereme jako nabídku k zařazení do organizátorského pracovního komanda. Jedete-li jako doprovod svého dítěte, spíchněte si doma alespoň plášť/hábit v nerušivé barvě.</li>
              <li>V pátek po 22. hodině platí v tábořišti a okolí <strong>noční klid</strong>. V sobotu musíme být všichni fit.</li>
              <li>Oheň je možno rozdělávat pouze v tábořišti, a to pouze v ohništích schválených a připravených organizátory. Zakládání vlastních ohnišť je povoleno jen po výslovném souhlasu organizátora. V rámci tábora je povoleno užívání přenosných ohnišť a grilů, které nepoškozují trávník a neodpadává z nich žhavé na zem.</li>
              <li>Zakládat ohniště nebo jinak významně zasahovat do přírody a krajiny v místě akce je možné až po výslovném souhlasu organizátora.</li>
              <li>Odpadky odhazujte do námi předem dodaných odpadkových pytlů.</li>
              <li><strong>Je přísně zakázáno kouřit na celém herním území.</strong> V táboře, např. u ohňů, se kouřit smí, pokud to nebude vadit nikomu z přítomných.</li>
              <li>Kdokoliv pod vlivem alkoholu či jiných omamných látek nebude vpuštěn do bitvy. Nevylučujeme namátkové kontroly před bitvou. Během bitvy je jakákoliv konzumace těchto látek přísně zakázána.</li>
              <li>Po akci má na louce zůstat jenom slehlá tráva. Žádné díry po kůlech, nezahrabaná ohniště, pohozené odpadky.</li>
            </ul>

            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
              Co bude na akci zajištěno
            </h4>
            <ul class="list-disc list-inside space-y-2">
              <li>Mobilní toalety (typu toi-toi).</li>
              <li>Pitná voda v přistavené cisterně.</li>
              <li>Hospoda s třemi jídly denně. Doporučujeme s sebou mít vlastní korbel a misku — plastové budou zpoplatněné.</li>
              <li>Dřevo na oheň ze zásob přivezených organizátory nebo sběrem spadaného dřeva. Žádné kácení dřevin.</li>
              <li><strong>Co zajištěno nebude:</strong> signál pro mobilní zařízení, elektrické zásuvky, vodní zdroj ke koupání.</li>
            </ul>
          </div>
        </Accordion>

        <!-- Boj — zásahy a techniky -->
        <Accordion id="boj-zasahy" question="Boj — zásahy a techniky" tone="dark">
          <div data-rules-section>
            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
              Základní pravidla zásahu
            </h4>
            <ul class="list-disc list-inside space-y-2 mb-6">
              <li>Každý úder musí být veden se <strong>zřetelným nápřahem</strong>. Žádné kydlení!</li>
              <li>Každý úder musí být <strong>brzděný</strong>, rány nesmí dopadnout plnou silou.</li>
              <li>Topora sekyr, kladiv a dřevcových zbraní nezpůsobují zásah.</li>
              <li>Zásah šípem platí pouze bambulí a pokud šíp dál nepokračuje v letu.</li>
              <li><strong>O platnosti zásahu rozhoduje zasažený.</strong></li>
              <li>Jste povinni ihned po zásahu nebo kdykoliv na požádání pravdivě oznámit zbývající počet životů. Např.: „Mám tři.", „Ještě dva.", „Nula, jsem mrtvý."</li>
              <li>Zásahy vedené současně několika protivníky se sčítají.</li>
              <li>Při <strong>souseku</strong> (vzájemný zásah do cca 1 vteřiny) jsou zraněni oba soupeři.</li>
              <li>Povolenou bojovou technikou je bodání u kopí a sekání u ostatních kontaktních zbraní.</li>
              <li>Sek i bod musí být veden se zřetelným nápřahem ruky (rozhodně ne pohybem pouze v zápěstí). Obouruční zbraně musí být ovládány oběma rukama. Zbraně i projektily se musí o svůj cíl zastavit a nepokračovat v letu, seku či jiném pohybu. Jakýkoliv pohyb zbraně musí být celou dobu kontrolován a zasažení protivníka musí být provedeno intenzitou odpovídající vzezření zasaženého (patnáctiletý vyžle v tunice × stokilový viking v kroužkách).</li>
              <li>Příliš „něžný" zásah, splňuje-li jinak výše uvedené (čili: protihráč do Vás třísknout mohl, ale nechtěl), není důvodem k neuznání zásahu, pokud jste zásah vizuálně zaregistrovali.</li>
            </ul>

            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[#e8a8aa] mb-3">
              Při boji se NESMÍ
            </h4>
            <ul class="list-disc list-inside space-y-2 mb-6">
              <li>Používat jakékoliv formy fyzického útoku, údery rukou, kopy, údery hlavicí zbraně, podražení nohou, povalení, chytání a držení protivníka, páky, zápas, zablokování čepele cizí zbraně vlastním tělem (a následné ušmrdlání krátkou zbraní) — prostě cokoliv, kdy dojde ke vzájemnému kontaktu těl bojujících.</li>
              <li>Zneužívat fyzické převahy k získání převahy v boji. Např. je dovoleno útočit kopím na štít protihráče, aby jej musel nadále držet ve směru útoku — ale není dovoleno na štít útočit silou tak, abychom jej i s jeho majitelem odstrčili metr dozadu.</li>
              <li>Chytat zbraně za čepel či za ostří, chytat protivníkův štít.</li>
              <li>Zatlačovat během boje protivníka do nebezpečného terénu.</li>
              <li>Útočit či tlačit do někoho štítem (zejména z rozběhu).</li>
            </ul>

            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[#9ec5a8] mb-3">
              Při boji se SMÍ
            </h4>
            <ul class="list-disc list-inside space-y-2 mb-6">
              <li>Zachytit předloktí útočníka u ruky držící zbraň, jílec meče, topor či ratiště zbraně. <strong>Povolená doba držení jsou 3 sekundy.</strong></li>
            </ul>

            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
              Bezpečnost
            </h4>
            <ul class="list-disc list-inside space-y-2">
              <li>V případě jakéhokoliv bolestivého zásahu (zejména do hlavy) má zasažený právo přerušit na potřebnou dobu souboj — položením ruky na hlavu znamená „jsem mimo hru".</li>
              <li>V případě zranění protivníka mu musíte ihned poskytnout potřebnou pomoc a přivolat zdravotníka.</li>
              <li>Na nebezpečných místech je boj všeho druhu zakázán.</li>
              <li>Všichni hráči jsou povinni hlídat terén, v jakém se souboj odehrává, a nenatlačovat protihráče do nebezpečného terénu (např. větší množství popadaných větví). Ustupujícího protihráče musí varovat a dbát i na jeho bezpečnost.</li>
              <li>Máte-li pocit, že někdo bojuje neférově, předpokládejte, že tak činí z nevědomosti, a věcně jej upozorněte. Pokud se ukáže, že je to idiot, je nejlepší přestat s ním hrát a odebrat se na jinou část bojiště.</li>
            </ul>
          </div>
        </Accordion>

        <!-- Zásahové plochy a životy -->
        <Accordion id="zasahove-plochy" question="Zásahové plochy a životy" tone="dark">
          <div data-rules-section>
            <p class="mb-4">
              Bojuje se na tzv. <strong>velké zásahové plochy</strong>. Sem zásah platí.
              Mimo ně zásah neplatí a je proti pravidlům na ně cíleně útočit.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div class="border border-[var(--color-side-free)]/40 bg-[var(--color-side-free)]/10 p-5">
                <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[#9ec5a8] mb-3 flex items-center gap-2">
                  <Icon name="lucide:check-circle" class="w-5 h-5" />
                  Sem zásah PLATÍ
                </h4>
                <ul class="list-disc list-inside space-y-1 text-sm">
                  <li>trup</li>
                  <li>ruce od trupu k zápěstí</li>
                  <li>nohy od trupu ke kotníkům</li>
                </ul>
              </div>
              <div class="border border-[var(--color-side-evil)]/40 bg-[var(--color-side-evil)]/10 p-5">
                <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[#e8a8aa] mb-3 flex items-center gap-2">
                  <Icon name="lucide:x-circle" class="w-5 h-5" />
                  Sem zásah NEPLATÍ
                </h4>
                <ul class="list-disc list-inside space-y-1 text-sm">
                  <li>hlava</li>
                  <li>krk</li>
                  <li>rozkrok</li>
                  <li>ruce od zápěstí dolů (včetně)</li>
                  <li>nohy od kotníků dolů (včetně)</li>
                </ul>
              </div>
            </div>

            <ul class="list-disc list-inside space-y-2 mb-6">
              <li><strong>Při zásahu do platné i neplatné zásahové plochy zásah neplatí.</strong></li>
              <li>Všechny platné zásahové plochy jsou rovnocenné — zásah do ruky či nohy má stejnou hodnotu jako zásah do hrudníku, břicha či zad.</li>
              <li>Neplatnými zásahovými plochami je zakázáno se krýt. Pravidlo dopadá i na takový způsob boje, který za neplatné zásahové plochy schovává plochy platné (typicky postoj v náklonu vpřed s nekrytou hlavou vystrčenou před tělem).</li>
            </ul>

            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
              Ztráta životů
            </h4>
            <ul class="list-disc list-inside space-y-2">
              <li><strong>Zásah zbraní na blízko</strong> do platné zásahové plochy odebere <strong>1 život</strong>.</li>
              <li><strong>Zásah střelnou zbraní</strong> (luk, kuše) do platné zásahové plochy odebere <strong>2 životy</strong>.</li>
              <li>Při ztrátě posledního života (stav 0 životů) jste <strong>smrtelně raněni</strong> (viz <a href="#smrt-a-oziveni">Smrt a oživování</a>).</li>
              <li>Počet životů, který si přinesete do bitvy, závisí na hodnocení kostýmu (viz <a href="#hodnoceni-kostymu">Hodnocení kostýmů</a>) — 2 až 4 životy.</li>
            </ul>
          </div>
        </Accordion>

        <!-- Smrt a oživování -->
        <Accordion id="smrt-a-oziveni" question="Smrt a oživování" tone="dark">
          <div data-rules-section>
            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
              Když ztratíš poslední život
            </h4>
            <ul class="list-disc list-inside space-y-2 mb-6">
              <li>Při stavu 0 životů jste smrtelně raněni.</li>
              <li>Pokud máte v dané herní fázi k dispozici <strong>oživení</strong> (dozvíte se to před každým střetem), odpadáte (odstupujete, odplazíte se) z místa střetu a s rukou za hlavou se tiše a bez dalšího zasahování do střetu přesouváte ke svému oživovacímu místu — vaší <strong>armádní zástavě (standartě)</strong>.</li>
              <li>Pokud v dané herní fázi <strong>žádná oživení nemáte</strong>, zůstáváte smrtelně raněni ležet tam, kde Vás nepřítel přemohl.</li>
            </ul>

            <h4 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
              Smrtelné zranění se hraje
            </h4>
            <p class="mb-3">
              Smrtelně raněný se na místě zhroutí na zem, kde tiše a nehnutě leží.
              Občas může někdo sténat bolestí, chrčet a jinak atmosféricky přispívat
              k vytváření dojmu bojiště posetého umírajícími.
            </p>
            <p class="mb-3">
              <strong>Nepřehrávejte to!</strong> Mrtví nepostávají a nevedou neherní řeči.
              Nekažte atmosféru. Jako smrtelně raněný nijak jinak nezasahujete do hry
              (ani hovorem).
            </p>
            <p>
              Pokud hrozí v místě střetu ušlapání, můžete se odpotácet a padnout
              o kousek dál nebo se jako již ležící odplazit o kus vedle.
            </p>
          </div>
        </Accordion>

        <!-- Zbraně — povolené, rozměry, kombinace -->
        <Accordion id="zbrane-povolene" question="Zbraně — povolené, rozměry, kombinace" tone="dark">
          <div data-rules-section>
            <p class="mb-4">
              Všechny zbraně používané na akci musí být schváleny organizátorem.
              Kdo bude přistižen, že bojuje s neschválenou zbraní, vystavuje se:
              jistotě odebrání zbraně do konce akce; možnosti, že bude zbraň zničena;
              a možnosti, že bude vyzván k opuštění akce.
            </p>

            <div class="overflow-x-auto mb-6 border border-[var(--color-gold-darkest)]">
              <table class="w-full text-sm">
                <thead class="bg-[var(--color-bg-medium)]">
