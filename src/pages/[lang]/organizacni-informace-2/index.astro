---
/**
 * Organizační informace 2 — sjednocený přehled
 * URL: /cs/organizacni-informace-2/
 * Datum: 2026-05-07
 *
 * Experimentální stránka. Konsoliduje obsah z /organizacni-informace/ a /prakticke-info/
 * + dokumenty card z /pro-rodice/. Pouze CS jazyková mutace.
 *
 * Pořadí sekcí:
 *   1. Hero
 *   2. Akce v kostce (EventFactsBlock — 10 karet)
 *   3. Chceš jet do Středozemě (RegistraceBigCta)
 *   4. Registrace a platba — 3 karty (rychlý přehled, posunuto nahoru)
 *   5. Harmonogram víkendu (převzato z prakticke-info)
 *   6. Co si vzít s sebou + dokumenty ke stažení (grid 3fr_1fr)
 *   7. Hospoda a jídlo a pití (sloučená strava + hospoda)
 *   8. Dětská hra (samostatně)
 *   9. Jarmark (samostatně, sjednocený)
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import Checklist from '@components/blocks/Checklist.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import EventFactsBlock from '@components/blocks/EventFactsBlock.astro';
import RegistraceBigCta from '@components/blocks/RegistraceBigCta.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const tp = getPageContent('organizacni-informace-2', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: tp('title') },
];

const packing = [
  tp('pack.1'),
  tp('pack.2'),
  tp('pack.3'),
  tp('pack.4'),
  tp('pack.5'),
  tp('pack.6'),
  tp('pack.7'),
  tp('pack.8'),
];
---

<BaseLayout
  title={tp('meta_title')}
  description={tp('meta_description')}
  lang={lang}
>

  <!-- 1. Hero -->
  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {tp('title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-3xl">
        {tp('subtitle')}
      </p>
    </div>
  </section>

  <!-- 2. Akce v kostce (10 karet) — bez integrované CTA, ta jde dolů přes RegistraceBigCta -->
  <EventFactsBlock lang={lang} showRegistrationCta={false} />

  <!-- 3. Chceš jet do Středozemě? -->
  <RegistraceBigCta lang={lang} />

  <!-- 4. Registrace a platba — 3 karty (rychlý přehled, posunuto nahoru) -->
  <section class="py-12">
    <div class="container-base max-w-4xl">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-8 text-center">
        {tp('reg.title')}
      </h2>
      <Divider variant="line-diamond" tone="dark" class="mb-8" />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="border border-[var(--color-gold-darkest)] p-5">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{tp('reg.s1_label')}</div>
          <p class="text-sm text-[var(--color-text-on-dark)]">{tp('reg.s1_pre')}<strong>{tp('reg.s1_strong')}</strong>{tp('reg.s1_post')}</p>
        </div>
        <div class="border border-[var(--color-gold-darkest)] p-5">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{tp('reg.s2_label')}</div>
          <p class="text-sm text-[var(--color-text-on-dark)]">{tp('reg.s2_pre')}<strong>{tp('reg.s2_strong')}</strong>{tp('reg.s2_post')}</p>
        </div>
        <div class="border border-[var(--color-gold-darkest)] p-5">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{tp('reg.s3_label')}</div>
          <p class="text-sm text-[var(--color-text-on-dark)]"><strong>{tp('reg.s3_strong')}</strong>{tp('reg.s3_post')}</p>
        </div>
      </div>

      <div class="text-center">
        <a href={`/${lang}/registrace/`} class="inline-flex items-center gap-2 px-6 py-3 border border-[var(--color-gold)] text-[var(--color-gold-light)] hover:bg-[var(--color-gold)] hover:text-[var(--color-bg-dark)] font-[family-name:var(--font-display)] uppercase tracking-wider text-sm transition-colors">
          <Icon name="lucide:user-plus" class="w-5 h-5" />
          {tp('reg.cta')}
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Harmonogram víkendu (převzato z prakticke-info) -->
  <section class="py-12 border-t border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-3xl">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 text-center scroll-mt-24">
        {tp('har.title')}
      </h2>
      <p class="text-center text-[var(--color-text-on-dark-muted)] italic mb-8 max-w-2xl mx-auto">
        {tp('har.subtitle')}
      </p>
      <Divider variant="line-diamond" tone="dark" class="mb-10" />

      <!-- Tabulka harmonogramu -->
      <div class="overflow-x-auto mb-10">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b-2 border-[var(--color-gold-darkest)]">
              <th class="text-left py-3 pr-4 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)]">{tp('har.th_day')}</th>
              <th class="text-left py-3 pr-4 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)]">{tp('har.th_date')}</th>
              <th class="text-left py-3 pr-4 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)]">{tp('har.th_what')}</th>
              <th class="text-left py-3 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)]">{tp('har.th_for')}</th>
            </tr>
          </thead>
          <tbody class="text-[var(--color-text-on-dark)]">
            <tr class="border-b border-[var(--color-gold-darkest)]/40">
              <td class="py-3 pr-4"><a href="#ctvrtek" class="font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)] hover:underline">{tp('har.day_thu')}</a></td>
              <td class="py-3 pr-4 whitespace-nowrap">20. 8. 2026</td>
              <td class="py-3 pr-4">{tp('har.thu_what')}</td>
              <td class="py-3 text-xs text-[var(--color-text-on-dark-muted)]">{tp('har.thu_for')}</td>
            </tr>
            <tr class="border-b border-[var(--color-gold-darkest)]/40">
              <td class="py-3 pr-4"><a href="#patek" class="font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)] hover:underline">{tp('har.day_fri')}</a></td>
              <td class="py-3 pr-4 whitespace-nowrap">21. 8. 2026</td>
              <td class="py-3 pr-4">{tp('har.fri_what')}</td>
              <td class="py-3 text-xs text-[var(--color-text-on-dark-muted)]">{tp('har.fri_for')}</td>
            </tr>
            <tr class="border-b border-[var(--color-gold-darkest)]/40 bg-[var(--color-bg-darkest)]/50">
              <td class="py-3 pr-4"><a href="#sobota" class="font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)] hover:underline"><strong>{tp('har.day_sat')}</strong></a></td>
              <td class="py-3 pr-4 whitespace-nowrap">22. 8. 2026</td>
              <td class="py-3 pr-4"><strong>{tp('har.sat_what_strong')}</strong>{tp('har.sat_what_post')}</td>
              <td class="py-3 text-xs text-[var(--color-text-on-dark-muted)]">{tp('har.sat_for')}</td>
            </tr>
            <tr>
              <td class="py-3 pr-4"><a href="#nedele" class="font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)] hover:underline">{tp('har.day_sun')}</a></td>
              <td class="py-3 pr-4 whitespace-nowrap">23. 8. 2026</td>
              <td class="py-3 pr-4">{tp('har.sun_what')}</td>
              <td class="py-3 text-xs text-[var(--color-text-on-dark-muted)]">{tp('har.sun_for')}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Vizuální timeline -->
      <div class="hidden md:flex items-stretch justify-between gap-2 mb-12">
        {[
          { id: 'ctvrtek', label: tp('har.day_thu'), short: '20. 8.', emoji: '🌲', sub: tp('tl.thu_sub') },
          { id: 'patek', label: tp('har.day_fri'), short: '21. 8.', emoji: '🔥', sub: tp('tl.fri_sub') },
          { id: 'sobota', label: tp('har.day_sat'), short: '22. 8.', emoji: '⚔️', sub: tp('tl.sat_sub'), highlight: true },
          { id: 'nedele', label: tp('har.day_sun'), short: '23. 8.', emoji: '🎒', sub: tp('tl.sun_sub') },
        ].map((d) => (
          <a
            href={`#${d.id}`}
            class:list={[
              'flex-1 flex flex-col items-center text-center px-3 py-4 border transition-colors',
              d.highlight
                ? 'border-[var(--color-gold)] bg-[var(--color-bg-darkest)]'
                : 'border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)]',
            ]}
          >
            <span class="text-3xl mb-1" aria-hidden="true">{d.emoji}</span>
            <span class="font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)]">{d.label}</span>
            <span class="text-xs text-[var(--color-text-on-dark-muted)]">{d.short}</span>
            <span class="text-xs text-[var(--color-text-on-dark)] mt-1">{d.sub}</span>
          </a>
        ))}
      </div>

      <!-- Detail dnů -->
      <div class="space-y-8">
        <article id="ctvrtek" class="scroll-mt-24">
          <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-2">{tp('thu.h3')}</h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{tp('thu.p1')}</p>
          <p class="text-[var(--color-text-on-dark-muted)] text-sm mb-3 italic">{tp('thu.p2')}</p>
          <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
            <li>{tp('thu.li1')}</li>
            <li>{tp('thu.li2')}</li>
            <li>{tp('thu.li3')}</li>
          </ul>
        </article>

        <article id="patek" class="scroll-mt-24">
          <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-2">{tp('fri.h3')}</h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{tp('fri.p1')}</p>
          <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
            <li>{tp('fri.li1')}</li>
            <li>{tp('fri.li2')}</li>
            <li>{tp('fri.li3')}</li>
            <li>{tp('fri.li4')}</li>
          </ul>
        </article>

        <article id="sobota" class="scroll-mt-24 bg-[var(--color-bg-darkest)]/60 border border-[var(--color-gold-darkest)] p-5">
          <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-2">{tp('sat.h3')}</h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{tp('sat.p1')}</p>
          <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
            <li>{tp('sat.li1')}</li>
            <li>{tp('sat.li2')}</li>
            <li>{tp('sat.li3')}</li>
            <li>{tp('sat.li4')}</li>
            <li>{tp('sat.li5')}</li>
          </ul>
        </article>

        <article id="nedele" class="scroll-mt-24">
          <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-2">{tp('sun.h3')}</h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{tp('sun.p1')}</p>
          <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
            <li>{tp('sun.li1')}</li>
            <li>{tp('sun.li2')}</li>
            <li>{tp('sun.li3')}</li>
          </ul>
        </article>
      </div>

      <AlertBox variant="info" class="mt-10">
        <strong>{tp('har.alert_strong')}</strong>{tp('har.alert_post')}
      </AlertBox>
    </div>
  </section>

  <!-- 6. Co si vzít s sebou + dokumenty ke stažení -->
  <section class="py-12 border-t border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-5xl">
      <h2 id="vybaveni" class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 text-center scroll-mt-24">
        {tp('eq.title')}
      </h2>
      <p class="text-center text-[var(--color-text-on-dark-muted)] italic mb-8 max-w-2xl mx-auto">
        {tp('eq.intro')}
      </p>
      <Divider variant="ornament" tone="dark" class="mb-8" />

      <div class="grid grid-cols-1 md:grid-cols-[3fr_1fr] gap-6 items-start">
        <div>
          <div class="bg-[var(--color-bg-medium)]/40 border border-[var(--color-gold-darkest)] p-8">
            <Checklist items={packing} tone="dark" />
          </div>

          <div class="mt-8 space-y-4">
            <AlertBox variant="warning" title={tp('eq.alert_warn_title')}>
              {tp('eq.alert_warn_body')}
            </AlertBox>
            <AlertBox variant="info" title={tp('eq.alert_info_title')}>
              {tp('eq.alert_info_body')}
            </AlertBox>
          </div>
        </div>

        <!-- Dokumenty ke stažení (převzato z /pro-rodice/#co-vzit) -->
        <aside class="bg-[var(--color-bg-medium)] border border-[var(--color-gold)] p-5 md:sticky md:top-24">
          <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
            <Icon name="lucide:file-down" class="w-4 h-4" aria-hidden="true" />
            {tp('docs.title')}
          </h3>
          <p class="text-xs text-[var(--color-text-on-dark-muted)] mb-4 leading-relaxed">
            {tp('docs.p')}
          </p>
          <div class="flex flex-col gap-2">
            <Button href="/dokumenty/prihlaska-2026.pdf" variant="primary" size="sm" icon="lucide:download" external>
              {tp('docs.btn1')}
            </Button>
            <Button href="/dokumenty/souhlas-zakonneho-zastupce-2026.pdf" variant="secondary" size="sm" icon="lucide:download" external>
              {tp('docs.btn2')}
            </Button>
            <Button href="/dokumenty/karta-parkovani-2026.pdf" variant="ghost" size="sm" icon="lucide:download" external>
              {tp('docs.btn3')}
            </Button>
          </div>
          <p class="text-[11px] text-[var(--color-text-on-dark-muted)] italic mt-4 leading-relaxed">
            {tp('docs.note_pre')}<a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a>{tp('docs.note_post')}
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 7. Hospoda a jídlo a pití (sloučená strava) -->
  <section class="py-12 border-t border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-3xl">
      <h2 id="strava" class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 text-center scroll-mt-24 flex items-center justify-center gap-3">
        <Icon name="lucide:beer" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {tp('food.title')}
      </h2>
      <Divider variant="line-diamond" tone="dark" class="mb-8" />
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">{tp('food.p1')}</p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('food.p2_pre')}<strong class="text-[var(--color-gold-light)]">{tp('food.p2_strong')}</strong>{tp('food.p2_post')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{tp('food.p3')}</p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>{tp('food.li1')}</li>
        <li>{tp('food.li2')}</li>
        <li>{tp('food.li3')}</li>
        <li>{tp('food.li4')}</li>
        <li>{tp('food.li5')}</li>
      </ul>
      <p class="text-sm text-[var(--color-text-on-dark-muted)] italic">{tp('food.note')}</p>
    </div>
  </section>

  <!-- 8. Dětská hra (samostatně) -->
  <section class="py-12 border-t border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-3xl">
      <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-6 md:p-8 hover:border-[var(--color-gold)] transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <Icon name="lucide:baby" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
          <h2 id="detska-hra" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] scroll-mt-24">
            {tp('kids.title')}
          </h2>
        </div>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-5">
          {tp('kids.p_pre')}<strong class="text-[var(--color-gold-light)]">{tp('kids.p_strong')}</strong>{tp('kids.p_post')}
        </p>
        <a href={`/${lang}/detska-hra/`} class="inline-flex items-center gap-2 text-sm uppercase tracking-wider font-[family-name:var(--font-display)] text-[var(--color-gold-light)] hover:text-[var(--color-gold)]">
          {tp('kids.cta')}
          <Icon name="lucide:arrow-right" class="w-4 h-4" aria-hidden="true" />
        </a>
      </article>
    </div>
  </section>

  <!-- 9. Jarmark (samostatně, sjednocený) -->
  <section class="py-12 border-t border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-3xl">
      <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-6 md:p-8 hover:border-[var(--color-gold)] transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <Icon name="lucide:store" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
          <h2 id="jarmark" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] scroll-mt-24">
            {tp('stalls.title')}
          </h2>
        </div>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{tp('stalls.p1')}</p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-5">{tp('stalls.p2')}</p>
        <a href={`/${lang}/stanky-a-prodejci/`} class="inline-flex items-center gap-2 text-sm uppercase tracking-wider font-[family-name:var(--font-display)] text-[var(--color-gold-light)] hover:text-[var(--color-gold)]">
          {tp('stalls.cta')}
          <Icon name="lucide:arrow-right" class="w-4 h-4" aria-hidden="true" />
        </a>
      </article>
    </div>
  </section>

</BaseLayout>
