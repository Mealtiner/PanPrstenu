---
/**
 * Organizační informace 2 — sjednocený přehled (CS only)
 * URL: /cs/organizacni-informace-2/
 * Datum: 2026-05-08
 *
 * Konsoliduje obsah z /organizacni-informace/ a /prakticke-info/.
 * Mirroruje strukturu /organizacni-informace/ (sidebar + accordion + Rychlý přístup
 * + fulltext + citát), a navíc přidává nahoru:
 *   - Hero
 *   - Akce v kostce (EventFactsBlock)
 *   - Chceš jet do Středozemě (RegistraceBigCta)
 *   - Registrace a platba — 3 karty (rychlý přehled, posunuto nahoru)
 *
 * Pouze CS jazyková mutace.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Accordion from '@components/blocks/Accordion.astro';
import Quote from '@components/blocks/Quote.astro';
import EventFactsBlock from '@components/blocks/EventFactsBlock.astro';
import RegistraceBigCta from '@components/blocks/RegistraceBigCta.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, getPageContent } from '@lib/content/pages';

interface OrgChapter {
  id: string;
  title: string;
  open: boolean;
  icon: string;
  audiences: string[];
  body_html: string;
}

interface OrgPage {
  meta: { title: string; description: string };
  breadcrumb: string;
  hero: { h1: string; subtitle: string };
  intro: string;
  audience_pills: { id: string; label: string; icon: string }[];
  quick_tiles: { icon: string; title: string; description: string; href: string; color: string }[];
  sidebar: {
    h3: string;
    expand_all?: string;
    collapse_all?: string;
    expand_all_aria?: string;
    collapse_all_aria?: string;
  };
  chapters: OrgChapter[];
  quick_access_h2: string;
  filter_label: string;
  filter_aria: string;
  search_placeholder: string;
  search_aria: string;
  search_results_label: string;
  search_results_suffix: string;
  search_empty: string;
  quote: { author: string; text: string };
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

// Top sekce (Hero, Registrace cards) — z vlastního JSON pro tuto stránku
const tp = getPageContent('organizacni-informace-2', lang);

// Sidebar + kapitoly — sdílená data ze /organizacni-informace/
const p = getPageData<OrgPage>('organizacni-informace', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: tp('title') },
];

const sidebarItems = p.chapters.map((c) => ({
  id: c.id,
  label: c.title,
  icon: c.icon,
}));

const tileColorMap: Record<string, string> = {
  free: 'border-[var(--color-side-free)]/40 hover:border-[var(--color-side-free)] hover:bg-[var(--color-side-free)]/5',
  gold: 'border-[var(--color-gold)]/40 hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5',
  evil: 'border-[var(--color-side-evil)]/40 hover:border-[var(--color-side-evil)] hover:bg-[var(--color-side-evil)]/5',
};
---

<BaseLayout
  title={tp('meta_title')}
  description={tp('meta_description')}
  lang={lang}
>

  <!-- 1. Hero -->
  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {tp('title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-3xl">
        {tp('subtitle')}
      </p>
    </div>
  </section>

  <!-- 2. Akce v kostce (10 karet) -->
  <EventFactsBlock lang={lang} showRegistrationCta={false} />

  <!-- 3. Chceš jet do Středozemě? -->
  <RegistraceBigCta lang={lang} />

  <!-- 4. Registrace a platba — 3 karty (rychlý přehled, posunuto nahoru) -->
  <section class="py-12">
    <div class="container-base max-w-4xl">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-8 text-center">
        {tp('reg.title')}
      </h2>
      <Divider variant="line-diamond" tone="dark" class="mb-8" />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="border border-[var(--color-gold-darkest)] p-5">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{tp('reg.s1_label')}</div>
          <p class="text-sm text-[var(--color-text-on-dark)]">{tp('reg.s1_pre')}<strong>{tp('reg.s1_strong')}</strong>{tp('reg.s1_post')}</p>
        </div>
        <div class="border border-[var(--color-gold-darkest)] p-5">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{tp('reg.s2_label')}</div>
          <p class="text-sm text-[var(--color-text-on-dark)]">{tp('reg.s2_pre')}<strong>{tp('reg.s2_strong')}</strong>{tp('reg.s2_post')}</p>
        </div>
        <div class="border border-[var(--color-gold-darkest)] p-5">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{tp('reg.s3_label')}</div>
          <p class="text-sm text-[var(--color-text-on-dark)]"><strong>{tp('reg.s3_strong')}</strong>{tp('reg.s3_post')}</p>
        </div>
      </div>

      <div class="text-center">
        <a href={`/${lang}/registrace/`} class="inline-flex items-center gap-2 px-6 py-3 border border-[var(--color-gold)] text-[var(--color-gold-light)] hover:bg-[var(--color-gold)] hover:text-[var(--color-bg-dark)] font-[family-name:var(--font-display)] uppercase tracking-wider text-sm transition-colors">
          <Icon name="lucide:user-plus" class="w-5 h-5" />
          {tp('reg.cta')}
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Rychlý přístup + Fulltext + Citát + Sidebar/Accordion (převzato z /organizacni-informace/) -->
  <section class="py-12 border-t border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-5xl" data-rules-root>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-6 text-center">
        {p.quick_access_h2}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        {p.quick_tiles.map((tile) => (
          <a
            href={tile.href}
            class={`group flex items-start gap-4 p-5 border bg-[var(--color-bg-medium)]/30 transition-all ${tileColorMap[tile.color]}`}
          >
            <span class="w-12 h-12 shrink-0 flex items-center justify-center rounded-full bg-[var(--color-bg-darkest)] border border-[var(--color-gold)]/40 group-hover:border-[var(--color-gold)] transition-colors">
              <Icon name={tile.icon} class="w-6 h-6 text-[var(--color-gold)]" />
            </span>
            <div class="flex-1 min-w-0">
              <div class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)] transition-colors">
                {tile.title}
              </div>
              <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-1">
                {tile.description}
              </p>
            </div>
          </a>
        ))}
      </div>

      <details class="mb-8 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)]/60 group bg-[var(--color-bg-medium)]/20">
        <summary class="flex items-center gap-3 px-4 py-3 cursor-pointer list-none font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]">
          <Icon name="lucide:search" class="w-5 h-5 text-[var(--color-gold)] flex-shrink-0" />
          <span class="flex-1">{p.search_aria}</span>
          <Icon name="lucide:plus" class="w-4 h-4 text-[var(--color-gold)] transition-transform group-open:rotate-45 flex-shrink-0" />
        </summary>
        <div class="p-4 border-t border-[var(--color-gold-darkest)]">
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none">
              <Icon name="lucide:search" class="w-5 h-5 text-[var(--color-gold)]" />
            </span>
            <input
              type="search"
              data-rules-search
              placeholder={p.search_placeholder}
              aria-label={p.search_aria}
              class="w-full pl-12 pr-4 py-3 bg-[var(--color-bg-medium)]/50 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] focus:border-[var(--color-gold)] focus:outline-none text-[var(--color-text-on-dark)] placeholder:text-[var(--color-text-on-dark-muted)] transition-colors"
            />
          </div>
          <div class="text-xs text-[var(--color-text-on-dark-muted)] mt-2 px-1">
            {p.search_results_label}<span data-rules-counter>—</span>{p.search_results_suffix}
          </div>

          <div data-rules-results hidden aria-live="polite" class="mt-4"></div>

          <div data-rules-empty hidden class="mt-4 p-6 border border-[var(--color-gold-darkest)] bg-[var(--color-bg-medium)]/30 text-center">
            <Icon name="lucide:search-x" class="w-8 h-8 text-[var(--color-gold)] mx-auto mb-2" />
            <p class="text-[var(--color-text-on-dark-muted)]">{p.search_empty}</p>
          </div>
        </div>
      </details>

      <Quote author={p.quote.author} tone="dark" class="my-10">
        {p.quote.text}
      </Quote>

      <!-- Sidebar + Accordion -->
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={sidebarItems} title={p.sidebar.h3} ariaLabel={p.sidebar.h3}>
          <div class="mt-6 pt-4 border-t border-[var(--color-gold-darkest)] space-y-2">
            <button
              type="button"
              data-rules-expand-all
              class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors"
              aria-label={p.sidebar.expand_all_aria ?? 'Rozbalit všechny kapitoly'}
            >
              <Icon name="lucide:chevrons-down" class="w-3.5 h-3.5" aria-hidden="true" />
              {p.sidebar.expand_all ?? 'Rozbalit vše'}
            </button>
            <button
              type="button"
              data-rules-collapse-all
              class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors"
              aria-label={p.sidebar.collapse_all_aria ?? 'Sbalit všechny kapitoly'}
            >
              <Icon name="lucide:chevrons-up" class="w-3.5 h-3.5" aria-hidden="true" />
              {p.sidebar.collapse_all ?? 'Sbalit vše'}
            </button>
          </div>
        </TocSidebar>

        <div class="space-y-0 min-w-0">
          {p.chapters.map((ch) => (
            <Accordion id={ch.id} question={ch.title} tone="dark" open={ch.open}>
              <div data-rules-section data-audiences={ch.audiences.join(',')} set:html={ch.body_html}></div>
            </Accordion>
          ))}
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  import '@scripts/rules.ts';
</script>
