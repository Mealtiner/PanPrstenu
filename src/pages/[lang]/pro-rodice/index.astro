---
/**
 * Pro rodiče — informační stránka pro dvě situace:
 *  1) rodič jede s menším dítětem na dětskou hru,
 *  2) rodič posílá starší dítě (12+) na hlavní hru bez sebe.
 * URL: /cs/pro-rodice/, …
 * Datum: 2026-05-03
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import Accordion from '@components/blocks/Accordion.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Pro rodiče' },
];

const chapters = [
  { id: 'larp-a-boj',         label: 'Co je larp a boj',          icon: 'lucide:swords' },
  { id: 'vek',                label: 'Věk a účast',               icon: 'lucide:cake' },
  { id: 'dite-bez-rodicu',    label: 'Dítě jede bez rodičů',      icon: 'lucide:user' },
  { id: 'rodic-jede-s-ditetem', label: 'Rodič jede s dítětem',    icon: 'lucide:users' },
  { id: 'bezpecnostni-vybaveni', label: 'Bezpečnostní vybavení',  icon: 'lucide:shield-check' },
  { id: 'co-vzit',            label: 'Co si dítě vzít s sebou',   icon: 'lucide:backpack' },
  { id: 'detska-hra',         label: 'Dětská hra',                icon: 'lucide:sparkles' },
  { id: 'rodic-i-bitva',      label: 'Bitva + dítě na hře',       icon: 'lucide:swords' },
  { id: 'prihlasit',          label: 'Jak dítě přihlásit',        icon: 'lucide:user-plus' },
  { id: 'poplatek-rodina',    label: 'Rodinný strop poplatku',    icon: 'lucide:credit-card' },
  { id: 'zazemi',             label: 'Co je na místě',            icon: 'lucide:tent' },
  { id: 'parkovani',          label: 'Parkování a příjezd',       icon: 'lucide:car' },
  { id: 'faq',                label: 'Časté obavy rodičů',        icon: 'lucide:help-circle' },
  { id: 'co-potrebujeme',     label: 'Co od rodičů chceme',       icon: 'lucide:check-circle' },
  { id: 'odkazy',             label: 'Důležité odkazy',           icon: 'lucide:link' },
  { id: 'zaver',              label: 'Závěrem',                   icon: 'lucide:flag' },
];

// FAQ sekce „Nejčastější obavy rodičů" — accordion stejný jako na /faq/
const faqItems = [
  {
    q: 'Je akce bezpečná?',
    a: 'Děláme maximum pro to, aby byla bezpečná. Kontrolujeme zbraně, řešíme pravidla boje, máme zdravotníka a organizátory v terénu. Zároveň ale platí, že jde o pohybovou venkovní akci, kde se může stát drobný úraz.',
  },
  {
    q: 'Může jet dítě samo?',
    a: 'Hlavní hry se mohou účastnit hráči od 12 let. Do 18 let potřebujeme podepsaný souhlas zákonného zástupce. U osob mladších 15 let je nutný doprovod osoby starší 18 let, která za ně odpovídá.',
  },
  {
    q: 'Musí mít dítě kostým?',
    a: 'Ano. Kostým je součástí hry i atmosféry. Nemusí být dokonalý, ale měl by odpovídat vybrané armádě, být bezpečný a použitelný v terénu.',
  },
  {
    q: 'Musí mít dítě vlastní zbraň?',
    a: 'Pokud se chce účastnit boje, ano. Zbraň musí být měkčená a musí projít kontrolou. Doporučujeme mít i náhradní variantu, kdyby některá zbraň neprošla schválením.',
  },
  {
    q: 'Může se rodič zapojit?',
    a: 'Ano. Můžeš jet jako nehrající doprovod, jako hrající účastník, jako pomocník nebo nám můžeš pomoct s dětskou hrou.',
  },
];

// JSON-LD FAQ schema
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title="Pro rodiče — Pán Prstenů 2026"
  description="Co je akce, od kolika let se mohou děti účastnit, bezpečnost, dokumenty a vybavení. Praktický průvodce pro rodiče dětí a mladších účastníků."
  lang={lang}
  breadcrumbs={[{ name: 'Pro rodiče', href: `/${lang}/pro-rodice/` }]}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />

  <!-- Hero -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="👪" size={140} tone="gold" class="shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">Rodiny a děti</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl lg:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            Pro rodiče
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            Když se tvoje dítě chystá do Středozemě.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title="Obsah stránky" ariaLabel="Obsah stránky pro rodiče" />
        <article class="min-w-0 max-w-3xl">

        <!-- Úvod -->
        <p class="text-[var(--color-text-on-dark)] leading-relaxed text-lg mb-4">
          Pokud tě tvoje dítě přesvědčilo, že chce jet na <strong>Pána Prstenů — Bitvu o Středozem</strong>, jsi na správném místě. Tady najdeš přehled toho, co akce je, od jakého věku se jí děti mohou účastnit, jak řešíme bezpečnost, jaké dokumenty potřebujeme a co si má dítě vzít s sebou.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          Pán Prstenů je velký víkendový <strong>larp inspirovaný světem J. R. R. Tolkiena</strong>. Účastníci si vybírají stranu a armádu, připraví si kostým, zbraň a postavu, a společně prožijí příběh ve světě Středozemě. Čeká je táborový život, program, roleplay, kostýmy, komunita a hlavně sobotní bitva.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
          Akci pořádá <strong>Moravian LARP, z. s.</strong> a připravují ji lidé, kteří mají s podobnými akcemi dlouholeté zkušenosti.
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Co je larp a jak vypadá boj -->
        <h2 id="larp-a-boj" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          Co je larp a jak vypadá boj
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          Larp je hra naživo. Účastníci nejsou jen diváci — sami vstupují do příběhu. Obléknou si kostým, ztvární postavu a podle pravidel se zapojují do dění.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          Součástí Pána Prstenů je také boj. Nebojujeme skutečnými zbraněmi. Používají se <strong>bezpečné měkčené repliky zbraní</strong>, typicky meče, sekery, kopí, štíty nebo luky, které musí projít kontrolou organizátorů. Zbraně nejsou kovové a jsou upravené tak, aby byly pro hru co nejbezpečnější.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          I tak je dobré počítat s tím, že jde o <strong>akční pohybovou aktivitu v terénu</strong>. Běhá se, bojuje se, hraje se venku a v lese. Může se stát oděrka, modřina, pád nebo natažený kotník. Vážnější úrazy na podobných akcích nebývají běžné, ale úplně vyloučit je nejde — podobně jako u sportu, tábora nebo jiné outdoorové aktivity.
        </p>
        <AlertBox variant="info" title="Zdravotník na místě">
          Po celou dobu akce je v táboře přítomen zdravotník. Detail viz
          <a href={`/${lang}/bezpecnost/`} class="underline">Bezpečnost a krizové situace</a>.
        </AlertBox>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Od kolika let se mohou děti účastnit -->
        <h2 id="vek" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          Od kolika let se mohou děti účastnit
        </h2>

        <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          Hlavní hra a bitva
        </h3>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          Hlavní hra je určena pro účastníky od <strong>12 let</strong>.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          Účastníci mladší 18 let musí mít při registraci vytištěnou, vyplněnou a podepsanou <strong>přihlášku / souhlas zákonného zástupce</strong>.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          Osoby mladší 15 let se mohou akce účastnit pouze v doprovodu osoby starší 18 let, která za ně během akce odpovídá. Může to být rodič, zákonný zástupce nebo jiná dospělá osoba, se kterou je účast předem jasně domluvená.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          Pokud dítě nejede přímo s rodičem, potřebujeme mít písemně jasné, <strong>kdo za něj na akci odpovídá</strong>.
        </p>

        <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          Dětská hra
        </h3>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          Pro mladší děti připravujeme samostatnou <strong>dětskou hru</strong>.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          Ta je určena hlavně pro děti přibližně od <strong>5 do 10 let</strong>. Mladší děti, zhruba od 3 do 5 let, se mohou zapojit pouze s doprovodem rodiče nebo jiné odpovědné dospělé osoby.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          Dětská hra není náhrada za hlídání úplně malých dětí. Je to program pro malé dobrodruhy — bezpečnější, hravější a přizpůsobený jejich věku.
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Když dítě jede bez rodičů -->
        <h2 id="dite-bez-rodicu" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          Když dítě jede bez rodičů
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          Pokud na akci posíláš starší dítě bez sebe, zkontroluj prosím hlavně tyto věci:
        </p>
        <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5 mb-6">
          <li>dítě má platnou registraci,</li>
          <li>registrační poplatek je uhrazený,</li>
          <li>má vytištěnou a podepsanou přihlášku / souhlas zákonného zástupce,</li>
          <li>má kartičku zdravotní pojišťovny,</li>
          <li>má občanský průkaz nebo jiný doklad totožnosti, pokud ho už má,</li>
          <li>ví, kdo je jeho dospělý doprovod nebo dozor,</li>
          <li>má s sebou potřebné léky a ví, kdy je užívat,</li>
          <li>případné zdravotní informace nahlásí při registraci zdravotníkovi,</li>
          <li>má vhodné vybavení do tábora, do lesa a do počasí,</li>
          <li>rozumí tomu, že musí respektovat pokyny organizátorů.</li>
        </ul>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          U dětí a mladších účastníků je důležité, aby věděli, že na akci platí jednoduché pravidlo:
        </p>
        <p class="font-[family-name:var(--font-display)] uppercase tracking-wider text-[var(--color-gold-light)] text-lg mb-4">
          „Co řekne organizátor, to platí."
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          Není to proto, že bychom chtěli kazit dobrodružství. Je to proto, aby hra byla bezpečná, férová a zvládnutelná pro všechny.
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Když jedeš s dítětem na akci -->
        <h2 id="rodic-jede-s-ditetem" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          Když jedeš s dítětem na akci
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          Na akci můžeš jet s dítětem jako <strong>nehrající doprovod</strong>. Můžeš být v táboře, sledovat dění z bezpečné vzdálenosti, pomoct dítěti s vybavením, odpočinkem nebo orientací na místě.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          Zároveň se můžeš zapojit i aktivněji. Můžeš se registrovat jako hrající účastník, vybrat si stranu a armádu, připravit si kostým a prožít víkend naplno společně s ostatními.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          Pokud jedeš jen jako doprovod, prosíme tě i tak o respekt k atmosféře akce. Ideální je jednoduché, nerušivé oblečení v přírodních barvách, případně plášť, tunika nebo jiný základní kostýmový prvek. Pomůžeš tím udržet dojem Středozemě a nebudeš v táboře působit jako návštěva z 21. století.
        </p>
        <div class="text-sm">
          <a href={`/${lang}/role/nebojovy-doprovod/`} class="inline-flex items-center gap-2 text-[var(--color-gold-light)] underline hover:text-[var(--color-gold)]">
            <Icon name="lucide:arrow-right" class="w-4 h-4" aria-hidden="true" />
            Více o roli „Nebojový doprovod"
          </a>
        </div>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Bezpečnostní vybavení pro děti -->
        <h2 id="bezpecnostni-vybaveni" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          Bezpečnostní vybavení pro děti
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          Doporučujeme, aby děti a mladší účastníci měli základní ochranné vybavení. Není to jen o pravidlech, ale hlavně o pohodlí a jistotě.
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          <strong>Velmi doporučujeme:</strong>
        </p>
        <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5 mb-4">
          <li>rukavice,</li>
          <li>pevnou nerušivou obuv do lesa,</li>
          <li>vhodné oblečení do počasí,</li>
          <li>vlastní láhev nebo čutoru na vodu,</li>
          <li>u mladších a menších účastníků také helmu nebo vhodnou ochranu hlavy,</li>
          <li>kostým, ve kterém se dítě může bezpečně hýbat,</li>
          <li>zbraň, která projde kontrolou.</li>
        </ul>
        <p class="text-[var(--color-text-on-dark-muted)] italic mb-4">
          Rukavice opravdu nepodceňujte. Neotlučené prsty za ně poděkují.
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Co si má dítě vzít s sebou — s boxem dokumentů -->
        <h2 id="co-vzit" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          Co si má dítě vzít s sebou
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          <strong>Základní výbava:</strong>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-[3fr_1fr] gap-6 mb-6 items-start">
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5">
            <li>kostým,</li>
            <li>bezpečnou měkčenou zbraň,</li>
            <li>vybavení pro táboření,</li>
            <li>spacák a karimatku,</li>
            <li>oblečení do deště a chladnějšího počasí,</li>
            <li>pevnou obuv do lesa,</li>
            <li>kartičku zdravotní pojišťovny,</li>
            <li>podepsanou přihlášku / souhlas zákonného zástupce, pokud je účastník mladší 18 let,</li>
            <li>láhev nebo čutoru na vodu,</li>
            <li>svačinu a něco rychlého na doplnění energie,</li>
            <li>osobní léky,</li>
            <li>dobrou náladu a ochotu hrát fér.</li>
          </ul>

          <!-- Box: dokumenty ke stažení -->
          <aside class="bg-[var(--color-bg-medium)] border border-[var(--color-gold)] p-5 sticky top-24">
            <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:file-down" class="w-4 h-4" aria-hidden="true" />
              Dokumenty ke stažení
            </h3>
            <p class="text-xs text-[var(--color-text-on-dark-muted)] mb-4 leading-relaxed">
              Vytiskni, vyplň, podepiš a vezmi s sebou na registraci.
            </p>
            <div class="flex flex-col gap-2">
              <Button href="/dokumenty/prihlaska-2026.pdf" variant="primary" size="sm" icon="lucide:download" external>
                Přihláška PDF
              </Button>
              <Button href="/dokumenty/souhlas-zakonneho-zastupce-2026.pdf" variant="secondary" size="sm" icon="lucide:download" external>
                Souhlas zástupce
              </Button>
              <Button href="/dokumenty/karta-parkovani-2026.pdf" variant="ghost" size="sm" icon="lucide:download" external>
                Karta parkování
              </Button>
            </div>
            <p class="text-[11px] text-[var(--color-text-on-dark-muted)] italic mt-4 leading-relaxed">
              PDF dokumenty doplníme po finalizaci registračního systému 2026. Když potřebuješ něco dřív, napiš na <a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a>.
            </p>
          </aside>
        </div>

        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          Pokud dítě bere pravidelně léky, má alergie, astma nebo jiné zdravotní omezení, dejte mu léky s sebou a informaci prosím nahlaste při registraci zdravotníkovi.
        </p>
        <div class="text-sm mb-2">
          <a href={`/${lang}/pro-novacky/#co-vzit`} class="inline-flex items-center gap-2 text-[var(--color-gold-light)] underline hover:text-[var(--color-gold)]">
            <Icon name="lucide:arrow-right" class="w-4 h-4" aria-hidden="true" />
            Detailní seznam „Co si vzít s sebou" pro nováčky
          </a>
        </div>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Dětská hra — 3/4 + 1/4 layout s CTA boxem -->
        <h2 id="detska-hra" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          Dětská hra
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-[3fr_1fr] gap-6 mb-6 items-start">
          <div>
