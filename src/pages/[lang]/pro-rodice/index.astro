---
/**
 * Pro rodiče — informační stránka pro dvě situace:
 *  1) rodič jede s menším dítětem na dětskou hru,
 *  2) rodič posílá starší dítě (12+) na hlavní hru bez sebe.
 * URL: /cs/pro-rodice/, …
 * Datum: 2026-05-03
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import Accordion from '@components/blocks/Accordion.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const tp = getPageContent('pro-rodice', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: tp('bc_label') },
];

const chapters = [
  { id: 'larp-a-boj',         label: tp('ch_larp'),       icon: 'lucide:swords' },
  { id: 'vek',                label: tp('ch_vek'),        icon: 'lucide:cake' },
  { id: 'dite-bez-rodicu',    label: tp('ch_alone'),      icon: 'lucide:user' },
  { id: 'rodic-jede-s-ditetem', label: tp('ch_with'),     icon: 'lucide:users' },
  { id: 'bezpecnostni-vybaveni', label: tp('ch_safety_eq'), icon: 'lucide:shield-check' },
  { id: 'co-vzit',            label: tp('ch_take'),       icon: 'lucide:backpack' },
  { id: 'detska-hra',         label: tp('ch_kids'),       icon: 'lucide:sparkles' },
  { id: 'rodic-i-bitva',      label: tp('ch_battle'),     icon: 'lucide:swords' },
  { id: 'prihlasit',          label: tp('ch_signup'),     icon: 'lucide:user-plus' },
  { id: 'poplatek-rodina',    label: tp('ch_family_fee'), icon: 'lucide:credit-card' },
  { id: 'zazemi',             label: tp('ch_zazemi'),     icon: 'lucide:tent' },
  { id: 'parkovani',          label: tp('ch_parking'),    icon: 'lucide:car' },
  { id: 'faq',                label: tp('ch_faq'),        icon: 'lucide:help-circle' },
  { id: 'co-potrebujeme',     label: tp('ch_need'),       icon: 'lucide:check-circle' },
  { id: 'odkazy',             label: tp('ch_links'),      icon: 'lucide:link' },
  { id: 'zaver',              label: tp('ch_end'),        icon: 'lucide:flag' },
];

type FaqItem = { qKey: string; aKey: string };
const faqItems: FaqItem[] = [
  { qKey: 'faq_q1', aKey: 'faq_a1' },
  { qKey: 'faq_q2', aKey: 'faq_a2' },
  { qKey: 'faq_q3', aKey: 'faq_a3' },
  { qKey: 'faq_q4', aKey: 'faq_a4' },
  { qKey: 'faq_q5', aKey: 'faq_a5' },
];

// JSON-LD FAQ schema
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: tp(item.qKey),
    acceptedAnswer: { '@type': 'Answer', text: tp(item.aKey) },
  })),
};
---

<BaseLayout
  title={tp('meta_title')}
  description={tp('description')}
  lang={lang}
  breadcrumbs={[{ name: tp('bc_label'), href: `/${lang}/pro-rodice/` }]}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />

  <!-- Hero -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="👪" size={140} tone="gold" class="shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">{tp('tag')}</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl lg:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            {tp('title')}
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            {tp('subtitle')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title={tp('toc_title')} ariaLabel={tp('toc_aria')} />
        <article class="min-w-0 max-w-3xl">

        <!-- Úvod -->
        <p class="text-[var(--color-text-on-dark)] leading-relaxed text-lg mb-4">
          {tp('intro_p1_pre')}<strong>{tp('intro_p1_strong')}</strong>{tp('intro_p1_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('intro_p2_pre')}<strong>{tp('intro_p2_strong')}</strong>{tp('intro_p2_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
          {tp('intro_p3_pre')}<strong>{tp('intro_p3_strong')}</strong>{tp('intro_p3_post')}
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Co je larp a jak vypadá boj -->
        <h2 id="larp-a-boj" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_larp')}
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('larp_p1')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('larp_p2_pre')}<strong>{tp('larp_p2_strong')}</strong>{tp('larp_p2_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('larp_p3_pre')}<strong>{tp('larp_p3_strong')}</strong>{tp('larp_p3_post')}
        </p>
        <AlertBox variant="info" title={tp('medic_title')}>
          {tp('medic_pre')}<a href={`/${lang}/bezpecnost/`} class="underline">{tp('medic_link')}</a>{tp('medic_post')}
        </AlertBox>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Od kolika let se mohou děti účastnit -->
        <h2 id="vek" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_vek')}
        </h2>

        <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          {tp('vek_h_main')}
        </h3>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          {tp('vek_p1_pre')}<strong>{tp('vek_p1_strong')}</strong>{tp('vek_p1_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          {tp('vek_p2_pre')}<strong>{tp('vek_p2_strong')}</strong>{tp('vek_p2_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          {tp('vek_p3')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          {tp('vek_p4_pre')}<strong>{tp('vek_p4_strong')}</strong>{tp('vek_p4_post')}
        </p>

        <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          {tp('vek_h_kids')}
        </h3>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          {tp('vek_kids_p1_pre')}<strong>{tp('vek_kids_p1_strong')}</strong>{tp('vek_kids_p1_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          {tp('vek_kids_p2_pre')}<strong>{tp('vek_kids_p2_strong')}</strong>{tp('vek_kids_p2_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          {tp('vek_kids_p3')}
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Když dítě jede bez rodičů -->
        <h2 id="dite-bez-rodicu" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_alone')}
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('alone_p1')}
        </p>
        <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5 mb-6">
          <li>{tp('alone_l1')}</li>
          <li>{tp('alone_l2')}</li>
          <li>{tp('alone_l3')}</li>
          <li>{tp('alone_l4')}</li>
          <li>{tp('alone_l5')}</li>
          <li>{tp('alone_l6')}</li>
          <li>{tp('alone_l7')}</li>
          <li>{tp('alone_l8')}</li>
          <li>{tp('alone_l9')}</li>
          <li>{tp('alone_l10')}</li>
        </ul>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          {tp('alone_p2')}
        </p>
        <p class="font-[family-name:var(--font-display)] uppercase tracking-wider text-[var(--color-gold-light)] text-lg mb-4">
          {tp('alone_quote')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          {tp('alone_p3')}
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Když jedeš s dítětem na akci -->
        <h2 id="rodic-jede-s-ditetem" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_with')}
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('with_p1_pre')}<strong>{tp('with_p1_strong')}</strong>{tp('with_p1_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('with_p2')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          {tp('with_p3')}
        </p>
        <div class="text-sm">
          <a href={`/${lang}/role/nebojovy-doprovod/`} class="inline-flex items-center gap-2 text-[var(--color-gold-light)] underline hover:text-[var(--color-gold)]">
            <Icon name="lucide:arrow-right" class="w-4 h-4" aria-hidden="true" />
            {tp('with_link')}
          </a>
        </div>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Bezpečnostní vybavení pro děti -->
        <h2 id="bezpecnostni-vybaveni" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_safety_eq')}
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('safety_eq_p1')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          <strong>{tp('safety_eq_strong')}</strong>
        </p>
        <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5 mb-4">
          <li>{tp('safety_eq_l1')}</li>
          <li>{tp('safety_eq_l2')}</li>
          <li>{tp('safety_eq_l3')}</li>
          <li>{tp('safety_eq_l4')}</li>
          <li>{tp('safety_eq_l5')}</li>
          <li>{tp('safety_eq_l6')}</li>
          <li>{tp('safety_eq_l7')}</li>
        </ul>
        <p class="text-[var(--color-text-on-dark-muted)] italic mb-4">
          {tp('safety_eq_note')}
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Co si má dítě vzít s sebou — s boxem dokumentů -->
        <h2 id="co-vzit" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_take')}
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          <strong>{tp('take_strong')}</strong>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-[3fr_1fr] gap-6 mb-6 items-start">
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5">
            <li>{tp('take_l1')}</li>
            <li>{tp('take_l2')}</li>
            <li>{tp('take_l3')}</li>
            <li>{tp('take_l4')}</li>
            <li>{tp('take_l5')}</li>
            <li>{tp('take_l6')}</li>
            <li>{tp('take_l7')}</li>
            <li>{tp('take_l8')}</li>
            <li>{tp('take_l9')}</li>
            <li>{tp('take_l10')}</li>
            <li>{tp('take_l11')}</li>
            <li>{tp('take_l12')}</li>
          </ul>

          <!-- Box: dokumenty ke stažení -->
          <aside class="bg-[var(--color-bg-medium)] border border-[var(--color-gold)] p-5 sticky top-24">
            <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:file-down" class="w-4 h-4" aria-hidden="true" />
              {tp('docs_title')}
            </h3>
            <p class="text-xs text-[var(--color-text-on-dark-muted)] mb-4 leading-relaxed">
              {tp('docs_p')}
            </p>
            <div class="flex flex-col gap-2">
              <Button href="/dokumenty/prihlaska-2026.pdf" variant="primary" size="sm" icon="lucide:download" external>
                {tp('docs_btn1')}
              </Button>
              <Button href="/dokumenty/souhlas-zakonneho-zastupce-2026.pdf" variant="secondary" size="sm" icon="lucide:download" external>
                {tp('docs_btn2')}
              </Button>
              <Button href="/dokumenty/karta-parkovani-2026.pdf" variant="ghost" size="sm" icon="lucide:download" external>
                {tp('docs_btn3')}
              </Button>
            </div>
            <p class="text-[11px] text-[var(--color-text-on-dark-muted)] italic mt-4 leading-relaxed">
              {tp('docs_note_pre')}<a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a>{tp('docs_note_post')}
            </p>
          </aside>
        </div>

        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('take_p2')}
        </p>
        <div class="text-sm mb-2">
          <a href={`/${lang}/pro-novacky/#co-vzit`} class="inline-flex items-center gap-2 text-[var(--color-gold-light)] underline hover:text-[var(--color-gold)]">
            <Icon name="lucide:arrow-right" class="w-4 h-4" aria-hidden="true" />
            {tp('take_link')}
          </a>
        </div>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Dětská hra — 3/4 + 1/4 layout s CTA boxem -->
        <h2 id="detska-hra" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_kids')}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-[3fr_1fr] gap-6 mb-6 items-start">
          <div>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
              {tp('kids_p1')}
            </p>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
              {tp('kids_p2')}
            </p>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-2">
              <strong>{tp('kids_strong')}</strong>
            </p>
            <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1.5 mb-4">
              <li><strong>{tp('kids_l1_strong')}</strong>{tp('kids_l1_post')}</li>
              <li><strong>{tp('kids_l2_strong')}</strong>{tp('kids_l2_post')}</li>
              <li><strong>{tp('kids_l3_strong')}</strong>{tp('kids_l3_post')}</li>
              <li><strong>{tp('kids_l4_strong')}</strong>{tp('kids_l4_post')}</li>
              <li><strong>{tp('kids_l5_strong')}</strong>{tp('kids_l5_post')}</li>
            </ul>
            <p class="text-[var(--color-text-on-dark-muted)] italic">
              {tp('kids_note')}
            </p>
          </div>

          <!-- CTA box: registrace + odkaz na detail dětské hry -->
          <aside class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-5 sticky top-24">
            <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:sparkles" class="w-4 h-4" aria-hidden="true" />
              {tp('kids_box_title')}
            </h3>
            <p class="text-xs text-[var(--color-text-on-dark-muted)] mb-4 leading-relaxed">
              {tp('kids_box_p')}
            </p>
            <div class="flex flex-col gap-2">
              <Button href={`/${lang}/registrace/`} variant="primary" size="sm" icon="lucide:arrow-right">
                {tp('kids_box_btn1')}
              </Button>
              <Button href={`/${lang}/detska-hra/`} variant="secondary" size="sm" icon="lucide:arrow-right">
                {tp('kids_box_btn2')}
              </Button>
            </div>
          </aside>
        </div>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Můžu jít do bitvy a dítě nechat na dětské hře? -->
        <h2 id="rodic-i-bitva" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_battle')}
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('battle_p1')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('battle_p2')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
          {tp('battle_p3')}
        </p>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Jak dítě přihlásit — 3/4 + 1/4 layout s CTA -->
        <h2 id="prihlasit" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_signup')}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-[3fr_1fr] gap-6 mb-6 items-start">
          <div>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
              {tp('signup_p1')}
            </p>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
              {tp('signup_p2_pre')}<strong>{tp('signup_p2_strong')}</strong>{tp('signup_p2_post')}
            </p>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed">
              {tp('signup_p3')}
            </p>
          </div>

          <aside class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-5 sticky top-24">
            <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:user-plus" class="w-4 h-4" aria-hidden="true" />
              {tp('signup_box_title')}
            </h3>
            <p class="text-xs text-[var(--color-text-on-dark-muted)] mb-4 leading-relaxed">
              {tp('signup_box_p')}
            </p>
            <div class="flex flex-col gap-2">
              <Button href={`/${lang}/registrace/`} variant="primary" size="sm" icon="lucide:arrow-right">
                {tp('signup_box_btn1')}
              </Button>
              <Button href="mailto:info@panprstenu.cz?subject=P%C5%99ihl%C3%A1%C5%A1en%C3%AD%20d%C3%ADt%C4%9Bte" variant="secondary" size="sm" icon="lucide:mail">
                {tp('signup_box_btn2')}
              </Button>
            </div>
          </aside>
        </div>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <!-- Registrační poplatek pro rodiny -->
        <h2 id="poplatek-rodina" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
          {tp('h_family_fee')}
        </h2>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('family_fee_p1_pre')}<strong>{tp('family_fee_p1_strong')}</strong>{tp('family_fee_p1_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('family_fee_p2')}
