---
/**
 * Příběh letošního ročníku
 * URL: /cs/pribeh/, /en/pribeh/, /de/pribeh/, /sk/pribeh/, /uk/pribeh/
 * Datum: 2026-05-03
 *
 * Placeholder — finální text dorazí od dramaturgie.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Quote from '@components/blocks/Quote.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import Button from '@components/ui/Button.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.story') },
];
---

<BaseLayout
  title={t('nav.story')}
  description={t('page.story.description')}
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('nav.story')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {t('page.story.subtitle')}
      </p>
    </div>
  </section>

  <section class="py-16">
    <article class="container-base max-w-3xl">

      <Quote author="J. R. R. Tolkien" source={t('page.story.quote.source')} tone="dark">
        {t('page.story.quote.text')}
      </Quote>

      <p class="text-lg text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        {t('page.story.intro_p1')}
      </p>

      <p class="text-base text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        {t('page.story.intro_p2_pre')}<a href={`/${lang}/novinky/`} class="underline text-[var(--color-gold-light)]">{t('page.story.intro_p2_link')}</a>{t('page.story.intro_p2_post')}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <AlertBox variant="info" title={t('page.story.alert.title')}>
        {t('page.story.alert.body_pre')}<a href={`/${lang}/frakce/`} class="underline">{t('page.story.alert.body_link_factions')}</a>{t('page.story.alert.body_sep1')}<a href={`/${lang}/pravidla/`} class="underline">{t('page.story.alert.body_link_rules')}</a>{t('page.story.alert.body_sep2')}<a href={`/${lang}/svet-stredozeme/`} class="underline">{t('page.story.alert.body_link_world')}</a>{t('page.story.alert.body_sep3')}<a href={`/${lang}/prakticke-info/`} class="underline">{t('page.story.alert.body_link_practical')}</a>{t('page.story.alert.body_post')}
      </AlertBox>

      <div class="mt-10 flex flex-wrap gap-3">
        <Button href={`/${lang}/frakce/`} variant="primary" size="md" icon="lucide:arrow-right">
          {t('cta.show_all_factions')}
        </Button>
        <Button href={`/${lang}/svet-stredozeme/`} variant="secondary" size="md">
          {t('cta.world_of_middle_earth')}
        </Button>
        <Button href={`/${lang}/novinky/`} variant="ghost" size="md">
          {t('nav.news')}
        </Button>
      </div>

    </article>
  </section>

</BaseLayout>
