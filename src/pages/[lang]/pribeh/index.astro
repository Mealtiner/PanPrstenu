---
/**
 * Příběh letošního ročníku
 * URL: /cs/pribeh/, …
 * Datum: 2026-04-29
 *
 * Placeholder — finální text dorazí od dramaturgie.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Quote from '@components/blocks/Quote.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import Button from '@components/ui/Button.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.story') },
];
---

<BaseLayout
  title={t('nav.story')}
  description="Příběhový rámec ročníku 2026 — Bitva o Středozem."
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('nav.story')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Příběhový rámec ročníku 2026.
      </p>
    </div>
  </section>

  <section class="py-16">
    <article class="container-base max-w-3xl">

      <Quote author="J. R. R. Tolkien" source="Pán Prstenů" tone="dark">
        Není všechno zlato, co se třpytí, a ne všichni tuláci jsou ztraceni.
      </Quote>

      <p class="text-lg text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Stíny dlouhé jako věky padají na Středozem. Svobodné národy zvedají
        standarty, zatímco ze severu i z jihu se znovu ozývá krok těch, kdo
        slouží Stínu.
      </p>

      <p class="text-base text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Příběh ročníku 2026 budeme postupně odhalovat během následujících
        týdnů. Sleduj <a href={`/${lang}/novinky/`} class="underline text-[var(--color-gold-light)]">novinky</a>
        — první zvěsti dorazí dřív, než armády vytáhnou k boji.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <AlertBox variant="info" title="Jak se připravit">
        Než zvedneme prapory, prober si <a href={`/${lang}/frakce/`} class="underline">armády</a>,
        <a href={`/${lang}/pravidla/`} class="underline"> pravidla</a>,
        <a href={`/${lang}/svet-stredozeme/`} class="underline"> Svět Středozemě</a>
        a <a href={`/${lang}/prakticke-info/`} class="underline">praktické informace</a>.
        Příběhový rámec sám o sobě stačí pro náladu — pro hru potřebuješ
        kostým, registraci a odvahu.
      </AlertBox>

      <div class="mt-10 flex flex-wrap gap-3">
        <Button href={`/${lang}/frakce/`} variant="primary" size="md" icon="lucide:arrow-right">
          {t('cta.show_all_factions')}
        </Button>
        <Button href={`/${lang}/svet-stredozeme/`} variant="secondary" size="md">
          Svět Středozemě
        </Button>
        <Button href={`/${lang}/novinky/`} variant="ghost" size="md">
          Novinky
        </Button>
      </div>

    </article>
  </section>

</BaseLayout>
