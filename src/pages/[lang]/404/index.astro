---
/**
 * Error page 404
 * URL: /cs/404/, /en/404/, …
 * Datum: 2026-05-04
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import ErrorPage from '@components/blocks/ErrorPage.astro';
import type { Lang } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';

interface ErrorData {
  meta: { title: string; description: string };
  h1: string;
  quote?: string;
  quote_attr?: string;
  subtitle: string;
  body: string;
  btn_home: string;
  btn_factions: string;
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const data = getPageData<ErrorData>('_root/404', lang);
---

<BaseLayout
  title={data.meta.title}
  description={data.meta.description}
  lang={lang}
  noIndex={true}
>
  <ErrorPage data={data} lang={lang} />
</BaseLayout>
