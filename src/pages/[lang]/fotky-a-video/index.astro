---
/**
 * Fotky a video — souhlasy, použití, kontakt pro účastníky a rodiče
 * URL: /cs/fotky-a-video/, ...
 * Datum: 2026-05-03
 *
 * Doplněk k /pravidla/, /gdpr/ a /pristupnost/. Vysvětluje, co se děje
 * s podobiznou účastníka a jak požádat o omezení zveřejnění.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('fotky-a-video', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: p.title },
];
---

<BaseLayout
  title={p.title}
  description={p.description}
  lang={lang}
  breadcrumbs={[{ name: p.title, href: `/${lang}/fotky-a-video/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.title}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {p.subtitle}
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-5xl prose-readable">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        {p.intro_pre}<strong>{p.intro_strong}</strong>{p.intro_post}
      </p>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        {p.h_layers}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="border border-[var(--color-gold-darkest)] p-5 bg-[var(--color-bg-medium)]/30">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
            <Icon name="lucide:camera" class="w-4 h-4 text-[var(--color-gold)]" aria-hidden="true" />
            {p.layer_official_title}
          </div>
          <p class="text-sm text-[var(--color-text-on-dark)]">
            {p.layer_official_desc}
          </p>
        </div>
        <div class="border border-[var(--color-gold-darkest)] p-5 bg-[var(--color-bg-medium)]/30">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
            <Icon name="lucide:user" class="w-4 h-4 text-[var(--color-gold)]" aria-hidden="true" />
            {p.layer_private_title}
          </div>
          <p class="text-sm text-[var(--color-text-on-dark)]">
            {p.layer_private_desc}
          </p>
        </div>
        <div class="border border-[var(--color-gold-darkest)] p-5 bg-[var(--color-bg-medium)]/30">
          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
            <Icon name="lucide:briefcase" class="w-4 h-4 text-[var(--color-gold)]" aria-hidden="true" />
            {p.layer_commercial_title}
          </div>
          <p class="text-sm text-[var(--color-text-on-dark)]">
            {p.layer_commercial_desc}
          </p>
        </div>
      </div>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        {p.h_consent}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.consent_p1_pre}<strong>{p.consent_p1_strong}</strong>{p.consent_p1_post}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        {p.consent_p2_pre}<strong>{p.consent_p2_strong}</strong>{p.consent_p2_post}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        {p.h_minors}
      </h2>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        <li>{p.minors_l1_pre}<strong>{p.minors_l1_strong}</strong>{p.minors_l1_post}</li>
        <li>{p.minors_l2_pre}<strong>{p.minors_l2_strong}</strong>{p.minors_l2_post}</li>
        <li>{p.minors_l3}</li>
      </ul>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        {p.h_rules}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.rules_intro_pre}<a href={`/${lang}/organizacni-informace/#foto-video`} class="underline text-[var(--color-gold-light)]">{p.rules_intro_link}</a>{p.rules_intro_post}
      </p>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        <li>{p.rules_l1}</li>
        <li>{p.rules_l2}</li>
        <li>{p.rules_l3}</li>
        <li>{p.rules_l4}</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        {p.h_request}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {p.request_p}
      </p>
      <div class="border border-[var(--color-gold)] bg-[var(--color-bg-medium)]/40 p-5 my-6">
        <ul class="space-y-2">
          <li>
            <strong>{p.request_email_label}:</strong>
            <a href="mailto:info@panprstenu.cz?subject=Fotky%20a%20video%20%E2%80%94%20%C5%BE%C3%A1dost%20o%20omezen%C3%AD" class="underline text-[var(--color-gold-light)]">
              info@panprstenu.cz
            </a>
          </li>
          <li><strong>{p.request_subject_label}:</strong> {p.request_subject_value}</li>
        </ul>
        <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-3">
          {p.request_response}
        </p>
      </div>

      <AlertBox variant="info" title={p.related_title}>
        <ul class="list-disc list-inside mt-2 space-y-1">
          <li><a href={`/${lang}/gdpr/`} class="underline">{p.related_l1}</a></li>
          <li><a href={`/${lang}/pristupnost/`} class="underline">{p.related_l2}</a></li>
          <li><a href={`/${lang}/organizacni-informace/#foto-video`} class="underline">{p.related_l3}</a></li>
          <li><a href={`/${lang}/pro-media/`} class="underline">{p.related_l4}</a></li>
        </ul>
      </AlertBox>

    </article>
  </section>

</BaseLayout>
