---
/**
 * Minulé ročníky — historie akce
 * URL: /cs/minule-rocniky/, …
 * Datum: 2026-05-03
 *
 * Zatím stub — kompletní přehled ročníků s příběhy doplníme později.
 * Hlavní obsah ze starých ročníků je dnes v Galerii a v Novinkách.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.past_editions.title') },
];

// Stručný přehled — orientační data, doplníme s podklady.
const editions = [
  { year: '2024', title: t('page.past_editions.e_2024_title'), desc: t('page.past_editions.e_2024_desc') },
  { year: '2023', title: t('page.past_editions.e_2023_title'), desc: t('page.past_editions.e_2023_desc') },
  { year: '2022', title: t('page.past_editions.e_2022_title'), desc: t('page.past_editions.e_2022_desc') },
];
---

<BaseLayout
  title={t('page.past_editions.meta_title')}
  description={t('page.past_editions.description')}
  lang={lang}
  breadcrumbs={[{ name: t('page.past_editions.title'), href: `/${lang}/minule-rocniky/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.past_editions.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {t('page.past_editions.subtitle')}
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-base max-w-4xl">

      <AlertBox variant="info" title={t('page.past_editions.alert_title')}>
        {t('page.past_editions.alert_pre')}<a href={`/${lang}/galerie/`} class="underline">{t('page.past_editions.alert_link_gallery')}</a>{t('page.past_editions.alert_sep')}<a href={`/${lang}/novinky/`} class="underline">{t('page.past_editions.alert_link_news')}</a>{t('page.past_editions.alert_post')}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <div class="space-y-6">
        {editions.map((e) => (
          <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-6 hover:border-[var(--color-gold)] transition-colors">
            <div class="flex items-start gap-5">
              <div class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] shrink-0 w-20">
                {e.year}
              </div>
              <div class="flex-1">
                <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-2">
                  {e.title}
                </h2>
                <p class="text-[var(--color-text-on-dark)] leading-relaxed">
                  {e.desc}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <div class="flex flex-wrap gap-3">
        <Button href={`/${lang}/galerie/`} variant="primary" size="md" icon="lucide:image">{t('page.past_editions.btn_gallery')}</Button>
        <Button href={`/${lang}/ohlasy/`} variant="secondary" size="md" icon="lucide:quote">{t('page.past_editions.btn_testimonials')}</Button>
        <Button href={`/${lang}/pribeh/`} variant="ghost" size="md" icon="lucide:scroll-text">{t('page.past_editions.btn_story')}</Button>
      </div>

    </div>
  </section>

</BaseLayout>
