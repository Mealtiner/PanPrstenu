---
/**
 * Demografie účastníků — landing.
 * URL: /<lang>/minule-rocniky/statistiky/
 * Datum: 2026-05-12 (revize 2026-05-12 — i18n přes content collection)
 *
 * Obsah: src/content/pages/minule-rocniky/statistiky/{lang}.json (CMS-ready,
 * Sveltia edituje 1 file per jazyk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';
import '@styles/registration.css';

interface DataCategory { label: string; desc: string; }
interface Card { slug: string; icon: string; title: string; desc: string; accent_var: string; }

interface StatistikyLandingPage {
  meta: { title: string; description: string };
  breadcrumb: { minule_rocniky: string; demografie: string };
  hero: { h1: string; lead: string };
  intro: {
    icon: string;
    h2: string;
    lead: string;
    data_categories: DataCategory[];
    api_note_prefix: string;
    api_note_endpoint: string;
    api_note_suffix: string;
  };
  graf_section: { after_note_prefix: string; after_note_link_label: string };
  cards_section: { icon: string; h2: string; lead: string; cards: Card[] };
  sidebar_aria: string;
}

interface EraChapter { id: string; title: string; icon: string; body_html: string; }
interface MinuleRocnikyPage { chapters: EraChapter[]; }

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<StatistikyLandingPage>('minule-rocniky/statistiky', lang);

const minuleRocniky = getPageData<MinuleRocnikyPage>('minule-rocniky', lang);
const grafChapter = minuleRocniky.chapters.find((c) => c.id === 'graf') ?? null;

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: p.breadcrumb.minule_rocniky, href: `/${lang}/minule-rocniky/` },
  { label: p.breadcrumb.demografie },
];
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  lang={lang}
  breadcrumbs={[
    { name: p.breadcrumb.minule_rocniky, href: `/${lang}/minule-rocniky/` },
    { name: p.breadcrumb.demografie, href: `/${lang}/minule-rocniky/statistiky/` },
  ]}
>
  <section class="py-8 md:py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4 leading-tight">
        {p.hero.h1}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-base sm:text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-3xl">
        {p.hero.lead}
      </p>
    </div>
  </section>

  <section class="py-6 sm:py-8 lg:py-10 bg-[var(--color-bg-dark)]" data-lang={lang}>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-6 lg:gap-12 items-start lg:min-h-[calc(100vh-12rem)]">
        <MobileSidebarShell
          asideId="statistiky-sidebar"
          tabLabel={t('sidebar.tab_menu')}
          tabIcon="lucide:menu"
          ariaLabel={p.sidebar_aria}
          asideClass="reg-sidebar"
        ></MobileSidebarShell>

        <div class="min-w-0 space-y-10 lg:space-y-12">

          <!-- 1) Úvod -->
          <section class="border border-[var(--color-gold-darkest)] bg-[var(--color-bg-medium)]/40 p-6 md:p-8">
            <h2 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
              <Icon name={p.intro.icon} class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              {p.intro.h2}
            </h2>
            <div class="space-y-3 text-[var(--color-text-on-dark)] leading-relaxed">
              <p>{p.intro.lead}</p>
              <ul class="list-disc ml-6 space-y-1.5 text-[var(--color-text-on-dark)]">
                {p.intro.data_categories.map((d) => (
                  <li><strong>{d.label}</strong> {d.desc}</li>
                ))}
              </ul>
              <p class="text-sm text-[var(--color-text-on-dark-muted)] italic">
                {p.intro.api_note_prefix} <code class="text-[var(--color-gold-light)]">{p.intro.api_note_endpoint}</code>{p.intro.api_note_suffix}
              </p>
            </div>
          </section>

          <!-- 2) Graf 1992–2025 (recyklován z minule-rocniky) -->
          {grafChapter && (
            <section id="graf-ucastniku" class="border border-[var(--color-gold-darkest)] bg-[var(--color-bg-medium)]/40 p-6 md:p-8">
              <h2 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
                <Icon name={grafChapter.icon || 'lucide:line-chart'} class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
                {grafChapter.title}
              </h2>
              <div class="era-body" set:html={grafChapter.body_html} />
              <p class="mt-4 text-sm text-[var(--color-text-on-dark-muted)] italic">
                {p.graf_section.after_note_prefix} <a href={`/${lang}/minule-rocniky/`} class="text-[var(--color-gold-light)] underline hover:text-[var(--color-gold)]">{p.graf_section.after_note_link_label}</a>.
              </p>
            </section>
          )}

          <!-- 3) Karty pro ročníky -->
          <section>
            <h2 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-3">
              <Icon name={p.cards_section.icon} class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              {p.cards_section.h2}
            </h2>
            <p class="text-[var(--color-text-on-dark-muted)] mb-6 max-w-2xl">
              {p.cards_section.lead}
            </p>
            <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
              {p.cards_section.cards.map((c) => (
                <a
                  href={`/${lang}/minule-rocniky/statistiky/${c.slug}/`}
                  class="group block border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] bg-[var(--color-bg-medium)]/30 hover:bg-[var(--color-bg-medium)]/60 p-5 md:p-6 transition-all"
                  style={`border-top: 4px solid var(${c.accent_var})`}
                >
                  <div class="flex items-start gap-4">
                    <Icon name={c.icon} class="w-7 h-7 text-[var(--color-gold)] flex-shrink-0 mt-0.5" aria-hidden="true" />
                    <div class="min-w-0">
                      <h3 class="font-[family-name:var(--font-display)] text-base md:text-lg uppercase tracking-widest text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)] mb-2 leading-tight">
                        {c.title}
                      </h3>
                      <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
                        {c.desc}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>

        </div>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/statistiky-sidebar';
  </script>
</BaseLayout>

<style is:global>
  /* Subset era-body styles pro recyklovaný graf chapter */
  .era-body p { margin: 0.75rem 0; line-height: 1.7; color: var(--color-text-on-dark); }
  .era-body p:first-child { margin-top: 0; }
  .era-body p:last-child { margin-bottom: 0; }
  .era-body strong { color: var(--color-gold-light); font-weight: 600; }
  .era-body h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }
  .era-body .era-chart {
    margin: 1rem 0 1.25rem;
    border: 1px solid var(--color-gold-darkest);
    background: color-mix(in srgb, var(--color-bg-darkest) 60%, transparent);
    padding: 1rem;
  }
  .era-body .era-chart img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  .era-body .era-chart figcaption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text-on-dark-muted);
    line-height: 1.5;
    font-style: italic;
    text-align: center;
  }
  .era-body .era-note {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--color-gold-darkest);
    font-size: 0.85rem;
    color: var(--color-text-on-dark-muted);
  }
</style>
