---
/**
 * Srovnání ročníků 2024 / 2025 / 2026.
 * URL: /<lang>/minule-rocniky/statistiky/srovnani/
 * Datum: 2026-05-12 (revize — i18n přes content collection)
 *
 * Obsah: src/content/pages/minule-rocniky/statistiky/srovnani/{lang}.json
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';
import '@styles/registration.css';

interface SrovnaniPage {
  meta: { title: string; description: string };
  breadcrumb: { minule_rocniky: string; demografie: string; comparison: string };
  hero: { h1: string; lead: string };
  sidebar_aria: string;
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<SrovnaniPage>('minule-rocniky/statistiky/srovnani', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: p.breadcrumb.minule_rocniky, href: `/${lang}/minule-rocniky/` },
  { label: p.breadcrumb.demografie, href: `/${lang}/minule-rocniky/statistiky/` },
  { label: p.breadcrumb.comparison },
];
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  lang={lang}
  breadcrumbs={[
    { name: p.breadcrumb.minule_rocniky, href: `/${lang}/minule-rocniky/` },
    { name: p.breadcrumb.demografie, href: `/${lang}/minule-rocniky/statistiky/` },
    { name: p.breadcrumb.comparison, href: `/${lang}/minule-rocniky/statistiky/srovnani/` },
  ]}
>
  <section class="py-8 md:py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4 leading-tight">
        {p.hero.h1}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-base sm:text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {p.hero.lead}
      </p>
    </div>
  </section>

  <section class="py-6 sm:py-8 lg:py-10 bg-[var(--color-bg-dark)]" data-lang={lang}>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-6 lg:gap-12 items-start lg:min-h-[calc(100vh-12rem)]">
        <MobileSidebarShell
          asideId="statistiky-sidebar"
          tabLabel={t('sidebar.tab_menu')}
          tabIcon="lucide:menu"
          ariaLabel={p.sidebar_aria}
          asideClass="reg-sidebar"
        ></MobileSidebarShell>
        <div
          id="srovnani-app"
          class="min-w-0"
          data-event-slug="PP2026"
          data-lang={lang}
        >
          <div class="reg-loading">{t('loading.compare')}</div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/statistiky-sidebar';
    import { initSrovnani } from '@scripts/registration/srovnani';
    initSrovnani('#srovnani-app');
  </script>
</BaseLayout>
