---
/**
 * Srovnání ročníků Pán Prstenů 2024 / 2025 / 2026.
 * URL: /<lang>/minule-rocniky/statistiky/srovnani/
 * Datum: 2026-05-12
 *
 * Fetchuje 3× /api/v1/events/PP{rok}/stats paralelně a vykresluje
 * mezi-ročníkové srovnání (KPI, trendy, slope chart, pyramidy vedle sebe).
 *
 * Sidebar — "Demografie účastníků" se 4 položkami, sdílený init script
 * @scripts/statistiky-sidebar (active item = "Srovnání ročníků").
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import '@styles/registration.css';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Minulé ročníky', href: `/${lang}/minule-rocniky/` },
  { label: 'Demografie účastníků', href: `/${lang}/minule-rocniky/statistiky/` },
  { label: 'Srovnání ročníků' },
];
---

<BaseLayout
  title="Srovnání ročníků 2024–2026 — Pán Prstenů"
  description="Mezi-ročníkové srovnání demografie účastníků larpu Pán Prstenů: růst účasti, posuny v armádách, věku, pohlaví, zbraních a registračních dynamikách 2024, 2025, 2026."
  lang={lang}
>
  <section class="py-8 md:py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4 leading-tight">
        Srovnání ročníků 2024 – 2025 – 2026
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-base sm:text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Jak se Pán Prstenů mění ročník od ročníku — kde rostou armády, kde se posouvá věk, kdo se registruje dřív.
      </p>
    </div>
  </section>

  <section class="py-6 sm:py-8 lg:py-10 bg-[var(--color-bg-dark)]">
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-6 lg:gap-12 items-start lg:min-h-[calc(100vh-12rem)]">
        <MobileSidebarShell
          asideId="statistiky-sidebar"
          tabLabel="Menu"
          tabIcon="lucide:menu"
          ariaLabel="Demografie účastníků"
          asideClass="reg-sidebar"
        ></MobileSidebarShell>
        <div
          id="srovnani-app"
          class="min-w-0"
          data-event-slug="PP2026"
        >
          <div class="reg-loading">Načítám data tří ročníků…</div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/statistiky-sidebar';
    import { initSrovnani } from '@scripts/registration/srovnani';
    initSrovnani('#srovnani-app');
  </script>
</BaseLayout>
