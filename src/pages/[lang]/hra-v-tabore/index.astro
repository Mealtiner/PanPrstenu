---
/**
 * Hra v táboře
 * URL: /cs/hra-v-tabore/, …
 * Datum: 2026-05-03
 *
 * Stránka, která ukazuje, že akce není jen sobotní bitva, ale celý víkend
 * ve Středozemi. Mince + ekonomika, tábořiště po armádách, páteční vlajkovaná,
 * táborový život, mikro questy, dětská hra (teaser).
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const tp = getPageContent('hra-v-tabore', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: tp('bc_label') },
];

const chapters = [
  { id: 'mince',      label: tp('ch_mince'),      icon: 'lucide:coins' },
  { id: 'taboriste',  label: tp('ch_taboriste'),  icon: 'lucide:tent' },
  { id: 'vlajkovana', label: tp('ch_vlajkovana'), icon: 'lucide:flag' },
  { id: 'zivot',      label: tp('ch_zivot'),      icon: 'lucide:flame' },
  { id: 'questy',     label: tp('ch_questy'),     icon: 'lucide:scroll-text' },
];

type NewsCard = {
  icon: string;
  anchor: string;
  titleKey: string;
  descKey: string;
  audKeys: string[];
};

const novinky: NewsCard[] = [
  {
    icon: 'lucide:coins',
    anchor: '#mince',
    titleKey: 'news1_title',
    descKey: 'news1_desc',
    audKeys: ['aud_player', 'aud_newcomer', 'aud_escort'],
  },
  {
    icon: 'lucide:tent',
    anchor: '#taboriste',
    titleKey: 'news2_title',
    descKey: 'news2_desc',
    audKeys: ['aud_player', 'aud_armies', 'aud_commanders'],
  },
  {
    icon: 'lucide:flag',
    anchor: '#vlajkovana',
    titleKey: 'news3_title',
    descKey: 'news3_desc',
    audKeys: ['aud_player', 'aud_newcomer'],
  },
  {
    icon: 'lucide:flame',
    anchor: '#zivot',
    titleKey: 'news4_title',
    descKey: 'news4_desc',
    audKeys: ['aud_player', 'aud_escort', 'aud_newcomer'],
  },
  {
    icon: 'lucide:scroll-text',
    anchor: '#questy',
    titleKey: 'news5_title',
    descKey: 'news5_desc',
    audKeys: ['aud_player', 'aud_newcomer'],
  },
  {
    icon: 'lucide:baby',
    anchor: '#deti',
    titleKey: 'news6_title',
    descKey: 'news6_desc',
    audKeys: ['aud_parent', 'aud_children'],
  },
];
---

<BaseLayout
  title={tp('meta_title')}
  description={tp('description')}
  lang={lang}
  breadcrumbs={[{ name: tp('bc_label'), href: `/${lang}/hra-v-tabore/` }]}
>

  <!-- Hero -->
  <section class="py-16 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {tp('title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {tp('subtitle')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mt-4 max-w-3xl">
        {tp('intro_p1')}
      </p>
    </div>
  </section>

  <!-- 60 sekund + karty novinek (sjednoceno s /pro-novacky/, /pravidla/, /frakce/ — 2026-05-04) -->
  <section class="py-10 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base max-w-4xl">
      <div class="border-2 border-[var(--color-gold)] bg-[var(--color-bg-medium)]/40 p-6 md:p-8">
        <h2 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
          <Icon name="lucide:zap" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
          {tp('h_60s')}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-[var(--color-text-on-dark)]">
          <li class="flex items-start gap-2"><span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span><span>{tp('s60_l1')}</span></li>
          <li class="flex items-start gap-2"><span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span><span>{tp('s60_l2')}</span></li>
          <li class="flex items-start gap-2"><span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span><span>{tp('s60_l3')}</span></li>
          <li class="flex items-start gap-2"><span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span><span>{tp('s60_l4')}</span></li>
          <li class="flex items-start gap-2"><span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span><span>{tp('s60_l5')}</span></li>
          <li class="flex items-start gap-2"><span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span><span>{tp('s60_l6_pre')}<a href={`/${lang}/detska-hra/`} class="underline text-[var(--color-gold-light)]">{tp('s60_l6_link')}</a>{tp('s60_l6_post')}</span></li>
          <li class="flex items-start gap-2"><span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span><span><strong>{tp('s60_l7_strong')}</strong>{tp('s60_l7_post')}</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container-base max-w-5xl">

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 text-center">
        {tp('h_news')}
      </h2>
      <Divider variant="line-diamond" tone="dark" class="mb-8" />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {novinky.map((n) => (
          <a
            href={n.anchor}
            class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)]"
          >
            <div class="flex items-center gap-3 mb-3">
              <Icon name={n.icon} class="w-7 h-7 text-[var(--color-gold)] group-hover:text-[var(--color-gold-light)] transition-colors" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)]">
                {tp(n.titleKey)}
              </h3>
            </div>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {tp(n.descKey)}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {n.audKeys.map((a) => (
                <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-on-dark-muted)] border border-[var(--color-gold-darkest)] px-1.5 py-0.5">
                  {tp(a)}
                </span>
              ))}
            </div>
            <div class="mt-3 text-xs uppercase tracking-wider text-[var(--color-gold-light)] group-hover:underline inline-flex items-center gap-1">
              {tp('read_more')}
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Divider variant="line-diamond" tone="dark" class="my-4" />

  <!-- Detailní sekce -->
  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title={tp('toc_title')} ariaLabel={tp('toc_aria')} />
        <article class="min-w-0 max-w-3xl">

      <!-- MINCE -->
      <h2 id="mince" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:coins" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {tp('mince_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('mince_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('mince_p2')}
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {tp('mince_h_use')}
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {tp('mince_use_intro')}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>{tp('mince_l1')}</li>
        <li>{tp('mince_l2')}</li>
        <li>{tp('mince_l3')}</li>
        <li>{tp('mince_l4')}</li>
        <li>{tp('mince_l5')}</li>
        <li>{tp('mince_l6')}</li>
        <li>{tp('mince_l7')}</li>
        <li>{tp('mince_l8')}</li>
      </ul>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed italic mb-4">
        {tp('mince_use_note')}
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {tp('mince_h_pub')}
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('mince_pub_p_pre')}<strong>{tp('mince_pub_p_strong')}</strong>{tp('mince_pub_p_post')}
      </p>
      <AlertBox variant="warning" title={tp('mince_alert_title')} class="mb-6">
        {tp('mince_alert_pre')}<strong>{tp('mince_alert_strong')}</strong>{tp('mince_alert_post')}
      </AlertBox>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {tp('mince_h_more')}
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {tp('mince_more_intro')}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li>{tp('mince_more_l1')}</li>
        <li>{tp('mince_more_l2')}</li>
        <li>{tp('mince_more_l3')}</li>
        <li>{tp('mince_more_l4')}</li>
        <li>{tp('mince_more_l5')}</li>
        <li>{tp('mince_more_l6')}</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- TÁBOŘIŠTĚ -->
      <h2 id="taboriste" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:tent" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {tp('tab_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('tab_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('tab_p2')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('tab_p3_pre')}<strong class="text-[var(--color-side-free-text)]">{tp('tab_p3_free')}</strong>{tp('tab_p3_mid')}<strong class="text-[var(--color-side-evil-text)]">{tp('tab_p3_evil')}</strong>{tp('tab_p3_post')}
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {tp('tab_h_pract')}
      </h3>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>{tp('tab_l1')}</li>
        <li>{tp('tab_l2')}</li>
        <li>{tp('tab_l3')}</li>
        <li>{tp('tab_l4')}</li>
        <li>{tp('tab_l5')}</li>
        <li>{tp('tab_l6')}</li>
      </ul>
      <AlertBox variant="info" class="mb-4">
        {tp('tab_alert')}
      </AlertBox>
      <AlertBox variant="info" class="mb-8">
        <span set:html={tp('tab_alert_rental')} />
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- VLAJKOVANÁ -->
      <h2 id="vlajkovana" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:flag" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {tp('vl_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('vl_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('vl_p2')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{tp('vl_intro')}</p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>{tp('vl_l1')}</li>
        <li>{tp('vl_l2')}</li>
        <li>{tp('vl_l3')}</li>
        <li>{tp('vl_l4')}</li>
        <li>{tp('vl_l5')}</li>
        <li>{tp('vl_l6')}</li>
      </ul>
      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mb-8">
        {tp('vl_note')}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- TÁBOROVÝ ŽIVOT -->
      <h2 id="zivot" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:flame" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {tp('z_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('z_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {tp('z_intro')}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>{tp('z_l1')}</li>
        <li>{tp('z_l2')}</li>
        <li>{tp('z_l3')}</li>
        <li>{tp('z_l4')}</li>
        <li>{tp('z_l5')}</li>
        <li>{tp('z_l6')}</li>
        <li>{tp('z_l7')}</li>
        <li>{tp('z_l8')}</li>
      </ul>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {tp('z_h_inspire')}
      </h3>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6 columns-1 sm:columns-2">
        <li>{tp('z_i1')}</li>
        <li>{tp('z_i2')}</li>
        <li>{tp('z_i3')}</li>
        <li>{tp('z_i4')}</li>
        <li>{tp('z_i5')}</li>
        <li>{tp('z_i6')}</li>
        <li>{tp('z_i7')}</li>
        <li>{tp('z_i8')}</li>
        <li>{tp('z_i9')}</li>
        <li>{tp('z_i10')}</li>
        <li>{tp('z_i11')}</li>
      </ul>

      <!-- Box: Chci se zapojit, ale nevím jak -->
      <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 mb-8">
        <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
          <Icon name="lucide:help-circle" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
          {tp('z_box_title')}
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
          <li>{tp('z_box_l1')}</li>
          <li>{tp('z_box_l2')}</li>
          <li>{tp('z_box_l3')}</li>
          <li>{tp('z_box_l4')}</li>
          <li>{tp('z_box_l5')}</li>
          <li>{tp('z_box_l6')}</li>
          <li>{tp('z_box_l7')}</li>
        </ul>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- MIKRO QUESTY -->
      <h2 id="questy" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:scroll-text" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {tp('q_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('q_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{tp('q_intro')}</p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>{tp('q_l1')}</li>
        <li>{tp('q_l2')}</li>
        <li>{tp('q_l3')}</li>
        <li>{tp('q_l4')}</li>
        <li>{tp('q_l5')}</li>
        <li>{tp('q_l6')}</li>
        <li>{tp('q_l7')}</li>
        <li>{tp('q_l8')}</li>
      </ul>
      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mb-8">
        {tp('q_note')}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- DĚTI teaser -->
      <div id="deti" class="scroll-mt-24 bg-[var(--color-bg-darkest)] border-2 border-[var(--color-gold-darkest)] p-6 md:p-8 mb-10">
        <div class="flex items-center gap-3 mb-3">
          <Icon name="lucide:baby" class="w-8 h-8 text-[var(--color-gold)]" aria-hidden="true" />
          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)]">
            {tp('ki_h')}
          </h2>
        </div>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          {tp('ki_p1_pre')}<strong class="text-[var(--color-gold-light)]">{tp('ki_p1_strong')}</strong>{tp('ki_p1_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {tp('ki_p2')}
        </p>
        <Button href={`/${lang}/detska-hra/`} variant="primary" size="md">{tp('ki_btn')}</Button>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- Závěr -->
      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        {tp('end_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('end_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('end_p2')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6 italic">
        {tp('end_p3')}
      </p>

      <div class="flex flex-wrap gap-3 mt-8">
        <Button href={`/${lang}/registrace/`} variant="primary" size="md">{tp('btn_register')}</Button>
        <Button href={`/${lang}/prakticke-info/`} variant="secondary" size="md">{tp('btn_practical')}</Button>
        <Button href={`/${lang}/pro-novacky/`} variant="ghost" size="md">{tp('btn_newcomer')}</Button>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-12 italic">
        {tp('footnote')}
      </p>

        </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

</BaseLayout>
