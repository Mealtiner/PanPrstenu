---
/**
 * Hra v táboře
 * URL: /cs/hra-v-tabore/, …
 * Datum: 2026-04-30
 *
 * Stránka, která ukazuje, že akce není jen sobotní bitva, ale celý víkend
 * ve Středozemi. Mince + ekonomika, tábořiště po armádách, páteční vlajkovaná,
 * táborový život, mikro questy, dětská hra (teaser).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Hra v táboře' },
];

const chapters = [
  { id: 'mince',      label: 'Mince a ekonomika',     icon: 'lucide:coins' },
  { id: 'taboriste',  label: 'Tábořiště po armádách', icon: 'lucide:tent' },
  { id: 'vlajkovana', label: 'Páteční vlajkovaná',    icon: 'lucide:flag' },
  { id: 'zivot',      label: 'Táborový život',        icon: 'lucide:flame' },
  { id: 'questy',     label: 'Mikro questy',          icon: 'lucide:scroll-text' },
];

const novinky = [
  {
    icon: 'lucide:coins',
    anchor: '#mince',
    title: 'Mince a ekonomika',
    desc: 'Hry, sázky, služby, obchodování. Mince oživí táborový život.',
    audiences: ['hráč', 'nováček', 'doprovod'],
  },
  {
    icon: 'lucide:tent',
    anchor: '#taboriste',
    title: 'Tábořiště po armádách',
    desc: 'Dělící linie mezi světlou a temnou stranou. Armády spolu.',
    audiences: ['hráč', 'armády', 'velitelé'],
  },
  {
    icon: 'lucide:flag',
    anchor: '#vlajkovana',
    title: 'Páteční vlajkovaná',
    desc: 'Týmová hra v táboře. Kratší formát, vhodné i pro nováčky.',
    audiences: ['hráč', 'nováček'],
  },
  {
    icon: 'lucide:flame',
    anchor: '#zivot',
    title: 'Táborový život',
    desc: 'Obchody, bardi, žoldnéři, věštkyně. Nejlepší vznikne mezi vámi.',
    audiences: ['hráč', 'doprovod', 'nováček'],
  },
  {
    icon: 'lucide:scroll-text',
    anchor: '#questy',
    title: 'Mikro questy',
    desc: 'Drobné úkoly: doruč zprávu, vyhraj sázku, najdi člověka.',
    audiences: ['hráč', 'nováček'],
  },
  {
    icon: 'lucide:baby',
    anchor: '#deti',
    title: 'Hra pro malé dobrodruhy',
    desc: 'Samostatný program pro děti 5–9 let. Vlastní dobrodružství.',
    audiences: ['rodič', 'děti'],
  },
];
---

<BaseLayout
  title="Hra v táboře — mince, questy, páteční program a táborový život"
  description="Pán Prstenů 2026 není jen sobotní bitva. Přijeď už ve čtvrtek nebo v pátek a zažij táborový život ve Středozemi: mince, obchodování, drobné questy, páteční hru, frakční ležení a program pro malé dobrodruhy."
  lang={lang}
  breadcrumbs={[{ name: 'Hra v táboře', href: `/${lang}/hra-v-tabore/` }]}
>

  <!-- Hero -->
  <section class="py-16 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        Hra v táboře
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        Přijeď dřív. Středozem začne už v táboře.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mt-4 max-w-3xl">
        Pán Prstenů není jen sobotní bitva. Chceme, aby se tábořiště už od příjezdu
        měnilo v kus Středozemě — s vlastní atmosférou, armádami, ohni, obchodováním,
        zpěvem, drobnými hrami, službami, questy a setkáváními. Pro ročník 2026
        připravujeme několik novinek, které mají hraní mimo hlavní bitvu podpořit.
      </p>
    </div>
  </section>

  <!-- 60 sekund + karty novinek -->
  <section class="py-12">
    <div class="container-base max-w-5xl">
      <div class="bg-[var(--color-bg-darkest)] border-2 border-[var(--color-gold)] p-6 mb-10">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
          <span class="text-[var(--color-gold)]">━ ◆</span>
          Nejdůležitější v 60 sekundách
          <span class="text-[var(--color-gold)]">◆ ━</span>
        </h2>
        <ul class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 list-disc list-inside text-sm md:text-base">
          <li>Každý účastník dostane při registraci určitý počet herních mincí.</li>
          <li>Mince půjde využít pro drobné hry, sázky, služby, obchodování a atmosférické hraní v táboře.</li>
          <li>Tábořiště chceme rozdělit více podle armád a stran.</li>
          <li>Pátek bude věnovaný hře v tábořišti, doprovodnému programu, arénám, vlajkované a dětské hře.</li>
          <li>Budou vznikat mikro osobní questy a drobné úkoly.</li>
          <li>Pro děti připravujeme samostatnou
            <a href={`/${lang}/detska-hra/`} class="underline text-[var(--color-gold-light)]">hru pro malé dobrodruhy</a>.</li>
          <li><strong>Nic z toho nebude fungovat bez vás.</strong> Táborový život vznikne jen tehdy, když si budete chtít hrát.</li>
        </ul>
      </div>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 text-center">
        Co připravujeme
      </h2>
      <Divider variant="line-diamond" tone="dark" class="mb-8" />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {novinky.map((n) => (
          <a
            href={n.anchor}
            class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)]"
          >
            <div class="flex items-center gap-3 mb-3">
              <Icon name={n.icon} class="w-7 h-7 text-[var(--color-gold)] group-hover:text-[var(--color-gold-light)] transition-colors" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)]">
                {n.title}
              </h3>
            </div>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {n.desc}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {n.audiences.map((a) => (
                <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-on-dark-muted)] border border-[var(--color-gold-darkest)] px-1.5 py-0.5">
                  {a}
                </span>
              ))}
            </div>
            <div class="mt-3 text-xs uppercase tracking-wider text-[var(--color-gold-light)] group-hover:underline inline-flex items-center gap-1">
              Číst dál
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Divider variant="line-diamond" tone="dark" class="my-4" />

  <!-- Detailní sekce -->
  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title="Obsah stránky" ariaLabel="Obsah Hra v táboře" />
        <article class="min-w-0 max-w-3xl">

      <!-- MINCE -->
      <h2 id="mince" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:coins" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        Mince a ekonomika v táboře
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Každý účastník dostane na začátku akce určitý počet herních mincí.
        Připravujeme více druhů mincí tak, aby zapadaly do různých národů a ras
        Středozemě.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        V základu počítáme s jednoduchým kurzem 1:1 mezi jednotlivými druhy
        mincí. Ale Středozemě není účetní tabulka. Bude na vás, jestli tento kurz
        udržíte, nebo si mezi sebou začnete vytvářet vlastní hodnotu, dohody
        a obchodní zvyklosti.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        K čemu mince budou
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Mince mají sloužit hlavně jako podpora táborového života. Můžete je
        použít například:
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>při hospodských hrách,</li>
        <li>jako zápisné do soutěží,</li>
        <li>při sázkách na arény a turnaje,</li>
        <li>při obchodování mezi účastníky,</li>
        <li>jako odměnu za služby,</li>
        <li>při zadávání drobných úkolů,</li>
        <li>při plnění mikro questů,</li>
        <li>za drobné upomínkové předměty.</li>
      </ul>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed italic mb-4">
        Chcete dřevo k ohni? Najměte si někoho, kdo vám pomůže. Chcete bardov
        u ohně? I bardové neživí jen ze slávy. Chcete si zastřílet z luku
        v elfském táboře? Možná vás to bude něco stát. Chcete si objednat noční
        ostrahu? Žoldnéři mají také své světské potřeby.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        Mince a hospoda
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Počítáme také s možností využívat mince jako herní prvek při domluvě
        s hospodou <strong>U Zeleného draka</strong>. Přesné podmínky a rozsah
        použití ještě upřesníme.
      </p>
      <AlertBox variant="warning" title="Mince nejsou oficiální měna" class="mb-6">
        Herní mince <strong>nejsou běžné platidlo ani nárokovatelná sleva</strong>.
        Jsou to herní předměty určené k oživení táborového života. Jejich využití
        v hospodě, u organizátorů nebo v konkrétních aktivitách se bude řídit
        domluvou a pravidly akce.
      </AlertBox>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        Jak získám další mince
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Základní počet mincí získá každý účastník při registraci na místě. Další
        mince můžete získat například:
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li>plněním mikro questů,</li>
        <li>účastí v arénách, turnajích a hrách,</li>
        <li>nabízením služeb ostatním hráčům,</li>
        <li>obchodováním,</li>
        <li>pomocí organizátorům při chystání,</li>
        <li>vlastní tvořivostí a zapojením do táborového života.</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- TÁBOŘIŠTĚ -->
      <h2 id="taboriste" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:tent" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        Rozdělení tábořiště po armádách
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        V posledních letech se tábořiště výrazně proměnilo. Historických stanů,
        tematických přístřešků a dobově laděných ležení přibylo tolik, že už
        nejde jen o malý doplněk někde na kraji louky.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Zároveň stále častěji slyšíme od skupin, panovníků a velitelů, že chtějí
        být pohromadě se svou armádou. Chtějí mít společný oheň, domlouvat se,
        hrát táborový život, secvičovat a tvořit atmosféru své strany.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Proto chceme tábořiště pro ročník 2026 více rozdělit podle armád a stran.
        Dělící cesta / linie bude přirozeně mezi <strong class="text-[var(--color-side-free-text)]">Svobodnými národy</strong>
        a <strong class="text-[var(--color-side-evil-text)]">Silami temna</strong>.
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        Co to znamená prakticky
      </h3>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>Armády a skupiny by měly mít větší šanci tábořit pohromadě.</li>
        <li>Tábor se víc promění v herní prostor.</li>
        <li>Bude snazší hrát frakční život.</li>
        <li>Dobové a tematické stany budou stále vítané.</li>
        <li>Moderní stany doporučujeme co nejvíc maskovat plachtami, látkou nebo nerušivým umístěním.</li>
        <li>Pokud máte možnost pořídit nebo půjčit historický stan, velmi to pomůže atmosféře.</li>
      </ul>
      <AlertBox variant="info" class="mb-8">
        Tábořiště chceme letos vnímat jako součást hry. Nejde jen o to, kde
        přespíte. Jde o to, aby se už od příjezdu začal tvořit pocit armádního
        ležení ve Středozemi.
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- VLAJKOVANÁ -->
      <h2 id="vlajkovana" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:flag" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        Páteční hra / vlajkovaná
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pátek nebude jen čekání na sobotní bitvu. Chceme, aby se už v pátek hrálo.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Připravujeme páteční hru v tábořišti, jejíž součástí bude vlajkovaná
        a další doprovodné aktivity. Cílem není vytvořit druhou hlavní bitvu —
        cílem je rozhýbat tábor, zapojit armády, podpořit atmosféru a dát
        účastníkům důvod přijet dřív.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Pracovní popis:</p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>jednoduchá týmová hra v tábořišti nebo jeho okolí,</li>
        <li>zapojení armád,</li>
        <li>vhodné i pro nováčky,</li>
        <li>kratší formát než sobotní bitva,</li>
        <li>důraz na pohyb, spolupráci a atmosféru,</li>
        <li>bez nutnosti znát celý sobotní scénář.</li>
      </ul>
      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mb-8">
        Přesná pravidla, časy a způsob zapojení doplníme během června.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- TÁBOROVÝ ŽIVOT -->
      <h2 id="zivot" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:flame" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        Hraní táborového života
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Táborový život nejsou jen organizátorské aktivity. Nejlepší věci často
        vzniknou mezi účastníky.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Chceme vás podpořit, abyste v táboře:
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>obchodovali,</li>
        <li>nabízeli služby,</li>
        <li>pořádali drobné hry,</li>
        <li>zpívali,</li>
        <li>vyjednávali,</li>
        <li>najímali se navzájem,</li>
        <li>tvořili malé příběhy,</li>
        <li>hráli svou postavu i mimo bojiště.</li>
      </ul>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        Inspirace na drobné podniky
      </h3>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6 columns-1 sm:columns-2">
        <li>trpasličí výčep u ohně,</li>
        <li>skřetí lázně,</li>
        <li>elfská střelnice,</li>
        <li>haradský obchod s kořením,</li>
        <li>bard na objednávku,</li>
        <li>žoldnéřská ochranka,</li>
        <li>věštkyně,</li>
        <li>lovec zpráv,</li>
        <li>nosič vody,</li>
        <li>vypravěč příběhů,</li>
        <li>písař smluv a sázek.</li>
      </ul>

      <!-- Box: Chci se zapojit, ale nevím jak -->
      <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 mb-8">
        <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
          <Icon name="lucide:help-circle" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
          Chci se zapojit, ale nevím jak
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
          <li>přijď za svou armádou,</li>
          <li>zeptej se panovníka / velitele,</li>
          <li>vezmi si mikro quest,</li>
          <li>nabídni službu,</li>
          <li>zapoj se do hry nebo arény,</li>
          <li>přijď k ohni,</li>
          <li>neboj se začít malou věcí.</li>
        </ul>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- MIKRO QUESTY -->
      <h2 id="questy" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:scroll-text" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        Mikro osobní questy
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Připravujeme také drobné osobní questy. Nemají nahradit hlavní hru. Mají
        doplnit atmosféru a dát účastníkům malé důvody pro interakci.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Může jít například o:</p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>doručení zprávy,</li>
