---
/**
 * Hra v táboře
 * URL: /cs/hra-v-tabore/, …
 * Datum: 2026-05-03
 *
 * Stránka, která ukazuje, že akce není jen sobotní bitva, ale celý víkend
 * ve Středozemi. Mince + ekonomika, tábořiště po armádách, páteční vlajkovaná,
 * táborový život, mikro questy, dětská hra (teaser).
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { Icon } from 'astro-icon/components';
import type { Lang, TranslationKey } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.camp_life.bc_label') },
];

const chapters = [
  { id: 'mince',      label: t('page.camp_life.ch_mince'),      icon: 'lucide:coins' },
  { id: 'taboriste',  label: t('page.camp_life.ch_taboriste'),  icon: 'lucide:tent' },
  { id: 'vlajkovana', label: t('page.camp_life.ch_vlajkovana'), icon: 'lucide:flag' },
  { id: 'zivot',      label: t('page.camp_life.ch_zivot'),      icon: 'lucide:flame' },
  { id: 'questy',     label: t('page.camp_life.ch_questy'),     icon: 'lucide:scroll-text' },
];

type NewsCard = {
  icon: string;
  anchor: string;
  titleKey: TranslationKey;
  descKey: TranslationKey;
  audKeys: TranslationKey[];
};

const novinky: NewsCard[] = [
  {
    icon: 'lucide:coins',
    anchor: '#mince',
    titleKey: 'page.camp_life.news1_title',
    descKey: 'page.camp_life.news1_desc',
    audKeys: ['page.camp_life.aud_player', 'page.camp_life.aud_newcomer', 'page.camp_life.aud_escort'],
  },
  {
    icon: 'lucide:tent',
    anchor: '#taboriste',
    titleKey: 'page.camp_life.news2_title',
    descKey: 'page.camp_life.news2_desc',
    audKeys: ['page.camp_life.aud_player', 'page.camp_life.aud_armies', 'page.camp_life.aud_commanders'],
  },
  {
    icon: 'lucide:flag',
    anchor: '#vlajkovana',
    titleKey: 'page.camp_life.news3_title',
    descKey: 'page.camp_life.news3_desc',
    audKeys: ['page.camp_life.aud_player', 'page.camp_life.aud_newcomer'],
  },
  {
    icon: 'lucide:flame',
    anchor: '#zivot',
    titleKey: 'page.camp_life.news4_title',
    descKey: 'page.camp_life.news4_desc',
    audKeys: ['page.camp_life.aud_player', 'page.camp_life.aud_escort', 'page.camp_life.aud_newcomer'],
  },
  {
    icon: 'lucide:scroll-text',
    anchor: '#questy',
    titleKey: 'page.camp_life.news5_title',
    descKey: 'page.camp_life.news5_desc',
    audKeys: ['page.camp_life.aud_player', 'page.camp_life.aud_newcomer'],
  },
  {
    icon: 'lucide:baby',
    anchor: '#deti',
    titleKey: 'page.camp_life.news6_title',
    descKey: 'page.camp_life.news6_desc',
    audKeys: ['page.camp_life.aud_parent', 'page.camp_life.aud_children'],
  },
];
---

<BaseLayout
  title={t('page.camp_life.meta_title')}
  description={t('page.camp_life.description')}
  lang={lang}
  breadcrumbs={[{ name: t('page.camp_life.bc_label'), href: `/${lang}/hra-v-tabore/` }]}
>

  <!-- Hero -->
  <section class="py-16 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.camp_life.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {t('page.camp_life.subtitle')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mt-4 max-w-3xl">
        {t('page.camp_life.intro_p1')}
      </p>
    </div>
  </section>

  <!-- 60 sekund + karty novinek -->
  <section class="py-12">
    <div class="container-base max-w-5xl">
      <div class="bg-[var(--color-bg-darkest)] border-2 border-[var(--color-gold)] p-6 mb-10">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
          <span class="text-[var(--color-gold)]">━ ◆</span>
          {t('page.camp_life.h_60s')}
          <span class="text-[var(--color-gold)]">◆ ━</span>
        </h2>
        <ul class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 list-disc list-inside text-sm md:text-base">
          <li>{t('page.camp_life.s60_l1')}</li>
          <li>{t('page.camp_life.s60_l2')}</li>
          <li>{t('page.camp_life.s60_l3')}</li>
          <li>{t('page.camp_life.s60_l4')}</li>
          <li>{t('page.camp_life.s60_l5')}</li>
          <li>{t('page.camp_life.s60_l6_pre')}<a href={`/${lang}/detska-hra/`} class="underline text-[var(--color-gold-light)]">{t('page.camp_life.s60_l6_link')}</a>{t('page.camp_life.s60_l6_post')}</li>
          <li><strong>{t('page.camp_life.s60_l7_strong')}</strong>{t('page.camp_life.s60_l7_post')}</li>
        </ul>
      </div>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 text-center">
        {t('page.camp_life.h_news')}
      </h2>
      <Divider variant="line-diamond" tone="dark" class="mb-8" />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {novinky.map((n) => (
          <a
            href={n.anchor}
            class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)]"
          >
            <div class="flex items-center gap-3 mb-3">
              <Icon name={n.icon} class="w-7 h-7 text-[var(--color-gold)] group-hover:text-[var(--color-gold-light)] transition-colors" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)]">
                {t(n.titleKey)}
              </h3>
            </div>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {t(n.descKey)}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {n.audKeys.map((a) => (
                <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-on-dark-muted)] border border-[var(--color-gold-darkest)] px-1.5 py-0.5">
                  {t(a)}
                </span>
              ))}
            </div>
            <div class="mt-3 text-xs uppercase tracking-wider text-[var(--color-gold-light)] group-hover:underline inline-flex items-center gap-1">
              {t('page.camp_life.read_more')}
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Divider variant="line-diamond" tone="dark" class="my-4" />

  <!-- Detailní sekce -->
  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title={t('page.camp_life.toc_title')} ariaLabel={t('page.camp_life.toc_aria')} />
        <article class="min-w-0 max-w-3xl">

      <!-- MINCE -->
      <h2 id="mince" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:coins" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {t('page.camp_life.mince_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.mince_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.mince_p2')}
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {t('page.camp_life.mince_h_use')}
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {t('page.camp_life.mince_use_intro')}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>{t('page.camp_life.mince_l1')}</li>
        <li>{t('page.camp_life.mince_l2')}</li>
        <li>{t('page.camp_life.mince_l3')}</li>
        <li>{t('page.camp_life.mince_l4')}</li>
        <li>{t('page.camp_life.mince_l5')}</li>
        <li>{t('page.camp_life.mince_l6')}</li>
        <li>{t('page.camp_life.mince_l7')}</li>
        <li>{t('page.camp_life.mince_l8')}</li>
      </ul>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed italic mb-4">
        {t('page.camp_life.mince_use_note')}
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {t('page.camp_life.mince_h_pub')}
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.mince_pub_p_pre')}<strong>{t('page.camp_life.mince_pub_p_strong')}</strong>{t('page.camp_life.mince_pub_p_post')}
      </p>
      <AlertBox variant="warning" title={t('page.camp_life.mince_alert_title')} class="mb-6">
        {t('page.camp_life.mince_alert_pre')}<strong>{t('page.camp_life.mince_alert_strong')}</strong>{t('page.camp_life.mince_alert_post')}
      </AlertBox>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {t('page.camp_life.mince_h_more')}
      </h3>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {t('page.camp_life.mince_more_intro')}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li>{t('page.camp_life.mince_more_l1')}</li>
        <li>{t('page.camp_life.mince_more_l2')}</li>
        <li>{t('page.camp_life.mince_more_l3')}</li>
        <li>{t('page.camp_life.mince_more_l4')}</li>
        <li>{t('page.camp_life.mince_more_l5')}</li>
        <li>{t('page.camp_life.mince_more_l6')}</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- TÁBOŘIŠTĚ -->
      <h2 id="taboriste" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:tent" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {t('page.camp_life.tab_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.tab_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.tab_p2')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.tab_p3_pre')}<strong class="text-[var(--color-side-free-text)]">{t('page.camp_life.tab_p3_free')}</strong>{t('page.camp_life.tab_p3_mid')}<strong class="text-[var(--color-side-evil-text)]">{t('page.camp_life.tab_p3_evil')}</strong>{t('page.camp_life.tab_p3_post')}
      </p>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {t('page.camp_life.tab_h_pract')}
      </h3>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>{t('page.camp_life.tab_l1')}</li>
        <li>{t('page.camp_life.tab_l2')}</li>
        <li>{t('page.camp_life.tab_l3')}</li>
        <li>{t('page.camp_life.tab_l4')}</li>
        <li>{t('page.camp_life.tab_l5')}</li>
        <li>{t('page.camp_life.tab_l6')}</li>
      </ul>
      <AlertBox variant="info" class="mb-8">
        {t('page.camp_life.tab_alert')}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- VLAJKOVANÁ -->
      <h2 id="vlajkovana" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:flag" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {t('page.camp_life.vl_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.vl_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.vl_p2')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{t('page.camp_life.vl_intro')}</p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>{t('page.camp_life.vl_l1')}</li>
        <li>{t('page.camp_life.vl_l2')}</li>
        <li>{t('page.camp_life.vl_l3')}</li>
        <li>{t('page.camp_life.vl_l4')}</li>
        <li>{t('page.camp_life.vl_l5')}</li>
        <li>{t('page.camp_life.vl_l6')}</li>
      </ul>
      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mb-8">
        {t('page.camp_life.vl_note')}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- TÁBOROVÝ ŽIVOT -->
      <h2 id="zivot" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:flame" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {t('page.camp_life.z_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.z_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {t('page.camp_life.z_intro')}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>{t('page.camp_life.z_l1')}</li>
        <li>{t('page.camp_life.z_l2')}</li>
        <li>{t('page.camp_life.z_l3')}</li>
        <li>{t('page.camp_life.z_l4')}</li>
        <li>{t('page.camp_life.z_l5')}</li>
        <li>{t('page.camp_life.z_l6')}</li>
        <li>{t('page.camp_life.z_l7')}</li>
        <li>{t('page.camp_life.z_l8')}</li>
      </ul>

      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-2 mt-6">
        {t('page.camp_life.z_h_inspire')}
      </h3>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6 columns-1 sm:columns-2">
        <li>{t('page.camp_life.z_i1')}</li>
        <li>{t('page.camp_life.z_i2')}</li>
        <li>{t('page.camp_life.z_i3')}</li>
        <li>{t('page.camp_life.z_i4')}</li>
        <li>{t('page.camp_life.z_i5')}</li>
        <li>{t('page.camp_life.z_i6')}</li>
        <li>{t('page.camp_life.z_i7')}</li>
        <li>{t('page.camp_life.z_i8')}</li>
        <li>{t('page.camp_life.z_i9')}</li>
        <li>{t('page.camp_life.z_i10')}</li>
        <li>{t('page.camp_life.z_i11')}</li>
      </ul>

      <!-- Box: Chci se zapojit, ale nevím jak -->
      <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 mb-8">
        <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
          <Icon name="lucide:help-circle" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
          {t('page.camp_life.z_box_title')}
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
          <li>{t('page.camp_life.z_box_l1')}</li>
          <li>{t('page.camp_life.z_box_l2')}</li>
          <li>{t('page.camp_life.z_box_l3')}</li>
          <li>{t('page.camp_life.z_box_l4')}</li>
          <li>{t('page.camp_life.z_box_l5')}</li>
          <li>{t('page.camp_life.z_box_l6')}</li>
          <li>{t('page.camp_life.z_box_l7')}</li>
        </ul>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- MIKRO QUESTY -->
      <h2 id="questy" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24 flex items-center gap-3">
        <Icon name="lucide:scroll-text" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
        {t('page.camp_life.q_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.q_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{t('page.camp_life.q_intro')}</p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
        <li>{t('page.camp_life.q_l1')}</li>
        <li>{t('page.camp_life.q_l2')}</li>
        <li>{t('page.camp_life.q_l3')}</li>
        <li>{t('page.camp_life.q_l4')}</li>
        <li>{t('page.camp_life.q_l5')}</li>
        <li>{t('page.camp_life.q_l6')}</li>
        <li>{t('page.camp_life.q_l7')}</li>
        <li>{t('page.camp_life.q_l8')}</li>
      </ul>
      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mb-8">
        {t('page.camp_life.q_note')}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- DĚTI teaser -->
      <div id="deti" class="scroll-mt-24 bg-[var(--color-bg-darkest)] border-2 border-[var(--color-gold-darkest)] p-6 md:p-8 mb-10">
        <div class="flex items-center gap-3 mb-3">
          <Icon name="lucide:baby" class="w-8 h-8 text-[var(--color-gold)]" aria-hidden="true" />
          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)]">
            {t('page.camp_life.ki_h')}
          </h2>
        </div>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
          {t('page.camp_life.ki_p1_pre')}<strong class="text-[var(--color-gold-light)]">{t('page.camp_life.ki_p1_strong')}</strong>{t('page.camp_life.ki_p1_post')}
        </p>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
          {t('page.camp_life.ki_p2')}
        </p>
        <Button href={`/${lang}/detska-hra/`} variant="primary" size="md">{t('page.camp_life.ki_btn')}</Button>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <!-- Závěr -->
      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        {t('page.camp_life.end_h')}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.end_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {t('page.camp_life.end_p2')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6 italic">
        {t('page.camp_life.end_p3')}
