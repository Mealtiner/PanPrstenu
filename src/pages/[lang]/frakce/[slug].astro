---
/**
 * Frakce — detail
 * URL: /cs/frakce/gondor/, …
 * Datum: 2026-04-29
 *
 * Generuje statickou stránku pro každou kombinaci jazyka × frakce.
 *
 * Skladba:
 *   - Hero s emblémem frakce a tagline
 *   - Sidebar s navigací mezi sourozenci
 *   - Hlavní obsah (zatím placeholder — později z content collection)
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  const factions = await getCollection('factions');
  const langs: Lang[] = ['cs', 'en', 'de', 'sk'];

  return langs.flatMap((lang) =>
    factions.map((f) => ({
      params: { lang, slug: f.id.replace(/\.ya?ml$/, '') },
      props: { faction: f, allFactions: factions },
    })),
  );
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { faction } = Astro.props;
const t = getTranslation(lang);

const data = faction.data;
const name = data.i18n[lang]?.name ?? data.i18n.cs.name;
const tagline = data.i18n[lang]?.tagline ?? data.i18n.cs.tagline;
const sideLabel = data.side === 'free' ? t('factions.free') : t('factions.evil');
const sideTone = data.side === 'free' ? 'var(--color-side-free-text)' : 'var(--color-side-evil-text)';

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title'), href: `/${lang}/frakce/` },
  { label: name },
];

const difficultyLabel = (n: number) => '◆'.repeat(n) + '◇'.repeat(5 - n);

// Lore link mapping — slug → kotva v /svet-stredozeme/narody/
const factionSlug = faction.id.replace(/\.ya?ml$/, '');
const loreAnchorMap: Record<string, string> = {
  gondor: 'dunedain',
  rohan: 'rohirim',
  elves: 'elfove',
  dwarves: 'trpaslici',
  mordor: 'skreti',
  isengard: 'skreti',
  easterlings: 'vychodnane',
};
const loreAnchor = loreAnchorMap[factionSlug] ?? '';
const loreUrl = `/${lang}/svet-stredozeme/narody/${loreAnchor ? '#' + loreAnchor : ''}`;
---

<BaseLayout
  title={`${name} — ${t('page.factions.title')}`}
  description={`${name}: ${tagline}`}
  lang={lang}
>

  <!-- Hero frakce -->
  <section
    class="relative py-16 md:py-24 overflow-hidden"
    style={`background: radial-gradient(ellipse at 70% 50%, ${data.colors[0]}50, transparent 60%), var(--color-bg-darkest)`}
  >
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol={data.emblem} size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant={data.side === 'free' ? 'green' : 'red'} size="md" class="mb-4">
            {sideLabel}
          </Tag>
          <h1
            class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3"
          >
            {name}
          </h1>
          <p
            class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl"
            style={`color:${sideTone}`}
          >
            {tagline}
          </p>

          <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-2 text-sm text-[var(--color-text-on-dark-muted)] max-w-2xl">
            <div class="flex items-center gap-2">
              <span class="text-xs uppercase tracking-widest">Pro nováčka:</span>
              <span class="text-[var(--color-gold)] tracking-widest" aria-label={`${data.difficulty_for_newcomer} z 5`}>
                {difficultyLabel(data.difficulty_for_newcomer)}
              </span>
            </div>
            {data.costume_difficulty && (
              <div class="flex items-center gap-2">
                <span class="text-xs uppercase tracking-widest">Kostým:</span>
                <span class="text-[var(--color-gold)] tracking-widest" aria-label={`${data.costume_difficulty} z 5`}>
                  {difficultyLabel(data.costume_difficulty)}
                </span>
              </div>
            )}
            {data.roleplay_difficulty && (
              <div class="flex items-center gap-2">
                <span class="text-xs uppercase tracking-widest">Roleplay:</span>
                <span class="text-[var(--color-gold)] tracking-widest" aria-label={`${data.roleplay_difficulty} z 5`}>
                  {difficultyLabel(data.roleplay_difficulty)}
                </span>
              </div>
            )}
          </div>
          {data.tags && data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {data.tags.map((tag) => (
                <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-on-dark-muted)] border border-[var(--color-gold-darkest)] px-1.5 py-0.5">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Obsah s postranní navigací -->
  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug={slug}
          currentSection={data.side}
        />

        <article class="max-w-3xl">
          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            O frakci
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
            Plný atmosférický popis frakce {name} doplníme postupně z content
            collection. Praktické informace pro registraci, kostým a roleplay
            najdete níže.
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <!-- Pro nováčky -->
          <h3 id="pro-novacky" class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
            Pro nováčky
          </h3>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {data.newbie_costume_hint
              ? data.newbie_costume_hint
              : `Frakce ${name} je vhodná, pokud tě láká její atmosféra a zvládneš si připravit základní kostým v jejích barvách a stylu.`}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Na první účast nepotřebuješ dokonalou výbavu. Důležité je, aby bylo
            poznat, ke komu patříš, aby kostým nepůsobil civilně a aby tvoje
            zbraň prošla schvalováním.
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            Začni jednoduše:
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6">
            <li>základní tunika nebo svrchní vrstva v barvách frakce,</li>
            <li>pevná nerušivá obuv,</li>
            <li>rukavice, opasek, vak nebo taštice,</li>
            <li>jednoduchá pokrývka hlavy,</li>
            <li>zbraň odpovídající pravidlům.</li>
          </ul>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6 italic">
            Pokud si nejsi jistý, zeptej se organizátorů nebo zkušenějších hráčů
            frakce. Lepší je jednoduchý, ale čistý a tematický kostým než složitá
            výbava, která do frakce nezapadá.
          </p>

          <!-- Pro koho je vhodná / nevhodná -->
          {(data.recommended_for || data.not_recommended_for) && (
            <>
              <h3 id="pro-koho" class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
                Pro koho je frakce vhodná
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                {data.recommended_for && data.recommended_for.length > 0 && (
                  <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-4">
                    <h4 class="text-xs uppercase tracking-widest text-[var(--color-gold)] mb-2 flex items-center gap-2">
                      <span aria-hidden="true">✓</span> Vhodné pro
                    </h4>
                    <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
                      {data.recommended_for.map((r) => <li>{r}</li>)}
                    </ul>
                  </div>
                )}
                {data.not_recommended_for && data.not_recommended_for.length > 0 && (
                  <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-4">
                    <h4 class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)] mb-2 flex items-center gap-2">
                      <span aria-hidden="true">✕</span> Méně vhodné pro
                    </h4>
                    <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
                      {data.not_recommended_for.map((r) => <li>{r}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </>
          )}

          {/* Styl boje */}
          {data.combat_style && data.combat_style.length > 0 && (
            <>
              <h3 id="styl-boje" class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
                Styl boje
              </h3>
              <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-6">
                {data.combat_style.map((s) => <li>{s}</li>)}
              </ul>
            </>
          )}

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <!-- Barvy a heraldika -->
          <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
            Barvy a heraldika
          </h3>
          <div class="flex flex-wrap gap-3 mb-6">
            {data.colors.map((c) => (
              <span
                class="flex items-center gap-2 px-3 py-1.5 border border-[var(--color-gold-darkest)] bg-[var(--color-bg-medium)]"
              >
                <span class="w-4 h-4 border border-[var(--color-gold-darkest)]" style={`background:${c}`}></span>
                <code class="text-xs text-[var(--color-text-on-dark-muted)]">{c}</code>
              </span>
            ))}
          </div>

          <!-- Tábor a roleplay -->
          {data.camp_hook && (
            <>
              <h3 id="tabor" class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
                Tábor a roleplay
              </h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3 italic">
                {data.camp_hook}
              </p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
                Tábořiště pro ročník 2026 více rozdělíme podle armád a stran —
                to znamená vlastní oheň, společné secvičky, prostor pro
                obchodování, drobné služby a roleplay. Více v
                <a href={`/${lang}/hra-v-tabore/`} class="underline text-[var(--color-gold-light)]"> Hře v táboře</a>.
              </p>
            </>
          )}

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <!-- Lore box (audit balík #6) -->
          <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 mb-6">
            <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
              <span class="text-[var(--color-gold)]">◆</span>
              Chceš vědět víc o světě této frakce?
            </h3>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {name} na PP vychází z širší tradice popisované v Tolkienově
              Středozemi. Pro <strong>účast na hře</strong> jsou rozhodující
              praktické požadavky frakce výše — barvy, kostým, výzbroj,
              bezpečnost a schvalování. Pro <strong>atmosféru a kostým</strong>
              pomůže lore vrstva.
            </p>
            <div class="flex flex-wrap gap-2 text-xs">
              <a href={loreUrl} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider">
                <span aria-hidden="true">📖</span> Lore {name}
              </a>
              <a href={`/${lang}/svet-stredozeme/mistopis/`} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider">
                <span aria-hidden="true">🗺</span> Místopis
              </a>
              <a href={`/${lang}/svet-stredozeme/casova-linka/`} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider">
                <span aria-hidden="true">⏳</span> Časová linka
              </a>
              <a href={`/${lang}/pravidla/`} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider">
                <span aria-hidden="true">⚔</span> Pravidla
              </a>
            </div>
          </div>

          <AlertBox variant="info" title="Plný popis frakce" class="mt-6">
            Atmosférický text o {name} a kontext v ročníkovém příběhu doplníme
            postupně z content collection. Praktické informace pro registraci
            a kostým najdete výše.
          </AlertBox>

          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={`/${lang}/frakce/`} variant="ghost" size="md" icon="lucide:arrow-left" iconPosition="left">
              Zpět na přehled
            </Button>
            <Button href={`/${lang}/registrace/`} variant="primary" size="md" icon="lucide:arrow-right">
              {t('cta.go_to_registration')}
            </Button>
          </div>
        </article>
      </div>
    </div>
  </section>

</BaseLayout>
