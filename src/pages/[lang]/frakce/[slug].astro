const heraldry = HERALDRY[slug] ?? [];

/**
 * Lokalizovaná lore vrstva — strukturovaný obsah armády (combat_style, ruler,
 * lore_sections, atd.) žije v `data.i18n.{lang}.*`. Pro non-CS jazyky padá
 * na CS jako fallback. Přístup přes f.X je terser než opakované
 * `data.i18n[lang]?.X ?? data.i18n.cs.X`.
 */
const i18nCS = data.i18n.cs;
const i18nL = data.i18n[lang] ?? i18nCS;
const f = {
  combat_style:        i18nL.combat_style        ?? i18nCS.combat_style,
  recommended_for:     i18nL.recommended_for     ?? i18nCS.recommended_for,
  not_recommended_for: i18nL.not_recommended_for ?? i18nCS.not_recommended_for,
  tags:                i18nL.tags                ?? i18nCS.tags,
  newbie_costume_hint: i18nL.newbie_costume_hint ?? i18nCS.newbie_costume_hint,
  camp_hook:           i18nL.camp_hook           ?? i18nCS.camp_hook,
  costume_colors_text: i18nL.costume_colors_text ?? i18nCS.costume_colors_text,
  heraldry_text:       i18nL.heraldry_text       ?? i18nCS.heraldry_text,
  ruler:               i18nL.ruler               ?? i18nCS.ruler,
  lore_sections:       i18nL.lore_sections       ?? i18nCS.lore_sections,
};

/**
 * Krátké úvodní popisky odvozené z existujících lore_sections:
 *   - shortCostume = první odstavec sekce „Stylizace kostýmu" (resp. lokalizované varianty)
 *   - shortIntro   = první odstavec první „ne-Stylizace" sekce (typicky O <národu> / O království)
 * Bez nutnosti nových YAML polí — texty už v lore existují.
 */
type LoreSection = { title: string; paragraphs: string[] };
const styleRegex = /styliz|costume|kostüm|kostýmu|стиліз/i;
const sections: LoreSection[] = (f.lore_sections as LoreSection[] | undefined) ?? [];
const styleSection = sections.find((s) => styleRegex.test(s.title));
const introSection = sections.find((s) => !styleRegex.test(s.title));
const shortCostume = styleSection?.paragraphs?.[0] ?? '';
const shortIntro = introSection?.paragraphs?.[0] ?? '';
const sideTone =
  data.side === 'free'
    ? 'var(--color-side-free-text)'
    : data.side === 'evil'
      ? 'var(--color-side-evil-text)'
      : 'var(--color-gold-light)';

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('factions.heading'), href: `/${lang}/frakce/` },
  { label: name },
];

const difficultyLabel = (n: number) => '◆'.repeat(n) + '◇'.repeat(5 - n);
const diffAria = (n: number) => `${t('page.faction_detail.diff_aria_pre')}${n}${t('page.faction_detail.diff_aria_post')}`;

// Lore link mapping — slug → kotva v /svet-stredozeme/narody/
const factionSlug = faction.id.replace(/\.ya?ml$/, '');
const loreAnchorMap: Record<string, string> = {
  gondor: 'dunedain',
  rohan: 'rohirim',
  elves: 'elfove',
  dwarves: 'trpaslici',
  skreti: 'skreti',
  skuruti: 'skreti',
  harad: 'vychodnane',
  umbar: 'vychodnane',
  vrchovina: '',
};
const loreAnchor = loreAnchorMap[factionSlug] ?? '';
const loreUrl = `/${lang}/svet-stredozeme/narody/${loreAnchor ? '#' + loreAnchor : ''}`;
---

<BaseLayout
  title={`${name} — ${t('factions.heading')}`}
  description={`${name}: ${tagline}`}
  lang={lang}
>

  <!-- Hero frakce -->
  <section
    class="relative py-16 md:py-24 overflow-hidden"
    style={`background: radial-gradient(ellipse at 70% 50%, ${data.colors[0]}50, transparent 60%), var(--color-bg-darkest)`}
  >
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        {hasFactionIcon(factionSlug) ? (
          <EmblemMedallion iconSlug={factionIconSlug(factionSlug)} size={140} tone="gold" class="flex-shrink-0" />
        ) : (
          <EmblemMedallion symbol={data.emblem} size={140} tone="gold" class="flex-shrink-0" />
        )}

        <div class="flex-1 text-center md:text-left">
          <h1
            class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3"
          >
            {name}
          </h1>
          <p
            class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl"
            style={`color:${sideTone}`}
          >
            {tagline}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Obsah s postranní navigací -->
  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug={slug}
          currentSection={data.side}
        />

        <article class="max-w-3xl">

          {/* [1] Krátký úvod (3–4 věty) — z první ne-Stylizace lore sekce */}
          {shortIntro && (
            <p class="text-lg md:text-xl leading-relaxed text-[var(--color-text-on-dark)] mb-6">
              {shortIntro}
            </p>
          )}

          {/* [2] Krátký popis stylizace — z první „Stylizace kostýmu" lore sekce */}
          {shortCostume && (
            <div class="bg-[var(--color-bg-medium)]/40 border-l-4 border-[var(--color-gold)] p-5 mb-8">
              <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
                <span class="text-[var(--color-gold)]" aria-hidden="true">◆</span>
                {styleSection?.title}
              </h3>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed">
                {shortCostume}
              </p>
            </div>
          )}

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          {/* [3] Karty 2×2 — Barvy a heraldika / Výsostné znaky / Styl boje / Tábor a roleplay */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            {/* Barvy a heraldika */}
            <div class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-5 bg-[var(--color-bg-medium)]/30">
              <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
                {t('page.faction_detail.her_h')}
              </h3>
              <div class="flex flex-wrap gap-2 items-center mb-3">
                {data.colors.map((c) => (
                  <span
                    class="w-10 h-10 rounded-full border-2 border-[var(--color-gold-darkest)] shadow-md hover:scale-105 transition-transform"
                    style={`background:${c}`}
                    title={c}
                    aria-label={`${t('page.faction_detail.her_color_aria')} ${c}`}
                  ></span>
                ))}
              </div>
              {f.costume_colors_text && (
                <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
                  {f.costume_colors_text}
                </p>
              )}
            </div>

            {/* Výsostné znaky (heraldika) */}
            <div class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-5 bg-[var(--color-bg-medium)]/30">
              <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
                {t('page.faction_detail.her_heraldry_l')}
              </h3>
              {f.heraldry_text ? (
                <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
                  {f.heraldry_text}
                </p>
              ) : (
                <p class="text-sm text-[var(--color-text-on-dark-muted)] italic">{t('page.faction_detail.todo')}</p>
              )}
              {heraldry.length > 0 && (
                <div class={`mt-4 grid gap-2 ${heraldry.length > 1 ? 'grid-cols-2' : 'grid-cols-1'}`}>
                  {heraldry.map((h) => (
                    <div
                      class="flex flex-col items-center gap-2 p-4 border border-[var(--color-gold-darkest)] rounded"
                      style={`background:${h.bg};`}
                    >
                      <div class="w-20 h-20 flex items-center justify-center" style={h.filter ? `filter:${h.filter};` : ''}>
                        {h.iconSlug ? (
                          <img src={`/images/ikony-narody/${h.iconSlug}.svg`} alt={h.name} class="w-full h-full object-contain" loading="lazy" />
                        ) : h.customSvg ? (
                          <Fragment set:html={h.customSvg} />
                        ) : null}
                      </div>
                      <div class="text-[10px] uppercase tracking-wider text-center text-white/90 font-[family-name:var(--font-display)]">
                        {h.name}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* Styl boje */}
            <div class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-5 bg-[var(--color-bg-medium)]/30">
              <h3 id="styl-boje" class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 scroll-mt-24">
                {t('page.faction_detail.combat_h')}
              </h3>
              {f.combat_style && f.combat_style.length > 0 ? (
                <ul class="text-sm text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-0.5">
                  {f.combat_style.map((s) => <li>{s}</li>)}
                </ul>
              ) : (
                <p class="text-sm text-[var(--color-text-on-dark-muted)] italic">{t('page.faction_detail.todo')}</p>
              )}
            </div>

            {/* Tábor a roleplay */}
            <div class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-5 bg-[var(--color-bg-medium)]/30">
              <h3 id="tabor" class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 scroll-mt-24">
                {t('page.faction_detail.camp_h')}
              </h3>
              {f.camp_hook ? (
                <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed italic">
                  {f.camp_hook}
                </p>
              ) : (
                <p class="text-sm text-[var(--color-text-on-dark-muted)] italic">{t('page.faction_detail.todo')}</p>
              )}
            </div>
          </div>

          <p class="text-sm text-[var(--color-text-on-dark-muted)] leading-relaxed mb-6">
            {t('page.faction_detail.camp_p_pre')}<a href={`/${lang}/hra-v-tabore/`} class="underline text-[var(--color-gold-light)]">{t('page.faction_detail.camp_p_link')}</a>{t('page.faction_detail.camp_p_post')}
          </p>

          {/* [4] Karta panovníka — posunuto výš */}
          {f.ruler && (
            <>
              <Divider variant="line-diamond" tone="dark" class="my-8" />
              <h3 id="panovnik" class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 scroll-mt-24">
                {t('page.faction_detail.ruler_h')}
              </h3>
              <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-5 md:p-6 mb-6">
                <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] md:grid-cols-[160px_1fr] gap-5 md:gap-6 items-start">
                  <div class="mx-auto sm:mx-0 relative w-[140px] h-[140px] md:w-[160px] md:h-[160px] rounded-full overflow-hidden border-2 border-[var(--color-gold)] shrink-0" aria-hidden="true">
                    {data.ruler?.photo ? (
                      <img
                        src={`/images/panovnici/${data.ruler.photo}.webp`}
                        alt=""
                        width="160"
                        height="160"
                        class="absolute inset-0 w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : hasFactionIcon(factionSlug) ? (
                      <div
                        class="absolute inset-0 flex items-center justify-center p-6"
                        style={`background: radial-gradient(circle at center, ${data.colors[0]}60, var(--color-bg-darkest))`}
                      >
                        <img
                          src={`/images/ikony-narody/${factionIconSlug(factionSlug)}.svg`}
                          alt=""
                          class="w-full h-full object-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ) : (
                      <div
                        class="absolute inset-0 flex items-center justify-center text-6xl"
                        style={`background: radial-gradient(circle at center, ${data.colors[0]}60, var(--color-bg-darkest))`}
                      >
                        {data.emblem}
                      </div>
                    )}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-1">
                      {f.ruler.name}
                    </div>
                    <p class="font-[family-name:var(--font-serif)] italic text-base md:text-lg text-[var(--color-text-on-dark-muted)] mb-3">
                      {f.ruler.title}
                    </p>
                    <p class="text-[var(--color-text-on-dark)] leading-relaxed">
                      {f.ruler.description}
                    </p>
                  </div>
                </div>
              </div>
            </>
          )}

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          {/* [5] Pro nováčky — text bez rámečku + info karta Pro koho je armáda vhodná */}
          <h2 id="pro-novacky" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 scroll-mt-24 flex items-center gap-3">
            <span aria-hidden="true" class="text-[var(--color-gold)]">◆</span>
            {t('page.faction_detail.newbie_h')}
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-[1fr_280px] gap-6 mb-8 items-start">
            {/* Text Pro nováčky — bez rámečku */}
            <div>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
                {f.newbie_costume_hint
                  ? f.newbie_costume_hint
                  : `${t('page.faction_detail.newbie_fallback_pre')}${name}${t('page.faction_detail.newbie_fallback_post')}`}
              </p>
              <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
                {t('page.faction_detail.newbie_p2')}
              </p>
              <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-3">
                <li>{t('page.faction_detail.newbie_l1')}</li>
                <li>{t('page.faction_detail.newbie_l2')}</li>
                <li>{t('page.faction_detail.newbie_l3')}</li>
                <li>{t('page.faction_detail.newbie_l4')}</li>
                <li>{t('page.faction_detail.newbie_l5')}</li>
              </ul>
              <p class="text-sm text-[var(--color-text-on-dark-muted)] leading-relaxed italic">
                {t('page.faction_detail.newbie_note')}
              </p>
            </div>

            {/* Info karta Pro koho je armáda vhodná (vpravo) */}
            {(f.recommended_for || f.not_recommended_for) && (
              <aside class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-5 bg-[var(--color-bg-medium)]/30 md:sticky md:top-24">
                <h3 id="pro-koho" class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 scroll-mt-24">
                  {t('page.faction_detail.whom_h')}
                </h3>
                {f.recommended_for && f.recommended_for.length > 0 && (
                  <div class="mb-3">
                    <h4 class="text-[10px] uppercase tracking-widest text-[var(--color-gold)] mb-1 flex items-center gap-1">
                      <span aria-hidden="true">✓</span> {t('page.faction_detail.whom_yes')}
                    </h4>
                    <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-0.5">
                      {f.recommended_for.map((r) => <li>{r}</li>)}
                    </ul>
                  </div>
                )}
                {f.not_recommended_for && f.not_recommended_for.length > 0 && (
                  <div>
                    <h4 class="text-[10px] uppercase tracking-widest text-[var(--color-text-on-dark-muted)] mb-1 flex items-center gap-1">
                      <span aria-hidden="true">✕</span> {t('page.faction_detail.whom_no')}
                    </h4>
                    <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-0.5">
                      {f.not_recommended_for.map((r) => <li>{r}</li>)}
                    </ul>
                  </div>
                )}
                {inspiromatSlug && (
                  <a
                    href={`/${lang}/navody-a-inspirace/inspiromat/${inspiromatSlug}/`}
                    class="mt-4 block text-center px-3 py-2 border-2 border-[var(--color-gold)] bg-[var(--color-gold)]/10 hover:bg-[var(--color-gold)]/25 text-[var(--color-gold-light)] hover:text-[var(--color-gold)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors"
                  >
                    <span aria-hidden="true">📷</span> Inspiromat — fotky kostýmů
                  </a>
                )}
              </aside>
            )}
          </div>

          <!-- Lore box "Chceš vědět víc?" — součást Pro nováčky sekce, plná šířka -->
          <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-5 mb-6">
            <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
              <span class="text-[var(--color-gold)]">◆</span>
              {t('page.faction_detail.lore_h')}
            </h3>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {t('page.faction_detail.lore_p_pre')}{name}{t('page.faction_detail.lore_p_mid')}<strong>{t('page.faction_detail.lore_p_s1')}</strong>{t('page.faction_detail.lore_p_mid2')}<strong>{t('page.faction_detail.lore_p_s2')}</strong>{t('page.faction_detail.lore_p_post')}
            </p>
            <div class="flex flex-wrap gap-2 text-xs">
              <a href={loreUrl} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider">
                <span aria-hidden="true">📖</span> {t('page.faction_detail.lore_btn_lore_pre')}{name}
              </a>
              <a href={`/${lang}/svet-stredozeme/mistopis/`} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider">
                <span aria-hidden="true">🗺</span> {t('page.faction_detail.lore_btn_map')}
              </a>
              <a href={`/${lang}/svet-stredozeme/casova-linka/`} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider">
                <span aria-hidden="true">⏳</span> {t('page.faction_detail.lore_btn_tl')}
              </a>
              <a href={`/${lang}/pravidla/`} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] uppercase tracking-wider">
                <span aria-hidden="true">⚔</span> {t('page.faction_detail.lore_btn_rules')}
              </a>
              {inspiromatSlug && (
                <a href={`/${lang}/navody-a-inspirace/inspiromat/${inspiromatSlug}/`} class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold)]/60 hover:border-[var(--color-gold)] bg-[var(--color-gold)]/10 hover:bg-[var(--color-gold)]/20 text-[var(--color-gold-light)] hover:text-[var(--color-gold)] uppercase tracking-wider">
                  <span aria-hidden="true">📷</span> Inspiromat — {name}
                </a>
              )}
            </div>
          </div>

          {/* Plný popis armády — dlouhé texty z podkladů */}
          {f.lore_sections && f.lore_sections.length > 0 ? (
            <>
              <Divider variant="line-diamond" tone="dark" class="my-10" />
              <h2 id="plny-popis" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 scroll-mt-24 flex items-center gap-3">
                <span aria-hidden="true" class="text-[var(--color-gold)]">◆</span>
                {t('page.faction_detail.full_h')}
              </h2>
              <div class="space-y-8">
                {f.lore_sections.map((sec) => (
                  <section>
                    <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
                      {sec.title}
                    </h3>
                    {sec.paragraphs.map((p) => (
                      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">{p}</p>
                    ))}
                  </section>
                ))}
              </div>
            </>
          ) : (
            <AlertBox variant="info" title={t('page.faction_detail.placeholder_title')} class="mt-6">
              {t('page.faction_detail.placeholder_p_pre')}{name}{t('page.faction_detail.placeholder_p_post')}
            </AlertBox>
          )}

          <div class="mt-10 flex flex-wrap gap-3">
            <Button href={`/${lang}/frakce/`} variant="ghost" size="md" icon="lucide:arrow-left" iconPosition="left">
              {t('page.faction_detail.back_btn')}
            </Button>
            {inspiromatSlug && (
              <Button
                href={`/${lang}/navody-a-inspirace/inspiromat/${inspiromatSlug}/`}
                variant="secondary"
                size="md"
                icon="lucide:image"
              >
                Inspiromat — {name}
              </Button>
            )}
            <Button href={`/${lang}/registrace/`} variant="primary" size="md" icon="lucide:arrow-right">
              {t('cta.go_to_registration')}
            </Button>
          </div>
        </article>
      </div>
    </div>
  </section>

</BaseLayout>
