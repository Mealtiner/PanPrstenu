---
/**
 * Frakce — detail
 * URL: /cs/frakce/gondor/, …
 * Datum: 2026-05-03
 *
 * Generuje statickou stránku pro každou kombinaci jazyka × frakce.
 *
 * Skladba:
 *   - Hero s emblémem frakce a tagline
 *   - Sidebar s navigací mezi sourozenci
 *   - Hlavní obsah (zatím placeholder — později z content collection)
 *
 * 2026-05-03: kompletní překlad UI textů do 5 jazyků (cs/en/de/sk/uk).
 * Pozn.: Strukturovaná data armád (combat_style, lore_sections, ruler popis,
 * recommended_for, atd.) v src/content/factions/*.yml jsou zatím jen v CS.
 * Pro non-CS prohlížeče se zobrazí v CS jako fallback (lore vrstva), zatímco
 * UI texty (nadpisy, navigace, tlačítka) jsou plně přeložené.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { factionIconSlug, hasFactionIcon } from '@data/factionIcons';

export async function getStaticPaths() {
  const factions = await getCollection('factions');
  const langs: Lang[] = ['cs', 'en', 'de', 'sk', 'uk'];

  return langs.flatMap((lang) =>
    factions.map((f) => ({
      params: { lang, slug: f.id.replace(/\.ya?ml$/, '') },
      props: { faction: f, allFactions: factions },
    })),
  );
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { faction } = Astro.props;
const t = getTranslation(lang);

const data = faction.data;
const name = data.i18n[lang]?.name ?? data.i18n.cs.name;
const tagline = data.i18n[lang]?.tagline ?? data.i18n.cs.tagline;

// Mapping faction slug → inspiromat slug (existující galerie).
// Skuruti a vrchovina (Horalé) zatím nemají fotky — odkaz se nezobrazí.
const INSPIROMAT_SLUG: Record<string, string> = {
  gondor: 'gondor',
  rohan: 'rohan',
  elves: 'elfove',
  dwarves: 'trpaslici',
  skreti: 'skreti',
  harad: 'harad',
  umbar: 'umbar',
};
const inspiromatSlug = INSPIROMAT_SLUG[slug];

// Heraldické boxy zobrazené pod heraldry_text.
// `bg` = pozadí (heraldicky správná barva pole), `iconSlug` = soubor v
// /images/ikony-narody/{iconSlug}.svg, `filter` = CSS filter pro barvu kresby.
// Některé frakce mají víc znaků (Gondor + Dol Amroth).
// Zdroje: en.wikipedia.org/wiki/Heraldry_of_Middle-earth + tolkiengateway.net/wiki/Heraldry
type Heraldry = {
  name: string;
  description: string;
  bg: string;
  iconSlug?: string;
  filter?: string;
  customSvg?: string;
};

