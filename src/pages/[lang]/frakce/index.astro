---
/**
 * Armády a strany — hub stránka
 * URL: /cs/frakce/, …
 * Datum: 2026-05-01
 *
 * Podle mockupu Image 5 (desktop) a Image 6 (mobile).
 * Hub se 3 sekcemi (Svobodné národy Středozemě / Síly Temného pána /
 * Žoldáci) a velkými kartami. Plus Další způsoby účasti vč. Hobité.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Divider from '@components/decorative/Divider.astro';
import Button from '@components/ui/Button.astro';
import Tag from '@components/ui/Tag.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const factions = await getCollection('factions');
const free = factions.filter((f) => f.data.side === 'free').sort((a, b) => a.data.order - b.data.order);
const evil = factions.filter((f) => f.data.side === 'evil').sort((a, b) => a.data.order - b.data.order);
const mercenary = factions.filter((f) => f.data.side === 'mercenary').sort((a, b) => a.data.order - b.data.order);

const getName = (data: typeof factions[number]['data']) =>
  data.i18n[lang]?.name ?? data.i18n.cs.name;
const getTagline = (data: typeof factions[number]['data']) =>
  data.i18n[lang]?.tagline ?? data.i18n.cs.tagline;

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title') },
];

const difficultyLabel = (n: number) => '◆'.repeat(n) + '◇'.repeat(5 - n);
---

<BaseLayout
  title={t('page.factions.title')}
  description="Vyber si armádu v Bitvě o Středozem — Svobodné národy Středozemě, Síly Temného pána nebo Žoldáci."
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.factions.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {t('factions.subheading')}
      </p>
    </div>
  </section>

  <section class="py-12 border-b border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-4xl">
      <!-- Nejdůležitější v 60 sekundách -->
      <div class="bg-[var(--color-bg-darkest)] border-2 border-[var(--color-gold)] p-6">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
          <span class="text-[var(--color-gold)]">━ ◆</span>
          Nejdůležitější v 60 sekundách
          <span class="text-[var(--color-gold)]">◆ ━</span>
        </h2>
        <ul class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 list-disc list-inside text-sm md:text-base">
          <li>Armádu vybírej podle atmosféry, ale i podle toho, jaký kostým zvládneš připravit.</li>
          <li>Každý účastník má po celou dobu akce kostýmovou povinnost.</li>
          <li>Kostým nemusí být dokonalý, ale musí být tematický a nerušivý.</li>
          <li>Zbraně musí být bezpečné, schválené a vzhledově vhodné ke světu Středozemě.</li>
          <li>Hlavní bitva a účast v hlavní hře je <strong class="text-[var(--color-gold-light)]">od 12 let</strong>.</li>
          <li>Pro mladší účastníky připravujeme samostatnou
            <a href={`/${lang}/detska-hra/`} class="underline text-[var(--color-gold-light)]">dětskou hru</a>.</li>
          <li>Pokud nechceš bojovat, můžeš jet jako nebojový doprovod, atmosférická postava, fotograf, pomocník nebo rodič.</li>
          <li>Nejsi-li si jistý výběrem, začni stránkou
            <a href={`/${lang}/pro-novacky/`} class="underline text-[var(--color-gold-light)]"><strong>Jedu poprvé</strong></a>.</li>
        </ul>
        <div class="flex flex-wrap gap-2 mt-5">
          <Button href={`/${lang}/pravidla/`} variant="primary" size="sm">Přečíst pravidla</Button>
          <Button href={`/${lang}/pro-novacky/`} variant="secondary" size="sm">Jedu poprvé</Button>
          <Button href={`/${lang}/prakticke-info/`} variant="ghost" size="sm">Praktické info</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">

      <!-- Svobodné národy -->
      <div id="svobodne-narody" class="mb-16 scroll-mt-24">
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-side-free-text)] flex items-center gap-3 mb-6">
          <span class="text-3xl">⚔</span>
          {t('factions.free')}
        </h2>
        <Divider variant="line-diamond" tone="dark" class="mb-8" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {free.map((f) => (
            <a
              href={`/${lang}/frakce/${f.id.replace(/\.ya?ml$/, '')}/`}
              class="pp-card-hover group relative bg-[var(--color-bg-medium)]/60 border border-[var(--color-side-free)]/40 hover:border-[var(--color-side-free-text)] flex flex-col no-underline overflow-hidden"
              aria-label={`${getName(f.data)} — ${getTagline(f.data)}`}
            >
              <!-- Velká symbol/embléma sekce — obrázek armády (dark/light) -->
              <div
                class="relative aspect-[3/2] overflow-hidden border-b border-[var(--color-side-free)]/30"
                style={`background: radial-gradient(ellipse at center, ${f.data.colors[0]}40, transparent 70%), var(--color-bg-darkest)`}
                aria-hidden="true"
              >
                {f.data.card_image ? (
                  <>
                    <img
                      src={`/images/armady/${f.data.card_image}-dark.webp`}
                      alt=""
                      class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      src={`/images/armady/${f.data.card_image}-light.webp`}
                      alt=""
                      class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                  </>
                ) : (
                  <span class="absolute inset-0 flex items-center justify-center text-7xl md:text-8xl drop-shadow-lg group-hover:scale-110 transition-transform duration-300">{f.data.emblem}</span>
                )}
              </div>

              <!-- Textová část -->
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
                  {getName(f.data)}
                </h3>
                <p class="font-[family-name:var(--font-serif)] italic text-base text-[var(--color-text-on-dark-muted)] mb-4 flex-1">
                  {getTagline(f.data)}
                </p>
                <div class="flex items-center justify-between gap-3 pt-3 border-t border-[var(--color-gold-darkest)]/40 mt-auto">
                  <span class="text-[var(--color-gold)] tracking-widest text-sm" aria-label={`Náročnost ${f.data.difficulty_for_newcomer}/5`}>
                    {difficultyLabel(f.data.difficulty_for_newcomer)}
                  </span>
                  <Tag variant="green" size="sm">Volný národ</Tag>
                </div>
                <span class="mt-3 inline-flex items-center gap-2 text-xs font-[family-name:var(--font-display)] uppercase tracking-wider text-[var(--color-side-free-text)] group-hover:gap-3 transition-all">
                  {t('cta.read_more')}
                  <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Síly Temného pána -->
      <div id="sily-temna" class="scroll-mt-24">
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-side-evil-text)] flex items-center gap-3 mb-6">
          <span class="text-3xl">🔥</span>
          {t('factions.evil')}
        </h2>
        <Divider variant="line-diamond" tone="dark" class="mb-8" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {evil.map((f) => (
            <a
              href={`/${lang}/frakce/${f.id.replace(/\.ya?ml$/, '')}/`}
              class="pp-card-hover group relative bg-[var(--color-bg-medium)]/60 border border-[var(--color-side-evil)]/40 hover:border-[var(--color-side-evil-text)] flex flex-col no-underline overflow-hidden"
              aria-label={`${getName(f.data)} — ${getTagline(f.data)}`}
            >
              <!-- Velká symbol/embléma sekce — obrázek armády (dark/light) -->
              <div
                class="relative aspect-[3/2] overflow-hidden border-b border-[var(--color-side-evil)]/30"
                style={`background: radial-gradient(ellipse at center, ${f.data.colors[0]}40, transparent 70%), var(--color-bg-darkest)`}
                aria-hidden="true"
              >
                {f.data.card_image ? (
                  <>
                    <img
                      src={`/images/armady/${f.data.card_image}-dark.webp`}
                      alt=""
                      class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      src={`/images/armady/${f.data.card_image}-light.webp`}
                      alt=""
                      class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                  </>
                ) : (
                  <span class="absolute inset-0 flex items-center justify-center text-7xl md:text-8xl drop-shadow-lg group-hover:scale-110 transition-transform duration-300">{f.data.emblem}</span>
                )}
              </div>

              <!-- Textová část -->
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
                  {getName(f.data)}
                </h3>
                <p class="font-[family-name:var(--font-serif)] italic text-base text-[var(--color-text-on-dark-muted)] mb-4 flex-1">
                  {getTagline(f.data)}
                </p>
                <div class="flex items-center justify-between gap-3 pt-3 border-t border-[var(--color-gold-darkest)]/40 mt-auto">
                  <span class="text-[var(--color-gold)] tracking-widest text-sm" aria-label={`Náročnost ${f.data.difficulty_for_newcomer}/5`}>
                    {difficultyLabel(f.data.difficulty_for_newcomer)}
                  </span>
                  <Tag variant="red" size="sm">Síla Temného pána</Tag>
                </div>
                <span class="mt-3 inline-flex items-center gap-2 text-xs font-[family-name:var(--font-display)] uppercase tracking-wider text-[var(--color-side-evil-text)] group-hover:gap-3 transition-all">
                  {t('cta.read_more')}
                  <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Žoldáci (neutrální / vyrovnávací strana) -->
      {mercenary.length > 0 && (
        <div id="zoldaci" class="mt-16 scroll-mt-24">
          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] flex items-center gap-3 mb-3">
            <span class="text-3xl">⚒</span>
            {t('factions.mercenary')}
          </h2>
          <p class="text-[var(--color-text-on-dark-muted)] mb-6 max-w-3xl">
            Žoldáci jsou neutrální strana — během akce mohou být přiřazeni
            buď ke Svobodným národům, nebo k Silám Temného pána podle toho,
            jak je potřeba pro vyrovnání bojů a vyprávění.
          </p>
          <Divider variant="line-diamond" tone="dark" class="mb-8" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {mercenary.map((f) => (
              <a
                href={`/${lang}/frakce/${f.id.replace(/\.ya?ml$/, '')}/`}
                class="pp-card-hover group relative bg-[var(--color-bg-medium)]/60 border border-[var(--color-gold)]/40 hover:border-[var(--color-gold)] flex flex-col no-underline overflow-hidden"
                aria-label={`${getName(f.data)} — ${getTagline(f.data)}`}
              >
                <!-- Velká symbol/embléma sekce — obrázek armády (dark/light) -->
                <div
                  class="relative aspect-[3/2] overflow-hidden border-b border-[var(--color-gold)]/30"
                  style={`background: radial-gradient(ellipse at center, ${f.data.colors[0]}40, transparent 70%), var(--color-bg-darkest)`}
                  aria-hidden="true"
                >
                  {f.data.card_image ? (
                    <>
                      <img
                        src={`/images/armady/${f.data.card_image}-dark.webp`}
                        alt=""
                        class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                        decoding="async"
                      />
                      <img
                        src={`/images/armady/${f.data.card_image}-light.webp`}
                        alt=""
                        class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                        decoding="async"
                      />
                    </>
                  ) : (
                    <span class="absolute inset-0 flex items-center justify-center text-7xl md:text-8xl drop-shadow-lg group-hover:scale-110 transition-transform duration-300">{f.data.emblem}</span>
                  )}
                </div>

                <!-- Textová část -->
                <div class="p-6 flex-1 flex flex-col">
                  <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
                    {getName(f.data)}
                  </h3>
                  <p class="font-[family-name:var(--font-serif)] italic text-base text-[var(--color-text-on-dark-muted)] mb-4 flex-1">
                    {getTagline(f.data)}
                  </p>
                  <div class="flex items-center justify-between gap-3 pt-3 border-t border-[var(--color-gold-darkest)]/40 mt-auto">
                    <span class="text-[var(--color-gold)] tracking-widest text-sm" aria-label={`Náročnost ${f.data.difficulty_for_newcomer}/5`}>
                      {difficultyLabel(f.data.difficulty_for_newcomer)}
                    </span>
                    <Tag variant="gold" size="sm">Žoldáci</Tag>
                  </div>
                  <span class="mt-3 inline-flex items-center gap-2 text-xs font-[family-name:var(--font-display)] uppercase tracking-wider text-[var(--color-gold-light)] group-hover:gap-3 transition-all">
                    {t('cta.read_more')}
                    <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tábořiště podle armád -->
      <div id="taboriste" class="mt-16 pt-10 border-t border-[var(--color-gold-darkest)]">
        <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 md:p-8">
          <div class="flex items-center gap-3 mb-3">
            <Icon name="lucide:tent" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
            <h2 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)]">
              Tábořiště bude žít podle armád
            </h2>
          </div>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3 max-w-3xl">
            Chceme, aby armády nebyly jen barva na bojišti. Armády budou mít
            vlastní táborový život, prostor pro obchodování, služby, roleplay
            a drobné úkoly. Pro ročník 2026 chceme tábořiště více rozdělit
            podle armád a stran — dělící linie přirozeně mezi
            <strong class="text-[var(--color-side-free-text)]">Svobodnými národy</strong> a
            <strong class="text-[var(--color-side-evil-text)]">Silami temna</strong>.
          </p>
          <a href={`/${lang}/hra-v-tabore/#taboriste`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline inline-flex items-center gap-1">
            Detail v Hře v táboře →
          </a>
        </div>
      </div>

      <!-- Další způsoby účasti / role -->
      <div id="role" class="mt-16 pt-10 border-t border-[var(--color-gold-darkest)]">
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] flex items-center gap-3 mb-3">
          <Icon name="lucide:users" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
          Další způsoby účasti
        </h2>
        <p class="text-[var(--color-text-on-dark-muted)] mb-8 max-w-2xl">
          Nechceš bojovat, ale chceš být součástí Středozemě? Existuje hned několik
          rolí, které do akce neodmyslitelně patří.
        </p>
        <Divider variant="line-diamond" tone="dark" class="mb-8" />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Hobité -->
          <article class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b border-[var(--color-gold-darkest)]" aria-hidden="true">
              <img src="/images/armady/hobiti-dark.webp" alt="" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/hobiti-light.webp" alt="" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:wheat" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                Hobité
              </h3>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              Druhá snídaně, dýmka a pohled jiných očí.
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              Atmosférická role pro hospodské, obchodníky, stánkaře, CP postavy
              i pozorovatele dění. Hobité nebojují, ale jsou srdcem tábořiště
              a jarmarku.
            </p>
            <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>kostým z přírodních materiálů,</li>
              <li>hra mimo bojové linie,</li>
              <li>vhodné pro hospodu, jarmark, CP role,</li>
              <li>pohostinnost a klidná atmosféra.</li>
            </ul>
            <a href={`/${lang}/role/hobiti/`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">
              Detail role →
            </a>
          </article>

          <!-- Nebojový doprovod -->
          <article class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b border-[var(--color-gold-darkest)]" aria-hidden="true">
              <img src="/images/armady/nebojovy-doprovod-dark.webp" alt="" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/nebojovy-doprovod-light.webp" alt="" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:user-plus" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                Nebojový doprovod
              </h3>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              Jsi ve hře, pomáháš atmosféře, ale nebojuješ.
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              Doprovod bojovníků, markytáni, vlajkonoši, řemeslníci, posly,
              táborové role nebo atmosférické postavy.
            </p>
            <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>kostýmová povinnost,</li>
              <li>respektování pravidel akce,</li>
              <li>pohyb mimo bojové situace,</li>
              <li>domluva s armádou nebo organizátory.</li>
            </ul>
            <a href={`/${lang}/role/nebojovy-doprovod/`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">
              Zjistit více →
            </a>
          </article>

          <!-- Fotografové a kameramani -->
          <article class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b border-[var(--color-gold-darkest)]" aria-hidden="true">
              <img src="/images/armady/fotografove-dark.webp" alt="" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/fotografove-light.webp" alt="" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:camera" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                Fotografové a kameramani
              </h3>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              Zachytit příběh ano. Překážet hře ne.
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              Pro fotografy a kameramany platí kostýmová povinnost a pravidla
              pohybu v herním prostoru.
            </p>
            <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>v kostýmu nebo nerušivém oděvu,</li>
              <li>nelze vstupovat mezi bojující,</li>
              <li>technika na vlastní riziko,</li>
              <li>dron jen po předchozí domluvě.</li>
            </ul>
            <a href={`/${lang}/role/fotografove-a-kameramani/`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">
              Detail role →
            </a>
          </article>

          <!-- Stánkaři -->
          <article class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b border-[var(--color-gold-darkest)]" aria-hidden="true">
              <img src="/images/armady/stankari-dark.webp" alt="" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/stankari-light.webp" alt="" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:store" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                Stánkaři
              </h3>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              Řemeslo, jarmark a věci do Středozemě.
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              Prodejci kostýmů, látek, kožených doplňků, šperků, zbraní pro
              larp a dalšího tematického vybavení. Stánek je součástí jarmarku
              a tábořiště.
            </p>
            <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>tematický sortiment a stánek,</li>
              <li>obsluha v kostýmu nebo nenápadném oděvu,</li>
              <li>vlastní zázemí a pokladna,</li>
              <li>předchozí domluva s organizátory.</li>
            </ul>
            <a href={`/${lang}/role/stankari/`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">
              Detail role →
            </a>
          </article>

          <!-- Pomocníci -->
          <article class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b border-[var(--color-gold-darkest)]" aria-hidden="true">
              <img src="/images/armady/pomocnici-dark.webp" alt="" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/pomocnici-light.webp" alt="" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:hand-helping" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                Pomocníci
              </h3>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              Bez vás by tábor nestál. Bez nás taky ne.
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              Hledáme lidi, kteří chtějí pomoct s organizací — registrací,
              schvalováním, dětskou hrou, táborovým programem, zázemím.
              Za pomoc bývají
              <a href={`/${lang}/hra-v-tabore/#mince`} class="underline text-[var(--color-gold-light)]">herní mince</a>,
              dobrá nálada a respekt komunity.
            </p>
            <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>flexibilní čas zapojení,</li>
              <li>můžeš pomoct s konkrétní oblastí,</li>
              <li>napiš nám předem, co tě baví,</li>
              <li>i krátká pomoc se počítá.</li>
            </ul>
            <a href={`/${lang}/role/pomocnici/`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">
              Detail role →
            </a>
          </article>

          <!-- Organizátoři — vizuálně odlišená karta (slavnostní gold accent) -->
          <article class="group bg-[var(--color-bg-darkest)] border-2 border-[var(--color-gold)] p-5 pp-card-hover hover:border-[var(--color-gold-light)] relative overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b-2 border-[var(--color-gold)]" aria-hidden="true">
              <img src="/images/armady/organizatori-dark.webp" alt="" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/organizatori-light.webp" alt="" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <span class="absolute top-3 right-3 text-[10px] uppercase tracking-widest text-[var(--color-gold-light)] bg-[var(--color-bg-darkest)]/80 backdrop-blur-sm border border-[var(--color-gold)]/60 px-2 py-0.5">
                Tým akce
              </span>
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:crown" class="w-6 h-6 text-[var(--color-gold-light)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                Organizátoři
              </h3>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              Lidé, kteří Středozem stavějí.
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              Tým, který akci připravuje, organizuje a celý víkend vede. Najdeš
              tu kontakty, role v týmu a pár slov o lidech, díky kterým se to
              všechno děje.
            </p>
            <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>za organizátory se nelze přihlásit,</li>
              <li>tým je tvořený dlouhodobou domluvou,</li>
              <li>chceš pomáhat? <a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">Pomocníci</a>,</li>
              <li>chceš se víc zapojit do komunity? Ozvi se.</li>
            </ul>
            <a href={`/${lang}/role/organizatori/`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">
              Představit tým →
            </a>
          </article>
        </div>
      </div>

      <!-- Dětská hra -->
      <div id="detska-hra" class="mt-16 pt-10 border-t border-[var(--color-gold-darkest)]">
        <div class="group bg-[var(--color-bg-darkest)] border-2 border-[var(--color-gold-darkest)] overflow-hidden grid md:grid-cols-[1fr_2fr]">
          <!-- Obrázek -->
          <div class="relative aspect-[3/2] md:aspect-auto md:h-full overflow-hidden border-b md:border-b-0 md:border-r border-[var(--color-gold-darkest)]" aria-hidden="true">
            <img src="/images/armady/detska-hra-dark.webp" alt="" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            <img src="/images/armady/detska-hra-light.webp" alt="" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
          </div>
          <!-- Obsah -->
          <div class="p-6 md:p-8">
            <div class="flex items-center gap-3 mb-4">
              <Icon name="lucide:baby" class="w-8 h-8 text-[var(--color-gold)]" aria-hidden="true" />
              <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)]">
                Dětská hra
              </h2>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-base text-[var(--color-text-on-dark-muted)] mb-4">
              Dobrodružství pro mladší účastníky, které ještě nepatří do hlavní bitvy.
            </p>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
              Hlavní hra a účast v bitvě je určena pro účastníky
              <strong class="text-[var(--color-gold-light)]">od 12 let</strong>. Pro mladší
              děti připravujeme samostatnou dětskou hru, která má vlastní rytmus,
              přiměřenou náročnost a bezpečnější formu zapojení.
            </p>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
              Dětská hra probíhá odděleně od hlavní bitvy a je určená pro děti, které
              si chtějí zažít vlastní příběh ve Středozemi.
            </p>
            <div class="flex flex-wrap gap-3">
              <Button href={`/${lang}/detska-hra/`} variant="primary" size="md">Informace o dětské hře</Button>
              <Button href={`/${lang}/pro-rodice/`} variant="secondary" size="sm">Pro rodiče</Button>
              <Button href={`/${lang}/registrace/`} variant="ghost" size="sm">Registrace</Button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
