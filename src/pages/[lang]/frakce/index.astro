---
/**
 * Armády a strany — hub stránka
 * URL: /cs/frakce/, …
 * Datum: 2026-05-03
 *
 * Podle mockupu Image 5 (desktop) a Image 6 (mobile).
 * Hub se 3 sekcemi (Svobodné národy Středozemě / Síly Temného pána /
 * Žoldáci) a velkými kartami. Plus Další způsoby účasti vč. Hobité.
 *
 * 2026-05-03: kompletní překlad UI textů do 5 jazyků (cs/en/de/sk/uk).
 * Pozn.: Strukturovaná data armád (combat_style, lore, ...) v src/content/factions/*.yml
 * jsou zatím jen v CS — `name` a `tagline` jsou již lokalizovány přes i18n v yamlu.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Divider from '@components/decorative/Divider.astro';
import Button from '@components/ui/Button.astro';
import Tag from '@components/ui/Tag.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const tp = getPageContent('frakce', lang);

const factions = await getCollection('factions');
const free = factions.filter((f) => f.data.side === 'free').sort((a, b) => a.data.order - b.data.order);
const evil = factions.filter((f) => f.data.side === 'evil').sort((a, b) => a.data.order - b.data.order);
const mercenary = factions.filter((f) => f.data.side === 'mercenary').sort((a, b) => a.data.order - b.data.order);

const getName = (data: typeof factions[number]['data']) =>
  data.i18n[lang]?.name ?? data.i18n.cs.name;
const getTagline = (data: typeof factions[number]['data']) =>
  data.i18n[lang]?.tagline ?? data.i18n.cs.tagline;

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: tp('title') },
];

const difficultyLabel = (n: number) => '◆'.repeat(n) + '◇'.repeat(5 - n);
const diffAria = (n: number) => `${tp('diff_aria_pre')}${n}${tp('diff_aria_post')}`;
---

<BaseLayout
  title={tp('title')}
  description={tp('desc')}
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {tp('title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {t('factions.subheading')}
      </p>
    </div>
  </section>

  <section class="py-12 border-b border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-4xl">
      <!-- Nejdůležitější v 60 sekundách -->
      <div class="bg-[var(--color-bg-darkest)] border-2 border-[var(--color-gold)] p-6">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
          <span class="text-[var(--color-gold)]">━ ◆</span>
          {tp('h_60s')}
          <span class="text-[var(--color-gold)]">◆ ━</span>
        </h2>
        <ul class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 list-disc list-inside text-sm md:text-base">
          <li>{tp('s60_l1')}</li>
          <li>{tp('s60_l2')}</li>
          <li>{tp('s60_l3')}</li>
          <li>{tp('s60_l4')}</li>
          <li>{tp('s60_l5_pre')}<strong class="text-[var(--color-gold-light)]">{tp('s60_l5_strong')}</strong>{tp('s60_l5_post')}</li>
          <li>{tp('s60_l6_pre')}<a href={`/${lang}/detska-hra/`} class="underline text-[var(--color-gold-light)]">{tp('s60_l6_link')}</a>{tp('s60_l6_post')}</li>
          <li>{tp('s60_l7')}</li>
          <li>{tp('s60_l8_pre')}<a href={`/${lang}/pro-novacky/`} class="underline text-[var(--color-gold-light)]"><strong>{tp('s60_l8_link')}</strong></a>{tp('s60_l8_post')}</li>
        </ul>
        <div class="flex flex-wrap gap-2 mt-5">
          <Button href={`/${lang}/pravidla/`} variant="primary" size="sm">{tp('btn_rules')}</Button>
          <Button href={`/${lang}/pro-novacky/`} variant="secondary" size="sm">{tp('btn_newcomer')}</Button>
          <Button href={`/${lang}/prakticke-info/`} variant="ghost" size="sm">{tp('btn_practical')}</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">

      <!-- Svobodné národy -->
      <div id="svobodne-narody" class="mb-16 scroll-mt-24">
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-side-free-text)] flex items-center gap-3 mb-6">
          <span class="text-3xl">⚔</span>
          {t('factions.free')}
        </h2>
        <Divider variant="line-diamond" tone="dark" class="mb-8" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {free.map((f) => (
            <a
              href={`/${lang}/frakce/${f.id.replace(/\.ya?ml$/, '')}/`}
              class="pp-card-hover group relative bg-[var(--color-bg-medium)]/60 border border-[var(--color-side-free)]/40 hover:border-[var(--color-side-free-text)] flex flex-col no-underline overflow-hidden"
              aria-label={`${getName(f.data)} — ${getTagline(f.data)}`}
            >
              <!-- Velká symbol/embléma sekce — obrázek armády (dark/light) -->
              <div
                class="relative aspect-[3/2] overflow-hidden border-b border-[var(--color-side-free)]/30"
                style={`background: radial-gradient(ellipse at center, ${f.data.colors[0]}40, transparent 70%), var(--color-bg-darkest)`}
                aria-hidden="true"
              >
                {f.data.card_image ? (
                  <>
                    <img
                      src={`/images/armady/${f.data.card_image}-dark.webp`}
                      alt=""
                      width="1500"
                      height="1000"
                      class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      src={`/images/armady/${f.data.card_image}-light.webp`}
                      alt=""
                      width="1500"
                      height="1000"
                      class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                  </>
                ) : (
                  <span class="absolute inset-0 flex items-center justify-center text-7xl md:text-8xl drop-shadow-lg group-hover:scale-110 transition-transform duration-300">{f.data.emblem}</span>
                )}
              </div>

              <!-- Textová část -->
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
                  {getName(f.data)}
                </h3>
                <p class="font-[family-name:var(--font-serif)] italic text-base text-[var(--color-text-on-dark-muted)] mb-4 flex-1">
                  {getTagline(f.data)}
                </p>
                <div class="flex items-center justify-between gap-3 pt-3 border-t border-[var(--color-gold-darkest)]/40 mt-auto">
                  <span class="text-[var(--color-gold)] tracking-widest text-sm" aria-label={diffAria(f.data.difficulty_for_newcomer)}>
                    {difficultyLabel(f.data.difficulty_for_newcomer)}
                  </span>
                  <Tag variant="green" size="sm">{tp('tag_free')}</Tag>
                </div>
                <span class="mt-3 inline-flex items-center gap-2 text-xs font-[family-name:var(--font-display)] uppercase tracking-wider text-[var(--color-side-free-text)] group-hover:gap-3 transition-all">
                  {t('cta.read_more')}
                  <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Síly Temného pána -->
      <div id="sily-temna" class="scroll-mt-24">
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-side-evil-text)] flex items-center gap-3 mb-6">
          <span class="text-3xl">🔥</span>
          {t('factions.evil')}
        </h2>
        <Divider variant="line-diamond" tone="dark" class="mb-8" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {evil.map((f) => (
            <a
              href={`/${lang}/frakce/${f.id.replace(/\.ya?ml$/, '')}/`}
              class="pp-card-hover group relative bg-[var(--color-bg-medium)]/60 border border-[var(--color-side-evil)]/40 hover:border-[var(--color-side-evil-text)] flex flex-col no-underline overflow-hidden"
              aria-label={`${getName(f.data)} — ${getTagline(f.data)}`}
            >
              <!-- Velká symbol/embléma sekce — obrázek armády (dark/light) -->
              <div
                class="relative aspect-[3/2] overflow-hidden border-b border-[var(--color-side-evil)]/30"
                style={`background: radial-gradient(ellipse at center, ${f.data.colors[0]}40, transparent 70%), var(--color-bg-darkest)`}
                aria-hidden="true"
              >
                {f.data.card_image ? (
                  <>
                    <img
                      src={`/images/armady/${f.data.card_image}-dark.webp`}
                      alt=""
                      width="1500"
                      height="1000"
                      class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      src={`/images/armady/${f.data.card_image}-light.webp`}
                      alt=""
                      width="1500"
                      height="1000"
                      class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                  </>
                ) : (
                  <span class="absolute inset-0 flex items-center justify-center text-7xl md:text-8xl drop-shadow-lg group-hover:scale-110 transition-transform duration-300">{f.data.emblem}</span>
                )}
              </div>

              <!-- Textová část -->
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
                  {getName(f.data)}
                </h3>
                <p class="font-[family-name:var(--font-serif)] italic text-base text-[var(--color-text-on-dark-muted)] mb-4 flex-1">
                  {getTagline(f.data)}
                </p>
                <div class="flex items-center justify-between gap-3 pt-3 border-t border-[var(--color-gold-darkest)]/40 mt-auto">
                  <span class="text-[var(--color-gold)] tracking-widest text-sm" aria-label={diffAria(f.data.difficulty_for_newcomer)}>
                    {difficultyLabel(f.data.difficulty_for_newcomer)}
                  </span>
                  <Tag variant="red" size="sm">{tp('tag_evil')}</Tag>
                </div>
                <span class="mt-3 inline-flex items-center gap-2 text-xs font-[family-name:var(--font-display)] uppercase tracking-wider text-[var(--color-side-evil-text)] group-hover:gap-3 transition-all">
                  {t('cta.read_more')}
                  <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Žoldáci (neutrální / vyrovnávací strana) -->
      {mercenary.length > 0 && (
        <div id="zoldaci" class="mt-16 scroll-mt-24">
          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] flex items-center gap-3 mb-3">
            <span class="text-3xl">⚒</span>
            {t('factions.mercenary')}
          </h2>
          <p class="text-[var(--color-text-on-dark-muted)] mb-6 max-w-3xl">
            {tp('merc_p')}
          </p>
          <Divider variant="line-diamond" tone="dark" class="mb-8" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {mercenary.map((f) => (
              <a
                href={`/${lang}/frakce/${f.id.replace(/\.ya?ml$/, '')}/`}
                class="pp-card-hover group relative bg-[var(--color-bg-medium)]/60 border border-[var(--color-gold)]/40 hover:border-[var(--color-gold)] flex flex-col no-underline overflow-hidden"
                aria-label={`${getName(f.data)} — ${getTagline(f.data)}`}
              >
                <!-- Velká symbol/embléma sekce — obrázek armády (dark/light) -->
                <div
                  class="relative aspect-[3/2] overflow-hidden border-b border-[var(--color-gold)]/30"
                  style={`background: radial-gradient(ellipse at center, ${f.data.colors[0]}40, transparent 70%), var(--color-bg-darkest)`}
                  aria-hidden="true"
                >
                  {f.data.card_image ? (
                    <>
                      <img
                        src={`/images/armady/${f.data.card_image}-dark.webp`}
                        alt=""
                      width="1500"
                      height="1000"
                        class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                        decoding="async"
                      />
                      <img
                        src={`/images/armady/${f.data.card_image}-light.webp`}
                        alt=""
                      width="1500"
                      height="1000"
                        class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                        decoding="async"
                      />
                    </>
                  ) : (
                    <span class="absolute inset-0 flex items-center justify-center text-7xl md:text-8xl drop-shadow-lg group-hover:scale-110 transition-transform duration-300">{f.data.emblem}</span>
                  )}
                </div>

                <!-- Textová část -->
                <div class="p-6 flex-1 flex flex-col">
                  <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
                    {getName(f.data)}
                  </h3>
                  <p class="font-[family-name:var(--font-serif)] italic text-base text-[var(--color-text-on-dark-muted)] mb-4 flex-1">
                    {getTagline(f.data)}
                  </p>
                  <div class="flex items-center justify-between gap-3 pt-3 border-t border-[var(--color-gold-darkest)]/40 mt-auto">
                    <span class="text-[var(--color-gold)] tracking-widest text-sm" aria-label={diffAria(f.data.difficulty_for_newcomer)}>
                      {difficultyLabel(f.data.difficulty_for_newcomer)}
                    </span>
                    <Tag variant="gold" size="sm">{tp('tag_merc')}</Tag>
                  </div>
                  <span class="mt-3 inline-flex items-center gap-2 text-xs font-[family-name:var(--font-display)] uppercase tracking-wider text-[var(--color-gold-light)] group-hover:gap-3 transition-all">
                    {t('cta.read_more')}
                    <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tábořiště podle armád -->
      <div id="taboriste" class="mt-16 pt-10 border-t border-[var(--color-gold-darkest)]">
        <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 md:p-8">
          <div class="flex items-center gap-3 mb-3">
            <Icon name="lucide:tent" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
            <h2 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)]">
              {tp('tt_h')}
            </h2>
          </div>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3 max-w-3xl">
            {tp('tt_p_pre')}<strong class="text-[var(--color-side-free-text)]">{tp('tt_free')}</strong>{tp('tt_mid')}<strong class="text-[var(--color-side-evil-text)]">{tp('tt_evil')}</strong>{tp('tt_post')}
          </p>
          <a href={`/${lang}/hra-v-tabore/#taboriste`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline inline-flex items-center gap-1">
            {tp('tt_link')}
          </a>
        </div>
      </div>

      <!-- Další způsoby účasti / role -->
      <div id="role" class="mt-16 pt-10 border-t border-[var(--color-gold-darkest)]">
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] flex items-center gap-3 mb-3">
          <Icon name="lucide:users" class="w-7 h-7 text-[var(--color-gold)]" aria-hidden="true" />
          {tp('h_roles')}
        </h2>
        <p class="text-[var(--color-text-on-dark-muted)] mb-8 max-w-2xl">
          {tp('roles_p')}
        </p>
        <Divider variant="line-diamond" tone="dark" class="mb-8" />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Hobité -->
          <article class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b border-[var(--color-gold-darkest)]" aria-hidden="true">
              <img src="/images/armady/hobiti-dark.webp" alt="" width="1500" height="1000" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/hobiti-light.webp" alt="" width="1500" height="1000" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:wheat" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                {tp('role_h_hobiti')}
              </h3>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              {tp('role_t_hobiti')}
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {tp('role_d_hobiti')}
            </p>
            <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>{tp('role_l_hobiti_1')}</li>
              <li>{tp('role_l_hobiti_2')}</li>
              <li>{tp('role_l_hobiti_3')}</li>
              <li>{tp('role_l_hobiti_4')}</li>
            </ul>
            <a href={`/${lang}/role/hobiti/`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">
              {tp('role_link_detail')}
            </a>
          </article>

          <!-- Nebojový doprovod -->
          <article class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b border-[var(--color-gold-darkest)]" aria-hidden="true">
              <img src="/images/armady/nebojovy-doprovod-dark.webp" alt="" width="1500" height="1000" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/nebojovy-doprovod-light.webp" alt="" width="1500" height="1000" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:user-plus" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                {tp('role_h_escort')}
              </h3>
            </div>
            <p class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-text-on-dark-muted)] mb-3">
              {tp('role_t_escort')}
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {tp('role_d_escort')}
            </p>
            <ul class="text-xs text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>{tp('role_l_escort_1')}</li>
              <li>{tp('role_l_escort_2')}</li>
              <li>{tp('role_l_escort_3')}</li>
              <li>{tp('role_l_escort_4')}</li>
            </ul>
            <a href={`/${lang}/role/nebojovy-doprovod/`} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] hover:underline">
              {tp('role_link_more')}
            </a>
          </article>

          <!-- Fotografové a kameramani -->
          <article class="group bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 pp-card-hover hover:border-[var(--color-gold)] overflow-hidden">
            <div class="relative aspect-[3/2] -mx-5 -mt-5 mb-4 overflow-hidden border-b border-[var(--color-gold-darkest)]" aria-hidden="true">
              <img src="/images/armady/fotografove-dark.webp" alt="" width="1500" height="1000" class="theme-img-dark absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              <img src="/images/armady/fotografove-light.webp" alt="" width="1500" height="1000" class="theme-img-light absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            </div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="lucide:camera" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
              <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)]">
                {tp('role_h_photog')}
              </h3>
            </div>
