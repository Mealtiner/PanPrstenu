---
/**
 * Frakce a národy — hub stránka
 * URL: /cs/frakce/, …
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 5 (desktop) a Image 6 (mobile).
 * Hub se 2 sloupci (Svobodné národy / Síly Temna) a velkými kartami.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import InfoCard from '@components/blocks/InfoCard.astro';
import Divider from '@components/decorative/Divider.astro';
import Tag from '@components/ui/Tag.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const factions = await getCollection('factions');
const free = factions.filter((f) => f.data.side === 'free').sort((a, b) => a.data.order - b.data.order);
const evil = factions.filter((f) => f.data.side === 'evil').sort((a, b) => a.data.order - b.data.order);

const getName = (data: typeof factions[number]['data']) =>
  data.i18n[lang]?.name ?? data.i18n.cs.name;
const getTagline = (data: typeof factions[number]['data']) =>
  data.i18n[lang]?.tagline ?? data.i18n.cs.tagline;

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title') },
];

const difficultyLabel = (n: number) => '◆'.repeat(n) + '◇'.repeat(5 - n);
---

<BaseLayout
  title={t('page.factions.title')}
  description="Vyber si frakci v Bitvě o Středozem — Svobodné národy nebo Síly Temna."
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.factions.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {t('factions.subheading')}
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">

      <!-- Svobodné národy -->
      <div class="mb-16">
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[#9ec5a8] flex items-center gap-3 mb-6">
          <span class="text-3xl">⚔</span>
          {t('factions.free')}
        </h2>
        <Divider variant="line-diamond" tone="dark" class="mb-8" />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {free.map((f) => (
            <InfoCard
              href={`/${lang}/frakce/${f.id.replace(/\.ya?ml$/, '')}/`}
              title={getName(f.data)}
              description={getTagline(f.data)}
              tone="dark"
              cta={t('cta.read_more')}
            >
              <div class="mt-3 flex items-center gap-3 text-xs text-[var(--color-text-on-dark-muted)]">
                <span class="text-[var(--color-gold)]" aria-label={`Náročnost ${f.data.difficulty_for_newcomer}/5`}>
                  {difficultyLabel(f.data.difficulty_for_newcomer)}
                </span>
                <Tag variant="green" size="sm">Volný národ</Tag>
              </div>
            </InfoCard>
          ))}
        </div>
      </div>

      <!-- Síly Temna -->
      <div>
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[#e8a8aa] flex items-center gap-3 mb-6">
          <span class="text-3xl">🔥</span>
          {t('factions.evil')}
        </h2>
        <Divider variant="line-diamond" tone="dark" class="mb-8" />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {evil.map((f) => (
            <InfoCard
              href={`/${lang}/frakce/${f.id.replace(/\.ya?ml$/, '')}/`}
              title={getName(f.data)}
              description={getTagline(f.data)}
              tone="dark"
              cta={t('cta.read_more')}
            >
              <div class="mt-3 flex items-center gap-3 text-xs text-[var(--color-text-on-dark-muted)]">
                <span class="text-[var(--color-gold)]" aria-label={`Náročnost ${f.data.difficulty_for_newcomer}/5`}>
                  {difficultyLabel(f.data.difficulty_for_newcomer)}
                </span>
                <Tag variant="red" size="sm">Síla Temna</Tag>
              </div>
            </InfoCard>
          ))}
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
