---
/**
 * Cookies a nastavení soukromí
 * URL: /cs/cookies/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah načítán z src/content/pages-long/cookies/{lang}.md
 * (markdown content collection — frontmatter pro meta + body markdown).
 * Pro non-CS varianty zatím chybí překlad → fallback na cs.md s lang_notice.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { getEntry, render } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

// Pokus o načtení per-lang markdown, fallback na cs
const entry = (await getEntry('longPages', `cookies/${lang}`)) ?? (await getEntry('longPages', 'cookies/cs'));
if (!entry) throw new Error('cookies markdown not found');
const { Content } = await render(entry);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: entry.data.breadcrumb },
];

const chapters = [
  { id: 'co-jsou-cookies',   label: 'Co jsou cookies',          icon: 'lucide:cookie' },
  { id: 'kategorie',         label: 'Kategorie cookies',         icon: 'lucide:layers' },
  { id: 'prehled',           label: 'Přehled cookies',           icon: 'lucide:list' },
  { id: 'ga-ads',            label: 'Google Analytics a Ads',    icon: 'lucide:bar-chart-3' },
  { id: 'lista',             label: 'Cookie lišta',              icon: 'lucide:bell' },
  { id: 'zmena-nastaveni',   label: 'Změna nastavení',           icon: 'lucide:settings' },
  { id: 'dopady',            label: 'Dopady odmítnutí',          icon: 'lucide:alert-circle' },
  { id: 'registracka',       label: 'Registračka.cz',            icon: 'lucide:database' },
  { id: 'transparentni-ucet', label: 'Transparentní účet',       icon: 'lucide:wallet' },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  breadcrumbs={[{ name: entry.data.breadcrumb, href: `/${lang}/cookies/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {entry.data.title}
      </h1>
      {entry.data.hero_subtitle && (
        <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
          {entry.data.hero_subtitle}
        </p>
      )}
    </div>
  </section>

  <section class="py-12" data-toc-root>
    <div class="container-base">
      {lang !== 'cs' && (
        <div class="mb-8">
          <AlertBox variant="info">
            {t('legal.lang_notice_pending')}
          </AlertBox>
        </div>
      )}
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title="Obsah stránky" ariaLabel="Obsah stránky cookies" />
        <article class="min-w-0 max-w-3xl prose-cookies">
          <Content />

          {entry.data.last_updated && (
            <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-8 italic">
              Poslední aktualizace: {entry.data.last_updated} · Platí pro: web Pán Prstenů 2026
            </p>
          )}
        </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

</BaseLayout>

<style is:global>
  .prose-cookies {
    color: var(--color-text-on-dark);
    line-height: 1.7;
  }
  .prose-cookies h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gold-light);
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 6rem;
  }
  .prose-cookies h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gold-light);
    font-size: 1.125rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-cookies p { margin: 0 0 1rem; }
  .prose-cookies a { color: var(--color-gold-light); text-decoration: underline; }
  .prose-cookies a:hover { color: var(--color-gold); }
  .prose-cookies ul { list-style: disc; margin: 0 0 1rem 1.5rem; }
  .prose-cookies ol { list-style: decimal; margin: 0 0 1rem 1.5rem; }
  .prose-cookies blockquote {
    border-left: 3px solid var(--color-gold);
    padding: 0.5rem 0 0.5rem 1rem;
    margin: 1.5rem 0;
    background: var(--color-bg-medium);
  }
  .prose-cookies code {
    background: var(--color-bg-medium);
    color: var(--color-gold-light);
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    font-size: 0.95em;
  }
  .prose-cookies strong { color: var(--color-gold-light); }
  .prose-cookies table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9em;
  }
  .prose-cookies th {
    text-align: left;
    padding: 0.75rem 0.5rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gold-light);
    font-size: 0.75rem;
    border-bottom: 2px solid var(--color-gold-darkest);
  }
  .prose-cookies td {
    padding: 0.5rem;
    border-bottom: 1px solid rgba(94, 74, 35, 0.4);
  }
</style>
