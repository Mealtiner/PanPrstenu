---
/**
 * Pořadatel — detailní identifikace spolku
 * URL: /cs/poradatel/, …
 * Datum: 2026-04-30
 *
 * Detailní stránka pro identifikaci pořadatele (Moravian LARP, z. s.) —
 * IČO, spisová značka, sídlo, kontakty, rozsah činnosti, statutární orgán.
 * Z patičky odkazujeme sem, abychom v patičce mohli zachovat zkrácenou verzi.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Pořadatel' },
];
---

<BaseLayout
  title="Pořadatel — Moravian LARP, z. s."
  description="Pořadatelem akce Pán Prstenů 2026 je spolek Moravian LARP, z. s. (IČO 22669167, sídlo Brno). Identifikace, kontakty a rozsah činnosti."
  lang={lang}
  breadcrumbs={[{ name: 'Pořadatel', href: `/${lang}/poradatel/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        Pořadatel
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        Moravian LARP, z. s. — spolek pořádající Pán Prstenů, Bitvu o Středozem.
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Pán Prstenů — Bitva o Středozem je vícedenní larpová akce pořádaná
        spolkem <strong class="text-[var(--color-gold-light)]">Moravian LARP, z. s.</strong>
        Tato stránka shrnuje úplnou identifikaci pořadatele pro veřejnost,
        partnery, média, městské úřady a další subjekty.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 id="identifikace" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Identifikační údaje
      </h2>

      <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 mb-8">
        <dl class="grid grid-cols-1 sm:grid-cols-[180px_1fr] gap-x-6 gap-y-3 text-sm">
          <dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-xs text-[var(--color-gold-light)]">Název</dt>
          <dd class="text-[var(--color-text-on-dark)]"><strong>Moravian LARP, z. s.</strong></dd>

          <dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-xs text-[var(--color-gold-light)]">Právní forma</dt>
          <dd class="text-[var(--color-text-on-dark)]">Spolek (zapsaný spolek)</dd>

          <dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-xs text-[var(--color-gold-light)]">IČO</dt>
          <dd class="text-[var(--color-text-on-dark)]"><code class="text-[var(--color-gold-light)]">22669167</code></dd>

          <dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-xs text-[var(--color-gold-light)]">Spisová značka</dt>
          <dd class="text-[var(--color-text-on-dark)]">L 12656 vedená u Krajského soudu v Brně</dd>

          <dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-xs text-[var(--color-gold-light)]">Sídlo</dt>
          <dd class="text-[var(--color-text-on-dark)]">Starobrněnská 289/7, Brno-město, 602 00 Brno</dd>

          <dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-xs text-[var(--color-gold-light)]">E-mail</dt>
          <dd>
            <a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>
          </dd>

          <dt class="font-[family-name:var(--font-display)] uppercase tracking-widest text-xs text-[var(--color-gold-light)]">Web</dt>
          <dd>
            <a href="https://www.panprstenu.cz" class="underline text-[var(--color-gold-light)]">www.panprstenu.cz</a>
          </dd>
        </dl>
      </div>

      <h2 id="cinnost" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Rozsah činnosti
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Hlavní činností spolku je pořádání larpových akcí a souvisejících
        komunitních aktivit, zejména:
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>příprava a realizace vícedenní larpové akce <strong>Pán Prstenů — Bitva o Středozem</strong>,</li>
        <li>provoz registračního systému <strong>Registračka.cz</strong> pro vlastní akce a akce, kde organizačně zajišťujeme registraci,</li>
        <li>komunitní aktivity v oblasti larpu, kostýmování, historizující rekonstrukce a fantasy kultury,</li>
        <li>spolupráce s mediálními, kulturními a vzdělávacími subjekty.</li>
      </ul>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 italic">
        Spolek je nezisková organizace. Příjmy z registračních poplatků slouží
        výhradně k úhradě nákladů na přípravu a realizaci akce, jejího zázemí
        a souvisejících provozních potřeb.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 id="kontakt" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Kontakty
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
        <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
          <div class="flex items-center gap-3 mb-2">
            <Icon name="lucide:mail" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
            <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)]">Obecné dotazy</h3>
          </div>
          <a href="mailto:info@panprstenu.cz" class="text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] underline">info@panprstenu.cz</a>
          <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-2">
            Registrace, platby, dotazy účastníků, GDPR, fotky, organizační záležitosti.
          </p>
        </article>
        <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
          <div class="flex items-center gap-3 mb-2">
            <Icon name="lucide:newspaper" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
            <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)]">Pro média</h3>
          </div>
          <a href={`/${lang}/pro-media/`} class="text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] underline">Mediakit a tisková zpráva</a>
          <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-2">
            Logo ke stažení, fotky, fakta o akci, kontakt pro novináře.
          </p>
        </article>
        <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
          <div class="flex items-center gap-3 mb-2">
            <Icon name="lucide:store" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
            <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)]">Pro stánkaře</h3>
          </div>
          <a href={`/${lang}/pro-stankare/`} class="text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] underline">Přihláška a podmínky</a>
          <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-2">
            Pro prodejce kostýmů, látek, zbraní, šperků a tematického vybavení.
          </p>
        </article>
        <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
          <div class="flex items-center gap-3 mb-2">
            <Icon name="lucide:shield-question" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
            <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)]">GDPR a osobní údaje</h3>
          </div>
          <a href={`/${lang}/gdpr/`} class="text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] underline">Ochrana osobních údajů</a>
          <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-2">
            Práva subjektu údajů, doba uchování, kontakt pro výmaz / opravu.
          </p>
        </article>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 id="souvisejici" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Související právní stránky
      </h2>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed space-y-1 list-disc list-inside mb-8">
        <li><a href={`/${lang}/podminky-ucasti-a-registrace/`} class="underline hover:text-[var(--color-gold-light)]">Podmínky účasti a registrace</a></li>
        <li><a href={`/${lang}/gdpr/`} class="underline hover:text-[var(--color-gold-light)]">GDPR / Ochrana osobních údajů</a></li>
        <li><a href={`/${lang}/cookies/`} class="underline hover:text-[var(--color-gold-light)]">Cookies a nastavení soukromí</a></li>
        <li><a href={`/${lang}/fotky-a-video/`} class="underline hover:text-[var(--color-gold-light)]">Fotky a video — pravidla</a></li>
        <li><a href={`/${lang}/pravidla/`} class="underline hover:text-[var(--color-gold-light)]">Pravidla akce</a></li>
        <li><a href={`/${lang}/pristupnost/`} class="underline hover:text-[var(--color-gold-light)]">Přístupnost</a></li>
      </ul>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic">
        Aktualizace: 30. dubna 2026. V případě změny zápisu ve spolkovém rejstříku
        bude tato stránka aktualizována.
      </p>

    </article>
  </section>

</BaseLayout>
