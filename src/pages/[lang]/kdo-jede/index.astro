---
/**
 * Kdo jede
 * URL: /cs/kdo-jede/, …
 * Datum: 2026-05-01
 *
 * Veřejný přehled přihlášených účastníků podle stran a armád. Zatím
 * placeholder — data se budou načítat z registračního systému (Registračka.cz)
 * až bude napojení připravené. Stránka komunikuje motivačně: kdo už jede,
 * jak se plní strany a armády, kde je prostor.
 *
 * Soukromí: zobrazujeme pouze přezdívky / jména a armádu / roli,
 * nikdy věk, kontakty, platbu, dokumenty ani údaje zákonných zástupců.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import FactionIcon from '@components/decorative/FactionIcon.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';
import { factionIconSlug, hasFactionIcon } from '@data/factionIcons';
import '@styles/registration.css';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('kdo-jede', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: p.title },
];

// Načtení armád z content collection pro orientační strukturu
const factions = (await getCollection('factions')).filter((f) => !f.data.hidden);
const free = factions
  .filter((f) => f.data.side === 'free')
  .sort((a, b) => a.data.order - b.data.order);
const evil = factions
  .filter((f) => f.data.side === 'evil')
  .sort((a, b) => a.data.order - b.data.order);

const factionName = (data: any) => data.i18n[lang]?.name ?? data.i18n.cs.name;
const factionSlug = (id: string) => id.replace(/\.ya?ml$/, '');

const otherRoles = [
  { slug: 'nebojovy-doprovod', label: p.role_companion, icon: 'lucide:user-plus' },
  { slug: 'fotografove-a-kameramani', label: p.role_photographers, icon: 'lucide:camera' },
  { slug: 'stankari', label: p.role_vendors, icon: 'lucide:store' },
  { slug: 'pomocnici', label: p.role_helpers, icon: 'lucide:hand-helping' },
  { slug: 'organizatori', label: p.role_organizers, icon: 'lucide:crown' },
  { slug: 'detska-hra', label: p.role_kids_game, icon: 'lucide:sparkles', href: `/${lang}/detska-hra/` },
];
---

<BaseLayout
  title={p.meta_title}
  description={p.description}
  lang={lang}
  breadcrumbs={[{ name: p.title, href: `/${lang}/kdo-jede/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.title}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {p.subtitle}
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-5xl">

      <AlertBox variant="info" class="mb-8">
        {p.alert_pre}<strong>{p.alert_strong}</strong>{p.alert_post}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
        {p.h_factions}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        {p.factions_intro}
      </p>

      <!-- Svobodné národy -->
      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-side-free-text)] mb-3 flex items-center gap-2">
        <span aria-hidden="true">⚔</span>
        {t('factions.free')}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        {free.map((f) => {
          const slug = factionSlug(f.id);
          const name = factionName(f.data);
          return (
            <div
              class="kj-card kj-card--free bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] hover:border-[var(--color-side-free-text)] p-4 transition-colors flex items-center gap-3"
              data-kj-card
              data-kj-faction-slug={slug}
              data-kj-tone="free"
              data-kj-title={name}
            >
              {hasFactionIcon(slug) ? (
                <FactionIcon slug={factionIconSlug(slug)} size={32} tone="side-free" class="shrink-0" />
              ) : (
                <span class="text-2xl opacity-80 shrink-0" aria-hidden="true">{f.data.emblem}</span>
              )}
              <div class="flex-1 min-w-0">
                <a
                  href={`/${lang}/frakce/${slug}/`}
                  class="block font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-text-on-dark)] hover:text-[var(--color-side-free-text)] transition-colors"
                >{name}</a>
                <div class="kj-card__count-line text-xs text-[var(--color-text-on-dark-muted)] mt-0.5">
                  <span data-kj-count>—</span>/<span data-kj-limit>—</span> {p.count_label}
                </div>
              </div>
              <button type="button" class="kj-card__btn kj-card__btn--free" data-kj-show>
                {p.show_list}
              </button>
            </div>
          );
        })}
      </div>

      <!-- Síly Temného pána -->
      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-side-evil-text)] mb-3 mt-6 flex items-center gap-2">
        <span aria-hidden="true">🔥</span>
        {t('factions.evil')}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        {evil.map((f) => {
          const slug = factionSlug(f.id);
          const name = factionName(f.data);
          return (
            <div
              class="kj-card kj-card--evil bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] hover:border-[var(--color-side-evil-text)] p-4 transition-colors flex items-center gap-3"
              data-kj-card
              data-kj-faction-slug={slug}
              data-kj-tone="evil"
              data-kj-title={name}
            >
              {hasFactionIcon(slug) ? (
                <FactionIcon slug={factionIconSlug(slug)} size={32} tone="side-evil" class="shrink-0" />
              ) : (
                <span class="text-2xl opacity-80 shrink-0" aria-hidden="true">{f.data.emblem}</span>
              )}
              <div class="flex-1 min-w-0">
                <a
                  href={`/${lang}/frakce/${slug}/`}
                  class="block font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-text-on-dark)] hover:text-[var(--color-side-evil-text)] transition-colors"
                >{name}</a>
                <div class="kj-card__count-line text-xs text-[var(--color-text-on-dark-muted)] mt-0.5">
                  <span data-kj-count>—</span>/<span data-kj-limit>—</span> {p.count_label}
                </div>
              </div>
              <button type="button" class="kj-card__btn kj-card__btn--evil" data-kj-show>
                {p.show_list}
              </button>
            </div>
          );
        })}
      </div>

      <!-- Další role -->
      <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3 mt-6 flex items-center gap-2">
        <span class="text-[var(--color-gold)] text-xs" aria-hidden="true">◆</span>
        {p.h_other_roles}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
        {otherRoles.map((r) => (
          <div
            class="kj-card kj-card--gold bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] p-4 transition-colors flex items-center gap-3"
            data-kj-card
            data-kj-role-slug={r.slug}
            data-kj-tone="gold"
            data-kj-title={r.label}
          >
            {hasFactionIcon(r.slug) ? (
              <FactionIcon slug={factionIconSlug(r.slug)} size={32} tone="gold-light" class="shrink-0 opacity-80" />
            ) : (
              <Icon name={r.icon} class="w-5 h-5 text-[var(--color-gold-light)] opacity-80 shrink-0" aria-hidden="true" />
            )}
            <div class="flex-1 min-w-0">
              <a
                href={r.href ?? `/${lang}/role/${r.slug}/`}
                class="block font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)] transition-colors"
              >{r.label}</a>
              <div class="kj-card__count-line text-xs text-[var(--color-text-on-dark-muted)] mt-0.5">
                <span data-kj-count>—</span>/<span data-kj-limit>—</span> {p.count_label}
              </div>
            </div>
            <button type="button" class="kj-card__btn kj-card__btn--gold" data-kj-show>
              {p.show_list}
            </button>
          </div>
        ))}
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
        {p.h_privacy}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.privacy_p1_pre}<a href={`/${lang}/gdpr/`} class="underline text-[var(--color-gold-light)]">{p.privacy_p1_link}</a>{p.privacy_p1_post}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 italic">
        {p.privacy_p2}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-6" />

      <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          {p.cta_heading}
        </h2>
        <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
          {p.cta_body}
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <Button href={`/${lang}/registrace/`} variant="primary" size="md" icon="lucide:arrow-right">
            {p.btn_register}
          </Button>
          <Button href={`/${lang}/frakce/`} variant="secondary" size="md">
            {p.btn_pick_army}
          </Button>
        </div>
      </div>

    </article>
  </section>

  <script>
    import { initKdoJede } from '@scripts/kdo-jede';
    initKdoJede();
  </script>

</BaseLayout>
