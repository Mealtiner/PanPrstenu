---
/**
 * Podmínky účasti a registrace
 * URL: /cs/podminky-ucasti-a-registrace/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah z src/content/pages-long/podminky-ucasti-a-registrace/{lang}.md.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { getEntry, render } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const entry = (await getEntry('longPages', `podminky-ucasti-a-registrace/${lang}`))
  ?? (await getEntry('longPages', 'podminky-ucasti-a-registrace/cs'));
if (!entry) throw new Error('podminky markdown not found');
const { Content } = await render(entry);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: entry.data.breadcrumb },
];

const chapters = [
  { id: 'charakter-akce',     label: '1. Charakter akce',         icon: 'lucide:swords' },
  { id: 'registrace',         label: '2. Registrace',             icon: 'lucide:user-plus' },
  { id: 'registracni-poplatek', label: '3. Registrační poplatek', icon: 'lucide:credit-card' },
  { id: 'stravovani',         label: '4. Stravování',             icon: 'lucide:utensils' },
  { id: 'zmena-registrace',   label: '5. Změna registrace',       icon: 'lucide:edit' },
  { id: 'storno',             label: '6. Storno',                 icon: 'lucide:x-circle' },
  { id: 'zmena-mista',        label: '7. Změna místa',            icon: 'lucide:map-pin' },
  { id: 'zmena-terminu',      label: '8. Změna termínu',          icon: 'lucide:calendar' },
  { id: 'zruseni-vyssi-moc',  label: '9. Zrušení (vyšší moc)',    icon: 'lucide:cloud-rain' },
  { id: 'zruseni-poradatelem', label: '10. Zrušení pořadatelem',  icon: 'lucide:alert-triangle' },
  { id: 'omezeni-programu',   label: '11. Omezení programu',      icon: 'lucide:list-x' },
  { id: 'informovani',        label: '12. Informování',           icon: 'lucide:bell' },
  { id: 'vylouceni',          label: '13. Vyloučení účastníka',   icon: 'lucide:user-x' },
  { id: 'odpovednost',        label: '14. Odpovědnost',           icon: 'lucide:scale' },
  { id: 'zaverecna-ustanoveni', label: '15. Závěrečná ustanovení', icon: 'lucide:gavel' },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  breadcrumbs={[{ name: entry.data.breadcrumb, href: `/${lang}/podminky-ucasti-a-registrace/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {entry.data.title}
      </h1>
      {entry.data.hero_subtitle && (
        <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
          {entry.data.hero_subtitle}
        </p>
      )}
    </div>
  </section>

  <section class="py-12" data-toc-root>
    <div class="container-base">
      {lang !== 'cs' && (
        <div class="mb-8 max-w-3xl mx-auto">
          <AlertBox variant="info">
            {t('legal.lang_notice_pending')} {t('legal.jurisdiction_notice')}
          </AlertBox>
        </div>
      )}
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title="Obsah stránky" ariaLabel="Obsah podmínek účasti" />
        <article class="min-w-0 max-w-3xl prose-cookies">
          <Content />

          {entry.data.last_updated && (
            <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-8 italic">
              Poslední aktualizace: {entry.data.last_updated} · Platí pro: Pán Prstenů 2026
            </p>
          )}
        </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

</BaseLayout>
