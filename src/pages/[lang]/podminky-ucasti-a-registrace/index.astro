---
/**
 * Podmínky účasti, registrace, změny a zrušení akce
 * URL: /cs/podminky-ucasti-a-registrace/, …
 * Datum: 2026-04-30
 *
 * Pokrývá: registraci, registrační poplatek, stravování, změnu registrace,
 * storno, změnu místa konání, změnu termínu, zrušení akce z důvodu vyšší
 * moci nebo z rozhodnutí pořadatele, omezení programu, vyloučení účastníka.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const pageTitle = 'Podmínky účasti, registrace, změny a zrušení akce';

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Podmínky účasti a registrace' },
];

const chapters = [
  { id: 'charakter-akce',     label: 'Charakter akce',         icon: 'lucide:swords' },
  { id: 'registrace',         label: 'Registrace',             icon: 'lucide:user-plus' },
  { id: 'registracni-poplatek', label: 'Registrační poplatek', icon: 'lucide:credit-card' },
  { id: 'stravovani',         label: 'Stravování',             icon: 'lucide:utensils' },
  { id: 'zmena-registrace',   label: 'Změna registrace',       icon: 'lucide:edit' },
  { id: 'storno',             label: 'Storno',                 icon: 'lucide:x-circle' },
  { id: 'zmena-mista',        label: 'Změna místa',            icon: 'lucide:map-pin' },
  { id: 'zmena-terminu',      label: 'Změna termínu',          icon: 'lucide:calendar' },
  { id: 'zruseni-vyssi-moc',  label: 'Zrušení (vyšší moc)',    icon: 'lucide:cloud-rain' },
  { id: 'zruseni-poradatelem', label: 'Zrušení pořadatelem',   icon: 'lucide:alert-triangle' },
  { id: 'omezeni-programu',   label: 'Omezení programu',       icon: 'lucide:list-x' },
  { id: 'informovani',        label: 'Informování účastníků',  icon: 'lucide:bell' },
  { id: 'vylouceni',          label: 'Vyloučení účastníka',    icon: 'lucide:user-x' },
  { id: 'odpovednost',        label: 'Odpovědnost',            icon: 'lucide:scale' },
  { id: 'zaverecna-ustanoveni', label: 'Závěrečná ustanovení', icon: 'lucide:gavel' },
];
---

<BaseLayout
  title={t('page.terms.meta_title')}
  description={t('page.terms.meta_description')}
  lang={lang}
  breadcrumbs={[{ name: t('page.terms.bc_self'), href: `/${lang}/podminky-ucasti-a-registrace/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {pageTitle}
      </h1>
      <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        Pravidla pro registraci, platbu, storno, změny a případné zrušení akce.
        Krátká shrnutí nahoře, podrobnosti dole.
      </p>
    </div>
  </section>

  <section class="py-12" data-toc-root>
    <div class="container-base">
      {lang !== 'cs' && (
        <div class="mb-8 max-w-3xl mx-auto">
          <AlertBox variant="info">
            {t('legal.lang_notice_pending')} {t('legal.jurisdiction_notice')}
          </AlertBox>
        </div>
      )}
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title="Obsah stránky" ariaLabel="Obsah podmínek účasti" />
        <article class="min-w-0 max-w-3xl">

      <AlertBox variant="info" title="Nechceš číst celé podmínky?">
        Nejdůležitější praktické věci najdeš na stránkách
        <a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">Registrace</a>,
        <a href={`/${lang}/prakticke-info/`} class="underline text-[var(--color-gold-light)]">Praktické informace</a> a
        <a href={`/${lang}/pravidla/`} class="underline text-[var(--color-gold-light)]">Pravidla a bezpečnost</a>.
      </AlertBox>

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mt-8 mb-4">
        Tyto podmínky upravují základní pravidla účasti na akci
        <strong class="text-[var(--color-gold-light)]">Pán Prstenů — Bitva o Středozem</strong>,
        způsob registrace, platby registračního poplatku, storna, změny registrace
        a postup v případě změny nebo zrušení akce.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Akci pořádá <strong>Moravian LARP, z. s.</strong>, IČO
        <strong>22669167</strong>, spisová značka <strong>L 12656 vedená u Krajského
        soudu v Brně</strong>, se sídlem <strong>Starobrněnská 289/7, Brno-město,
        602 00 Brno</strong>. Kontaktní e-mail pořadatele:
        <a href="mailto:info@panprstenu.cz" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Účastí na akci se účastník zavazuje dodržovat pravidla akce, pokyny
        organizátorů a pravidla bezpečného chování. Pán Prstenů je hra, ne
        skutečná bitva. Přijíždíme si hrát, ne se zranit, hádat nebo někomu
        kazit víkend.
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 id="charakter-akce" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        1. Charakter akce
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pán Prstenů je vícedenní volnočasová larpová akce inspirovaná světem
        J. R. R. Tolkiena. Akce probíhá v konkrétním termínu a na konkrétním místě
        nebo v jeho náhradní lokalitě určené pořadatelem. Program akce se skládá
        zejména z příjezdu účastníků, táboření, doprovodného programu, dětské hry,
        hlavní sobotní hry/bitvy, večerního komunitního programu, balení a odjezdu.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Hlavní hra / hlavní bitva je určena pro hrající účastníky
        <strong class="text-[var(--color-gold-light)]">od 12 let</strong>. Pro mladší
        děti připravujeme samostatnou dětskou hru. Podrobné věkové podmínky jsou
        uvedeny v
        <a href={`/${lang}/organizacni-informace/`} class="underline text-[var(--color-gold-light)]">organizačních informacích</a>
        a v pravidlech pro účast nezletilých.
      </p>

      <h2 id="registrace" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        2. Registrace
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Účast na akci je možná pouze po řádné registraci prostřednictvím
        registračního systému nebo jiným způsobem výslovně určeným pořadatelem.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Registrace se stává závaznou po jejím odeslání a potvrzení ze strany
        registračního systému. Účastník je povinen uhradit registrační poplatek
        ve stanovené lhůtě a správně uvést platební údaje, zejména variabilní
        symbol nebo jiný identifikátor platby.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pokud registrační poplatek nebude uhrazen ve stanovené lhůtě, může být
        registrace zrušena a místo uvolněno dalším zájemcům.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Pořadatel si vyhrazuje právo odmítnout registraci nebo účast osoby,
        u níž existují důvodné pochybnosti o bezpečném průběhu účasti, schopnosti
        dodržovat pravidla akce nebo splnění podmínek účasti.
      </p>

      <h2 id="registracni-poplatek" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        3. Registrační poplatek
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Výše registračního poplatku je uvedena na stránce
        <a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">Registrace a platební informace</a>.
        Registrační poplatek slouží k zajištění akce, zejména k úhradě nákladů
        na pronájem a zajištění prostoru, technické a organizační vybavení,
        toalety, vodu, odpad, dopravu materiálu, zdravotnické zajištění, tisk
        a přípravu herních i organizačních podkladů, rekvizity a další náklady
        nutné pro přípravu a průběh akce.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Registrační poplatek <strong>není platbou za garantovaný počet bitev</strong>,
        konkrétní scénu, konkrétní roli, konkrétní umístění v tábořišti ani
        konkrétní podobu programu. Program může být z organizačních,
        bezpečnostních, povětrnostních nebo herních důvodů upraven.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Pořadatel se zavazuje připravit akci v dobré víře a s přiměřenou péčí.
        Zároveň platí, že jde o akci pořádanou v přírodním prostředí, kde mohou
        nastat okolnosti, které pořadatel nemůže plně ovlivnit.
      </p>

      <h2 id="stravovani" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        4. Stravování
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pořadatel přímo nezajišťuje individuální stravování účastníků.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Aby byl pobyt na akci pohodlnější, pořadatel domlouvá přítomnost hospody
        <strong class="text-[var(--color-gold-light)]">U Zeleného draka</strong>,
        která na místě zajišťuje možnost zakoupit jídlo a pití. Nabídka,
        provozní doba a dostupnost jednotlivých jídel se mohou řídit provozními
        možnostmi hospody.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Účastníkům doporučujeme mít s sebou vlastní základní rezervu jídla
        a pití, zejména pro případ pozdějšího příjezdu, specifických dietních
        potřeb, alergií nebo větší fyzické zátěže během hry.
      </p>

      <h2 id="zmena-registrace" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        5. Změna registrace účastníkem
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pokud se účastník nemůže akce zúčastnit, může požádat pořadatele o změnu
        nebo převod registrace na jinou osobu, pokud to organizační stav akce
        umožňuje.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Převod registrace na náhradníka je možný pouze po předchozí domluvě
        s pořadatelem. Náhradník musí splňovat všechny podmínky účasti, zejména
        věk, pravidla registrace a případně podmínky účasti nezletilých.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Pořadatel není povinen zajistit účastníkovi náhradníka, ale pokud je
        převod možný a administrativně proveditelný, pokusí se mu vyjít vstříc.
      </p>

      <h2 id="storno" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        6. Storno ze strany účastníka
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Storno podmínky jsou uvedeny na stránce
        <a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">Registrace a platební informace</a>.
        Pokud se účastník odhlásí ve lhůtě, pro kterou je stanoveno vrácení části
        nebo celé platby, pořadatel vrátí příslušnou část registračního poplatku
        podle aktuálně platných storno pravidel.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Po uplynutí stanovené lhůty již nemusí být registrační poplatek vracen,
        protože pořadatel s účastníkem počítá při přípravě akce a část nákladů
        již může být uhrazena nebo závazně objednána.
      </p>
      <AlertBox variant="info" class="mb-8">
        Pokud se nemůžeš dostavit, je lepší napsat pořadateli co nejdřív. Čím
        dřív se o změně dozvíme, tím větší je šance najít rozumné řešení.
      </AlertBox>

      <h2 id="zmena-mista" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        7. Změna místa konání
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pořadatel si vyhrazuje právo změnit místo konání akce, pokud je to nutné
        nebo vhodné z organizačních, bezpečnostních, povětrnostních, technických,
        právních nebo jiných vážných důvodů.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Změna místa konání v rámci České republiky, při zachování charakteru
        akce a jejího základního programu, nemá sama o sobě vliv na platnost
        registrace ani na výši registračního poplatku.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        V takovém případě zůstává registrace účastníka platná a automaticky se
        převádí na nové místo konání. Pořadatel bude účastníky o změně informovat
        e-mailem a zveřejní aktuální informace na webu akce.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Pokud by změna místa byla mimořádně zásadní a objektivně by významně
        měnila dostupnost nebo charakter akce, pořadatel může podle okolností
        nabídnout účastníkům individuální řešení, převod registrace, částečné
        vrácení poplatku nebo jiné férové vypořádání.
      </p>

      <h2 id="zmena-terminu" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        8. Změna termínu akce
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pořadatel si vyhrazuje právo změnit termín akce, pokud je to nutné
        z vážných organizačních, bezpečnostních, povětrnostních, technických,
        právních nebo jiných důvodů.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Při změně termínu bude registrace automaticky převedena na nový termín.
        Účastník tedy nemusí provádět novou registraci.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Chápeme však, že změna termínu může znamenat, že se účastník již nebude
        moci akce zúčastnit. Pokud účastníkovi nový termín nevyhovuje, může
        požádat o vrácení registračního poplatku. Pořadatel v takovém případě
        vrátí registrační poplatek v rozsahu, který odpovídá aktuálním možnostem
        a stavu vynaložených nákladů.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pokud ke změně termínu dojde s dostatečným předstihem a většina nákladů
        ještě nebyla vynaložena, pořadatel se bude snažit vrátit registrační
        poplatek v co nejvyšší možné výši.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Pokud ke změně termínu dojde krátce před akcí, kdy již byla část
        prostředků použita na přípravu, objednávky, pronájmy, materiál, dopravu
        nebo jiné nevratné náklady, může být vrácená částka snížena o poměrnou
        část již vynaložených nebo nevratných nákladů.
      </p>

      <h2 id="zruseni-vyssi-moc" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        9. Zrušení akce z důvodu vyšší moci
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Může nastat situace, kdy akci nebude možné uskutečnit z důvodů, které
        pořadatel nemohl ovlivnit ani jim při rozumné míře péče zabránit.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Jde zejména o mimořádné povětrnostní jevy, vichřici, bouřky, popadané
        stromy, poškození nebo znepřístupnění tábořiště, zásah orgánů veřejné
        moci, zákaz vstupu do lokality, mimořádná hygienická nebo bezpečnostní
        opatření, požár, povodeň, kalamitní stav, vážné poškození infrastruktury
        nebo jinou událost podobné povahy.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pokud bude akce z těchto důvodů zrušena, pořadatel bude postupovat tak,
        aby účastníkům vrátil co největší možnou část registračního poplatku.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Současně však účastník bere na vědomí, že zejména krátce před akcí již
        může být významná část registračních poplatků použita na přípravu akce.
        Některé náklady mohou být v té době již uhrazené, nevratné nebo závazně
        objednané (pronájem, doprava materiálu, technické zajištění, hygienické
        zázemí, toalety, voda, odpad, tisk, rekvizity, materiál, služby třetích
        stran nebo další organizační náklady).
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        V takovém případě pořadatel vrátí účastníkům tu část registračních
        poplatků, kterou bude možné po odečtení již vynaložených, nevratných
        nebo nutných nákladů spravedlivě rozdělit a vrátit.
      </p>
      <AlertBox variant="warning" class="mb-8">
        Nechceme na zrušené akci vydělávat. Zároveň ale nemůžeme z vlastních
        kapes znovu vytvořit peníze, které už byly v dobré víře utraceny za věci
        nutné pro přípravu akce a které kvůli vyšší moci nelze získat zpět.
      </AlertBox>

      <h2 id="zruseni-poradatelem" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        10. Zrušení akce z rozhodnutí pořadatele
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pokud by pořadatel akci zrušil z vlastního rozhodnutí bez toho, že by
        šlo o vyšší moc nebo jinou mimořádnou okolnost mimo jeho kontrolu, bude
        účastníkům vrácen registrační poplatek v co nejvyšší možné výši.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pořadatel může i v takovém případě zohlednit již vynaložené nevratné
        náklady, pokud vznikly v souvislosti s přípravou akce a nebylo možné
        je rozumně omezit. O způsobu vypořádání bude pořadatel účastníky
        informovat e-mailem.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Pokud to bude možné, může pořadatel místo vrácení platby nabídnout
        převod registrace na náhradní termín nebo další ročník. Účastník však
        nemusí takovou nabídku přijmout.
      </p>

      <h2 id="omezeni-programu" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
