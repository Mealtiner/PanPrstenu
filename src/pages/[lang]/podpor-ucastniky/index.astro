---
/**
 * Podpoř účastníky
 * URL: /cs/podpor-ucastniky/, /en/podpor-ucastniky/, ...
 * Datum: 2026-05-03
 *
 * Stránka pro účastníky a komunitu, kteří chtějí pomoct někomu jinému
 * přispěním na registrační poplatek nebo jinou formou. Citlivá komunikace,
 * individuální řešení.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const tp = getPageContent('podpor-ucastniky', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: tp('title') },
];
---

<BaseLayout
  title={tp('meta_title')}
  description={tp('description')}
  lang={lang}
  breadcrumbs={[{ name: tp('title'), href: `/${lang}/podpor-ucastniky/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {tp('title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {tp('subtitle')}
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('intro_p1')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {tp('intro_p2_pre')}<strong>{tp('intro_p2_strong1')}</strong>{tp('intro_p2_mid')}<strong>{tp('intro_p2_strong2')}</strong>{tp('intro_p2_post')}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 italic">
        {tp('intro_p3')}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
        {tp('h_options')}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
          <div class="flex items-center gap-2 font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] mb-2">
            <Icon name="lucide:user" class="w-4 h-4" aria-hidden="true" />
            {tp('opt_specific_title')}
          </div>
          <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            {tp('opt_specific_desc')}
          </p>
        </div>
        <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
          <div class="flex items-center gap-2 font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] mb-2">
            <Icon name="lucide:users" class="w-4 h-4" aria-hidden="true" />
            {tp('opt_general_title')}
          </div>
          <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            {tp('opt_general_desc')}
          </p>
        </div>
        <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5 sm:col-span-2">
          <div class="flex items-center gap-2 font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] mb-2">
            <Icon name="lucide:heart-handshake" class="w-4 h-4" aria-hidden="true" />
            {tp('opt_other_title')}
          </div>
          <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            {tp('opt_other_desc')}
          </p>
        </div>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
        {tp('h_how')}
      </h2>
      <ol class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-8">
        <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">1</span> <span>{tp('how_1_pre')}<a href="mailto:info@panprstenu.cz?subject=Podpor%C3%A1m%20%C3%BA%C4%8Dastn%C3%ADka" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>{tp('how_1_post')}</span></li>
        <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">2</span> <span>{tp('how_2')}</span></li>
        <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">3</span> <span>{tp('how_3')}</span></li>
        <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">4</span> <span>{tp('how_4')}</span></li>
      </ol>

      <AlertBox variant="info" class="mb-8">
        {tp('alert')}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
        {tp('h_related')}
      </h2>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li><a href={`/${lang}/registrace/kdyz-je-poplatek-problem/`} class="underline text-[var(--color-gold-light)]">{tp('rel_1_label')}</a>{tp('rel_1_post')}</li>
        <li><a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">{tp('rel_2_label')}</a>{tp('rel_2_post')}</li>
        <li><a href={`/${lang}/poradatel/`} class="underline text-[var(--color-gold-light)]">{tp('rel_3_label')}</a>{tp('rel_3_post')}</li>
        <li><a href={`/${lang}/kontakt/`} class="underline text-[var(--color-gold-light)]">{tp('rel_4_label')}</a>{tp('rel_4_post')}</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-6" />

      <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          {tp('cta_heading')}
        </h2>
        <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
          {tp('cta_body')}
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <Button href="mailto:info@panprstenu.cz?subject=Podpor%C3%A1m%20%C3%BA%C4%8Dastn%C3%ADka" variant="primary" size="md" icon="lucide:arrow-right">
            {tp('btn_support')}
          </Button>
          <Button href={`/${lang}/registrace/`} variant="secondary" size="md">
            {tp('btn_registration')}
          </Button>
        </div>
      </div>

    </article>
  </section>

</BaseLayout>
