---
/**
 * Ohlasy účastníků
 * URL: /cs/ohlasy/, …
 * Datum: 2026-05-03
 *
 * Stub stránka — citáty, zkušenosti a krátké příběhy z minulých ročníků.
 * Reálné ohlasy doplníme postupně, jakmile sesbíráme.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Quote from '@components/blocks/Quote.astro';
import Divider from '@components/decorative/Divider.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.testimonials.title') },
];

const ohlasy = [
  { text: t('page.testimonials.q1_text'), author: t('page.testimonials.q1_author') },
  { text: t('page.testimonials.q2_text'), author: t('page.testimonials.q2_author') },
  { text: t('page.testimonials.q3_text'), author: t('page.testimonials.q3_author') },
];
---

<BaseLayout
  title={t('page.testimonials.meta_title')}
  description={t('page.testimonials.description')}
  lang={lang}
  breadcrumbs={[{ name: t('page.testimonials.title'), href: `/${lang}/ohlasy/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.testimonials.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {t('page.testimonials.subtitle')}
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-base max-w-3xl">

      <AlertBox variant="info" title={t('page.testimonials.alert_title')}>
        {t('page.testimonials.alert_pre')}<a href="mailto:info@panprstenu.cz?subject=Ohlas%20%E2%80%94%20P%C3%A1n%20Prsten%C5%AF" class="underline">info@panprstenu.cz</a>{t('page.testimonials.alert_post')}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <div class="space-y-8">
        {ohlasy.map((o) => (
          <Quote author={o.author} tone="dark">
            {o.text}
          </Quote>
        ))}
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          {t('page.testimonials.cta_heading')}
        </h2>
        <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
          {t('page.testimonials.cta_body')}
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <Button href={`/${lang}/registrace/`} variant="primary" size="md" icon="lucide:arrow-right">{t('page.testimonials.btn_register')}</Button>
          <Button href={`/${lang}/galerie/`} variant="secondary" size="md" icon="lucide:image">{t('page.testimonials.btn_gallery')}</Button>
          <Button href={`/${lang}/minule-rocniky/`} variant="ghost" size="md" icon="lucide:scroll-text">{t('page.testimonials.btn_past')}</Button>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
