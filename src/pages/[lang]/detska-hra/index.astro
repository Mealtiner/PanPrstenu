---
/**
 * Dětská hra / Hra pro malé dobrodruhy
 * URL: /cs/detska-hra/, …
 * Datum: 2026-05-03
 *
 * Obsah verze v2 (z balíčku „Další role v2"). Samostatný program pro děti
 * přibližně 5–9 let (max ~10 let). Mladší 3–5 let jen s doprovodem rodiče.
 * Hlavní hra je 12+. Stránka má sidebar shodný s detaily armád / dalších
 * rolí (FactionRolesSidebar, currentSection='role', currentSlug='detska-hra').
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import EmblemMedallion from '@components/decorative/EmblemMedallion.astro';
import Divider from '@components/decorative/Divider.astro';
import FactionRolesSidebar from '@components/blocks/FactionRolesSidebar.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import { Icon } from 'astro-icon/components';
import type { Lang, TranslationKey } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.factions.title'), href: `/${lang}/frakce/` },
  { label: t('page.kids.title') },
];

type ProgramRow = {
  dayKey: TranslationKey;
  timeKey: TranslationKey;
  titleKey: TranslationKey;
  descKey: TranslationKey;
  audienceKey: TranslationKey;
  highlight?: boolean;
};

const program: ProgramRow[] = [
  {
    dayKey: 'page.kids.p1_day',
    timeKey: 'page.kids.p1_time',
    titleKey: 'page.kids.p1_title',
    descKey: 'page.kids.p1_desc',
    audienceKey: 'page.kids.p1_audience',
  },
  {
    dayKey: 'page.kids.p2_day',
    timeKey: 'page.kids.p2_time',
    titleKey: 'page.kids.p2_title',
    descKey: 'page.kids.p2_desc',
    audienceKey: 'page.kids.p2_audience',
  },
  {
    dayKey: 'page.kids.p3_day',
    timeKey: 'page.kids.p3_time',
    titleKey: 'page.kids.p3_title',
    descKey: 'page.kids.p3_desc',
    audienceKey: 'page.kids.p3_audience',
  },
  {
    dayKey: 'page.kids.p4_day',
    timeKey: 'page.kids.p4_time',
    titleKey: 'page.kids.p4_title',
    descKey: 'page.kids.p4_desc',
    audienceKey: 'page.kids.p4_audience',
    highlight: true,
  },
  {
    dayKey: 'page.kids.p5_day',
    timeKey: 'page.kids.p5_time',
    titleKey: 'page.kids.p5_title',
    descKey: 'page.kids.p5_desc',
    audienceKey: 'page.kids.p5_audience',
  },
];
---

<BaseLayout
  title={t('page.kids.meta_title')}
  description={t('page.kids.description')}
  lang={lang}
  breadcrumbs={[
    { name: t('page.factions.title'), href: `/${lang}/frakce/` },
    { name: t('page.kids.title'), href: `/${lang}/detska-hra/` },
  ]}
>

  <!-- Hero -->
  <section class="relative py-16 md:py-24 overflow-hidden bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base relative">
      <Breadcrumb items={breadcrumbItems} class="mb-8" />

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <EmblemMedallion symbol="✨" size={140} tone="gold" class="flex-shrink-0" />

        <div class="flex-1 text-center md:text-left">
          <Tag variant="gold" size="md" class="mb-4">{t('page.kids.tag')}</Tag>
          <h1 class="font-[family-name:var(--font-display)] text-5xl md:text-6xl uppercase tracking-wider text-[var(--color-gold-light)] leading-none mb-3">
            {t('page.kids.title')}
          </h1>
          <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-text-on-dark-muted)]">
            {t('page.kids.subtitle')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">

        <FactionRolesSidebar
          lang={lang}
          currentSlug="detska-hra"
          currentSection="role"
        />

        <article class="max-w-3xl">

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.kids.h_who')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {t('page.kids.who_p1')}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
            {t('page.kids.who_p2_pre')}<strong>{t('page.kids.who_p2_strong')}</strong>{t('page.kids.who_p2_post')}
          </p>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
            {t('page.kids.h_age')}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
              <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-side-free-text)] mb-2">{t('page.kids.age_card1_title')}</div>
              <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
                {t('page.kids.age_card1_p')}
              </p>
            </div>
            <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
              <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] mb-2">{t('page.kids.age_card2_title')}</div>
              <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
                {t('page.kids.age_card2_p')}
              </p>
            </div>
          </div>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 italic">
            {t('page.kids.age_note')}
          </p>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <!-- 60 sekund box -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-6 mb-10">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
              <Icon name="lucide:clock" class="w-5 h-5" aria-hidden="true" />
              {t('page.kids.h_60s')}
            </h2>
            <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1.5">
              <li>{t('page.kids.s60_l1')}</li>
              <li>{t('page.kids.s60_l2')}</li>
              <li>{t('page.kids.s60_l3_pre')}<strong>{t('page.kids.s60_l3_strong')}</strong>{t('page.kids.s60_l3_post')}</li>
              <li>{t('page.kids.s60_l4')}</li>
              <li>{t('page.kids.s60_l5')}</li>
              <li>{t('page.kids.s60_l6')}</li>
              <li>{t('page.kids.s60_l7')}</li>
              <li>{t('page.kids.s60_l8')}</li>
            </ul>
          </div>

          <h2 id="program" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
            {t('page.kids.h_program')}
          </h2>
          <p class="text-[var(--color-text-on-dark-muted)] mb-6 italic">
            {t('page.kids.program_note')}
          </p>

          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b-2 border-[var(--color-gold-darkest)]">
                  <th class="text-left py-3 pr-4 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)] whitespace-nowrap">{t('page.kids.th_day')}</th>
                  <th class="text-left py-3 pr-4 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)] whitespace-nowrap">{t('page.kids.th_time')}</th>
                  <th class="text-left py-3 pr-4 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)]">{t('page.kids.th_activity')}</th>
                  <th class="text-left py-3 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)]">{t('page.kids.th_audience')}</th>
                </tr>
              </thead>
              <tbody class="text-[var(--color-text-on-dark)]">
                {program.map((p) => (
                  <tr class:list={[
                    'border-b border-[var(--color-gold-darkest)]/40',
                    p.highlight ? 'bg-[var(--color-bg-darkest)]/60' : '',
                  ]}>
                    <td class="py-3 pr-4 whitespace-nowrap"><strong class="text-[var(--color-gold-light)]">{t(p.dayKey)}</strong></td>
                    <td class="py-3 pr-4 whitespace-nowrap text-[var(--color-text-on-dark-muted)]">{t(p.timeKey)}</td>
                    <td class="py-3 pr-4">
                      <strong class="text-[var(--color-text-on-dark)]">{t(p.titleKey)}</strong>
                      <div class="text-xs text-[var(--color-text-on-dark-muted)] mt-0.5">{t(p.descKey)}</div>
                    </td>
                    <td class="py-3 text-xs text-[var(--color-text-on-dark-muted)]">{t(p.audienceKey)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <AlertBox variant="info" class="mb-10">
            {t('page.kids.program_alert_pre')}<strong>{t('page.kids.program_alert_strong')}</strong>
          </AlertBox>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 id="co-deti-ceka" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
            {t('page.kids.h_what')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {t('page.kids.what_p1')}
          </p>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.kids.what_intro')}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8 columns-1 sm:columns-2">
            <li>{t('page.kids.what_l1')}</li>
            <li>{t('page.kids.what_l2')}</li>
            <li>{t('page.kids.what_l3')}</li>
            <li>{t('page.kids.what_l4')}</li>
            <li>{t('page.kids.what_l5')}</li>
            <li>{t('page.kids.what_l6')}</li>
            <li>{t('page.kids.what_l7')}</li>
            <li>{t('page.kids.what_l8')}</li>
            <li>{t('page.kids.what_l9')}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <!-- Pro rodiče -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-6 mb-10">
            <h2 id="pro-rodice" class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2 scroll-mt-24">
              <Icon name="lucide:users" class="w-5 h-5" aria-hidden="true" />
              {t('page.kids.parents_h')}
            </h2>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {t('page.kids.parents_p1')}
            </p>
            <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1 mb-4">
              <li>{t('page.kids.parents_l1')}</li>
              <li>{t('page.kids.parents_l2')}</li>
              <li>{t('page.kids.parents_l3')}</li>
              <li>{t('page.kids.parents_l4')}</li>
              <li>{t('page.kids.parents_l5')}</li>
            </ul>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
              {t('page.kids.parents_p2')}
            </p>
            <p class="text-sm text-[var(--color-text-on-dark)] italic mb-4">
              {t('page.kids.parents_p3')}
            </p>
            <a href={`/${lang}/pro-rodice/`} class="inline-flex items-center gap-2 text-sm text-[var(--color-gold-light)] underline hover:text-[var(--color-gold)]">
              <Icon name="lucide:arrow-right" class="w-4 h-4" aria-hidden="true" />
              {t('page.kids.parents_link')}
            </a>
          </div>

          <h2 id="kostym" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
            {t('page.kids.h_costume')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.kids.cos_intro')}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4 columns-1 sm:columns-2">
            <li>{t('page.kids.cos_l1')}</li>
            <li>{t('page.kids.cos_l2')}</li>
            <li>{t('page.kids.cos_l3')}</li>
            <li>{t('page.kids.cos_l4')}</li>
            <li>{t('page.kids.cos_l5')}</li>
            <li>{t('page.kids.cos_l6')}</li>
            <li>{t('page.kids.cos_l7')}</li>
            <li>{t('page.kids.cos_l8')}</li>
          </ul>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4 italic">
            {t('page.kids.cos_note')}
          </p>

          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3 mt-6">
            {t('page.kids.h_take')}
          </h3>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8 columns-1 sm:columns-2">
            <li>{t('page.kids.take_l1')}</li>
            <li>{t('page.kids.take_l2')}</li>
            <li>{t('page.kids.take_l3')}</li>
            <li>{t('page.kids.take_l4')}</li>
            <li>{t('page.kids.take_l5')}</li>
            <li>{t('page.kids.take_l6')}</li>
            <li>{t('page.kids.take_l7')}</li>
            <li>{t('page.kids.take_l8')}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 id="bezpecnost" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
            {t('page.kids.h_safety')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
            {t('page.kids.safety_intro')}
          </p>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
            <li>{t('page.kids.safety_l1')}</li>
            <li>{t('page.kids.safety_l2')}</li>
            <li>{t('page.kids.safety_l3')}</li>
            <li>{t('page.kids.safety_l4')}</li>
            <li>{t('page.kids.safety_l5')}</li>
            <li>{t('page.kids.safety_l6')}</li>
          </ul>
          <AlertBox variant="warning" class="mb-8">
            {t('page.kids.safety_alert_pre')}<strong>{t('page.kids.safety_alert_strong')}</strong>{t('page.kids.safety_alert_post')}
          </AlertBox>

          <Divider variant="line-diamond" tone="dark" class="my-8" />

          <h2 id="registrace" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
            {t('page.kids.h_register')}
          </h2>
          <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
            {t('page.kids.reg_p1')}
          </p>
          <ol class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-4">
            <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">1</span> <span>{t('page.kids.reg_step1')}</span></li>
            <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">2</span> <span>{t('page.kids.reg_step2')}</span></li>
            <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">3</span> <span>{t('page.kids.reg_step3_pre')}<strong>{t('page.kids.reg_step3_strong')}</strong>{t('page.kids.reg_step3_post')}</span></li>
            <li class="flex gap-3"><span class="flex-shrink-0 w-7 h-7 rounded-full border border-[var(--color-gold)] text-[var(--color-gold-light)] text-xs flex items-center justify-center">4</span> <span>{t('page.kids.reg_step4_pre')}<a href="mailto:info@panprstenu.cz?subject=D%C4%9Btsk%C3%A1%20hra%20%E2%80%94%20registrace" class="underline text-[var(--color-gold-light)]">info@panprstenu.cz</a>{t('page.kids.reg_step4_post')}</span></li>
          </ol>
          <AlertBox variant="info" class="mb-8">
            {t('page.kids.reg_alert')}
          </AlertBox>

          <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
            {t('page.kids.h_links')}
          </h2>
          <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
            <li><a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">{t('page.kids.link1_label')}</a>{t('page.kids.link1_post')}</li>
            <li><a href={`/${lang}/prakticke-info/`} class="underline text-[var(--color-gold-light)]">{t('page.kids.link2_label')}</a>{t('page.kids.link2_post')}</li>
            <li><a href={`/${lang}/pro-novacky/`} class="underline text-[var(--color-gold-light)]">{t('page.kids.link3_label')}</a>{t('page.kids.link3_post')}</li>
            <li><a href={`/${lang}/hra-v-tabore/`} class="underline text-[var(--color-gold-light)]">{t('page.kids.link4_label')}</a>{t('page.kids.link4_post')}</li>
            <li><a href={`/${lang}/pravidla/`} class="underline text-[var(--color-gold-light)]">{t('page.kids.link5_label')}</a>{t('page.kids.link5_post')}</li>
            <li><a href={`/${lang}/kontakt/`} class="underline text-[var(--color-gold-light)]">{t('page.kids.link6_label')}</a>{t('page.kids.link6_post')}</li>
          </ul>

          <Divider variant="line-diamond" tone="dark" class="my-6" />

          <!-- Závěrečné CTA -->
          <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
            <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
              {t('page.kids.cta_heading')}
            </h2>
            <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
              {t('page.kids.cta_body')}
            </p>
            <div class="flex flex-wrap gap-3 justify-center">
              <Button href={`/${lang}/registrace/`} variant="primary" size="md" icon="lucide:arrow-right">
                {t('page.kids.cta_btn_register')}
              </Button>
              <Button href="mailto:info@panprstenu.cz?subject=D%C4%9Btsk%C3%A1%20hra" variant="secondary" size="md">
                {t('page.kids.cta_btn_ask')}
              </Button>
            </div>
          </div>

          <p class="text-xs text-[var(--color-text-on-dark-muted)] text-center mt-12 italic">
            {t('page.kids.cta_footnote')}
          </p>

        </article>
      </div>
    </div>
  </section>

</BaseLayout>
