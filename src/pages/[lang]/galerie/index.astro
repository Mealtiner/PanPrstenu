---
/**
 * Galerie z předchozích ročníků
 * URL: /cs/galerie/, …
 * Datum: 2026-04-29
 *
 * Placeholder grid — reálné fotky doplnit do public/images/gallery/.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Tag from '@components/ui/Tag.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const tp = getPageContent('galerie', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.gallery') },
];

// Reálné fotky per ročník — naplň po dodání assetů do public/images/gallery/.
// Skrz prázdnost pole se grid nevykreslí a stránka ukáže jen
// „Galerie se připravuje" hlášku (bez 20 broken image linků).
type GalleryYear = { year: number; images: Array<{ src: string; alt: string }> };
const years: GalleryYear[] = [
  // {
  //   year: 2024,
  //   images: [
  //     { src: '/images/gallery/2024-01.jpg', alt: 'Bitva o Středozem 2024 — fotka 1' },
  //     ...
  //   ],
  // },
];
---

<BaseLayout
  title={t('nav.gallery')}
  description={tp('description')}
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('nav.gallery')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {tp('subtitle')}
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-base">

      <AlertBox variant="info" class="mb-10">
        {tp('alert_pre')}<a href={`/${lang}/frakce/`} class="underline">{tp('alert_link')}</a>{tp('alert_post')}
      </AlertBox>

      {years.length === 0 && (
        <div class="text-center py-12 border border-dashed border-[var(--color-gold-darkest)]">
          <Icon name="lucide:image" class="w-12 h-12 text-[var(--color-gold-darkest)] mx-auto mb-4" aria-hidden="true" />
          <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-2">
            {tp('empty_title')}
          </h2>
          <p class="text-sm text-[var(--color-text-on-dark-muted)] max-w-lg mx-auto">
            {tp('empty_pre')}<a href={`/${lang}/novinky/`} class="underline text-[var(--color-gold-light)]">{tp('empty_link')}</a>{tp('empty_post')}
          </p>
        </div>
      )}

      {years.map((y) => (
        <div class="mb-16">
          <header class="flex items-center justify-between flex-wrap gap-4 mb-6">
            <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] flex items-center gap-3">
              <Icon name="lucide:calendar" class="w-6 h-6 text-[var(--color-gold)]" />
              {tp('year_label')} {y.year}
            </h2>
            <Tag variant="gold" size="md">{y.images.length} {tp('photos_count_suffix')}</Tag>
          </header>
          <Divider variant="line-diamond" tone="dark" class="!my-2 mb-6" />

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
            {y.images.map((img) => (
              <a
                href={img.src}
                class="group relative aspect-square overflow-hidden bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors"
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  width="800"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  onerror="this.style.display='none'"
                />
                <span
                  class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 bg-[var(--color-bg-darkest)]/60 transition-opacity"
                  aria-hidden="true"
                >
                  <Icon name="lucide:zoom-in" class="w-5 h-5 text-[var(--color-gold-light)]" />
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

</BaseLayout>
