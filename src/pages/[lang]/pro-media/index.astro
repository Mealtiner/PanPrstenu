---
/**
 * Pro média / novináře — tisková stránka
 * URL: /cs/pro-media/, …
 * Datum: 2026-04-30
 *
 * Stručná, profesionální stránka pro novináře a média. Méně atmosféry,
 * více faktů. Odkazuje na pravidla pro fotografy.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Pro média' },
];
---

<BaseLayout
  title="Pro média a novináře"
  description="Tisková stránka akce Pán Prstenů — Bitva o Středozem. Základní fakta, kontakty pro média, podmínky pro fotografování a natáčení, mediakit."
  lang={lang}
  breadcrumbs={[{ name: 'Pro média', href: `/${lang}/pro-media/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        Pro média a novináře
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Základní fakta, kontakt, podmínky pro reportáž z akce.
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base prose-readable">

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-2 mb-4">
        Krátký popis akce
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        <strong>Pán Prstenů — Bitva o Středozem</strong> je velká fantasy larpová bitva
        inspirovaná světem J. R. R. Tolkiena. Účastníci v kostýmech představují armády
        a národy Středozemě a zapojují se do celovíkendové hry s důrazem na atmosféru,
        bezpečnost, fair play a komunitní zážitek. Akci pořádá spolek
        <strong>Moravian LARP, z. s.</strong>
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-6" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        Základní fakta
      </h2>
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 mb-6 text-[var(--color-text-on-dark)]">
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Název akce</dt>
          <dd>Pán Prstenů — Bitva o Středozem</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Ročník</dt>
          <dd>2026</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Termín</dt>
          <dd>20.–23. 8. 2026 (čt–ne, hlavní bitva sobota)</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Místo</dt>
          <dd>Křtiny / Bukovina, jižní Morava</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Pořadatel</dt>
          <dd>Moravian LARP, z. s.</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Očekávaný počet účastníků</dt>
          <dd>~500</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Typ akce</dt>
          <dd>Larp / fantasy historicky inspirovaná bitva</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Věk hrajících</dt>
          <dd>12+ (pod 18 souhlas zástupce, pod 15 doprovod)</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Web</dt>
          <dd><a href="https://www.panprstenu.cz" class="underline">www.panprstenu.cz</a></dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">7 armád</dt>
          <dd>Gondor, Rohan, Elfové, Trpaslíci, Mordor, Isengard, Východňané</dd>
        </div>
      </dl>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        Kontakt pro média
      </h2>
      <div class="border border-[var(--color-gold)] bg-[var(--color-bg-medium)]/40 p-5 mb-6">
        <ul class="space-y-2 text-[var(--color-text-on-dark)]">
          <li>
            <strong>E-mail:</strong>
            <a href="mailto:info@panprstenu.cz?subject=M%C3%A9dia%20%E2%80%94%20Bitva%20o%20St%C5%99edozem" class="underline text-[var(--color-gold-light)]">
              info@panprstenu.cz
            </a>
          </li>
          <li>
            <strong>Telefon:</strong>
            <a href="tel:+420606369997" class="underline text-[var(--color-gold-light)]">
              606 369 997
            </a>
            (Mealtiner — hlavní organizátor)
          </li>
          <li><strong>Předmět e-mailu:</strong> „Média — Bitva o Středozem"</li>
        </ul>
        <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-3">
          Pro reportáže přímo na místě prosíme o akreditaci minimálně 7 dní předem.
          Sdělte typ média, plánovaný formát a počet osob.
        </p>
      </div>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        Co je možné fotit a natáčet
      </h2>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        <li>Obecné záběry akce a tábořiště.</li>
        <li>Kostýmy a atmosféru po domluvě s konkrétními účastníky.</li>
        <li>Nástupy armád a vyhlášení.</li>
        <li>Boj — pouze z bezpečné vzdálenosti, bez vstupu do herního území.</li>
      </ul>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-side-evil-text)] mt-8 mb-4">
        Co bez předchozí domluvy nelze
      </h2>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        <li>Vstupovat do probíhajícího boje.</li>
        <li>Překážet hráčům nebo organizátorům.</li>
        <li>Používat dron bez povolení organizátora.</li>
        <li>Komerčně využívat podobizny účastníků bez vlastního právního titulu (souhlasu zachycených).</li>
        <li>Fotit citlivé situace, zdravotní zásahy nebo děti nevhodným způsobem.</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mt-8 mb-4">
        Mediakit ke stažení
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Tisková zpráva, logo akce ve více variantách a fotografie z minulých ročníků
        v tiskové kvalitě jsou k dispozici na vyžádání. Pošlete e-mail a my vám obratem
        zašleme přímý odkaz.
      </p>

      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        <li>Logo (SVG, PNG transparentní pozadí, varianty pro tmavé/světlé pozadí)</li>
        <li>Tisková zpráva ročníku 2026 (PDF)</li>
        <li>Krátký popis akce (cca 150 a 500 slov)</li>
        <li>Reprezentativní fotografie z minulých ročníků (vysoké rozlišení, popisky)</li>
        <li>Kontakty pro média</li>
      </ul>

      <AlertBox variant="info" title="Související">
        <ul class="list-disc list-inside mt-2 space-y-1">
          <li><a href={`/${lang}/organizacni-informace/#foto-video`} class="underline">Pravidla pro fotografy a kameramany</a></li>
          <li><a href={`/${lang}/fotky-a-video/`} class="underline">Fotky a video — souhlasy účastníků</a></li>
          <li><a href={`/${lang}/pribeh/`} class="underline">Příběh ročníku 2026</a></li>
          <li><a href={`/${lang}/frakce/`} class="underline">Armády a strany</a></li>
          <li><a href={`/${lang}/organizacni-informace/`} class="underline">Organizační informace</a></li>
        </ul>
      </AlertBox>

    </article>
  </section>

</BaseLayout>
