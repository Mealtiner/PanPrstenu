---
/**
 * Jedu poprvé / Pro nováčky
 * URL: /cs/pro-novacky/, …
 * Datum: 2026-05-03
 *
 * Layout shodný se /pravidla/ — vlevo sticky sidebar s 10 kroky + slovníček
 * + kam dál + doporučené čtení, vpravo sekce s textem a CTA.
 * ScrollSpy zvýrazňuje aktivní krok podle pozice ve viewportu.
 *
 * Pojmosloví: armáda (ne frakce), strana (dvě hlavní strany), registrační
 * poplatek (ne vklad), zdravotník (ne zdravotnická služba). Tykání.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Jedu poprvé' },
];

// 10 kroků + extra sekce na konci. Single source of truth pro sidebar i obsah.
const steps = [
  { id: 'co-je',         num:  1, label: 'Co je Pán Prstenů',     icon: 'lucide:tent' },
  { id: 'co-je-larp',    num:  2, label: 'Co je LARP',            icon: 'lucide:drama' },
  { id: 'vhodnost',      num:  3, label: 'Je akce pro mě?',       icon: 'lucide:user-check' },
  { id: 'vek',           num:  4, label: 'Věk a účast',           icon: 'lucide:cake' },
  { id: 'vyber-frakce',  num:  5, label: 'Vyber si stranu a armádu', icon: 'lucide:flag' },
  { id: 'kostym',        num:  6, label: 'Kostým a vybavení',     icon: 'lucide:shirt' },
  { id: 'pravidla',      num:  7, label: 'Pravidla a bezpečnost', icon: 'lucide:shield-check' },
  { id: 'registrace',    num:  8, label: 'Registrace a platba',   icon: 'lucide:credit-card' },
  { id: 'prijezd',       num:  9, label: 'Příjezd a první den',   icon: 'lucide:map-pin' },
  { id: 'vikend',        num: 10, label: 'Víkend ve hře',         icon: 'lucide:calendar-days' },
];
const extras = [
  { id: 'slovnicek', label: 'Slovníček', icon: 'lucide:book-marked' },
  { id: 'kam-dal',   label: 'Kam dál',   icon: 'lucide:arrow-right' },
  { id: 'cteni',     label: 'Doporučené čtení', icon: 'lucide:book-open' },
];

// Cesty účastníka — krok 3
const audiences = [
  {
    icon: 'game-icons:crossed-swords',
    title: 'Chci bojovat',
    desc: 'Vybereš si stranu a armádu, připravíš si kostým, bezpečnou zbraň a zapojíš se do hlavní hry. Tohle je nejběžnější cesta.',
    ctas: [
      { label: 'Vybrat armádu', href: `/${lang}/frakce/`, primary: true },
      { label: 'Pravidla boje', href: `/${lang}/pravidla/#boj-zasahy` },
    ],
  },
  {
    icon: 'lucide:users',
    title: 'Nebojový doprovod',
    desc: 'Jsi ve hře a v kostýmu, ale nebojuješ. Bard, kronikář, zásobovač, doprovod bojovníka, táborová postava.',
    ctas: [{ label: 'Detail role', href: `/${lang}/role/nebojovy-doprovod/`, primary: true }],
  },
  {
    icon: 'lucide:baby',
    title: 'Jedu s dítětem',
    desc: 'Pro mladší děti máme samostatnou dětskou hru. Starší se za splnění podmínek mohou účastnit hlavní hry.',
    ctas: [
      { label: 'Pro rodiče', href: `/${lang}/pro-rodice/`, primary: true },
      { label: 'Dětská hra', href: `/${lang}/detska-hra/` },
    ],
  },
  {
    icon: 'lucide:camera',
    title: 'Chci fotit nebo natáčet',
    desc: 'Fotografové a kameramani jsou vítaní, ale i pro ně platí kostýmová povinnost. Pokud nemáš kostým, domluv se předem.',
    ctas: [
      { label: 'Detail role', href: `/${lang}/role/fotografove-a-kameramani/`, primary: true },
      { label: 'Fotky a video', href: `/${lang}/fotky-a-video/` },
    ],
  },
  {
    icon: 'lucide:hand-helping',
    title: 'Chci pomáhat',
    desc: 'Pomocníci se mohou zapojit s přípravou, registrací, programem nebo úklidem. Domluvíme slevu, odpuštění poplatku nebo zajištění stravy.',
    ctas: [
      { label: 'Detail role', href: `/${lang}/role/pomocnici/`, primary: true },
      { label: 'Napsat', href: 'mailto:info@panprstenu.cz?subject=Chci%20pom%C3%A1hat' },
    ],
  },
  {
    icon: 'lucide:store',
    title: 'Chci prodávat / nabídnout služby',
    desc: 'Stánkaři přijíždějí s tematickým sortimentem. Gastro je potřeba domluvit dopředu kvůli hospodě U Zeleného draka.',
    ctas: [
      { label: 'Stánky a prodejci', href: `/${lang}/stanky-a-prodejci/`, primary: true },
      { label: 'Stánkaři — role', href: `/${lang}/role/stankari/` },
    ],
  },
];

// Externí čtení — pomocné podle larp.cz
const externalReading = {
  zacatek: [
    { label: 'O larpu pro nováčky', href: 'https://www.larp.cz/?q=cs/clanek/506/o-larpu-pro-novacky' },
    { label: 'Před, na a po prvním larpu', href: 'https://www.larp.cz/?q=cs/clanek/6788/pred-na-a-po-prvnim-larpu' },
    { label: 'Moje první dřevárna', href: 'https://www.larp.cz/?q=cs/clanek/670/moje-prvni-drevarna' },
    { label: 'Role-play aneb já nejsem já', href: 'https://www.larp.cz/?q=cs/clanek/657/role-play-aneb-ja-nejsem-ja' },
    { label: 'Slovníček popisů dřevárek', href: 'https://www.larp.cz/?q=cs/clanek/658/slovnicek-popisu-drevaren' },
  ],
  kostym: [
    { label: 'Jak na kostým — začínáme', href: 'https://www.larp.cz/?q=cs/clanek/2623/jak-na-kostym-zaciname' },
    { label: 'Úvod do výroby kostýmu', href: 'https://www.larp.cz/?q=cs/clanek/680/uvod-do-vyroby-kostymu' },
    { label: 'Úvod do výroby kostýmu II', href: 'https://www.larp.cz/?q=cs/clanek/683/uvod-do-vyroby-kostymu-ii' },
    { label: 'Kostým by měl mít smysl I (posloupnost)', href: 'https://www.larp.cz/?q=cs/clanek/6818/i-kostym-na-larp-by-mel-mit-smysl-cast-i-%E2%80%93-posloupnost-porizovani' },
    { label: 'Kostým by měl mít smysl II (inspirace historií)', href: 'https://www.larp.cz/?q=cs/clanek/6807/i-kostym-na-larp-by-mel-mit-smysl-cast-ii-%E2%80%93-inspirace-historii' },
    { label: 'Charakter postavy a kostým', href: 'https://www.larp.cz/?q=cs/clanek/6824/charakter-postavy-a-kostym' },
    { label: 'Výroba tuniky', href: 'https://www.larp.cz/?q=cs/clanek/1435/vyroba-tuniky' },
    { label: 'Pokrývka hlavy', href: 'https://www.larp.cz/?q=cs/clanek/1613/pokryvka-hlavy' },
    { label: 'Návod na výrobu kožené čapky', href: 'https://www.larp.cz/?q=cs/clanek/3428/navod-na-vyrobu-kozene-capky' },
    { label: 'Obličej v barvách duhy', href: 'https://www.larp.cz/?q=cs/clanek/1330/oblicej-v-barvach-duhy' },
  ],
  vybava: [
    { label: 'Výbava pro „život" postavy', href: 'https://www.larp.cz/?q=cs/clanek/6790/vybava-pro-%E2%80%9Ezivot%E2%80%9D-postavy' },
    { label: 'Zavazadla', href: 'https://www.larp.cz/?q=cs/clanek/1685/zavazadla' },
    { label: 'Áčkový stan aneb od patlala pro patlaly', href: 'https://www.larp.cz/?q=cs/clanek/8988/ackovy-stan-aneb-od-patlala-pro-patlaly' },
  ],
  zbrane: [
    { label: 'Válečník a jeho mocný meč', href: 'https://www.larp.cz/?q=cs/clanek/1297/valecnik-a-jeho-mocny-mec' },
    { label: 'Výroba štítu', href: 'https://www.larp.cz/?q=cs/clanek/1149/vyroba-stitu' },
    { label: 'Návod na hlavici šípu', href: 'https://www.larp.cz/?q=cs/clanek/4143/navod-na-hlavici-sipu' },
    { label: 'Návody na LARP.cz', href: 'https://larp.cz/odkazy#navody' },
  ],
};

// Slovníček — krátké pojmy
const slovnicek = [
  { term: 'Organizátor / org', desc: 'Člověk, který akci připravuje a během akce rozhoduje sporné situace. Co řekne, platí.' },
  { term: 'Strana', desc: 'Velký příběhový blok. Na akci jsou dvě hlavní strany.' },
  { term: 'Armáda', desc: 'Konkrétní herní skupina. Např. Gondor, Rohan, Elfové, Trpaslíci, Skřeti, Harad, Umbar.' },
  { term: 'Panovník / velitel', desc: 'Herní vůdce armády nebo její části — drží skupinu pohromadě.' },
  { term: 'CP / cizí postava', desc: 'Postava řízená organizátory nebo pomocníky, která pomáhá příběhu a hře.' },
  { term: 'Životy', desc: 'Počet zásahů, které tvoje postava podle pravidel vydrží.' },
  { term: 'Oživení', desc: 'Návrat do hry podle pravidel konkrétní fáze.' },
  { term: 'Schvalování zbraní', desc: 'Kontrola, že je zbraň bezpečná a vhodná pro hru.' },
  { term: 'Schvalování kostýmu', desc: 'Kontrola, že kostým odpovídá atmosféře. Podle něj se může určit i počet životů.' },
  { term: 'Nebojový doprovod', desc: 'Účastník, který je ve hře a v kostýmu, ale nebojuje.' },
  { term: 'Registrační poplatek', desc: 'Poplatek za účast. Po registraci dostaneš platební údaje a je potřeba ho zaplatit do 10 dnů.' },
];
---

<BaseLayout
  title="Jedu poprvé"
  description="Praktický průvodce pro nováčka — co je akce, co je larp, výběr armády, kostým, pravidla, registrace, příjezd a víkend ve hře."
  lang={lang}
  breadcrumbs={[{ name: 'Jedu poprvé', href: `/${lang}/pro-novacky/` }]}
>

  <!-- Hero -->
  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        Jedu poprvé
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-3xl">
        Vítej ve Středozemi. Tady začíná tvoje první výprava — krok za krokem od prvního seznámení s akcí až po sobotní bitvu.
      </p>
    </div>
  </section>

  <!-- 60-sekundový souhrn -->
  <section class="py-8 bg-[var(--color-bg-medium)]/30 border-b border-[var(--color-gold-darkest)]/40">
    <div class="container-base max-w-4xl">
      <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] p-6">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
          <Icon name="lucide:clock" class="w-5 h-5" aria-hidden="true" />
          Nejrychlejší cesta v 60 sekundách
        </h2>
        <ol class="text-sm text-[var(--color-text-on-dark)] list-decimal list-inside space-y-1.5 grid grid-cols-1 md:grid-cols-2 gap-x-6">
          <li>Pán Prstenů je víkendová larpová bitva inspirovaná Středozemí.</li>
          <li>Hlavní bitva je v sobotu, program začíná už ve čtvrtek a v pátek.</li>
          <li>Hlavní hry se mohou účastnit hráči od 12 let.</li>
          <li>Účastníci mladší 18 let potřebují souhlas zákonného zástupce.</li>
          <li>Vyber si stranu a armádu.</li>
          <li>Připrav si kostým, boty, rukavice, vodu a vybavení na táboření.</li>
          <li>Pokud chceš bojovat, potřebuješ bezpečnou měkčenou zbraň.</li>
          <li>Přečti si pravidla — boj, zásahy, zbraně a bezpečnost.</li>
          <li>Zaregistruj se a zaplať registrační poplatek do 10 dnů.</li>
          <li>Po příjezdu projdeš registrací a kontrolou zbraní/kostýmu.</li>
        </ol>
        <div class="flex flex-wrap gap-3 mt-5">
          <Button href="#co-je" variant="primary" size="sm" icon="lucide:arrow-down">Začít krok za krokem</Button>
          <Button href={`/${lang}/registrace/`} variant="secondary" size="sm" icon="lucide:arrow-right">K registraci</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Hlavní obsah s levým sticky sidebarem -->
  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">

        <!-- LEVÝ STICKY SIDEBAR — kroky novacka -->
        <MobileSidebarShell tabLabel="Cesta" tabIcon="lucide:sparkles" ariaLabel="Cesta nováčka">
          <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-2">
            <span class="text-[var(--color-gold)] text-xs" aria-hidden="true">◆</span>
            Cesta nováčka
          </h3>
          <ul class="space-y-1 border-l border-[var(--color-gold-darkest)] text-sm" role="list">
            {steps.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  data-toc-link={s.id}
                  class="toc-spy-link -ml-px flex items-center gap-2 pl-3 py-2 border-l-2 border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)] hover:bg-[var(--color-gold)]/5 transition-all leading-tight"
                >
                  <span class="text-[10px] font-[family-name:var(--font-display)] text-[var(--color-gold)] tracking-widest w-6 shrink-0">{String(s.num).padStart(2, '0')}</span>
                  <Icon name={s.icon} class="w-3.5 h-3.5 opacity-70 shrink-0" aria-hidden="true" />
                  <span class="flex-1">{s.label}</span>
                </a>
              </li>
            ))}
            <li class="border-t border-[var(--color-gold-darkest)]/40 mt-3 pt-3"></li>
            {extras.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  data-toc-link={s.id}
                  class="toc-spy-link -ml-px flex items-center gap-2 pl-3 py-2 border-l-2 border-transparent text-[var(--color-text-on-dark-muted)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)] hover:bg-[var(--color-gold)]/5 transition-all leading-tight text-xs uppercase tracking-wider"
                >
                  <Icon name={s.icon} class="w-3.5 h-3.5 opacity-70 shrink-0" aria-hidden="true" />
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </MobileSidebarShell>

        <!-- PRAVÝ OBSAH — 10 sekcí + extras -->
        <article class="min-w-0 max-w-3xl">

          <!-- ============== KROK 1 ============== -->
          <section id="co-je" class="scroll-mt-24 mb-14">
            <div class="flex items-baseline gap-3 mb-4">
              <span class="font-[family-name:var(--font-display)] text-[var(--color-gold)] text-sm tracking-widest">KROK 01</span>
            </div>
            <h2 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
              Co je Pán Prstenů
            </h2>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
              Pán Prstenů je velká několikadenní larpová bitva inspirovaná světem Středozemě. Hráči se rozdělí do dvou hlavních <strong>stran</strong> a jednotlivých <strong>armád</strong>. Každá armáda má vlastní styl, barvy, kostýmy, atmosféru, místo v příběhu a způsob, jakým vstupuje do hry.
            </p>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
              Nejde jen o sobotní bitvu. Celý víkend začíná už dřív: příjezdem, stavěním tábořiště, registrací, setkáváním s ostatními, páteční hrou v táboře, jarmarkem, arénami, dětskou hrou, večerním životem v táboře a společnou atmosférou. <strong>Hlavní hra probíhá v sobotu</strong> — právě tehdy se střetnou armády a vrcholí celý ročník.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
              <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
                <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
                  <Icon name="lucide:users" class="w-4 h-4" aria-hidden="true" /> Akce je pro lidi, co chtějí…
                </h3>
                <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
                  <li>zažít fantasy víkend v přírodě,</li>
                  <li>obléct kostým a vstoupit do role,</li>
                  <li>bojovat bezpečnými měkčenými zbraněmi,</li>
                  <li>být součástí velké armády,</li>
                  <li>potkat komunitu hráčů z celé republiky,</li>
                  <li>užít si táborový život a večerní ohně.</li>
                </ul>
              </div>
              <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-5">
                <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 flex items-center gap-2">
                  <Icon name="lucide:sparkles" class="w-4 h-4" aria-hidden="true" /> Co tě čeká
                </h3>
                <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
                  <li>tábořiště a večerní oheň,</li>
                  <li>jarmark, arény a mikro questy,</li>
                  <li>páteční hra v táboře a večerní program,</li>
                  <li>sobotní hlavní hra a bitva,</li>
                  <li>nedělní balení a rozloučení.</li>
                </ul>
              </div>
            </div>

            <p class="text-[var(--color-text-on-dark-muted)] italic mb-4">
              Pokud se bojíš, že nikoho neznáš, neboj. Na takových akcích vznikají družiny rychleji, než by řekl hobit „druhá snídaně".
            </p>

            <div class="flex flex-wrap gap-3">
              <Button href={`/${lang}/prakticke-info/`} variant="primary" size="sm" icon="lucide:arrow-right">Praktické informace</Button>
              <Button href={`/${lang}/organizacni-informace/`} variant="secondary" size="sm" icon="lucide:arrow-right">Organizační informace</Button>
              <Button href={`/${lang}/fotky-a-video/`} variant="ghost" size="sm" icon="lucide:image">Fotky a video</Button>
            </div>
          </section>

          <Divider variant="line-diamond" tone="dark" class="my-10" />

          <!-- ============== KROK 2 ============== -->
          <section id="co-je-larp" class="scroll-mt-24 mb-14">
            <div class="flex items-baseline gap-3 mb-4">
              <span class="font-[family-name:var(--font-display)] text-[var(--color-gold)] text-sm tracking-widest">KROK 02</span>
            </div>
            <h2 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
              Co je LARP
            </h2>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
              LARP je hra naživo. Nepoužíváš figurku na stole ani postavu na monitoru — postavou se na chvíli stáváš ty sám.
            </p>
            <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
              Na Pánu Prstenů to znamená, že si vybereš armádu, připravíš kostým, vezmeš si vybavení, dorazíš do tábora a zapojíš se do společné hry. Někdo jede bojovat, někdo jako nebojový doprovod, někdo fotí, někdo pomáhá, někdo jede s dítětem. Všichni společně vytváříme atmosféru Středozemě.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
              <div class="bg-[var(--color-side-free)]/10 border border-[var(--color-side-free-text)]/40 p-4">
                <h3 class="font-[family-name:var(--font-display)] text-xs uppercase tracking-widest text-[var(--color-side-free-text)] mb-2 flex items-center gap-2">
                  <Icon name="lucide:check" class="w-4 h-4" aria-hidden="true" /> LARP je
                </h3>
                <ul class="text-sm text-[var(--color-text-on-dark)] list-disc list-inside space-y-1">
                  <li>hra ve světě se svými pravidly,</li>
                  <li>kostým, role a atmosféra,</li>
