---
/**
 * Jedu poprvé / Pro nováčky
 * URL: /cs/pro-novacky/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah z src/content/pages-long/pro-novacky/{lang}.md (markdown).
 * Sidebar steps generuje TocSidebar z H2 headings v markdownu (přes id).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { Icon } from 'astro-icon/components';
import { getEntry, render } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const entry = (await getEntry('longPages', `pro-novacky/${lang}`))
  ?? (await getEntry('longPages', 'pro-novacky/cs'));
if (!entry) throw new Error('pro-novacky markdown not found');
const { Content } = await render(entry);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: entry.data.breadcrumb },
];

// Sidebar — čteme z frontmatteru (chapters[]), aby byly labely lokalizované.
// Fallback na hardcoded CS, kdyby frontmatter `chapters` neměl (defensivně).
const chapters = entry.data.chapters ?? [
  { id: 'co-je',         label: '1. Co je Pán Prstenů',     icon: 'lucide:tent' },
  { id: 'co-je-larp',    label: '2. Co je LARP',            icon: 'lucide:drama' },
  { id: 'vhodnost',      label: '3. Je akce pro mě?',       icon: 'lucide:user-check' },
  { id: 'vek',           label: '4. Věk a účast',           icon: 'lucide:cake' },
  { id: 'vyber-frakce',  label: '5. Vyber stranu a armádu', icon: 'lucide:flag' },
  { id: 'kostym',        label: '6. Kostým a vybavení',     icon: 'lucide:shirt' },
  { id: 'pravidla',      label: '7. Pravidla a bezpečnost', icon: 'lucide:shield-check' },
  { id: 'registrace',    label: '8. Registrace a platba',   icon: 'lucide:credit-card' },
  { id: 'prijezd',       label: '9. Příjezd a první den',   icon: 'lucide:map-pin' },
  { id: 'vikend',        label: '10. Víkend ve hře',        icon: 'lucide:calendar-days' },
  { id: 'slovnicek',     label: 'Slovníček',                icon: 'lucide:book-marked' },
  { id: 'kam-dal',       label: 'Kam dál',                  icon: 'lucide:arrow-right' },
  { id: 'cteni',         label: 'Doporučené čtení',         icon: 'lucide:book-open' },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  breadcrumbs={[{ name: entry.data.breadcrumb, href: `/${lang}/pro-novacky/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {entry.data.title}
      </h1>
      {entry.data.hero_subtitle && (
        <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-3xl">
          {entry.data.hero_subtitle}
        </p>
      )}
    </div>
  </section>

  {entry.data.brief && (
    <section class="py-10 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
      <div class="container-base max-w-4xl">
        <div class="border-2 border-[var(--color-gold)] bg-[var(--color-bg-medium)]/40 p-6 md:p-8">
          <h2 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
            <Icon name="lucide:zap" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
            {entry.data.brief.h2}
          </h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-[var(--color-text-on-dark)]">
            {entry.data.brief.items.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-[var(--color-gold)] shrink-0 mt-1" aria-hidden="true">◆</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="py-12" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title={entry.data.toc_title} ariaLabel={entry.data.toc_aria} />
        <article class="min-w-0 max-w-3xl prose-cookies">
          <Content />
        </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

  <style is:global>
    .prose-cookies .newcomer-info-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin: 1.5rem 0 1.5rem;
    }

    .prose-cookies .newcomer-info-card {
      border: 1px solid var(--color-gold);
      background: color-mix(in srgb, var(--color-bg-darkest) 84%, var(--color-bg-medium));
      padding: 1.25rem;
    }

    .prose-cookies .newcomer-info-card-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0 0 0.875rem;
      font-family: var(--font-display);
      font-size: 0.875rem;
      line-height: 1.35;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-gold-light);
    }

    .prose-cookies .newcomer-info-card-title span {
      color: var(--color-gold);
      font-size: 0.75rem;
      line-height: 1;
    }

    .prose-cookies .newcomer-info-card ul {
      margin: 0;
      padding-left: 1.125rem;
      color: var(--color-text-on-dark);
      font-size: 0.95rem;
      line-height: 1.65;
    }

    .prose-cookies .newcomer-info-card li {
      padding-left: 0.125rem;
    }

    @media (min-width: 768px) {
      .prose-cookies .newcomer-info-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
      }
    }
  </style>

</BaseLayout>
