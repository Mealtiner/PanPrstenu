---
/**
 * Kontakt
 * URL: /cs/kontakt/, …
 * Datum: 2026-04-29
 *
 * MVP: kontaktní údaje + jednoduchý formulář (mailto fallback).
 * Reálný backend přijde později (M3+).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Input from '@components/ui/Input.astro';
import Textarea from '@components/ui/Textarea.astro';
import Checkbox from '@components/ui/Checkbox.astro';
import Button from '@components/ui/Button.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('kontakt', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: p.title },
];

const channels = [
  { icon: 'lucide:mail', label: 'Email', value: 'info@panprstenu.cz', href: 'mailto:info@panprstenu.cz' },
  { icon: 'lucide:facebook', label: 'Facebook', value: 'Moravian LARP', href: 'https://www.facebook.com/MoravianLARP' },
  { icon: 'lucide:globe', label: 'Web', value: 'www.panprstenu.cz', href: 'https://www.panprstenu.cz' },
];
---

<BaseLayout
  title={p.title}
  description={p.description}
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.title}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {p.subtitle}
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-12 max-w-6xl">

      <!-- Levá strana — kontaktní info -->
      <div>
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-6">
          {p.details_heading}
        </h2>

        <ul class="space-y-4 mb-8" role="list">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.href.startsWith('http') ? '_blank' : undefined}
                rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-start gap-4 p-4 border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 transition-all"
              >
                <span class="w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-full bg-[var(--color-bg-medium)] border border-[var(--color-gold)]/40">
                  <Icon name={c.icon} class="w-4 h-4 text-[var(--color-gold)]" />
                </span>
                <div class="flex-1 min-w-0">
                  <div class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)] mb-1">
                    {c.label}
                  </div>
                  <div class="text-base text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)] transition-colors break-all">
                    {c.value}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <Divider variant="line-diamond" tone="dark" class="my-8" />

        <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
          {p.organizer_heading}
        </h3>
        <p class="text-[var(--color-text-on-dark)] leading-relaxed">
          <strong class="text-[var(--color-gold-light)]">Moravian LARP, z. s.</strong><br />
          {p.organizer_legal}<br />
          {p.organizer_ico_label}: <strong>22669167</strong><br />
          {p.organizer_register_label}: {p.organizer_register_value}<br />
          {p.organizer_address_label}: {p.organizer_address_value}
        </p>
      </div>

      <!-- Pravá strana — formulář -->
      <div>
        <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-widest text-[var(--color-gold-light)] mb-6">
          {p.form_heading}
        </h2>

        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5"
        >
          {/* Web3Forms required fields */}
          <input type="hidden" name="access_key" value="706b0224-787a-479f-b91a-f1681f538784" />
          <input type="hidden" name="from_name" value="Pán Prstenů — kontaktní formulář" />
          <input type="hidden" name="subject" value="Nová zpráva z kontaktního formuláře" />
          <input type="hidden" name="redirect" value="false" />

          {/* Honeypot — pole skryté pro lidi (CSS), boti ho často vyplní */}
          <div class="hidden" aria-hidden="true">
            <label>
              Nevyplňujte (anti-spam):
              <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <Input id="contact-name" name="name" label={p['form.name_label']} placeholder={p['form.name_placeholder']} required />
          <Input id="contact-email" name="email" type="email" label={p['form.email_label']} placeholder={p['form.email_placeholder']} required autocomplete="email" />
          <Input id="contact-subject" name="user_subject" label={p['form.subject_label']} placeholder={p['form.subject_placeholder']} />
          <Textarea id="contact-message" name="message" label={p['form.message_label']} placeholder={p['form.message_placeholder']} rows={6} required />
          <Checkbox
            id="contact-gdpr"
            name="gdpr_consent"
            label={p['form.gdpr_label']}
            required
          />

          {/* hCaptcha widget — Web3Forms public sitekey, vrací h-captcha-response token */}
          <div class="h-captcha" data-sitekey="50b2fe65-b00b-4b9e-ad62-3ba471098be2"></div>

          {/* Status hlášky — odhalí se podle JS state */}
          <div id="contact-status" class="hidden p-4 border" role="status" aria-live="polite"></div>

          <Button variant="primary" size="lg" type="submit" icon="lucide:send" iconPosition="right">
            {p['form.submit']}
          </Button>
        </form>

        <!-- hCaptcha API — async defer, načte widget definovaný výše -->
        <script src="https://js.hcaptcha.com/1/api.js" async defer is:inline></script>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  /**
   * Web3Forms async submit handler.
   * - access_key v hidden inputu (nebezpečné z hlediska key leak, ale Web3Forms
   *   to tak doporučuje a klíč je rate-limited per email)
   * - honeypot field "botcheck" — pokud bot vyplní, Web3Forms zprávu odmítne
   * - po success: form reset + zelená hláška, po error: červená hláška
   * - bez JS: form se odešle nativně přes POST na Web3Forms (JS jen UX)
   */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status') as HTMLDivElement | null;
  if (form && status) {
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = submitBtn?.textContent?.trim() ?? 'Odeslat';

    function showStatus(kind: 'success' | 'error', message: string) {
      if (!status) return;
      status.className =
        kind === 'success'
          ? 'p-4 border border-[var(--color-state-success)] bg-[var(--color-state-success)]/10 text-[var(--color-state-success-text,var(--color-text-on-dark))]'
          : 'p-4 border border-[var(--color-state-danger)] bg-[var(--color-state-danger)]/10 text-[var(--color-state-danger-text,var(--color-text-on-dark))]';
      status.textContent = message;
      status.classList.remove('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status?.classList.add('hidden');

      // Validace hCaptcha — pole `h-captcha-response` je vyplněné jen po
      // úspěšné verifikaci v hCaptcha widgetu (klik na checkbox + případný
      // image challenge). Bez něj Web3Forms zprávu odmítne.
      const captchaInput = form.querySelector<HTMLTextAreaElement>('textarea[name="h-captcha-response"]');
      if (!captchaInput || !captchaInput.value) {
        showStatus('error', 'Prosím potvrď, že nejsi robot — klikni na pole „Nejsem robot" výše.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-busy', 'true');
        const labelEl = submitBtn.querySelector('span');
        if (labelEl) labelEl.textContent = 'Odesílám…';
        else submitBtn.textContent = 'Odesílám…';
      }

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });
        const data = await response.json();

        if (response.ok && data.success) {
          showStatus(
            'success',
            'Děkujeme! Zpráva byla odeslána na info@panprstenu.cz. Potvrzovací e-mail jsme poslali i na tvou adresu.'
          );
          form.reset();
        } else {
          showStatus(
            'error',
            'Něco se pokazilo: ' + (data.message ?? 'neznámá chyba') + '. Zkus to prosím znovu, nebo nám napiš přímo na info@panprstenu.cz.'
          );
        }
      } catch (err) {
        showStatus(
          'error',
          'Spojení selhalo. Zkontroluj připojení a zkus to znovu, nebo nám napiš přímo na info@panprstenu.cz.'
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-busy');
          const labelEl = submitBtn.querySelector('span');
          if (labelEl) labelEl.textContent = submitLabel;
          else submitBtn.textContent = submitLabel;
        }
      }
    });
  }
</script>
