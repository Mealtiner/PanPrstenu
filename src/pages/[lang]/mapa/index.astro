---
/**
 * Mapa areálu a orientace
 * URL: /cs/mapa/, …
 * Datum: 2026-04-30
 *
 * Praktická orientační stránka — GPS, embed Google Maps, body areálu.
 * Detail cestovních pokynů je v /[lang]/organizacni-informace/#doprava.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const tp = getPageContent('mapa', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: tp('title') },
];

// Body areálu — detailní mapa s rozmístěním ohnišť, registrace, hospody atd.
// dorazí 14 dnů před akcí. Tady necháváme strukturu jako placeholder.
const arealPoints = [
  { icon: 'lucide:user-plus', name: tp('point_registration_name'), desc: tp('point_registration_desc') },
  { icon: 'lucide:heart-pulse', name: tp('point_medic_name'), desc: tp('point_medic_desc') },
  { icon: 'lucide:beer', name: tp('point_pub_name'), desc: tp('point_pub_desc') },
  { icon: 'lucide:droplet', name: tp('point_water_name'), desc: tp('point_water_desc') },
  { icon: 'lucide:toilet', name: tp('point_toilets_name'), desc: tp('point_toilets_desc') },
  { icon: 'lucide:car', name: tp('point_parking_name'), desc: tp('point_parking_desc') },
  { icon: 'lucide:tent', name: tp('point_camp_name'), desc: tp('point_camp_desc') },
  { icon: 'lucide:store', name: tp('point_market_name'), desc: tp('point_market_desc') },
  { icon: 'game-icons:crossed-swords', name: tp('point_game_name'), desc: tp('point_game_desc') },
  { icon: 'lucide:flame', name: tp('point_fire_name'), desc: tp('point_fire_desc') },
  { icon: 'lucide:trash-2', name: tp('point_waste_name'), desc: tp('point_waste_desc') },
];
---

<BaseLayout
  title={tp('title')}
  description={tp('description')}
  lang={lang}
  breadcrumbs={[{ name: tp('title'), href: `/${lang}/mapa/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {tp('title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {tp('subtitle')}
      </p>
    </div>
  </section>

  <!-- GPS + odkaz -->
  <section class="py-10 bg-[var(--color-bg-dark)]">
    <div class="container-base max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="border border-[var(--color-gold-darkest)] p-5">
          <div class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)] mb-1">{tp('gps_label')}</div>
          <code class="text-[var(--color-gold-light)] text-base break-all">49.29895232776445, 16.759155153131733</code>
          <div class="text-sm text-[var(--color-text-on-dark-muted)] mt-2">{tp('location_text')}</div>
        </div>
        <div class="border border-[var(--color-gold-darkest)] p-5 flex flex-col gap-3 justify-center">
          <a
            href="https://www.google.com/maps?q=49.29895232776445,16.759155153131733"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-[var(--color-gold-light)] hover:text-[var(--color-gold)] underline"
          >
            <Icon name="lucide:external-link" class="w-4 h-4" aria-hidden="true" />
            {tp('open_google')}
          </a>
          <a
            href="https://mapy.cz/zakladni?source=coor&id=16.759155%2C49.298952"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-[var(--color-gold-light)] hover:text-[var(--color-gold)] underline"
          >
            <Icon name="lucide:external-link" class="w-4 h-4" aria-hidden="true" />
            {tp('open_mapy')}
          </a>
        </div>
      </div>

      <!-- Embed mapy -->
      <div class="aspect-video w-full mb-6 border border-[var(--color-gold-darkest)] overflow-hidden">
        <iframe
          src="https://www.google.com/maps/d/embed?mid=1zIrsa8-VoEGKD4Zkx32Y4lmM9Lp5IIs&ehbc=2E312F"
          width="100%"
          height="100%"
          style="border:0; display:block; min-height:480px;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={tp('iframe_title')}
        ></iframe>
      </div>
      <p class="text-xs text-[var(--color-text-on-dark-muted)] italic">
        {tp('iframe_note')}
      </p>
    </div>
  </section>

  <!-- Body areálu -->
  <section class="py-12 bg-[var(--color-bg-darkest)]">
    <div class="container-base max-w-5xl">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 text-center">
        {tp('points_heading')}
      </h2>
      <Divider variant="ornament" tone="dark" class="mb-10" />

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" role="list">
        {arealPoints.map((p) => (
          <li class="flex items-start gap-3 border border-[var(--color-gold-darkest)] p-4 bg-[var(--color-bg-medium)]/30">
            <span class="w-10 h-10 shrink-0 flex items-center justify-center rounded-full bg-[var(--color-bg-darkest)] border border-[var(--color-gold)]/40">
              <Icon name={p.icon} class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
            </span>
            <div class="flex-1 min-w-0">
              <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)]">
                {p.name}
              </div>
              <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-1 leading-snug">
                {p.desc}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Doprava — přehled cest na místo + autobusové zastávky.
       Kompaktnější verze sekce z /organizacni-informace/#doprava (link na detail). -->
  <section class="py-12 bg-[var(--color-bg-dark)] border-t border-[var(--color-gold-darkest)]">
    <div class="container-base max-w-5xl">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 text-center">
        {tp('transport_h2')}
      </h2>
      <p class="font-[family-name:var(--font-serif)] italic text-base text-[var(--color-text-on-dark-muted)] mb-8 text-center max-w-2xl mx-auto">
        {tp('transport_subtitle')}
      </p>

      <!-- AUTO — úvod + 2 trasy -->
      <div class="mb-10 space-y-6">
        <div class="border-l-4 border-[var(--color-gold)] bg-[var(--color-bg-medium)]/30 p-5">
          <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
            <Icon name="lucide:car" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
            {tp('transport_car_intro_h3')}
          </h3>
          <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            {tp('transport_car_intro_text')}
          </p>
        </div>

        <div class="border-2 border-[var(--color-gold)] bg-[var(--color-bg-medium)]/40 p-6">
          <div class="flex items-center justify-between gap-3 mb-4">
            <h4 class="font-[family-name:var(--font-display)] text-base uppercase tracking-widest text-[var(--color-gold-light)]">
              {tp('transport_car_bukovina_title')}
            </h4>
            <span class="text-[10px] uppercase tracking-widest bg-[var(--color-gold)] text-[var(--color-bg-dark)] px-2 py-1 font-semibold">
              {tp('transport_car_bukovina_badge')}
            </span>
          </div>
          <div class="space-y-3 text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            <p>{tp('transport_car_bukovina_text_p1')}</p>
            <p>{tp('transport_car_bukovina_text_p2')}</p>
            <p>{tp('transport_car_bukovina_text_p3')}</p>
            <p>{tp('transport_car_bukovina_text_p4')}</p>
          </div>
        </div>

        <div class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-6 bg-[var(--color-bg-medium)]/30">
          <h4 class="font-[family-name:var(--font-display)] text-base uppercase tracking-widest text-[var(--color-gold-light)] mb-4">
            {tp('transport_car_krtiny_title')}
          </h4>
          <div class="space-y-3 text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            <p>{tp('transport_car_krtiny_text_p1')}</p>
            <p>{tp('transport_car_krtiny_text_p2')}</p>
            <p>{tp('transport_car_krtiny_text_p3')}</p>
            <p>{tp('transport_car_krtiny_text_p4')}</p>
            <p>{tp('transport_car_krtiny_text_p5')}</p>
            <p>{tp('transport_car_krtiny_text_p6')}</p>
            <p>{tp('transport_car_krtiny_text_p7')}</p>
          </div>
        </div>
      </div>

      <!-- AUTOBUS — úvod + 2 trasy -->
      <div class="mb-10 space-y-6">
        <div class="border-l-4 border-[var(--color-gold)] bg-[var(--color-bg-medium)]/30 p-5">
          <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
            <Icon name="lucide:bus" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
            {tp('transport_bus_intro_h3')}
          </h3>
          <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            {tp('transport_bus_intro_text')}
          </p>
        </div>

        <div class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-6 bg-[var(--color-bg-medium)]/30">
          <h4 class="font-[family-name:var(--font-display)] text-base uppercase tracking-widest text-[var(--color-gold-light)] mb-4">
            {tp('transport_bus_krtiny_title')}
          </h4>
          <div class="space-y-3 text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            <p>{tp('transport_bus_krtiny_text_p1')}</p>
            <p>{tp('transport_bus_krtiny_text_p2')}</p>
            <p>{tp('transport_bus_krtiny_text_p3')}</p>
            <p>{tp('transport_bus_krtiny_text_p4')}</p>
            <p class="italic text-[var(--color-text-on-dark-muted)]">{tp('transport_bus_krtiny_text_p5')}</p>
          </div>
        </div>

        <div class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-6 bg-[var(--color-bg-medium)]/30">
          <h4 class="font-[family-name:var(--font-display)] text-base uppercase tracking-widest text-[var(--color-gold-light)] mb-4">
            {tp('transport_bus_bukovina_title')}
          </h4>
          <div class="space-y-3 text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            <p>{tp('transport_bus_bukovina_text_p1')}</p>
            <p>{tp('transport_bus_bukovina_text_p2')}</p>
            <p>{tp('transport_bus_bukovina_text_p3')}</p>
            <p>{tp('transport_bus_bukovina_text_p4')}</p>
            <p class="italic text-[var(--color-text-on-dark-muted)]">{tp('transport_bus_bukovina_text_p5')}</p>
          </div>
        </div>
      </div>

      <!-- PĚŠKY -->
      <div class="mb-10">
        <div class="border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] transition-colors p-6 bg-[var(--color-bg-medium)]/30">
          <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-2">
            <Icon name="lucide:footprints" class="w-6 h-6 text-[var(--color-gold)]" aria-hidden="true" />
            {tp('transport_walk_title')}
          </h3>
          <div class="space-y-3 text-sm text-[var(--color-text-on-dark)] leading-relaxed">
            <p>{tp('transport_walk_text_p1')} <span aria-hidden="true">😉</span></p>
            <p>{tp('transport_walk_text_p2')}</p>
            <p>{tp('transport_walk_text_p3')}</p>
            <p><strong>{tp('transport_walk_text_p4')}</strong></p>
            <p class="italic">{tp('transport_walk_text_p5')} <span aria-hidden="true">🙂</span></p>
          </div>
        </div>
      </div>

      <!-- Autobusové zastávky — 3 odkazy na Google Maps -->
      <h3 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
        <Icon name="lucide:map-pin" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
        {tp('stops_h3')}
      </h3>
      <p class="text-sm text-[var(--color-text-on-dark-muted)] mb-4">
        {tp('stops_intro')}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-8">
        <a
          href="https://maps.app.goo.gl/obWygUHjpQxahkiT8"
          target="_blank"
          rel="noopener noreferrer"
          class="group border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 transition-colors p-4 bg-[var(--color-bg-medium)]/30"
        >
          <div class="flex items-center gap-2 font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)] mb-1">
            <Icon name="lucide:bus" class="w-4 h-4" aria-hidden="true" />
            {tp('stop_bukovina')}
            <Icon name="lucide:external-link" class="w-3 h-3 ml-auto opacity-60" aria-hidden="true" />
          </div>
          <p class="text-xs text-[var(--color-text-on-dark-muted)] leading-snug">
            {tp('stop_bukovina_desc')}
          </p>
        </a>
        <a
          href="https://maps.app.goo.gl/vRCcnus5L6WeTD4y6"
          target="_blank"
          rel="noopener noreferrer"
          class="group border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 transition-colors p-4 bg-[var(--color-bg-medium)]/30"
        >
          <div class="flex items-center gap-2 font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)] mb-1">
            <Icon name="lucide:bus" class="w-4 h-4" aria-hidden="true" />
            {tp('stop_krtiny_uu')}
            <Icon name="lucide:external-link" class="w-3 h-3 ml-auto opacity-60" aria-hidden="true" />
          </div>
          <p class="text-xs text-[var(--color-text-on-dark-muted)] leading-snug">
            {tp('stop_krtiny_uu_desc')}
          </p>
        </a>
        <a
          href="https://maps.app.goo.gl/t5WgyB69eDrY1vKy5"
          target="_blank"
          rel="noopener noreferrer"
          class="group border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] hover:bg-[var(--color-gold)]/5 transition-colors p-4 bg-[var(--color-bg-medium)]/30"
        >
          <div class="flex items-center gap-2 font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)] mb-1">
            <Icon name="lucide:bus" class="w-4 h-4" aria-hidden="true" />
            {tp('stop_bukovina_rozcesti')}
            <Icon name="lucide:external-link" class="w-3 h-3 ml-auto opacity-60" aria-hidden="true" />
          </div>
          <p class="text-xs text-[var(--color-text-on-dark-muted)] leading-snug">
            {tp('stop_bukovina_rozcesti_desc')}
          </p>
        </a>
      </div>

      <!-- Přílet na nazgúlích nosičích — humorná drobnost -->
      <div class="border-l-2 border-[var(--color-gold-darkest)] pl-4 py-2 mb-6">
        <h3 class="font-[family-name:var(--font-display)] text-base uppercase tracking-widest text-[var(--color-gold-light)] mb-2 flex items-center gap-2">
          <Icon name="lucide:plane" class="w-5 h-5 text-[var(--color-gold)]" aria-hidden="true" />
          {tp('transport_air_title')}
        </h3>
        <div class="space-y-2 text-sm text-[var(--color-text-on-dark-muted)] italic leading-relaxed">
          <p>{tp('transport_air_text_p1')}</p>
          <p>{tp('transport_air_text_p2')}</p>
        </div>
      </div>

      <AlertBox variant="info" class="mt-6">
        {tp('alert_pre')}<a href={`/${lang}/organizacni-informace/#doprava`} class="underline">{tp('alert_link')}</a>{tp('alert_post')}
      </AlertBox>
    </div>
  </section>

</BaseLayout>
