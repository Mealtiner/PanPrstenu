---
/**
 * GDPR / Ochrana osobních údajů
 * URL: /cs/gdpr/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah z src/content/pages-long/gdpr/{lang}.md (markdown).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import TocSidebar from '@components/blocks/TocSidebar.astro';
import { getEntry, render } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const entry = (await getEntry('longPages', `gdpr/${lang}`)) ?? (await getEntry('longPages', 'gdpr/cs'));
if (!entry) throw new Error('gdpr markdown not found');
const { Content } = await render(entry);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: entry.data.breadcrumb },
];

const chapters = [
  { id: 'kdo-jsme',          label: '1. Kdo jsme',                icon: 'lucide:building' },
  { id: 'registracka',       label: '2. Registračka.cz',          icon: 'lucide:user-check' },
  { id: 'udaje',             label: '3. Jaké údaje',              icon: 'lucide:database' },
  { id: 'proc',              label: '4. Proč',                    icon: 'lucide:help-circle' },
  { id: 'pravni-zaklady',    label: '5. Právní základy',          icon: 'lucide:scale' },
  { id: 'kdo-ma-pristup',    label: '6. Kdo má přístup',          icon: 'lucide:users' },
  { id: 'externi',           label: '7. Externí služby',          icon: 'lucide:cloud' },
  { id: 'mimo-eu',           label: '8. Mimo EU',                 icon: 'lucide:globe' },
  { id: 'doba',              label: '9. Doba uchování',           icon: 'lucide:clock' },
  { id: 'fotky',             label: '10. Fotografie a videa',     icon: 'lucide:camera' },
  { id: 'nezletili',         label: '11. Nezletilí',              icon: 'lucide:baby' },
  { id: 'zdravotni',         label: '12. Zdravotní údaje',        icon: 'lucide:heart-pulse' },
  { id: 'cookies',           label: '13. Cookies',                icon: 'lucide:cookie' },
  { id: 'prava',             label: '14. Vaše práva',             icon: 'lucide:shield-check' },
  { id: 'kdy-nemuzeme-smazat', label: '15. Kdy nemůžeme smazat',  icon: 'lucide:lock' },
  { id: 'zabezpeceni',       label: '16. Zabezpečení',            icon: 'lucide:shield' },
  { id: 'auto-rozhodovani',  label: '17. Automatizace',           icon: 'lucide:bot' },
  { id: 'kontakt',           label: '18. Kontakt',                icon: 'lucide:mail' },
  { id: 'stiznost',          label: '19. Stížnost na ÚOOÚ',       icon: 'lucide:alert-triangle' },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  breadcrumbs={[{ name: entry.data.breadcrumb, href: `/${lang}/gdpr/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {entry.data.title}
      </h1>
      {entry.data.hero_subtitle && (
        <p class="text-sm text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
          {entry.data.hero_subtitle}
        </p>
      )}
    </div>
  </section>

  <section class="py-12" data-toc-root>
    <div class="container-base">
      {lang !== 'cs' && (
        <div class="mb-8 max-w-3xl mx-auto">
          <AlertBox variant="info">
            {t('legal.jurisdiction_notice')}
          </AlertBox>
        </div>
      )}
      <div class="grid lg:grid-cols-[260px_1fr] gap-8 lg:gap-12">
        <TocSidebar items={chapters} title={entry.data.toc_title} ariaLabel={entry.data.toc_aria} />
        <article class="min-w-0 max-w-3xl prose-cookies">
          <Content />

          {entry.data.last_updated && (
            <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-8 italic">
              {entry.data.last_updated_label}: {entry.data.last_updated} · {entry.data.last_updated_suffix}
            </p>
          )}
        </article>
      </div>
    </div>
  </section>

  <script>
    import '@scripts/toc-spy.ts';
  </script>

</BaseLayout>
