---
/**
 * GDPR / Ochrana osobních údajů
 * URL: /cs/gdpr/, …
 * Datum: 2026-04-29
 *
 * Statická právní stránka — placeholder text, finální verzi
 * dodá klient (Moravian LARP, z. s.).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Divider from '@components/decorative/Divider.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('footer.legal.privacy') },
];
---

<BaseLayout
  title={t('footer.legal.privacy')}
  description="Zásady zpracování osobních údajů — Moravian LARP, z. s."
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('footer.legal.privacy')}
      </h1>
    </div>
  </section>

  <section class="py-16">
    <article class="container-base max-w-3xl prose prose-invert">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-6">
        Nějaké údaje o vás potřebujeme. Bez nich bychom nevěděli, kdo přijede,
        komu máme potvrdit registraci, kdo patří do jaké frakce, kdo je mladší
        18 let a komu máme v případě potřeby pomoct. Údaje používáme jen pro
        organizaci akce, bezpečnost účastníků, komunikaci, platby a přiměřenou
        propagaci akce.
      </p>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        1. Správce osobních údajů
      </h2>
      <div class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        <p class="mb-2"><strong class="text-[var(--color-gold-light)]">Moravian LARP, z. s.</strong></p>
        <ul class="list-none space-y-1 text-sm">
          <li>IČO: <strong>22669167</strong></li>
          <li>Spisová značka: L 12656 vedená u Krajského soudu v Brně</li>
          <li>Den zápisu: 1. ledna 2014</li>
          <li>Sídlo: Starobrněnská 289/7, Brno-město, 602 00 Brno</li>
          <li>E-mail: <a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a></li>
        </ul>
      </div>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        2. Jaké údaje zpracováváme
      </h2>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-8 list-disc list-inside">
        <li>Jméno a příjmení, datum narození</li>
        <li>Email, telefonní číslo</li>
        <li>Frakce a herní volby</li>
        <li>Stravovací omezení (pokud je účastník dobrovolně sdělí pro koordinaci s hospodou U Zeleného draka)</li>
        <li>Fotografie a videozáznamy z akce (s informovaným souhlasem)</li>
      </ul>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        3. Účel a doba zpracování
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Údaje zpracováváme výhradně pro organizaci akce, komunikaci s účastníky a evidenci. Po skončení
        ročníku jsou neaktivní záznamy archivovány po dobu 3 let, poté smazány.
      </p>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        4. Tvá práva
      </h2>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed space-y-2 mb-8 list-disc list-inside">
        <li>Právo na přístup k údajům</li>
        <li>Právo na opravu, výmaz a omezení zpracování</li>
        <li>Právo vznést námitku</li>
        <li>Právo podat stížnost u Úřadu pro ochranu osobních údajů</li>
      </ul>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
        5. Kontakt
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed">
        Pro uplatnění svých práv napiš na <a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a>.
      </p>

    </article>
  </section>

</BaseLayout>
