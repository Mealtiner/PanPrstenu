---
/**
 * Praktické informace
 * URL: /cs/prakticke-info/, …
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 7 (desktop) a Image 8 (mobile).
 * Sekce: Místo & dojezd, Co s sebou, Strava, Ubytování, Bezpečnost.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import InfoCard from '@components/blocks/InfoCard.astro';
import Checklist from '@components/blocks/Checklist.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import EventStats from '@components/blocks/EventStats.astro';
import Divider from '@components/decorative/Divider.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('page.practical.title') },
];

const stats = [
  { icon: 'lucide:calendar', value: '4', label: 'Dny akce' },
  { icon: 'lucide:users', value: '~500', label: 'Účastníků' },
  { icon: 'game-icons:crossed-swords', value: '7', label: 'Frakcí' },
  { icon: 'lucide:tent', value: '2', label: 'Tábořiště' },
];

const cardItems = [
  {
    icon: 'lucide:map-pin',
    title: 'Místo & dojezd',
    description: 'Tábořiště u Brna — přesné GPS obdrží registrovaní 14 dní před akcí. Z autobusové zastávky pěšky cca 20 minut.',
  },
  {
    icon: 'lucide:utensils',
    title: 'Strava',
    description: 'Společná polní kuchyně se 3 jídly denně. Hlas se k vegetariánské/veganské/bezlepkové variantě v registraci.',
  },
  {
    icon: 'lucide:tent',
    title: 'Ubytování',
    description: 'Vlastní stan v rámci táborového tábora frakce. K dispozici jsou parkoviště, sociální zařízení a sprchy.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Bezpečnost',
    description: 'Stálá zdravotnická služba. Vše projde bezpečnostní kontrolou (čekem). Rule of zero — STOP přerušuje hru.',
  },
];

const packing = [
  'Ověřená larpová zbraň (projde čekem)',
  'Kostým odpovídající tvé frakci',
  'Spací pytel a karimatka / postel',
  'Stan (pokud nehraješ ve sdíleném)',
  'Vlastní jídelní souprava (talíř, příbor, hrnek)',
  'Baterka / čelovka',
  'Pláštěnka a teplé oblečení',
  'Léky, hygiena, opalovací krém',
];
---

<BaseLayout
  title={t('page.practical.title')}
  description="Vše, co potřebuješ vědět před akcí: místo, doprava, strava, ubytování, bezpečnost a co si vzít."
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('page.practical.title')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Vše, co potřebuješ vědět před tím, než vyrazíš do Středozemě.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-base">
      <EventStats stats={stats} tone="dark" />
    </div>
  </section>

  <section class="py-12 bg-[var(--color-bg-darkest)]">
    <div class="container-base">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-8 text-center">
        Klíčové informace
      </h2>
      <Divider variant="line-diamond" tone="dark" class="mb-10" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {cardItems.map((item) => (
          <InfoCard
            icon={item.icon}
            title={item.title}
            description={item.description}
            tone="dark"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-base max-w-4xl">

      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-8 text-center">
        Co si vzít s sebou
      </h2>
      <Divider variant="ornament" tone="dark" class="mb-8" />

      <div class="bg-[var(--color-bg-medium)]/40 border border-[var(--color-gold-darkest)] p-8">
        <Checklist
          items={packing}
          tone="dark"
        />
      </div>

      <div class="mt-10 space-y-6">
        <AlertBox variant="warning" title="Bezpečnostní kontrola">
          Každý účastník absolvuje při příjezdu povinnou bezpečnostní kontrolu zbraně a kostýmu.
          Bez schválení nelze hrát.
        </AlertBox>

        <AlertBox variant="info" title="Mladší 18 let">
          Účastníkům do 18 let je nutné mít s sebou písemný souhlas zákonných zástupců.
          Vzor formuláře najdeš v sekci Registrace.
        </AlertBox>
      </div>

    </div>
  </section>

</BaseLayout>
