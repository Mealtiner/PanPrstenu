---
/**
 * Pro stánkaře a prodejce
 * URL: /cs/pro-stankare/, …
 * Datum: 2026-04-30
 *
 * Stránka pro potenciální prodejce — jak se přihlásit, koho hledáme,
 * co zajišťujeme my a co si zajišťuje prodejce.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Pro stánkaře' },
];
---

<BaseLayout
  title="Pro stánkaře a prodejce"
  description="Informace pro potenciální prodejce a stánkaře — jak se přihlásit, jaký sortiment hledáme, co zajišťujeme a co si zajišťuje prodejce."
  lang={lang}
  breadcrumbs={[{ name: 'Pro stánkaře', href: `/${lang}/pro-stankare/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        Pro stánkaře a prodejce
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        Prodáváš kostýmy, látky, zbraně, kožené doplňky, šperky nebo jiné tematické
        vybavení? Můžeš být součástí Středozemě.
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        Na Pánu Prstenů můžeš být součástí tábořiště a nabídnout účastníkům věci,
        které do Středozemě patří. Tábořiště se mění v živé místo plné hráčů
        v kostýmech a tematický stánek je pro mnohé součástí zážitku.
      </p>

      <h2 id="koho-hledame" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Koho hledáme
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Vítáme prodejce tematického vybavení, například:
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8 columns-1 sm:columns-2">
        <li>kostýmy,</li>
        <li>látky,</li>
        <li>zbraně pro larp a dřevárny,</li>
        <li>kožené výrobky,</li>
        <li>opasky a taštice,</li>
        <li>karetkované zboží,</li>
        <li>šperky,</li>
        <li>zbroje,</li>
        <li>tábornické a atmosférické vybavení,</li>
        <li>další věci do fantasy / historizujícího prostředí.</li>
      </ul>

      <h2 id="prihlaseni" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Jak se přihlásit
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Pokud chcete přijet jako prodejce, ozvěte se nám předem na
        <a href="mailto:info@panprstenu.cz?subject=P%C5%99ihl%C3%A1%C5%A1ka%20st%C3%A1nka%C5%99e" class="underline text-[var(--color-gold-light)]"><strong>info@panprstenu.cz</strong></a>.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">Do e-mailu prosím napište:</p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li>název stánku / značky,</li>
        <li>krátký popis sortimentu,</li>
        <li>odkaz na web / sociální sítě,</li>
        <li>velikost stánku,</li>
        <li>zda potřebujete speciální zázemí,</li>
        <li>kontaktní osobu,</li>
        <li>zda chcete být uvedeni na webu v seznamu prodejců.</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 id="co-zajistujeme" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Co zajišťujeme
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Od organizátorů můžete očekávat:
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li>místo pro stánek,</li>
        <li>základní zařazení do prostoru jarmarku / stánků,</li>
        <li>komunikaci před akcí,</li>
        <li>možnost být uvedeni na webu v
          <a href={`/${lang}/stanky-a-prodejci/`} class="underline text-[var(--color-gold-light)]">seznamu prodejců</a>.</li>
      </ul>

      <h2 id="co-si-zajistujete" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Co si zajišťujete sami
      </h2>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li>vlastní stánek,</li>
        <li>vybavení stánku,</li>
        <li>prodejní sortiment,</li>
        <li>obsluhu,</li>
        <li>případné platby / pokladnu,</li>
        <li>vlastní odpovědnost za zboží,</li>
        <li>registraci na akci jako nehrající účastník, pokud bude vyžadována.</li>
      </ul>

      <h2 id="atmosfera" class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 scroll-mt-24">
        Atmosféra a kostým
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        Stánek je součástí prostředí akce. Prosíme, aby stánek a obsluha působily
        pokud možno tematicky a nerušily atmosféru Středozemě.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Není potřeba stavět dokonalý středověký krám, ale pomůže:
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li>nerušivá plachta,</li>
        <li>dřevo / látka místo výrazných plastů,</li>
        <li>obsluha v kostýmu nebo nenápadném oděvu,</li>
        <li>omezení křiklavých moderních prvků.</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <AlertBox variant="info" title="Máte zájem?">
        Napište nám na
        <a href="mailto:info@panprstenu.cz?subject=P%C5%99ihl%C3%A1%C5%A1ka%20st%C3%A1nka%C5%99e" class="underline">info@panprstenu.cz</a>
        a domluvíme se na detailech.
      </AlertBox>

      <div class="mt-8 pt-6 border-t border-[var(--color-gold-darkest)]">
        <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3">
          Související
        </h3>
        <ul class="text-sm text-[var(--color-text-on-dark)] space-y-1">
          <li>› <a href={`/${lang}/stanky-a-prodejci/`} class="underline hover:text-[var(--color-gold-light)]">Seznam přihlášených prodejců</a></li>
          <li>› <a href={`/${lang}/prakticke-info/`} class="underline hover:text-[var(--color-gold-light)]">Praktické informace</a></li>
          <li>› <a href={`/${lang}/podminky-ucasti-a-registrace/`} class="underline hover:text-[var(--color-gold-light)]">Podmínky účasti</a></li>
        </ul>
      </div>

    </article>
  </section>

</BaseLayout>
