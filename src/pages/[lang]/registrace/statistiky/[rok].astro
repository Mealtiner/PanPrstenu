---
/**
 * /<lang>/registrace/statistiky/<rok>/ — 301 redirect na nové umístění
 * /<lang>/minule-rocniky/statistiky/<rok>/.
 * Datum: 2026-05-12
 *
 * Stránka byla přesunuta z Registrace do archivu Minulé ročníky.
 * Toto je zpětně-kompatibilní redirect pro staré odkazy.
 */
import type { Lang } from '@i18n/ui';

export async function getStaticPaths() {
  const langs: Lang[] = ['cs', 'en', 'de', 'sk', 'uk'];
  const years = ['2024', '2025', '2026'];
  return langs.flatMap((lang) =>
    years.map((rok) => ({ params: { lang, rok } })),
  );
}

const { lang, rok } = Astro.params as { lang: Lang; rok: string };
const target = `/${lang}/minule-rocniky/statistiky/${rok}/`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Přesměrování — Pán Prstenů</title>
  </head>
  <body>
    <p>Přesměrování na <a href={target}>{target}</a>…</p>
    <script set:html={`window.location.replace(${JSON.stringify(target)});`} is:inline />
  </body>
</html>
