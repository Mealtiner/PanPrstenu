---
/**
 * /<lang>/registrace/statistiky/ — redirect na aktuální ročník 2026.
 * Datum: 2026-05-12
 *
 * Statistiky byly rozčleněny per ročník (2024, 2025, 2026) + srovnání.
 * Tento index zachová zpětnou kompatibilitu starých odkazů.
 */
import type { Lang } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const target = `/${lang}/registrace/statistiky/2026/`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Přesměrování — Pán Prstenů</title>
  </head>
  <body>
    <p>Přesměrování na <a href={target}>{target}</a>…</p>
    <script set:html={`window.location.replace(${JSON.stringify(target)});`} is:inline />
  </body>
</html>
