---
/**
 * Osobní karta — úprava osobních údajů přihlášeného uživatele.
 * URL: /<lang>/registrace/osobni-karta/
 * Datum: 2026-05-12
 *
 * Vykresluje rámec (header, breadcrumb, sidebar) s vlastním stylingem.
 * Hlavní obsah = <iframe src="https://www.registracka.cz/personel.php">
 * s předaným session_tokenem v query parametru pro auto-login.
 *
 * Pokud user není přihlášen (nemá session_token v localStorage), iframe
 * ukáže registračkový login form. Funkčnost auto-loginu závisí na tom,
 * zda backend personel.php přijímá ?session_token=… parametr (Bearer).
 *
 * Skinovaný rámec a viditelný breadcrumb zajišťují, že stránka vypadá
 * jako součást našeho webu. Iframe samotný má design registračky
 * (cross-origin = nelze stylovat).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import '@styles/registration.css';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.registration'), href: `/${lang}/registrace/` },
  { label: t('reg.sidebar.personal_card') },
];
---

<BaseLayout
  title={`${t('reg.sidebar.personal_card')} — Pán Prstenů`}
  description="Úprava osobních údajů přihlášeného uživatele Registračky."
  lang={lang}
  noIndex={true}
>
  <section class="py-8 md:py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4 leading-tight">
        {t('reg.sidebar.personal_card')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-base sm:text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Uprav své osobní údaje. Změny se ukládají do systému Registračky.
      </p>
    </div>
  </section>

  <section class="py-6 sm:py-8 lg:py-10 bg-[var(--color-bg-dark)]" data-lang={lang}>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-6 lg:gap-12 items-start lg:min-h-[calc(100vh-12rem)]">
        <MobileSidebarShell
          asideId="registration-sidebar"
          tabLabel={t('sidebar.tab_menu')}
          tabIcon="lucide:menu"
          ariaLabel={t('sidebar.aria_registration')}
          asideClass="reg-sidebar"
        ></MobileSidebarShell>

        <div id="personal-card-app" class="min-w-0 reg-app" data-lang={lang}>
          <!-- Loading state — JS doplní iframe po načtení session_tokenu -->
          <div class="reg-loading">{t('loading.generic')}</div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initRegistrationSidebar } from '@scripts/registration';
    import { initPersonalCard } from '@scripts/registration/personal-card';
    initRegistrationSidebar('PP2026');
    initPersonalCard('#personal-card-app');
  </script>
</BaseLayout>
