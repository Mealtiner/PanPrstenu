---
/**
 * Výpisy přihlášených — dynamic route pro 6 typů × 5 jazyků.
 * Datum: 2026-05-12 (revize — i18n přes content collection)
 *
 * URL: /<lang>/registrace/vypisy/celkovy/, …/svobodne-narody/, atd.
 * Obsah: src/content/pages/registrace/vypisy/{lang}.json
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';
import '@styles/registration.css';

interface VypisyPage {
  meta_title_template: string;
  meta_description_template: string;
  breadcrumb: { vypis: string };
  titulky: Record<string, string>;
  titulek_fallback: string;
  lead: string;
  sidebar_aria: string;
}

const TYPY = ['celkovy', 'svobodne-narody', 'sily-temneho-pana', 'zoldaci', 'nehrajici', 'detska-hra'] as const;
type Typ = (typeof TYPY)[number];

export async function getStaticPaths() {
  const langs: Lang[] = ['cs', 'en', 'de', 'sk', 'uk'];
  const typy = ['celkovy', 'svobodne-narody', 'sily-temneho-pana', 'zoldaci', 'nehrajici', 'detska-hra'];
  return langs.flatMap((lang) => typy.map((typ) => ({ params: { lang, typ } })));
}

const { lang, typ } = Astro.params as { lang: Lang; typ: Typ };
const t = getTranslation(lang);
const p = getPageData<VypisyPage>('registrace/vypisy', lang);

const EVENT_SLUG = 'PP2026';

const titulek = p.titulky[typ] || p.titulek_fallback;
const sub = (s: string): string => s.replace(/\{title\}/g, titulek);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.registration'), href: `/${lang}/registrace/` },
  { label: p.breadcrumb.vypis, href: `/${lang}/registrace/vypisy/celkovy/` },
  { label: titulek },
];
---

<BaseLayout
  title={sub(p.meta_title_template)}
  description={sub(p.meta_description_template)}
  lang={lang}
  noIndex={true}
>
  <section class="py-8 md:py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4 leading-tight">
        {titulek}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-base sm:text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {p.lead}
      </p>
    </div>
  </section>

  <section class="py-6 sm:py-8 lg:py-10 bg-[var(--color-bg-dark)]" data-lang={lang}>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-6 lg:gap-12 items-start lg:min-h-[calc(100vh-12rem)]">
        <MobileSidebarShell
          asideId="registration-sidebar"
          tabLabel={t('sidebar.tab_menu')}
          tabIcon="lucide:menu"
          ariaLabel={p.sidebar_aria}
          asideClass="reg-sidebar"
        ></MobileSidebarShell>
        <div
          id="vypis-app"
          class="min-w-0"
          data-event-slug={EVENT_SLUG}
          data-vypis-typ={typ}
          data-lang={lang}
        >
          <div class="reg-loading">{t('loading.generic')}</div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initRegistrationSidebar } from '@scripts/registration';
    import { initVypis } from '@scripts/registration/vypis';
    const root = document.getElementById('vypis-app');
    const slug = root?.dataset.eventSlug ?? 'PP2026';
    const typ = root?.dataset.vypisTyp ?? 'celkovy';
    initRegistrationSidebar(slug);
    initVypis('#vypis-app', slug, typ);
  </script>
</BaseLayout>
