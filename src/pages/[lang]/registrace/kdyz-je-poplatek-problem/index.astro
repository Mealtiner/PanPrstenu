---
/**
 * Když je registrační poplatek problém
 * URL: /cs/registrace/kdyz-je-poplatek-problem/, ...
 * Datum: 2026-05-03
 *
 * Stránka pro účastníky, kteří chtějí jet, ale registrační poplatek je
 * pro ně překážkou. Nabízí domluvu — pomoc s přípravou, podpora od
 * donátorů, individuální snížení poplatku, jiná osobní domluva.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('registrace/kdyz-je-poplatek-problem', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.registration'), href: `/${lang}/registrace/` },
  { label: p.bc_short },
];
---

<BaseLayout
  title={p.meta_title}
  description={p.description}
  lang={lang}
  breadcrumbs={[
    { name: t('nav.registration'), href: `/${lang}/registrace/` },
    { name: p.bc_short, href: `/${lang}/registrace/kdyz-je-poplatek-problem/` },
  ]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.title}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-3 max-w-3xl">
        {p.subtitle}
      </p>
    </div>
  </section>

  <section class="py-12">
    <article class="container-base max-w-3xl">

      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.intro_p1}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8">
        {p.intro_p2}
      </p>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
        {p.h_options}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {p.options_intro}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-2 mb-8">
        <li><strong>{p.opt_1_strong}</strong>{p.opt_1_post}</li>
        <li><strong>{p.opt_2_strong}</strong>{p.opt_2_post}</li>
        <li><strong>{p.opt_3_strong}</strong>{p.opt_3_post}</li>
        <li><strong>{p.opt_4_strong}</strong>{p.opt_4_post}</li>
        <li><strong>{p.opt_5_strong}</strong>{p.opt_5_mid}<a href={`/${lang}/podpor-ucastniky/`} class="underline text-[var(--color-gold-light)]">{p.opt_5_link}</a>{p.opt_5_post}</li>
        <li><strong>{p.opt_6_strong}</strong>{p.opt_6_post}</li>
      </ul>

      <AlertBox variant="info" class="mb-8">
        {p.alert_individual}
      </AlertBox>

      <Divider variant="line-diamond" tone="dark" class="my-8" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
        {p.h_how}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-4">
        {p.how_p_pre}<a href="mailto:info@panprstenu.cz?subject=Registra%C4%8Dn%C3%AD%20poplatek%20%E2%80%94%20mo%C5%BEnosti%20domluvy" class="underline text-[var(--color-gold-light)]"><strong>info@panprstenu.cz</strong></a>{p.how_p_post}
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {p.how_intro}
      </p>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-4">
        <li>{p.how_l1}</li>
        <li>{p.how_l2}</li>
        <li>{p.how_l3}</li>
        <li>{p.how_l4}</li>
      </ul>
      <AlertBox variant="info" class="mb-8">
        {p.alert_privacy}
      </AlertBox>

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4">
        {p.h_related}
      </h2>
      <ul class="text-[var(--color-text-on-dark)] leading-relaxed list-disc list-inside space-y-1 mb-8">
        <li><a href={`/${lang}/registrace/`} class="underline text-[var(--color-gold-light)]">{p.rel_1_label}</a>{p.rel_1_post}</li>
        <li><a href={`/${lang}/podpor-ucastniky/`} class="underline text-[var(--color-gold-light)]">{p.rel_2_label}</a>{p.rel_2_post}</li>
        <li><a href={`/${lang}/role/pomocnici/`} class="underline text-[var(--color-gold-light)]">{p.rel_3_label}</a>{p.rel_3_post}</li>
        <li><a href={`/${lang}/kontakt/`} class="underline text-[var(--color-gold-light)]">{p.rel_4_label}</a>{p.rel_4_post}</li>
      </ul>

      <Divider variant="line-diamond" tone="dark" class="my-6" />

      <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-6 text-center">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          {p.cta_heading}
        </h2>
        <p class="text-sm text-[var(--color-text-on-dark)] max-w-xl mx-auto mb-5">
          {p.cta_body}
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <Button href="mailto:info@panprstenu.cz?subject=Registra%C4%8Dn%C3%AD%20poplatek%20%E2%80%94%20mo%C5%BEnosti%20domluvy" variant="primary" size="md" icon="lucide:arrow-right">
            {p.btn_write}
          </Button>
          <Button href={`/${lang}/registrace/`} variant="secondary" size="md">
            {p.btn_back}
          </Button>
        </div>
      </div>

    </article>
  </section>

</BaseLayout>
