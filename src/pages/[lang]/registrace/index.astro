---
/**
 * Registrace — průvodník registrací
 * URL: /cs/registrace/, …
 * Datum: 2026-04-29
 *
 * Vysvětlení procesu + odkaz na náš registrační systém Registračka.cz,
 * který provozuje Moravian LARP, z. s.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import Checklist from '@components/blocks/Checklist.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import InfoCard from '@components/blocks/InfoCard.astro';
import Divider from '@components/decorative/Divider.astro';
import WaxSeal from '@components/decorative/WaxSeal.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.registration') },
];

// Náš registrační systém — provozuje Moravian LARP, z. s.
const REGISTRATION_URL = 'https://www.registracka.cz/';

const steps = [
  {
    icon: 'lucide:user-plus',
    title: '1. Vyplň formulář',
    description: 'Online registrace v našem systému Registračka.cz. Trvá cca 10 minut. Vyber typ účasti a armádu, dolaď údaje.',
  },
  {
    icon: 'lucide:credit-card',
    title: '2. Zaplať vklad',
    description: 'Do 10 dnů od registrace obdržíš pokyny k platbě. Platbou se rezervace stává závaznou.',
  },
  {
    icon: 'lucide:mail-check',
    title: '3. Potvrzení',
    description: 'Po platbě dostaneš shrnutí. Finální pokyny a GPS tábořiště posíláme registrovaným před akcí.',
  },
  {
    icon: 'lucide:tent',
    title: '4. Přijeď na místo',
    description: 'Při příjezdu projdeš bezpečnostní kontrolou, krátkým školením a registrací do tábora armády.',
  },
];

const conditions = [
  'Hlavní hra / bitva je od 12 let. Pro mladší účastníky je samostatná dětská hra.',
  'Účastníci mladší 18 let potřebují podepsaný souhlas zákonného zástupce; mladší 15 let pouze v doprovodu osoby starší 18 let.',
  'Účastník souhlasí s pravidly a bezpečnostními pokyny.',
  'Larpová zbraň a kostým musí projít kontrolou na místě.',
  'Storno, převod registrace a vyšší moc řeší samostatné Podmínky účasti a registrace.',
];
---

<BaseLayout
  title={t('nav.registration')}
  description="Jak se přihlásit na Bitvu o Středozem 2026 — krok za krokem, podmínky a odkaz na registraci."
  lang={lang}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {t('nav.registration')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Přihlas se do bitvy o Středozem v jednoduchých krocích.
      </p>
    </div>
  </section>

  <!-- Velký CTA blok -->
  <section class="py-16 bg-[var(--color-bg-dark)]">
    <div class="container-base max-w-4xl">
      <div
        class="relative bg-[var(--color-parchment-base)] text-[var(--color-text-on-light)] p-10 md:p-12"
        style="background-image: radial-gradient(ellipse at top, rgba(255,255,255,0.4), transparent 60%)"
      >
        <div class="absolute top-6 right-6 hidden md:block">
          <WaxSeal symbol="✓" color="green" size={80} tilt={-10} />
        </div>

        <div class="max-w-xl">
          <span class="font-[family-name:var(--font-serif)] italic text-sm text-[var(--color-gold-darkest)] tracking-widest uppercase">
            {t('hero.date_chip')}
          </span>
          <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider mt-2 mb-4">
            Jdeme na to
          </h2>
          <p class="text-base mb-8 leading-relaxed">
            Registrace probíhá přes <strong>náš registrační systém Registračka.cz</strong>,
            který provozuje spolek Moravian LARP, z. s. Účet si vytvoříš jednou
            a pak se přes něj můžeš přihlašovat na naše jednotlivé akce.
          </p>

          <div class="flex flex-wrap gap-3">
            <Button
              href={REGISTRATION_URL}
              variant="large-cta"
              size="lg"
              icon="lucide:external-link"
              external
            >
              {t('cta.go_to_registration')}
            </Button>
            <Button
              href={`/${lang}/podminky-ucasti-a-registrace/`}
              variant="ghost"
              size="lg"
            >
              Podmínky účasti
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kroky -->
  <section class="py-16 bg-[var(--color-bg-darkest)]">
    <div class="container-base">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-8 text-center">
        Jak to probíhá
      </h2>
      <Divider variant="ornament" tone="dark" class="mb-10" />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((s) => (
          <InfoCard
            icon={s.icon}
            title={s.title}
            description={s.description}
            tone="dark"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Podmínky -->
  <section class="py-16">
    <div class="container-base max-w-3xl">

      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 flex items-center gap-3">
        <Icon name="lucide:scroll-text" class="w-7 h-7 text-[var(--color-gold)]" />
        Podmínky účasti
      </h2>

      <div class="bg-[var(--color-bg-medium)]/40 border border-[var(--color-gold-darkest)] p-8 mb-6">
        <Checklist items={conditions} tone="dark" />
      </div>

      <AlertBox variant="warning" title="Ještě jsi nečetl pravidla?">
        Před odesláním registrace si projdi sekci
        <a href={`/${lang}/pravidla/`} class="underline text-[var(--color-gold-light)]">{t('page.rules.title')}</a>
        a
        <a href={`/${lang}/prakticke-info/`} class="underline text-[var(--color-gold-light)]">{t('page.practical.title')}</a>.
      </AlertBox>

    </div>
  </section>

  <!-- Platba a registrační poplatek -->
  <section class="py-16 bg-[var(--color-bg-darkest)]">
    <div class="container-base max-w-3xl">

      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 flex items-center gap-3">
        <Icon name="lucide:credit-card" class="w-7 h-7 text-[var(--color-gold)]" />
        Platba a registrační poplatek
      </h2>

      <div class="space-y-5 text-[var(--color-text-on-dark)] leading-relaxed">

        <div>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
            Co dostanu za registrační poplatek
          </h3>
          <p>
            Především <strong>samotnou hru</strong>. Do nákladů patří zajištění a pronájem
            pozemku, dovoz a odvoz rekvizit a vybavení, tisk pravidel, questů a map,
            malé občerstvení (sladká snídaně, sobotní svačina), výroba nových a oprava
            starých rekvizit, zdravotnický materiál a další nezbytné věci.
          </p>
        </div>

        <div>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
            Jak zaplatit
          </h3>
          <ul class="list-disc list-inside space-y-1">
            <li>Pokyny k platbě dostaneš e-mailem do <strong>10 dnů</strong> od registrace.</li>
            <li>Platbou se rezervace stává <strong>závaznou</strong>.</li>
            <li>Konkrétní částku a způsob (převodem / kartou) potvrzuje Registračka.cz po výběru armády.</li>
          </ul>
        </div>

        <div>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
            Storno, převod registrace a vyšší moc
          </h3>
          <p class="mb-3">
            Když víš, že nemůžeš přijet, napiš nám co nejdřív. Čím dřív to víme,
            tím větší je šance najít férové řešení.
          </p>
          <p class="mb-3">
            Registraci je možné po domluvě převést na náhradníka, pokud to organizační
            stav akce umožňuje. Náhradník musí splňovat stejné podmínky účasti.
          </p>
          <p class="mb-3">
            Krátce před akcí už bývá část peněz utracená za věci, které nejde
            vrátit (voda, toalety, doprava, materiál, zázemí). Proto nemusí být
            vždy možné vrátit celý registrační poplatek.
          </p>
          <p>
            Přesné podmínky najdeš v
            <a href={`/${lang}/podminky-ucasti-a-registrace/`} class="underline text-[var(--color-gold-light)]">Podmínkách účasti a registrace</a>.
          </p>
        </div>

        <div>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-2">
            Když se stane něco mimo naši kontrolu
          </h3>
          <p>
            Akce se koná venku a v přírodním prostředí. Pokud bychom museli
            akci z bezpečnostních nebo organizačních důvodů změnit, přesunout
            nebo zrušit, budeme vás informovat e-mailem a přes web. Vždy se
            budeme snažit najít co nejférovější řešení podle toho, co už
            bylo nutné zaplatit a co ještě půjde vrátit. Detail v
            <a href={`/${lang}/podminky-ucasti-a-registrace/`} class="underline text-[var(--color-gold-light)]">Podmínkách účasti</a>.
          </p>
        </div>

      </div>

      <Divider variant="line-diamond" tone="dark" class="my-10" />

      <h2 class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
        <Icon name="lucide:shield-check" class="w-6 h-6 text-[var(--color-gold)]" />
        Osobní údaje a GDPR
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Pro účast a používání registračního systému je potřeba souhlas se
        zpracováním osobních údajů. <strong>Registračka.cz</strong> je registrační
        systém provozovaný spolkem <strong>Moravian LARP, z. s.</strong> Údaje
        z konkrétní akce mají k dispozici jen lidé, kteří je pro danou akci
        skutečně potřebují.
      </p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        Podrobnosti najdeš na stránce
        <a href={`/${lang}/gdpr/`} class="underline text-[var(--color-gold-light)]">{t('footer.legal.privacy')}</a>.
      </p>

      <AlertBox variant="info" title="Proč registrace?">
        Díky registraci umíme naplánovat herní prostor, délku questů, administrativu,
        pronájmy prostor a další věci. Stručně: bez registrace neumíme připravit dobrou hru.
      </AlertBox>

    </div>
  </section>

</BaseLayout>
