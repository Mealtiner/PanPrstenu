---
/**
 * Registrace — průvodník registrací
 * URL: /cs/registrace/, …
 * Datum: 2026-05-04
 *
 * CMS-ready: obsah načítán z src/content/pages/registrace/{lang}.json.
 * Strukturovaná data: tabulky cen + příplatků, kroky, podmínky, examples.
 *
 * 2026-08-13: podmínky účasti se vykreslují jako HTML (odkaz na přihlášku do 18 let).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Button from '@components/ui/Button.astro';
import Checklist from '@components/blocks/Checklist.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import InfoCard from '@components/blocks/InfoCard.astro';
import Divider from '@components/decorative/Divider.astro';
import WaxSeal from '@components/decorative/WaxSeal.astro';
import MobileSidebarShell from '@components/blocks/MobileSidebarShell.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData } from '@lib/content/pages';
import '@styles/registration.css';

interface RegPage {
  meta: { title: string; description: string };
  breadcrumb: string;
  hero: { subtitle: string };
  cta_box: { h2: string; body_pre: string; body_strong: string; body_post: string; btn_secondary: string };
  steps_h2: string;
  steps: { icon: string; title: string; description: string }[];
  conditions: { h2: string; items: string[]; alert_warn_title: string; alert_warn_pre: string; alert_warn_mid: string; alert_warn_post: string };
  payment: any;
  gdpr: { h2: string; p1: string; p2_pre: string; p2_post: string; alert_title: string; alert_body: string };
  related: { h2: string; items: { title: string; desc: string; path: string }[] };
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<RegPage>('registrace', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.registration') },
];

const EVENT_SLUG = 'PP2026';

function md(text: string): string {
  return text
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  lang={lang}
>

  <section class="py-8 md:py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4 leading-tight">
        {t('nav.registration')}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-base sm:text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {p.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- Sloučená sekce s levým sidebarem (Registrace/Výpisy/Statistiky/Info)
       a hlavním obsahem. Sidebar se naplní client-side přes initRegistrationSidebar.
       data-toc-root aktivuje scroll-spy (zvýraznění aktivní sekce v sidebar). -->
  <section class="py-6 sm:py-8 lg:py-10 bg-[var(--color-bg-dark)]" data-toc-root>
    <div class="container-base">
      <div class="grid lg:grid-cols-[260px_1fr] gap-6 lg:gap-12 items-start">
        <MobileSidebarShell
          asideId="registration-sidebar"
          tabLabel="Menu"
          tabIcon="lucide:menu"
          ariaLabel="Menu registrace"
          asideClass="reg-sidebar"
        ></MobileSidebarShell>
        <div class="reg-main flex flex-col gap-8 sm:gap-10 min-w-0">

  <!-- Sekce 1: Velký CTA blok "Jdeme na to" -->
  <section id="jdeme-na-to" class="scroll-mt-24">
    <div class="max-w-4xl">
      <div
        class="relative bg-[var(--color-parchment-base)] text-[var(--color-text-on-light)] p-6 sm:p-8 md:p-10 lg:p-12"
        style="background-image: radial-gradient(ellipse at top, rgba(255,255,255,0.4), transparent 60%)"
      >
        <div class="grid md:grid-cols-[1fr_auto] gap-6 md:gap-10 items-start">
          <!-- Levý sloupec — nadpis + text + tlačítka -->
          <div>
            <span class="font-[family-name:var(--font-serif)] italic text-xs sm:text-sm text-[var(--color-gold-darkest)] tracking-widest uppercase">
              {t('hero.date_chip')}
            </span>
            <h2 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl uppercase tracking-wider mt-2 mb-4 leading-tight">
              {p.cta_box.h2}
            </h2>
            <p class="text-sm sm:text-base mb-6 sm:mb-8 leading-relaxed">
              {p.cta_box.body_pre}<strong>{p.cta_box.body_strong}</strong>{p.cta_box.body_post}
            </p>

            <div class="flex flex-wrap gap-3">
              <Button href="#formular" variant="large-cta" size="lg" icon="lucide:arrow-down">
                {t('cta.go_to_registration')}
              </Button>
            </div>
          </div>

          <!-- Pravý sloupec — datum spuštění registrace + wax seal -->
          <aside class="relative w-full md:w-64 lg:w-72 border-2 border-[var(--color-gold-darkest)] bg-white/40 p-5 sm:p-6 text-center">
            <div class="absolute -top-5 -right-5 hidden md:block">
              <WaxSeal symbol="✓" color="green" size={70} tilt={-10} />
            </div>
            <div class="font-[family-name:var(--font-serif)] italic text-xs text-[var(--color-gold-darkest)] tracking-widest uppercase mb-2">
              {t('reg_box.spustena_label')}
            </div>
            <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-text-on-light)] mb-1">
              {t('reg_box.spustena_state')}
            </div>
            <div class="font-[family-name:var(--font-display)] text-5xl md:text-6xl font-bold leading-none text-[var(--color-text-on-light)]">
              {t('reg_box.spustena_date')}
            </div>
            <div class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-wider text-[var(--color-gold-darkest)] mt-1">
              {t('reg_box.spustena_year')}
            </div>
            <div class="text-xs text-[var(--color-text-on-light)]/70 italic mt-3">
              {t('reg_box.spustena_time')}
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- Sekce 2: Jak to probíhá -->
  <section id="jak-to-probiha" class="scroll-mt-24">
    <h2 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-6 sm:mb-8 text-center leading-tight">
      {p.steps_h2}
    </h2>
    <Divider variant="ornament" tone="dark" class="mb-8 sm:mb-10" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {p.steps.map((s) => (
        <InfoCard icon={s.icon} title={s.title} description={s.description} tone="dark" />
      ))}
    </div>
  </section>

  <!-- Sekce 3: Registrační formulář (dynamicky z API) -->
  <section id="formular" class="scroll-mt-24">
    <h2 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 sm:mb-6 flex items-center gap-3 leading-tight">
      <Icon name="lucide:file-edit" class="w-6 h-6 sm:w-7 sm:h-7 text-[var(--color-gold)] shrink-0" />
      {t('reg.section.form_h2')}
    </h2>
    <Divider variant="line-diamond" tone="dark" class="mb-6" />
    <div id="registration-app" data-event-slug={EVENT_SLUG}>
      <div class="reg-loading">{t('loading.generic')}</div>
    </div>
  </section>

  <!-- Sekce 4: Podmínky -->
  <section id="podminky-ucasti" class="scroll-mt-24">
    <div class="max-w-3xl">
      <h2 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 sm:mb-6 flex items-center gap-3 leading-tight">
        <Icon name="lucide:scroll-text" class="w-6 h-6 sm:w-7 sm:h-7 text-[var(--color-gold)] shrink-0" />
        {p.conditions.h2}
      </h2>

      <div class="bg-[var(--color-bg-medium)]/40 border border-[var(--color-gold-darkest)] p-5 sm:p-8 mb-6">
        <Checklist items={p.conditions.items} tone="dark" html />
      </div>

      <AlertBox variant="warning" title={p.conditions.alert_warn_title}>
        {p.conditions.alert_warn_pre}
        <a href={`/${lang}/pravidla/`} class="underline text-[var(--color-gold-light)]">{t('breadcrumb.rules')}</a>
        {p.conditions.alert_warn_mid}
        <a href={`/${lang}/organizacni-informace/`} class="underline text-[var(--color-gold-light)]">{t('breadcrumb.practical')}</a>
        {p.conditions.alert_warn_post}
      </AlertBox>
    </div>
  </section>

  <!-- Sekce 5: Platba a registrační poplatek -->
  <section id="platba" class="scroll-mt-24">
    <div class="max-w-3xl">
      <h2 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 sm:mb-6 flex items-center gap-3 leading-tight">
        <Icon name="lucide:credit-card" class="w-6 h-6 sm:w-7 sm:h-7 text-[var(--color-gold)] shrink-0" />
        {p.payment.h2}
      </h2>

      <div class="space-y-5 text-[var(--color-text-on-dark)] leading-relaxed">

        <div>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{p.payment.what_h3}</h3>
          <p set:html={md(p.payment.what_p)}></p>
        </div>

        <div id="vyse-poplatku" class="scroll-mt-24">
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">{p.payment.rates_h3}</h3>
          <p class="mb-4">{p.payment.rates_intro}</p>

          <div class="overflow-x-auto mb-4">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b-2 border-[var(--color-gold-darkest)]">
                  {p.payment.rates_table.headers.map((h: string, i: number) => (
                    <th class:list={['py-3 pr-4 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)]', i === 0 ? 'text-left' : 'text-right whitespace-nowrap']}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="text-[var(--color-text-on-dark)]">
                {p.payment.rates_table.rows.map((r: any) => (
                  <tr class:list={['border-b border-[var(--color-gold-darkest)]/40', r.highlight ? 'bg-[var(--color-bg-darkest)]/40' : '']}>
                    <td class="py-3 pr-4"><strong>{r.label}</strong></td>
                    {r.single_link ? (
                      <td colspan="3" class="py-3 text-center">
                        <a href={`/${lang}${r.single_link}`} class="underline text-[var(--color-gold-light)]">{r.single_link_text}</a>
                      </td>
                    ) : r.single ? (
                      <td colspan="3" class:list={['py-3 text-center', r.single_class === 'free' ? 'text-[var(--color-side-free-text)]' : 'text-[var(--color-text-on-dark-muted)]']}>{r.single}</td>
                    ) : (
                      <>
                        <td class="py-3 pr-4 text-right whitespace-nowrap">{r.p1}</td>
                        <td class="py-3 pr-4 text-right whitespace-nowrap">{r.p2}</td>
                        <td class="py-3 text-right whitespace-nowrap">{r.p3}</td>
                      </>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {p.payment.rates_table.footnotes.map((fn: string) => (
            <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mb-2">{fn}</p>
          ))}
        </div>

        <div id="priplatky" class="scroll-mt-24">
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">{p.payment.surcharges_h3}</h3>
          <div class="overflow-x-auto mb-4">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b-2 border-[var(--color-gold-darkest)]">
                  {p.payment.surcharges_table.headers.map((h: string, i: number) => (
                    <th class:list={['py-3 pr-4 font-[family-name:var(--font-display)] uppercase tracking-wider text-xs text-[var(--color-gold-light)]', i === 0 ? 'text-left' : 'text-right whitespace-nowrap']}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="text-[var(--color-text-on-dark)]">
                {p.payment.surcharges_table.rows.map((r: any) => (
                  <tr class="border-b border-[var(--color-gold-darkest)]/40">
                    <td class="py-3 pr-4"><strong>{r.label}</strong></td>
                    <td class="py-3 pr-4 text-right whitespace-nowrap">{r.predem}</td>
                    <td class="py-3 text-right whitespace-nowrap">{r.namiste}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {p.payment.surcharges_table.footnotes.map((fn: string) => (
            <p class="text-xs text-[var(--color-text-on-dark-muted)] italic mb-2">{fn}</p>
          ))}
        </div>

        <div id="blizsi-informace" class="scroll-mt-24">
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-3">{p.payment.details_h3}</h3>
          <ul class="list-disc list-inside space-y-2">
            {p.payment.details_items.map((it: string) => (
              <li set:html={md(it)}></li>
            ))}
          </ul>

          <h4 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)] mt-6 mb-2">{p.payment.kids_h4}</h4>
          <ul class="list-disc list-inside space-y-2">
            {p.payment.kids_items.map((it: string) => (
              <li set:html={md(it)}></li>
            ))}
          </ul>

          <h4 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)] mt-6 mb-2">{p.payment.family_h4}</h4>
          <ul class="list-disc list-inside space-y-2 mb-4">
            {p.payment.family_items.map((it: string) => (
              <li set:html={md(it)}></li>
            ))}
          </ul>

          {p.payment.examples.map((ex: any) => (
            <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-4 mb-3">
              <div class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] mb-2">{ex.label}</div>
              <p class="text-sm" set:html={md(ex.body)}></p>
            </div>
          ))}
        </div>

        <div>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{p.payment.how_pay_h3}</h3>
          <ul class="list-disc list-inside space-y-1">
            {p.payment.how_pay_items.map((it: string) => (
              <li set:html={md(it)}></li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{p.payment.cancel_h3}</h3>
          {p.payment.cancel_paragraphs.map((para: string) => (
            <p class="mb-3" set:html={md(para)}></p>
          ))}
        </div>

        <div>
          <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-widest text-[var(--color-gold-light)] mb-2">{p.payment.force_majeure_h3}</h3>
          <p set:html={md(p.payment.force_majeure_p)}></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sekce 6: Osobní údaje a GDPR -->
  <section id="gdpr" class="scroll-mt-24">
    <div class="max-w-3xl">
      <h2 class="font-[family-name:var(--font-display)] text-xl sm:text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 flex items-center gap-3 leading-tight">
        <Icon name="lucide:shield-check" class="w-5 h-5 sm:w-6 sm:h-6 text-[var(--color-gold)] shrink-0" />
        {p.gdpr.h2}
      </h2>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3" set:html={md(p.gdpr.p1)}></p>
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-3">
        {p.gdpr.p2_pre}<a href={`/${lang}/gdpr/`} class="underline text-[var(--color-gold-light)]">{t('footer.legal.privacy')}</a>{p.gdpr.p2_post}
      </p>
      <AlertBox variant="info" title={p.gdpr.alert_title}>
        {p.gdpr.alert_body}
      </AlertBox>
    </div>
  </section>

  <!-- Sekce 7: Související odkazy -->
  <section class="scroll-mt-24">
    <div class="max-w-3xl">
      <h2 class="font-[family-name:var(--font-display)] text-xl sm:text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-4 flex items-center gap-3 leading-tight">
        <Icon name="lucide:link" class="w-5 h-5 sm:w-6 sm:h-6 text-[var(--color-gold)] shrink-0" />
        {p.related.h2}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        {p.related.items.map((item) => (
          <a href={`/${lang}${item.path}`} class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] p-4 transition-colors">
            <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] mb-1">{item.title}</div>
            <div class="text-xs text-[var(--color-text-on-dark-muted)]">{item.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

        </div><!-- /.reg-main -->
      </div><!-- /.grid -->
    </div><!-- /.container-base -->
  </section><!-- /sloučená sekce s sidebarem -->

  <script>
    import { initRegistration } from '@scripts/registration';
    import '@scripts/toc-spy';
    const root = document.getElementById('registration-app');
    const slug = root?.dataset.eventSlug ?? 'PP2026';
    initRegistration('#registration-app', slug);
  </script>
</BaseLayout>
