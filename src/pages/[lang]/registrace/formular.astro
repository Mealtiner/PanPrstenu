---
/**
 * /<lang>/registrace/formular/ — 301 redirect na /<lang>/registrace/#formular
 * Datum: 2026-05-12
 *
 * Stránka byla sloučena s /<lang>/registrace/. URL zachovaná pro
 * backward compatibility (staré odkazy, sdílené URL atd.).
 */
import type { Lang } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const target = `/${lang}/registrace/#formular`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Přesměrování — Pán Prstenů 2026</title>
  </head>
  <body>
    <p>Přesměrování na <a href={target}>{target}</a>…</p>
    <script set:html={`window.location.replace(${JSON.stringify(target)});`} is:inline />
  </body>
</html>
