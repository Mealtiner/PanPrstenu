---
/**
 * Bezpečnost a krizové situace
 * URL: /cs/bezpecnost/, …
 * Datum: 2026-04-30
 *
 * Praktická tisknutelná stránka „Co dělat, když se něco stane".
 * Doplněk k pravidlům a stránce pro rodiče. Použitelná i na mobilu
 * se špatným signálem.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: 'Bezpečnost a krizové situace' },
];

const procedures = [
  {
    icon: 'lucide:heart-pulse',
    title: 'Když se někdo zraní',
    color: 'evil',
    steps: [
      'Přerušte nebezpečnou činnost.',
      'Zajistěte okolí, aby nedošlo k dalšímu zranění.',
      'Přivolejte zdravotníka nebo organizátora.',
      'Nepřesouvejte zraněného, pokud to není nutné kvůli bezprostřednímu nebezpečí.',
      'U vážného stavu volejte 155 nebo 112 a informujte organizátory.',
    ],
  },
  {
    icon: 'lucide:user-search',
    title: 'Když se ztratí dítě nebo účastník',
    color: 'gold',
    steps: [
      'Ihned informujte organizátora / registraci / org stan.',
      'Uveďte jméno, věk, vzhled, kostým a kde byl naposledy viděn.',
      'Neorganizujte chaotické hledání bez domluvy s orgy.',
      'Organizátor určí další postup.',
    ],
  },
  {
    icon: 'lucide:flame',
    title: 'Požár',
    color: 'evil',
    steps: [
      'Varujte okolí.',
      'Nehaste, pokud byste ohrozili sebe.',
      'Zavolejte organizátora.',
      'Volejte 150 nebo 112 podle rozsahu.',
      'Uvolněte přístupové cesty pro hasiče.',
      'Řiďte se pokyny organizátorů.',
    ],
  },
  {
    icon: 'lucide:cloud-lightning',
    title: 'Bouřka, silný vítr, extrémní počasí',
    color: 'gold',
    steps: [
      'Sledujte pokyny organizátorů.',
      'Nezdržujte se pod osamělými stromy.',
      'Zajistěte stany a volné předměty.',
      'Při pokynu k přerušení hry okamžitě ukončete boj a přesuňte se na určené místo.',
    ],
  },
  {
    icon: 'lucide:shield-alert',
    title: 'Konflikt / nevhodné chování / porušení hranic',
    color: 'free',
    steps: [
      'Pokud je to bezpečné, řekněte jasně, že vám chování vadí.',
      'V případě potřeby kontaktujte organizátora, důvěrníka nebo důvěrnici.',
      'Neřešte vážné konflikty fyzicky ani veřejným lynčem.',
      'Organizátor má právo účastníka napomenout, omezit nebo vyloučit.',
    ],
  },
  {
    icon: 'lucide:wine-off',
    title: 'Alkohol a omamné látky',
    color: 'evil',
    steps: [
      'Pod vlivem alkoholu nebo omamných látek se nesmí do bitvy.',
      'Během bitvy je konzumace přísně zakázána.',
      'Organizátor může účastníka z bitvy nebo akce vyloučit.',
    ],
  },
];

const colorMap: Record<string, string> = {
  free: 'border-[var(--color-side-free)]/40 hover:border-[var(--color-side-free)]',
  gold: 'border-[var(--color-gold)]/40 hover:border-[var(--color-gold)]',
  evil: 'border-[var(--color-side-evil)]/40 hover:border-[var(--color-side-evil)]',
};
---

<BaseLayout
  title="Bezpečnost a krizové situace"
  description="Praktický přehled co dělat při úrazu, ztracení dítěte, požáru, bouřce nebo konfliktu na akci. Tisknutelná verze pro tábor."
  lang={lang}
  breadcrumbs={[{ name: 'Bezpečnost', href: `/${lang}/bezpecnost/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        Bezpečnost a krizové situace
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        Co dělat, když se něco stane. Krátká praktická karta — vytisknout, vzít s sebou.
      </p>
    </div>
  </section>

  <!-- Tisknutelná bezpečnostní karta -->
  <section class="py-10 bg-[var(--color-bg-dark)]">
    <div class="container-base max-w-4xl">
      <div class="border-2 border-[var(--color-state-danger)] bg-[var(--color-state-danger)]/10 p-6 md:p-8">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
          <Icon name="lucide:phone" class="w-6 h-6 text-[var(--color-state-danger)]" aria-hidden="true" />
          Rychlá bezpečnostní karta
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Tísňová linka</dt>
            <dd class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-gold-light)]">
              <a href="tel:112" class="underline">112</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Záchranná služba</dt>
            <dd class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-gold-light)]">
              <a href="tel:155" class="underline">155</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Hasiči</dt>
            <dd class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-gold-light)]">
              <a href="tel:150" class="underline">150</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Policie</dt>
            <dd class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-gold-light)]">
              <a href="tel:158" class="underline">158</a>
            </dd>
          </div>
        </dl>

        <Divider variant="line-diamond" tone="dark" class="my-6" />

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Lokalita pro záchranné složky</dt>
            <dd>Křtiny / Bukovina, jižní Morava</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">GPS</dt>
            <dd><code class="text-[var(--color-gold-light)]">49.29895, 16.75916</code></dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Hlavní organizátor</dt>
            <dd>
              Mealtiner —
              <a href="tel:+420606369997" class="underline">606 369 997</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">E-mail</dt>
            <dd><a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">Zdravotník na místě</dt>
            <dd>U registrace / org stanu (kvalifikovaný zdravotník po celou dobu akce)</dd>
          </div>
        </dl>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-3 italic">
        Tip: vytiskni tuto kartu (Ctrl/Cmd+P) a vezmi si ji s sebou. Signál v okolí není vždy spolehlivý.
      </p>
    </div>
  </section>

  <!-- Procedury -->
  <section class="py-12 bg-[var(--color-bg-darkest)]">
    <div class="container-base max-w-5xl">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-8 text-center">
        Postupy v krizových situacích
      </h2>
      <Divider variant="ornament" tone="dark" class="mb-10" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {procedures.map((p) => (
          <div class={`border bg-[var(--color-bg-medium)]/30 p-5 ${colorMap[p.color]} transition-colors`}>
            <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-3">
              <Icon name={p.icon} class="w-5 h-5 text-[var(--color-gold)] shrink-0" aria-hidden="true" />
              {p.title}
            </h3>
            <ol class="list-decimal list-inside space-y-1.5 text-sm text-[var(--color-text-on-dark)]">
              {p.steps.map((step) => <li>{step}</li>)}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Návaznosti -->
  <section class="py-12">
    <div class="container-base max-w-4xl">
      <AlertBox variant="info" title="Související pravidla a informace">
        <ul class="list-disc list-inside mt-2 space-y-1">
          <li><a href={`/${lang}/pravidla/#boj-zasahy`} class="underline">Pravidla boje a zásahy</a></li>
          <li><a href={`/${lang}/pravidla/#smrt-a-oziveni`} class="underline">Smrt a oživování</a></li>
          <li><a href={`/${lang}/pro-rodice/`} class="underline">Pro rodiče — kompletní průvodce</a></li>
          <li><a href={`/${lang}/organizacni-informace/#doprava`} class="underline">Jak se k nám dostat (GPS, mapa)</a></li>
          <li><a href={`/${lang}/kontakt/`} class="underline">Kontakt na organizátory</a></li>
        </ul>
      </AlertBox>
    </div>
  </section>

</BaseLayout>
