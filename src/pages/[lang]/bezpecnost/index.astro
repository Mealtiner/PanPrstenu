---
/**
 * Bezpečnost a krizové situace
 * URL: /cs/bezpecnost/, …
 * Datum: 2026-05-03
 *
 * Praktická tisknutelná stránka „Co dělat, když se něco stane".
 * Doplněk k pravidlům a stránce pro rodiče. Použitelná i na mobilu
 * se špatným signálem.
 *
 * 2026-05-03: kompletní překlad do 5 jazyků (cs/en/de/sk/uk).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import AlertBox from '@components/blocks/AlertBox.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import { getPageData, type PageContent } from '@lib/content/pages';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'uk' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslation(lang);
const p = getPageData<PageContent>('bezpecnost', lang);

const breadcrumbItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: p.title },
];

type Procedure = {
  icon: string;
  titleKey: string;
  color: string;
  stepKeys: string[];
};

const procedures: Procedure[] = [
  {
    icon: 'lucide:heart-pulse',
    titleKey: 'p1_title',
    color: 'evil',
    stepKeys: [
      'p1_s1',
      'p1_s2',
      'p1_s3',
      'p1_s4',
      'p1_s5',
    ],
  },
  {
    icon: 'lucide:user-search',
    titleKey: 'p2_title',
    color: 'gold',
    stepKeys: [
      'p2_s1',
      'p2_s2',
      'p2_s3',
      'p2_s4',
    ],
  },
  {
    icon: 'lucide:flame',
    titleKey: 'p3_title',
    color: 'evil',
    stepKeys: [
      'p3_s1',
      'p3_s2',
      'p3_s3',
      'p3_s4',
      'p3_s5',
      'p3_s6',
    ],
  },
  {
    icon: 'lucide:cloud-lightning',
    titleKey: 'p4_title',
    color: 'gold',
    stepKeys: [
      'p4_s1',
      'p4_s2',
      'p4_s3',
      'p4_s4',
    ],
  },
  {
    icon: 'lucide:shield-alert',
    titleKey: 'p5_title',
    color: 'free',
    stepKeys: [
      'p5_s1',
      'p5_s2',
      'p5_s3',
      'p5_s4',
    ],
  },
  {
    icon: 'lucide:wine-off',
    titleKey: 'p6_title',
    color: 'evil',
    stepKeys: [
      'p6_s1',
      'p6_s2',
      'p6_s3',
    ],
  },
];

const colorMap: Record<string, string> = {
  free: 'border-[var(--color-side-free)]/40 hover:border-[var(--color-side-free)]',
  gold: 'border-[var(--color-gold)]/40 hover:border-[var(--color-gold)]',
  evil: 'border-[var(--color-side-evil)]/40 hover:border-[var(--color-side-evil)]',
};
---

<BaseLayout
  title={p.meta_title}
  description={p.description}
  lang={lang}
  breadcrumbs={[{ name: p.bc_label, href: `/${lang}/bezpecnost/` }]}
>

  <section class="py-12 bg-[var(--color-bg-darkest)] border-b border-[var(--color-gold-darkest)]">
    <div class="container-base">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl uppercase tracking-wider text-[var(--color-gold-light)] mt-4">
        {p.title}
      </h1>
      <p class="font-[family-name:var(--font-serif)] italic text-lg text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl">
        {p.subtitle}
      </p>
    </div>
  </section>

  <!-- Tisknutelná bezpečnostní karta -->
  <section class="py-10 bg-[var(--color-bg-dark)]">
    <div class="container-base max-w-4xl">
      <div class="border-2 border-[var(--color-state-danger)] bg-[var(--color-state-danger)]/10 p-6 md:p-8">
        <h2 class="font-[family-name:var(--font-display)] text-xl uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-3">
          <Icon name="lucide:phone" class="w-6 h-6 text-[var(--color-state-danger)]" aria-hidden="true" />
          {p.card_title}
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.emergency_label}</dt>
            <dd class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-gold-light)]">
              <a href="tel:112" class="underline">112</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.ems_label}</dt>
            <dd class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-gold-light)]">
              <a href="tel:155" class="underline">155</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.fire_label}</dt>
            <dd class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-gold-light)]">
              <a href="tel:150" class="underline">150</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.police_label}</dt>
            <dd class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-gold-light)]">
              <a href="tel:158" class="underline">158</a>
            </dd>
          </div>
        </dl>

        <Divider variant="line-diamond" tone="dark" class="my-6" />

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.location_label}</dt>
            <dd>{p.location_value}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.gps_label}</dt>
            <dd><code class="text-[var(--color-gold-light)]">49.29895, 16.75916</code></dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.main_org_label}</dt>
            <dd>
              {p.main_org_name} —
              <a href="tel:+420606369997" class="underline">606 369 997</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.email_label}</dt>
            <dd><a href="mailto:info@panprstenu.cz" class="underline">info@panprstenu.cz</a></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs uppercase tracking-widest text-[var(--color-text-on-dark-muted)]">{p.medic_label}</dt>
            <dd>{p.medic_value}</dd>
          </div>
        </dl>
      </div>

      <p class="text-xs text-[var(--color-text-on-dark-muted)] mt-3 italic">
        {p.print_tip}
      </p>
    </div>
  </section>

  <!-- Procedury -->
  <section class="py-12 bg-[var(--color-bg-darkest)]">
    <div class="container-base max-w-5xl">
      <h2 class="font-[family-name:var(--font-display)] text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-8 text-center">
        {p.h_procedures}
      </h2>
      <Divider variant="ornament" tone="dark" class="mb-10" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {procedures.map((proc) => (
          <div class={`border bg-[var(--color-bg-medium)]/30 p-5 ${colorMap[proc.color]} transition-colors`}>
            <h3 class="font-[family-name:var(--font-display)] text-lg uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-3">
              <Icon name={proc.icon} class="w-5 h-5 text-[var(--color-gold)] shrink-0" aria-hidden="true" />
              {p[proc.titleKey]}
            </h3>
            <ol class="list-decimal list-inside space-y-1.5 text-sm text-[var(--color-text-on-dark)]">
              {proc.stepKeys.map((sk) => <li>{p[sk]}</li>)}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Návaznosti -->
  <section class="py-12">
    <div class="container-base max-w-4xl">
      <AlertBox variant="info" title={p.related_title}>
        <ul class="list-disc list-inside mt-2 space-y-1">
          <li><a href={`/${lang}/pravidla/#boj-zasahy`} class="underline">{p.rel_l1}</a></li>
          <li><a href={`/${lang}/pravidla/#smrt-a-oziveni`} class="underline">{p.rel_l2}</a></li>
          <li><a href={`/${lang}/pro-rodice/`} class="underline">{p.rel_l3}</a></li>
          <li><a href={`/${lang}/organizacni-informace/#doprava`} class="underline">{p.rel_l4}</a></li>
          <li><a href={`/${lang}/kontakt/`} class="underline">{p.rel_l5}</a></li>
        </ul>
      </AlertBox>
    </div>
  </section>

</BaseLayout>
