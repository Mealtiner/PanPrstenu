---
/**
 * 404 — Stránka nenalezena
 * Datum: 2026-05-04
 *
 * Statická CS verze (Astro 6 vyrenderuje 404.html v rootu dist/).
 * Texty z src/content/pages/_root/404/cs.json (CMS-ready).
 * WebGlobe FTP host nastaví ErrorDocument 404 → /404.html.
 *
 * Pozn.: Web má 5 jazyků, ale 404 zůstává jednojazyčná (CS) na úrovni
 * web serveru. Pro per-lang 404 by bylo nutno SSR nebo client-side
 * lang detekci — pro statický build to není přínosné.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Divider from '@components/decorative/Divider.astro';
import { getPageData } from '@lib/content/pages';

interface Page404 {
  meta: { title: string; description: string };
  h1: string;
  subtitle: string;
  body: string;
  btn_home: string;
  btn_factions: string;
}

const p = getPageData<Page404>('_root/404', 'cs');
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  lang="cs"
  noIndex={true}
>

  <section class="min-h-[60vh] flex items-center py-20">
    <div class="container-base max-w-2xl text-center">

      <h1 class="font-[family-name:var(--font-display)] text-6xl tracking-wider text-[var(--color-gold-light)] mb-2">
        {p.h1}
      </h1>

      <Divider variant="line-diamond" tone="dark" class="!my-2" />

      <h2 class="font-[family-name:var(--font-serif)] italic text-2xl md:text-3xl text-[var(--color-gold)] mb-4">
        {p.subtitle}
      </h2>

      <p class="text-[var(--color-text-on-dark-muted)] mb-8 max-w-md mx-auto">
        {p.body}
      </p>

      <div class="flex flex-wrap gap-3 justify-center">
        <Button href="/cs/" variant="primary" size="md" icon="lucide:home" iconPosition="left">
          {p.btn_home}
        </Button>
        <Button href="/cs/frakce/" variant="secondary" size="md">
          {p.btn_factions}
        </Button>
      </div>

    </div>
  </section>

</BaseLayout>
