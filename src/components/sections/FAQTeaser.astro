---
/**
 * FAQTeaser — sekce "Časté dotazy" na HP
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 1. 4 nejčastější otázky + CTA na plnou FAQ stránku.
 */

import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import Accordion from '@components/blocks/Accordion.astro';
import Button from '@components/ui/Button.astro';
import Divider from '@components/decorative/Divider.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslation(lang);

const items = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
];
---

<section class="py-20 bg-[var(--color-bg-darkest)]" id="faq">
  <div class="container-base max-w-4xl">

    <div class="text-center mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)]">
        {t('faq.heading')}
      </h2>
      <Divider variant="ornament" tone="dark" class="mt-4" />
    </div>

    <div class="space-y-0">
      {items.map((item, idx) => (
        <Accordion question={item.q} open={idx === 0}>
          {item.a}
        </Accordion>
      ))}
    </div>

    <div class="text-center mt-10">
      <Button href={`/${lang}/faq/`} variant="secondary" size="md" icon="lucide:arrow-right">
        {t('cta.show_all_answers')}
      </Button>
    </div>
  </div>
</section>
