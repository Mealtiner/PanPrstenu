---
/**
 * Hero — úvodní sekce landing page
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 1 (desktop) a Image 2 (mobile).
 *
 * Struktura:
 *   - Velký nadpis "Pán Prstenů 2026"
 *   - Podtitulek "Bitva o Středozem"
 *   - Lede (3 řádky)
 *   - Meta chips (datum + místo)
 *   - 2 CTA tlačítka
 *   - Pozadí: gradient + atmosférická fotka (až dodáš)
 */

import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import Button from '@components/ui/Button.astro';
import Logo from '@components/layout/Logo.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslation(lang);
---

<section class="relative min-h-[85vh] flex items-center overflow-hidden -mt-20 pt-20">

  <!-- POZADÍ -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <!-- Gradient base — viditelný okamžitě (před načtením YT iframe ~1-2 s).
         Slouží jako tmavé pozadí pod YT video, aby se nikdy nezobrazil
         bílý/světlý mezikrok. -->
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-bg-dark)] via-[#1a2a1d] to-[var(--color-bg-darkest)]"></div>

    <!--
      YouTube video pozadí (atmosféra Pán Prstenů, start v 157s).
      Strategie:
        - Mobile (< 768px) ani uživatelé s saveData / reduced-motion → žádné video,
          jen tmavý gradient (úspora ~1+ MB datasem).
        - Desktop → lazy-load video iframe přes IntersectionObserver.
        - youtube-nocookie.com → GDPR-friendlier varianta.
      Iframe je vždy viditelný (žádný poster) — uživatel nečeká na fade.
      Tmavý gradient + bottom-mask kryjí YT controls bar dokud video nehraje.
    -->
    <div id="hero-video-bg" class="absolute inset-0 overflow-hidden hero-video-bg" data-yt-id="_ZT3-s1k5sQ" data-yt-start="157">
      <iframe
        id="hero-yt-iframe"
        title={t('a11y.hero_video_title')}
        src="https://www.youtube-nocookie.com/embed/_ZT3-s1k5sQ?autoplay=1&mute=1&controls=0&start=157&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&showinfo=0&enablejsapi=1&fs=0"
        loading="eager"
        allow="autoplay; encrypted-media; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
        tabindex="-1"
      ></iframe>
    </div>

    <!-- Bottom mask — kryje YT controls bar (cca 50px) když by se ukázal. -->
    <div class="absolute bottom-0 left-0 right-0 h-20 z-20 bg-gradient-to-t from-[var(--color-bg-darkest)] to-transparent pointer-events-none"></div>

    <!--
      Klik-overlay: po kliknutí otevře video v lightboxu (delegát na
      VideoGallery custom event). Musí být NAD videem ale pod textovým
      obsahem hero sekce.
    -->
    <button
      type="button"
      data-hero-video-open
      aria-label={t('a11y.hero_video_title')}
      class="absolute inset-0 z-30 bg-transparent border-0 cursor-pointer p-0 m-0"
    ></button>

    <!-- Radiální světlo (zvedne kontrast loga / nadpisu) -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse at 70% 45%, rgba(201,167,94,0.18), transparent 60%), radial-gradient(ellipse at 25% 80%, rgba(46,76,58,0.25), transparent 55%)"
    ></div>

    <!-- Tmavý overlay pro čitelnost textu nad videem -->
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg-darkest)]/90 via-[var(--color-bg-darkest)]/55 to-[var(--color-bg-darkest)]/35 pointer-events-none"></div>
    <div class="absolute inset-0 bg-[var(--color-bg-darkest)]/30 pointer-events-none"></div>
  </div>

  <style>
    /* Video pozadí: iframe musí celé pokrýt sekci. Vychází z větší z hodnot
       100vw × 9/16 a 100vh × 16/9 (cover režim — žádné černé pruhy). */
    .hero-video-bg iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: max(100vw, 177.78vh);
      height: max(56.25vw, 100vh);
      pointer-events: none;
      border: 0;
    }

    /* Respekt k uživateli, který vyžaduje omezený pohyb */
    @media (prefers-reduced-motion: reduce) {
      .hero-video-bg { display: none; }
    }
  </style>

  <script is:inline>
    // Spuštění YouTube IFrame API + zacyklení od startovního času.
    // Strategie pro mobile/saveData: nikdy nezapínat video, jen gradient.
    (function () {
      // Helper: odstraň iframe (cancel network request kde to lze)
      const skipVideo = () => {
        const wrap = document.getElementById('hero-video-bg');
        if (wrap) wrap.remove();
      };

      const mq = window.matchMedia;
      if (mq && mq('(prefers-reduced-motion: reduce)').matches) { skipVideo(); return; }

      // Mobile (< 768px) — nezapínat video, šetříme data + battery
      if (mq && mq('(max-width: 768px)').matches) { skipVideo(); return; }

      // Save-data hint (Chrome/Edge mobile uživatelé s vypnutými datami)
      const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      if (conn && (conn.saveData || /(2g|slow-2g)/.test(conn.effectiveType || ''))) { skipVideo(); return; }

      const wrap = document.getElementById('hero-video-bg');
      const iframe = document.getElementById('hero-yt-iframe');
      if (!wrap || !iframe) return;

      const startSec = parseInt(wrap.dataset.ytStart || '0', 10);

      // POZN.: iframe.src už je nastaven přímo v HTML (loading="eager"),
      // browser ho začne stahovat během parsování DOM — paralelně s LCP.
      // Žádný IntersectionObserver, žádný about:blank → faster start.

      // Načtení YouTube IFrame API a registrace handleru pro loop-from-start
      if (!document.getElementById('youtube-iframe-api')) {
        const tag = document.createElement('script');
        tag.id = 'youtube-iframe-api';
        tag.src = 'https://www.youtube.com/iframe_api';
        tag.async = true;
        document.head.appendChild(tag);
      }

      let player;
      const initPlayer = () => {
        if (!window.YT || !window.YT.Player) return;
        player = new window.YT.Player(iframe, {
          events: {
            onStateChange: function (e) {
              // Stav 0 = ENDED → skok zpět na start a opětovné spuštění
              if (e.data === 0) {
                try { player.seekTo(startSec, true); player.playVideo(); } catch {}
              }
            },
          },
        });
      };

      const previous = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = function () {
        if (typeof previous === 'function') previous();
        initPlayer();
      };

      // Klik na hero video → otevře lightbox přes custom event
      // (zachycený VideoGallery.astro). Funguje i na mobilu kde video
      // pozadí neběží — uživatel uvidí poster a klik otevře video v dialogu.
      const openBtn = document.querySelector('[data-hero-video-open]');
      if (openBtn) {
        openBtn.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('pp:open-video', {
            detail: { id: '_ZT3-s1k5sQ', title: 'Pán Prstenů — Bitva o Středozem', start: startSec },
          }));
        });
      }
    })();
  </script>

  <!-- OBSAH -->
  <div class="container-base relative z-10 py-16 md:py-24">
    <div class="max-w-3xl">

      <!-- Logo + hlavní nadpis -->
      <div class="flex items-center gap-5 md:gap-6 mb-2">
        <Logo size={88} showText={false} tone="gold" class="shrink-0 hidden sm:flex" title="Pán Prstenů — Bitva o Středozem 2026" />
        <h1
          class="font-[family-name:var(--font-display)] font-bold text-5xl md:text-6xl text-[var(--color-gold-light)] leading-none tracking-wider"
          style="text-shadow: 0 2px 20px rgba(0,0,0,0.6)"
        >
          {t('hero.title')} <span class="text-[var(--color-gold)]">{t('hero.year')}</span>
        </h1>
      </div>

      <!-- Podtitulek s ornamentem (jako v mockupu) -->
      <div class="flex items-center gap-3 mb-8">
        <span class="text-[var(--color-gold-dark)]">◆━</span>
        <p class="font-[family-name:var(--font-serif)] italic text-xl md:text-2xl text-[var(--color-gold)] uppercase tracking-widest">
          {t('hero.subtitle')}
        </p>
        <span class="text-[var(--color-gold-dark)]">━◆</span>
      </div>

      <!-- Lede -->
      <p class="text-base md:text-lg text-[var(--color-text-on-dark)] leading-relaxed mb-8 max-w-2xl">
        {t('hero.lede')}
      </p>

      <!-- Meta chips -->
      <div class="flex flex-wrap gap-3 mb-8">
        <span class="inline-flex items-center gap-2 px-4 py-2 border border-[var(--color-gold)]/40 bg-[var(--color-bg-dark)]/60 text-sm text-[var(--color-text-on-dark)] backdrop-blur-sm">
          <Icon name="lucide:calendar" class="w-4 h-4 text-[var(--color-gold)]" />
          {t('hero.date_chip')}
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-2 border border-[var(--color-gold)]/40 bg-[var(--color-bg-dark)]/60 text-sm text-[var(--color-text-on-dark)] backdrop-blur-sm">
          <Icon name="lucide:shield" class="w-4 h-4 text-[var(--color-gold)]" />
          {t('hero.location_chip')}
        </span>
      </div>

      <!-- CTA tlačítka -->
      <div class="flex flex-wrap gap-3">
        <Button
          href={`/${lang}/registrace/`}
          variant="primary"
          size="lg"
          icon="lucide:arrow-right"
          iconPosition="right"
        >
          {t('cta.i_want_to_come')}
        </Button>
        <Button
          href={`/${lang}/pro-novacky/`}
          variant="secondary"
          size="lg"
        >
          {t('cta.how_it_works')}
        </Button>
      </div>
    </div>
  </div>

  <!-- Scroll indikátor -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-[var(--color-gold)]/60 hidden md:block animate-bounce" aria-hidden="true">
    <Icon name="lucide:chevron-down" class="w-6 h-6" />
  </div>
</section>
