---
/**
 * HraVTaboreTeaser — homepage CTA bloky
 * Datum: 2026-05-03
 *
 * Dva výrazné bloky:
 *  - Hra v táboře (mince, questy, páteční program)
 *  - Hra pro malé dobrodruhy (děti)
 */

import Button from '@components/ui/Button.astro';
import Divider from '@components/decorative/Divider.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslation(lang);
---

<section class="py-16 bg-[var(--color-bg-darkest)] border-y border-[var(--color-gold-darkest)]">
  <div class="container-base max-w-6xl">
    <div class="text-center mb-10">
      <h2 class="font-[family-name:var(--font-display)] text-3xl md:text-4xl uppercase tracking-wider text-[var(--color-gold-light)]">
        {t('home.teaser.heading')}
      </h2>
      <p class="font-[family-name:var(--font-serif)] italic text-[var(--color-text-on-dark-muted)] mt-2 max-w-2xl mx-auto">
        {t('home.teaser.subheading')}
      </p>
    </div>

    <Divider variant="line-diamond" tone="dark" class="mb-10" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Hra v táboře -->
      <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-6 md:p-8 pp-card-hover hover:border-[var(--color-gold)] flex flex-col">
        <div class="flex items-center gap-3 mb-4">
          <Icon name="lucide:flame" class="w-9 h-9 text-[var(--color-gold)]" aria-hidden="true" />
          <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-wider text-[var(--color-gold-light)]">
            {t('home.teaser.camp.title')}
          </h3>
        </div>
        <p class="font-[family-name:var(--font-serif)] italic text-[var(--color-text-on-dark-muted)] mb-3">
          {t('home.teaser.camp.subtitle')}
        </p>
        <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-6 flex-1">
          {t('home.teaser.camp.body')}
        </p>
        <div class="flex flex-wrap gap-2">
          <Button href={`/${lang}/hra-v-tabore/`} variant="primary" size="md">{t('home.teaser.camp.cta')}</Button>
        </div>
      </article>

      <!-- Hra pro malé dobrodruhy -->
      <article class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-6 md:p-8 pp-card-hover hover:border-[var(--color-gold)] flex flex-col">
        <div class="flex items-center gap-3 mb-4">
          <Icon name="lucide:baby" class="w-9 h-9 text-[var(--color-gold)]" aria-hidden="true" />
          <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-wider text-[var(--color-gold-light)]">
            {t('home.teaser.kids.title')}
          </h3>
        </div>
        <p class="font-[family-name:var(--font-serif)] italic text-[var(--color-text-on-dark-muted)] mb-3">
          {t('home.teaser.kids.subtitle')}
        </p>
        <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-6 flex-1">
          {t('home.teaser.kids.body')}
        </p>
        <div class="flex flex-wrap gap-2">
          <Button href={`/${lang}/detska-hra/`} variant="primary" size="md">{t('home.teaser.kids.cta')}</Button>
        </div>
      </article>
    </div>
  </div>
</section>
