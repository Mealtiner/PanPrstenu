---
/**
 * SidebarNav — postranní navigace pro detail stránky
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 11. Sticky postranní menu s odkazy v rámci
 * dlouhé stránky (TOC) nebo navigace mezi sourozenci.
 *
 * Props:
 *   - heading: nadpis seznamu
 *   - items: pole { label, href, active? }
 */

import { Icon } from 'astro-icon/components';

interface Item {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  heading?: string;
  items: Item[];
  class?: string;
}

const { heading, items, class: className = '' } = Astro.props;
---

<aside class={`sticky top-24 ${className}`}>
  {heading && (
    <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-4 flex items-center gap-2">
      <span class="text-[var(--color-gold)] text-xs">◆</span>
      {heading}
    </h3>
  )}

  <nav aria-label={heading || 'Postranní navigace'}>
    <ul class="space-y-1 border-l border-[var(--color-gold-darkest)]" role="list">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class:list={[
              '-ml-px flex items-center gap-2 pl-4 py-2 text-sm transition-all border-l-2',
              item.active
                ? 'border-[var(--color-gold)] text-[var(--color-gold-light)] bg-[var(--color-gold)]/5'
                : 'border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)]',
            ]}
          >
            <Icon name="lucide:chevron-right" class="w-3 h-3 opacity-70" />
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
