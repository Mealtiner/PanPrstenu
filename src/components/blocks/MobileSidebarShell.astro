---
/**
 * MobileSidebarShell — wrapper kolem inline sidebaru, který přidá mobile
 * drawer chování (klikací záložka na levém okraji + drawer + backdrop).
 * Datum: 2026-05-03
 *
 * Použití:
 *   <MobileSidebarShell tabLabel="Kapitoly" ariaLabel="Kapitoly pravidel">
 *     <h3>Kapitoly</h3>
 *     <ul>...</ul>
 *   </MobileSidebarShell>
 *
 * Toggle řídí @scripts/mobile-sidebar.ts (importováno globálně z BaseLayout).
 *
 * Desktop (lg+): wrapper má lg:contents, takže slot obsah je přímý child
 *                rodičovského gridu (nezasahuje layout).
 * Mobile (<lg): wrapper drží button + backdrop + drawer s obsahem.
 */

import { Icon } from 'astro-icon/components';

interface Props {
  /** Label vertikálně rotovaný v záložce na levé hraně (default: 'Obsah') */
  tabLabel?: string;
  /** Ikona záložky (lucide alias) */
  tabIcon?: string;
  /** aria-label pro <aside> draweru */
  ariaLabel?: string;
  /** extra třídy k aside (např. specifický bg/padding) */
  asideClass?: string;
}

const {
  tabLabel = 'Obsah',
  tabIcon = 'lucide:list',
  ariaLabel = 'Obsah stránky',
  asideClass = '',
} = Astro.props;
---

<div class="lg:contents" data-mobile-sidebar-root>

  <!-- Mobile: vertikálně rotovaná záložka na levé hraně.
       Začíná pod hlavičkou (top-24 = 6rem), text je orientován shora-dolů
       přes writing-mode, aby nezasahovala do obsahu vodorovně. -->
  <button
    type="button"
    class="mobile-sidebar-tab lg:hidden fixed left-0 top-24 z-30 bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] border-l-0 text-[var(--color-gold-light)] hover:bg-[var(--color-gold)] hover:text-[var(--color-bg-dark)] rounded-r-md shadow-lg flex flex-col items-center justify-center gap-2 py-4 px-1.5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-gold-light)]"
    aria-expanded="false"
    aria-label={`${tabLabel} — otevřít`}
    data-mobile-sidebar-toggle
  >
    <Icon name={tabIcon} class="w-4 h-4 shrink-0" aria-hidden="true" />
    <span
      class="text-xs uppercase tracking-widest font-[family-name:var(--font-display)] [writing-mode:vertical-rl] [transform:rotate(180deg)]"
    >{tabLabel}</span>
  </button>

  <!-- Mobile: backdrop -->
  <div
    class="mobile-sidebar-backdrop lg:hidden fixed inset-0 z-30 bg-black/60 opacity-0 pointer-events-none transition-opacity duration-200"
    aria-hidden="true"
    data-mobile-sidebar-backdrop
  ></div>

  <!-- Sidebar — mobile = drawer mezi headerem a spodním okrajem (top-24 + bottom-4),
       desktop = sticky sloupec.
       Drawer NEPŘEKRÝVÁ page header, ale začíná pod ním. Vlastní vnitřní scroll
       se zlatým scrollbarem (přes Tailwind 4 utility + ::-webkit-scrollbar). -->
  <aside
    data-mobile-sidebar-drawer
    class:list={[
      // Mobile drawer
      'mobile-sidebar-drawer pp-gold-scrollbar fixed top-24 bottom-4 left-0 z-40 w-80 max-w-[85vw] bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] border-l-0 shadow-2xl -translate-x-full transition-transform duration-300 overflow-y-auto py-5 px-5 rounded-r-md',
      // Desktop sticky (přepisuje mobile classy: top-24 zůstává, ale bottom-auto, h-auto)
      'lg:sticky lg:top-24 lg:bottom-auto lg:left-auto lg:z-auto lg:h-auto lg:w-auto lg:max-w-none lg:max-h-[calc(100vh-7rem)] lg:translate-x-0 lg:transition-none lg:bg-transparent lg:border-0 lg:shadow-none lg:py-0 lg:px-0 lg:rounded-none lg:self-start lg:overflow-y-auto pr-2',
      asideClass,
    ]}
    aria-label={ariaLabel}
  >
    <!-- Mobile close — small X v rohu uvnitř drawer -->
    <button
      type="button"
      class="lg:hidden absolute top-3 right-3 w-9 h-9 flex items-center justify-center text-[var(--color-gold-light)] hover:text-[var(--color-gold)] border border-[var(--color-gold-darkest)] hover:border-[var(--color-gold)] rounded-full transition-colors"
      aria-label="Zavřít"
      data-mobile-sidebar-close
    >
      <Icon name="lucide:x" class="w-5 h-5" aria-hidden="true" />
    </button>

    <slot />
  </aside>
</div>

<style is:global>
  /* Zlatý scrollbar uvnitř mobile sidebar draweru.
     Firefox: scrollbar-color. WebKit (Chrome/Safari/iOS): ::-webkit-scrollbar. */
  .pp-gold-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: var(--color-gold) var(--color-bg-medium);
  }
  .pp-gold-scrollbar::-webkit-scrollbar {
    width: 8px;
  }
  .pp-gold-scrollbar::-webkit-scrollbar-track {
    background: var(--color-bg-medium);
  }
  .pp-gold-scrollbar::-webkit-scrollbar-thumb {
    background: var(--color-gold-dark);
    border-radius: 4px;
  }
  .pp-gold-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--color-gold);
  }
</style>
