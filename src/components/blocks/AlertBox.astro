---
/**
 * AlertBox — varování / info / úspěch
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 11 a Image 12. Barevně rozlišené hlášky s ikonou.
 *
 * Props:
 *   - variant: 'info' | 'success' | 'warning' | 'danger'
 *   - title: nadpis hlášky (volitelné)
 *   - icon: vlastní ikona (default podle variantu)
 */

import { Icon } from 'astro-icon/components';

interface Props {
  variant?: 'info' | 'success' | 'warning' | 'danger';
  title?: string;
  icon?: string;
  class?: string;
}

const {
  variant = 'info',
  title,
  icon,
  class: className = '',
} = Astro.props;

// Tokeny pro bg + text — automaticky se přepnou v light tématu
// (overrides v [data-theme="light"] v global.css).
const variantConfig = {
  info: {
    border: 'var(--color-state-info)',
    bg: 'var(--color-state-info-bg)',
    text: 'var(--color-state-info-text)',
    defaultIcon: 'lucide:info',
  },
  success: {
    border: 'var(--color-state-success)',
    bg: 'var(--color-state-success-bg)',
    text: 'var(--color-state-success-text)',
    defaultIcon: 'lucide:check-circle',
  },
  warning: {
    border: 'var(--color-state-warning)',
    bg: 'var(--color-state-warning-bg)',
    text: 'var(--color-state-warning-text)',
    defaultIcon: 'lucide:alert-triangle',
  },
  danger: {
    border: 'var(--color-state-danger)',
    bg: 'var(--color-state-danger-bg)',
    text: 'var(--color-state-danger-text)',
    defaultIcon: 'lucide:octagon-alert',
  },
}[variant];

const finalIcon = icon ?? variantConfig.defaultIcon;
---

<div
  role={variant === 'danger' || variant === 'warning' ? 'alert' : 'status'}
  class={`flex items-start gap-4 p-5 border-l-4 ${className}`}
  style={`border-left-color:${variantConfig.border};background:${variantConfig.bg};color:${variantConfig.text}`}
>
  <Icon name={finalIcon} class="w-6 h-6 flex-shrink-0 mt-0.5" />

  <div class="flex-1">
    {title && (
      <h4 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest mb-1">
        {title}
      </h4>
    )}
    <div class="text-sm leading-relaxed">
      <slot />
    </div>
  </div>
</div>
