---
/**
 * FactionRolesSidebar — sdílený sidebar pro detail armády i role
 * Datum: 2026-05-01
 *
 * Čtyři sekce:
 *  1. Svobodné národy Středozemě (z content collection 'factions', side='free')
 *  2. Síly Temného pána (side='evil')
 *  3. Žoldáci (side='mercenary') — neutrální vyrovnávací strana
 *  4. Další role (hardcoded nebojové role + Hobité + Dětská hra)
 *
 * Props:
 *   - lang: aktuální jazyk pro prefixy URL
 *   - currentSlug: slug aktuální stránky
 *   - currentSection: 'free' | 'evil' | 'mercenary' | 'role'
 */

import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import FactionIcon from '@components/decorative/FactionIcon.astro';
import { factionIconSlug, hasFactionIcon } from '@data/factionIcons';

interface Props {
  lang: Lang;
  currentSlug: string;
  currentSection: 'free' | 'evil' | 'mercenary' | 'role';
  class?: string;
}

const { lang, currentSlug, currentSection, class: className = '' } = Astro.props;
const t = getTranslation(lang);

const factions = await getCollection('factions');
const free = factions
  .filter((f) => f.data.side === 'free')
  .sort((a, b) => a.data.order - b.data.order);
const evil = factions
  .filter((f) => f.data.side === 'evil')
  .sort((a, b) => a.data.order - b.data.order);
const mercenary = factions
  .filter((f) => f.data.side === 'mercenary')
  .sort((a, b) => a.data.order - b.data.order);

const roles: Array<{ slug: string; label: string; icon: string; href?: string }> = [
  { slug: 'hobiti', label: 'Hobité', icon: 'lucide:wheat' },
  { slug: 'nebojovy-doprovod', label: 'Nebojový doprovod', icon: 'lucide:user-plus' },
  { slug: 'fotografove-a-kameramani', label: 'Fotografové a kameramani', icon: 'lucide:camera' },
  { slug: 'stankari', label: 'Stánkaři', icon: 'lucide:store' },
  { slug: 'pomocnici', label: 'Pomocníci', icon: 'lucide:hand-helping' },
  // Dětská hra má vlastní top-level URL /cs/detska-hra/, ne /role/...
  { slug: 'detska-hra', label: 'Dětská hra', icon: 'lucide:sparkles', href: `/${lang}/detska-hra/` },
];

const isActive = (section: 'free' | 'evil' | 'mercenary' | 'role', slug: string) =>
  section === currentSection && slug === currentSlug;

const factionSlug = (id: string) => id.replace(/\.ya?ml$/, '');
const factionName = (data: any) => data.i18n[lang]?.name ?? data.i18n.cs.name;

const groupClass = 'space-y-1 border-l border-[var(--color-gold-darkest)]';
const itemBaseClass = '-ml-px flex items-center gap-2 pl-3 py-1.5 text-sm transition-all border-l-2';
---

<aside class:list={['sticky top-24', className]} aria-label="Postranní navigace — armády a role">

  <!-- Svobodné národy -->
  <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-side-free-text)] mb-3 flex items-center gap-2">
    <span class="text-base" aria-hidden="true">⚔</span>
    {t('factions.free')}
  </h3>
  <ul class={groupClass} role="list">
    {free.map((f) => {
      const slug = factionSlug(f.id);
      const active = isActive('free', slug);
      return (
        <li>
          <a
            href={`/${lang}/frakce/${slug}/`}
            aria-current={active ? 'page' : undefined}
            class:list={[
              itemBaseClass,
              active
                ? 'border-[var(--color-side-free-text)] text-[var(--color-side-free-text)] bg-[var(--color-side-free-text)]/5 font-semibold'
                : 'border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-side-free-text)] hover:text-[var(--color-side-free-text)]',
            ]}
          >
            {hasFactionIcon(factionSlug(f.id)) ? (
              <FactionIcon slug={factionIconSlug(factionSlug(f.id))} size={18} tone="currentColor" class="opacity-80 shrink-0" />
            ) : (
              <span class="opacity-70" aria-hidden="true">{f.data.emblem}</span>
            )}
            {factionName(f.data)}
          </a>
        </li>
      );
    })}
  </ul>

  <!-- Síly Temného pána -->
  <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-side-evil-text)] mb-3 mt-6 flex items-center gap-2">
    <span class="text-base" aria-hidden="true">🔥</span>
    {t('factions.evil')}
  </h3>
  <ul class={groupClass} role="list">
    {evil.map((f) => {
      const slug = factionSlug(f.id);
      const active = isActive('evil', slug);
      return (
        <li>
          <a
            href={`/${lang}/frakce/${slug}/`}
            aria-current={active ? 'page' : undefined}
            class:list={[
              itemBaseClass,
              active
                ? 'border-[var(--color-side-evil-text)] text-[var(--color-side-evil-text)] bg-[var(--color-side-evil-text)]/5 font-semibold'
                : 'border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-side-evil-text)] hover:text-[var(--color-side-evil-text)]',
            ]}
          >
            {hasFactionIcon(factionSlug(f.id)) ? (
              <FactionIcon slug={factionIconSlug(factionSlug(f.id))} size={18} tone="currentColor" class="opacity-80 shrink-0" />
            ) : (
              <span class="opacity-70" aria-hidden="true">{f.data.emblem}</span>
            )}
            {factionName(f.data)}
          </a>
        </li>
      );
    })}
  </ul>

  <!-- Žoldáci (neutrální / vyrovnávací) -->
  {mercenary.length > 0 && (
    <>
      <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 mt-6 flex items-center gap-2">
        <span class="text-base" aria-hidden="true">⚒</span>
        {t('factions.mercenary')}
      </h3>
      <ul class={groupClass} role="list">
        {mercenary.map((f) => {
          const slug = factionSlug(f.id);
          const active = isActive('mercenary', slug);
          return (
            <li>
              <a
                href={`/${lang}/frakce/${slug}/`}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  itemBaseClass,
                  active
                    ? 'border-[var(--color-gold)] text-[var(--color-gold-light)] bg-[var(--color-gold)]/5 font-semibold'
                    : 'border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)]',
                ]}
              >
                <span class="opacity-70" aria-hidden="true">{f.data.emblem}</span>
                {factionName(f.data)}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}

  <!-- Další role -->
  <h3 class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)] mb-3 mt-6 flex items-center gap-2">
    <span class="text-[var(--color-gold)] text-xs" aria-hidden="true">◆</span>
    Další role
  </h3>
  <ul class={groupClass} role="list">
    {roles.map((r) => {
      const active = isActive('role', r.slug);
      return (
        <li>
          <a
            href={r.href ?? `/${lang}/role/${r.slug}/`}
            aria-current={active ? 'page' : undefined}
            class:list={[
              itemBaseClass,
              active
                ? 'border-[var(--color-gold)] text-[var(--color-gold-light)] bg-[var(--color-gold)]/5 font-semibold'
                : 'border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)]',
            ]}
          >
            {hasFactionIcon(r.slug) ? (
              <FactionIcon slug={factionIconSlug(r.slug)} size={18} tone="currentColor" class="opacity-80 shrink-0" />
            ) : (
              <Icon name={r.icon} class="w-3.5 h-3.5 opacity-70" aria-hidden="true" />
            )}
            {r.label}
          </a>
        </li>
      );
    })}
  </ul>

  <!-- Zpět na hub -->
  <div class="mt-8 pt-4 border-t border-[var(--color-gold-darkest)]">
    <a
      href={`/${lang}/frakce/`}
      class="inline-flex items-center gap-1 text-xs uppercase tracking-wider text-[var(--color-text-on-dark-muted)] hover:text-[var(--color-gold-light)]"
    >
      <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" aria-hidden="true" />
      Zpět na přehled
    </a>
  </div>
</aside>
