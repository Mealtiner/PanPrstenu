---
/**
 * EventFactsBlock — sdílený horní blok „Akce v kostce"
 * Datum: 2026-05-01
 *
 * Záměrně duplicovaný blok pro stránky Praktické informace
 * a Organizační informace / Informace podle role. Návštěvník při
 * příchodu na obě stránky vidí stejné základní fakty + CTA registrace.
 *
 * Props:
 *   - lang: jazyk pro CTA URL prefix
 *   - heading: nadpis (default „Akce v kostce")
 *   - intro: úvodní odstavec před kartami (default = generická věta)
 *   - showRegistrationCta: zobrazit CTA blok pod kartami (default true)
 *   - bottomNote: text pod kartami (default = info o sobotě/pátku)
 *   - class: dodatečné třídy
 */

import Button from '@components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { getEvent } from '@data/event';
import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';

interface Props {
  lang: Lang;
  heading?: string;
  intro?: string;
  showRegistrationCta?: boolean;
  bottomNote?: string;
  class?: string;
}

const {
  lang,
  heading,
  intro,
  showRegistrationCta = true,
  bottomNote,
  class: className = '',
} = Astro.props;

const t = getTranslation(lang);
const event = getEvent(lang);

const headingText = heading ?? t('event_facts.heading');
const introText = intro ?? t('event_facts.intro');
const noteText = bottomNote ?? t('event_facts.note');

const cards = [
  { icon: 'lucide:calendar',         label: t('event_facts.card.date_label'),         value: event.date_short,    note: t('event_facts.card.date_note') },
  { icon: 'lucide:map-pin',          label: t('event_facts.card.place_label'),        value: event.place,         note: event.region },
  { icon: 'lucide:users',            label: t('event_facts.card.participants_label'), value: event.participants,  note: event.participants_note },
  { icon: 'lucide:user-check',       label: t('event_facts.card.age_label'),          value: event.age,           note: event.age_note },
  { icon: 'game-icons:crossed-swords', label: t('event_facts.card.armies_label'),     value: event.armies,        note: event.armies_note },
  { icon: 'lucide:tent',             label: t('event_facts.card.camps_label'),        value: event.camps,         note: event.camps_note },
  { icon: 'lucide:shield-alert',     label: t('event_facts.card.safety_label'),       value: event.safety,        note: event.safety_note },
  { icon: 'lucide:utensils',         label: t('event_facts.card.food_label'),         value: event.food,          note: event.food_note },
  { icon: 'lucide:baby',             label: t('event_facts.card.kids_label'),         value: event.kids_age,      note: event.kids_note },
  { icon: 'lucide:eye',              label: t('event_facts.card.noncombat_label'),    value: event.noncombat,     note: event.noncombat_note },
];
---

<section class:list={['py-12 bg-[var(--color-bg-darkest)] border-y border-[var(--color-gold-darkest)]', className]} aria-labelledby="event-facts-heading">
  <div class="container-base">

    <h2 id="event-facts-heading" class="font-[family-name:var(--font-display)] text-2xl md:text-3xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3 flex items-center gap-3">
      <span class="text-[var(--color-gold)] text-sm" aria-hidden="true">◆</span>
      {heading}
    </h2>

    {introText && (
      <p class="text-[var(--color-text-on-dark)] leading-relaxed mb-8 max-w-3xl">
        {introText}
      </p>
    )}

    <!-- 10 karet (2 sloupce na mobilu, 3 na md, 5 na lg → 5×2 matice) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4 mb-6">
      {cards.map((c) => (
        <div class="bg-[var(--color-bg-medium)]/60 border border-[var(--color-gold)]/30 p-4 md:p-5 flex flex-col items-center text-center">
          <Icon name={c.icon} class="w-6 h-6 text-[var(--color-gold)] mb-2" aria-hidden="true" />
          <div class="text-[10px] uppercase tracking-widest text-[var(--color-text-on-dark-muted)] mb-1">{c.label}</div>
          <div class="font-[family-name:var(--font-display)] text-lg md:text-xl text-[var(--color-gold-light)] leading-tight mb-1">
            {c.value}
          </div>
          <div class="text-xs text-[var(--color-text-on-dark-muted)] leading-tight">{c.note}</div>
        </div>
      ))}
    </div>

    <p class="text-sm text-[var(--color-text-on-dark-muted)] italic mb-8 max-w-3xl">
      {noteText}
    </p>

    {showRegistrationCta && (
      <div class="bg-[var(--color-bg-medium)]/40 border border-[var(--color-gold)]/40 p-6 md:p-8 max-w-3xl">
        <h3 class="font-[family-name:var(--font-display)] text-xl md:text-2xl uppercase tracking-wider text-[var(--color-gold-light)] mb-3">
          {t('event_facts.cta_h3')}
        </h3>
        <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-5">
          {t('event_facts.cta_body_pre')}<strong>{event.registration_system}</strong>{t('event_facts.cta_body_mid')}<strong>{t('event_facts.cta_body_due_pre')}{event.payment_due_days}{t('event_facts.cta_body_due_post')}</strong>{t('event_facts.cta_body_post')}{event.payment_methods.join(t('event_facts.cta_body_or'))}{t('event_facts.cta_body_end')}
        </p>
        <div class="flex flex-wrap gap-3">
          <Button href={`/${lang}/registrace/`} variant="primary" size="md" icon="lucide:arrow-right">
            {t('event_facts.btn_register')}
          </Button>
          <Button href={`/${lang}/pro-novacky/`} variant="secondary" size="md">
            {t('event_facts.btn_newcomer')}
          </Button>
          <Button href={`/${lang}/organizacni-informace/#program`} variant="ghost" size="md">
            {t('event_facts.btn_schedule')}
          </Button>
        </div>
      </div>
    )}

  </div>
</section>
