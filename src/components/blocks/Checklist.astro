---
/**
 * Checklist — seznam s odškrtávacími položkami
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 11 (sekce "Co tě čeká") a Image 1.
 * Vstupní pole `items` (string[]) — vykreslí jako:
 *
 *   ✓  Položka 1
 *   ✓  Položka 2
 *   …
 *
 * Props:
 *   - items: string[]
 *   - heading: nadpis seznamu (volitelné)
 *   - tone: 'dark' (default) | 'parchment'
 *   - icon: Iconify název check ikony (default 'lucide:check')
 */

import { Icon } from 'astro-icon/components';

interface Props {
  items: string[];
  heading?: string;
  tone?: 'dark' | 'parchment';
  icon?: string;
  class?: string;
}

const {
  items,
  heading,
  tone = 'dark',
  icon = 'lucide:check',
  class: className = '',
} = Astro.props;

const accentColor = tone === 'dark' ? 'var(--color-gold)' : 'var(--color-gold-darkest)';
const headingColor = tone === 'dark'
  ? 'text-[var(--color-gold-light)]'
  : 'text-[var(--color-text-on-light)]';
const itemColor = tone === 'dark'
  ? 'text-[var(--color-text-on-dark)]'
  : 'text-[var(--color-text-on-light)]';
---

<div class={className}>
  {heading && (
    <h3 class={`font-[family-name:var(--font-display)] text-lg uppercase tracking-widest mb-5 flex items-center gap-3 ${headingColor}`}>
      <span style={`color:${accentColor}`}>◆</span>
      {heading}
    </h3>
  )}

  <ul class="space-y-3" role="list">
    {items.map((item) => (
      <li class={`flex items-start gap-3 text-sm md:text-base leading-relaxed ${itemColor}`}>
        <span
          class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full flex items-center justify-center"
          style={`border:1px solid ${accentColor};color:${accentColor}`}
          aria-hidden="true"
        >
          <Icon name={icon} class="w-3 h-3" />
        </span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
