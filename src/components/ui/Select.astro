---
/**
 * Select — dropdown
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 9. Nativní <select> stylizovaný do tématu.
 *
 * Props:
 *   - id, name, label
 *   - options: { value, label }[]
 *   - placeholder: text první (disabled) volby
 */

import { Icon } from 'astro-icon/components';

interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name?: string;
  label?: string;
  options: Option[];
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  hint?: string;
  error?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  options,
  value,
  placeholder,
  required = false,
  disabled = false,
  hint,
  error,
  class: className = '',
} = Astro.props;

const hasError = !!error;
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---

<div class={`flex flex-col gap-2 ${className}`}>
  {label && (
    <label
      for={id}
      class="font-[family-name:var(--font-display)] text-xs uppercase tracking-widest text-[var(--color-gold-light)]"
    >
      {label}
      {required && <span class="text-[var(--color-state-danger)] ml-1">*</span>}
    </label>
  )}

  <div class="relative">
    <select
      id={id}
      name={name ?? id}
      required={required}
      disabled={disabled}
      aria-invalid={hasError}
      aria-describedby={describedBy}
      class:list={[
        'w-full bg-[var(--color-bg-darkest)]/60 border text-[var(--color-text-on-dark)] px-4 py-3 pr-10 transition-colors focus:outline-none appearance-none cursor-pointer',
        hasError
          ? 'border-[var(--color-state-danger)] focus:border-[var(--color-state-danger)]'
          : 'border-[var(--color-gold-darkest)] focus:border-[var(--color-gold)]',
        disabled ? 'opacity-50 cursor-not-allowed' : '',
      ]}
    >
      {placeholder && (
        <option value="" disabled selected={!value}>{placeholder}</option>
      )}
      {options.map((opt) => (
        <option value={opt.value} selected={value === opt.value}>
          {opt.label}
        </option>
      ))}
    </select>

    <Icon
      name="lucide:chevron-down"
      class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-gold)] pointer-events-none"
    />
  </div>

  {hint && !error && (
    <small id={`${id}-hint`} class="text-xs text-[var(--color-text-on-dark-muted)]">
      {hint}
    </small>
  )}

  {error && (
    <small id={`${id}-error`} class="text-xs text-[var(--color-state-danger)] flex items-center gap-1">
      <Icon name="lucide:alert-circle" class="w-3 h-3" />
      {error}
    </small>
  )}
</div>
