---
/**
 * Tag (Pill) — drobný štítek pro kategorie, novinky atd.
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 9.
 *
 * Varianty:
 *   - default | gold | green | red | info
 */

import { Icon } from 'astro-icon/components';

interface Props {
  variant?: 'default' | 'gold' | 'green' | 'red' | 'info';
  size?: 'sm' | 'md';
  icon?: string;
  href?: string;
  class?: string;
}

const {
  variant = 'default',
  size = 'sm',
  icon,
  href,
  class: className = '',
} = Astro.props;

const variantClasses = {
  default: 'bg-[var(--color-bg-medium)] border-[var(--color-gold-darkest)] text-[var(--color-text-on-dark)]',
  gold: 'bg-[var(--color-gold)]/15 border-[var(--color-gold)] text-[var(--color-gold-light)]',
  green: 'bg-[var(--color-side-free)]/20 border-[var(--color-side-free)] text-[#9ec5a8]',
  red: 'bg-[var(--color-state-danger)]/20 border-[var(--color-state-danger)] text-[#e8a8aa]',
  info: 'bg-[var(--color-state-info)]/20 border-[var(--color-state-info)] text-[#a8c5d4]',
}[variant];

const sizeClasses = {
  sm: 'text-[10px] px-2 py-0.5',
  md: 'text-xs px-3 py-1',
}[size];

const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class={`inline-flex items-center gap-1.5 border uppercase tracking-widest font-[family-name:var(--font-display)] no-underline ${variantClasses} ${sizeClasses} ${className}`}
>
  {icon && <Icon name={icon} class="w-3 h-3" />}
  <slot />
</Tag>
