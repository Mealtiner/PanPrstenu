---
/**
 * Breadcrumb — drobečková navigace
 * Datum: 2026-04-29 (revize 2026-08-14)
 *
 * Podle mockupu Image 9.
 *
 * POZOR — JSON-LD `BreadcrumbList` tady ZÁMĚRNĚ NENÍ.
 * Do 2026-08-14 ho komponenta emitovala do <body> a zároveň ho
 * `BaseLayout` emitoval do <head> přes prop `breadcrumbs`. Výsledkem
 * byly na ~37 stránkách DVA konfliktní BreadcrumbList entity — Google
 * v takovém případě vybírá jeden nedeterministicky a Rich Results Test
 * hlásí duplicitu. Jediným zdrojem pravdy je teď `BaseLayout`
 * (prop `breadcrumbs`), viz src/layouts/BaseLayout.astro.
 *
 * Značkování `<nav><ol><li>` + `aria-current="page"` zůstává —
 * vyhledávače i čtečky z něj hierarchii přečtou i bez JSON-LD.
 *
 * Props:
 *   - items: { label, href? }[]  (poslední je current)
 */

import { Icon } from 'astro-icon/components';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Drobečková navigace" class={`text-sm ${className}`}>
  <ol class="flex flex-wrap items-center gap-2" role="list">
    {items.map((item, idx) => {
      const isLast = idx === items.length - 1;
      return (
        <li class="flex items-center gap-2">
          {item.href && !isLast ? (
            <a
              href={item.href}
              class="text-[var(--color-text-on-dark-muted)] hover:text-[var(--color-gold-light)] transition-colors"
            >
              {item.label}
            </a>
          ) : (
            <span
              aria-current={isLast ? 'page' : undefined}
              class="text-[var(--color-gold-light)] font-[family-name:var(--font-display)] uppercase tracking-wider text-xs"
            >
              {item.label}
            </span>
          )}
          {!isLast && (
            <Icon
              name="lucide:chevron-right"
              class="w-3 h-3 text-[var(--color-gold-darkest)]"
              aria-hidden="true"
            />
          )}
        </li>
      );
    })}
  </ol>
</nav>
