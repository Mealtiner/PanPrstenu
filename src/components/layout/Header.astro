---
/**
 * Header — globální horní lišta s megamenu (desktop) + accordion (mobile)
 * Datum: 2026-05-01
 *
 * Chování:
 *   - Sticky, vždy viditelný
 *   - Desktop ≥lg: hlavní položky, megamenu pro mega položky (hover + klik)
 *   - Mobile <lg: hamburger → fullscreen drawer s accordion sekcemi
 *   - aria-current="page" na aktivní top-level + leaf
 *   - Esc zavře otevřené menu
 *   - Focus se vrací na původní toggle při zavření
 */

import type { Lang } from '@i18n/ui';
import { getTranslation } from '@i18n/ui';
import Logo from './Logo.astro';
import Button from '@components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { mainNavigation, primaryCta, getActiveKey } from '@data/navigation';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslation(lang);
const currentPath = Astro.url.pathname;

// Path bez /{lang}/ prefixu pro porovnání s navigačními URL
const pathWithoutLang = currentPath.replace(new RegExp(`^/${lang}`), '') || '/';
const activeKey = getActiveKey(pathWithoutLang);

// Mapování top-level klíče navigace → i18n klíče.
// Když je v navigation.ts uveden hardcoded label (cs), zde ho překládáme
// pomocí t() pro aktuální jazyk.
const topLevelLabel = (key: string, fallback: string): string => {
  switch (key) {
    case 'home': return t('nav.home');
    case 'newcomer': return t('nav.newcomer');
    case 'world': return t('mega.world');
    case 'practical': return t('mega.practical');
    case 'community': return t('mega.community');
    case 'collaboration': return t('mega.collaboration');
    case 'contact': return t('nav.contact');
    default: return fallback;
  }
};

// Mapování heading skupin v rámci megamenu.
const groupHeading = (parentKey: string, idx: number, fallback: string): string => {
  const k = `mega.${parentKey}.group${idx + 1}` as Parameters<typeof t>[0];
  const tr = t(k);
  return tr === k ? fallback : tr; // pokud klíč neexistuje, vraťíme fallback
};

// Highlight box title + text.
const highlightTitle = (parentKey: string, fallback: string): string => {
  const k = `mega.${parentKey}.cta_title` as Parameters<typeof t>[0];
  const tr = t(k);
  return tr === k ? fallback : tr;
};
const highlightText = (parentKey: string, fallback: string): string => {
  const k = `mega.${parentKey}.cta_text` as Parameters<typeof t>[0];
  const tr = t(k);
  return tr === k ? fallback : tr;
};
const highlightCtaLabel = (parentKey: string, fallback: string): string => {
  const k = `mega.${parentKey}.cta_label` as Parameters<typeof t>[0];
  const tr = t(k);
  return tr === k ? fallback : tr;
};

const localizedLabel = (item: { label: string; i18n?: Partial<Record<Lang, { label?: string }>> }): string =>
  item.i18n?.[lang]?.label ?? item.label;

const localizedDescription = (item: { description?: string; i18n?: Partial<Record<Lang, { description?: string }>> }): string | undefined =>
  item.i18n?.[lang]?.description ?? item.description;

// Helper: prefixuj URL z navigation.ts s /{lang}/, pokud nezačíná /cs/, /en/, atd.
const prefixHref = (href: string) => {
  if (href === '/') return `/${lang}/`;
  if (href.startsWith('#') || /^[a-z][a-z0-9+.-]*:/i.test(href) || href.startsWith('//')) return href;
  if (/^\/(cs|en|de|sk|uk)\//.test(href)) return href;
  return `/${lang}${href}`;
};

const isLeafActive = (href: string) => {
  const target = prefixHref(href);
  return target === currentPath || (target !== `/${lang}/` && currentPath.startsWith(target));
};
---

<header
  data-header
  class="fixed top-0 left-0 right-0 z-50 bg-[var(--color-bg-darkest)]/90 backdrop-blur-md border-b border-[var(--color-gold-darkest)]/30 transition-shadow duration-300"
  role="banner"
>
  <div class="container-base flex items-center justify-between py-4">

    <!-- Logo -->
    <a
      href={`/${lang}/`}
      class="flex items-center gap-3 hover:opacity-90 transition-opacity"
      aria-label="Pán Prstenů — Bitva o Středozem"
    >
      <Logo />
    </a>

    <!-- Desktop navigace (lg+) -->
    <nav class="hidden lg:flex items-center" aria-label="Hlavní navigace" data-megamenu-root>
      <ul class="flex items-center gap-1 xl:gap-2">
        {mainNavigation.map((item) => (
          <li class="relative" data-mega-item={item.type === 'mega' ? item.key : undefined}>
            {item.type === 'link' ? (
              <a
                href={prefixHref(item.href)}
                aria-current={activeKey === item.key ? 'page' : undefined}
                class:list={[
                  'block px-3 py-2 text-xs xl:text-sm uppercase tracking-wider font-[family-name:var(--font-display)] transition-colors',
                  activeKey === item.key
                    ? 'text-[var(--color-gold-light)]'
                    : 'text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]',
                ]}
              >
                {topLevelLabel(item.key, item.label)}
              </a>
            ) : item.href ? (
              <div class="inline-flex items-center">
                <a
                  href={prefixHref(item.href)}
                  aria-current={activeKey === item.key ? 'page' : undefined}
                  class:list={[
                    'block pl-3 pr-1 py-2 text-xs xl:text-sm uppercase tracking-wider font-[family-name:var(--font-display)] transition-colors',
                    activeKey === item.key
                      ? 'text-[var(--color-gold-light)]'
                      : 'text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]',
                  ]}
                >
                  {topLevelLabel(item.key, item.label)}
                </a>
                <button
                  type="button"
                  data-mega-toggle={item.key}
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls={`mega-${item.key}`}
                  aria-label={`${item.label} – rozbalit menu`}
                  class:list={[
                    'inline-flex items-center justify-center w-7 h-7 transition-colors',
                    activeKey === item.key
                      ? 'text-[var(--color-gold-light)]'
                      : 'text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]',
                  ]}
                >
                  <Icon name="lucide:chevron-down" class="w-3.5 h-3.5 transition-transform" data-mega-chevron />
                </button>
              </div>
            ) : (
              <button
                type="button"
                data-mega-toggle={item.key}
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls={`mega-${item.key}`}
                aria-current={activeKey === item.key ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center gap-1 px-3 py-2 text-xs xl:text-sm uppercase tracking-wider font-[family-name:var(--font-display)] transition-colors',
                  activeKey === item.key
                    ? 'text-[var(--color-gold-light)]'
                    : 'text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]',
                ]}
              >
                {topLevelLabel(item.key, item.label)}
                <Icon name="lucide:chevron-down" class="w-3.5 h-3.5 transition-transform" data-mega-chevron />
              </button>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Pravá část -->
    <div class="flex items-center gap-3">
      <!-- Theme toggle (tmavý / světlý) — sjednoceno s panelem přístupnosti -->
      <button
        type="button"
        data-header-theme-toggle
        data-label-dark={t('a11y.theme.toggle_to_dark')}
        data-label-light={t('a11y.theme.toggle_to_light')}
        class="theme-toggle hidden md:inline-flex relative items-center justify-center w-10 h-10 rounded-full text-[var(--color-gold-light)] hover:bg-[var(--color-gold)]/15 hover:text-[var(--color-gold)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-gold)]"
        aria-label={t('a11y.theme.toggle_to_dark')}
        title={t('a11y.theme.toggle_to_dark')}
      >
        <Icon name="lucide:moon" class="theme-toggle-moon w-5 h-5" aria-hidden="true" />
        <Icon name="lucide:sun" class="theme-toggle-sun w-5 h-5" aria-hidden="true" />
      </button>

      <!-- CTA Registrovat se (md+) -->
      <Button
        href={`/${lang}${primaryCta.href}`}
        variant="primary"
        size="sm"
        class="hidden md:inline-flex"
      >
        {t('cta.register')}
      </Button>

      <!-- Mobile hamburger -->
      <button
        data-mobile-toggle
        type="button"
        class="lg:hidden flex items-center justify-center w-10 h-10 text-[var(--color-gold-light)] hover:text-[var(--color-gold)] transition-colors"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="lucide:menu" class="w-6 h-6" />
      </button>
    </div>
  </div>

  <!-- DESKTOP MEGAMENU PANELS (full width pod headerem) -->
  {mainNavigation.filter((i) => i.type === 'mega').map((item) => (
    item.type === 'mega' && (
      <div
        id={`mega-${item.key}`}
        data-mega-panel={item.key}
        class="mega-panel hidden absolute left-0 right-0 top-full bg-[var(--color-bg-darkest)] border-y border-[var(--color-gold)] shadow-2xl"
        role="region"
        aria-label={item.label}
      >
        <div class="container-base py-8">
          <div class:list={[
            'grid grid-cols-1 gap-8',
            item.highlight || item.columns.length < 4 ? 'lg:grid-cols-[2fr_1fr]' : 'lg:grid-cols-1',
          ]}>
            <!-- Sloupce -->
            <div class:list={[
              'grid gap-6',
              item.columns.length === 2 ? 'grid-cols-1 sm:grid-cols-2' : '',
              item.columns.length === 3 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' : '',
              item.columns.length >= 4 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' : '',
            ]}>
              {item.columns.map((col, idx) => (
                <div>
                  <h3 class="font-[family-name:var(--font-display)] text-xs uppercase tracking-widest text-[var(--color-gold)] mb-3 pb-2 border-b border-[var(--color-gold-darkest)]">
                    {groupHeading(item.key, idx, col.heading)}
                  </h3>
                  <ul class="space-y-3">
                    {col.items.map((leaf) => (
                      <li>
                        <a
                          href={prefixHref(leaf.href)}
                          aria-current={isLeafActive(leaf.href) ? 'page' : undefined}
                          class:list={[
                            'group block -m-2 p-2 transition-colors',
                            leaf.featured
                              ? 'border border-[var(--color-gold)]/50 bg-[var(--color-gold)]/5 hover:bg-[var(--color-gold)]/10 hover:border-[var(--color-gold)]'
                              : 'hover:bg-[var(--color-bg-medium)]/40',
                            !leaf.featured && isLeafActive(leaf.href) ? 'bg-[var(--color-bg-medium)]/30' : '',
                          ]}
                        >
                          <div class="font-[family-name:var(--font-display)] text-sm uppercase tracking-wider text-[var(--color-gold-light)] group-hover:text-[var(--color-gold)]">
                            {localizedLabel(leaf)}
                          </div>
                          {localizedDescription(leaf) && (
                            <div class="text-xs text-[var(--color-text-on-dark-muted)] mt-0.5 leading-relaxed">
                              {localizedDescription(leaf)}
                            </div>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <!-- Highlight box -->
            {item.highlight && (
              <aside class="self-start space-y-4">
                {/* Info řádky NAD rámečkem (datum, místo …) */}
                {item.highlight.info && item.highlight.info.length > 0 && (
                  <div class="bg-[var(--color-bg-darkest)] border border-[var(--color-gold-darkest)] p-4 flex items-center gap-3">
                    <div class="flex-1 space-y-2">
                      {item.highlight.info.map((row) => (
                        <div class="text-sm">
                          <span class="font-[family-name:var(--font-display)] uppercase tracking-widest text-xs text-[var(--color-gold)] block">
                            {row.label}
                          </span>
                          <span class="text-[var(--color-gold-light)]">{row.value}</span>
                        </div>
                      ))}
                    </div>
                    <a
                      href={`/${lang}/mapa/`}
                      class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold)] text-[var(--color-gold-light)] hover:bg-[var(--color-gold)] hover:text-[var(--color-bg-dark)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors shrink-0"
                    >
                      <Icon name="lucide:map-pin" class="w-3.5 h-3.5" aria-hidden="true" />
                      {t('header.megamenu.how_to_get_there')}
                    </a>
                  </div>
                )}

                {/* Hlavní rámeček */}
                <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold)] p-5">
                  <h4 class="font-[family-name:var(--font-display)] text-base uppercase tracking-wider text-[var(--color-gold-light)] mb-2">
                    {highlightTitle(item.key, item.highlight.title)}
                  </h4>
                  <p class="text-sm text-[var(--color-text-on-dark)] leading-relaxed mb-4">
                    {highlightText(item.key, item.highlight.text)}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {item.highlight.links.map((l) => (
                      <a
                        href={prefixHref(l.href)}
                        class="inline-flex items-center gap-1 px-3 py-1.5 border border-[var(--color-gold)] text-[var(--color-gold-light)] hover:bg-[var(--color-gold)] hover:text-[var(--color-bg-dark)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors"
                      >
                        {localizedLabel(l)}
                      </a>
                    ))}
                  </div>
                </div>

                {/* Velké CTA POD rámečkem */}
                {item.highlight.cta && (
                  <a
                    href={prefixHref(item.highlight.cta.href)}
                    class="block w-full text-center bg-[var(--color-gold)] text-[var(--color-bg-dark)] hover:bg-[var(--color-gold-light)] font-[family-name:var(--font-display)] uppercase tracking-wider text-base py-3 px-6 border border-[var(--color-gold)] transition-colors"
                  >
                    {highlightCtaLabel(item.key, localizedLabel(item.highlight.cta))}
                  </a>
                )}
              </aside>
            )}
          </div>
        </div>
      </div>
    )
  ))}
</header>

<!-- MOBILE MENU (accordion) -->
<div
  data-mobile-menu
  id="mobile-menu"
  class="fixed inset-0 z-60 bg-[var(--color-bg-darkest)] translate-x-full transition-transform duration-300 lg:hidden flex flex-col"
  aria-hidden="true"
>
  <!-- Drawer header bar: logo + close X (zarovnaný s page headerem) -->
  <div class="shrink-0 flex items-center justify-between px-6 h-20 border-b border-[var(--color-gold-darkest)]/30">
    <span class="font-[family-name:var(--font-display)] text-base tracking-wider text-[var(--color-gold-light)] uppercase">
      {t('nav.menu')}
    </span>
    <button
      data-mobile-close
      type="button"
      aria-label={t('nav.close')}
      title={t('nav.close')}
      class="flex items-center justify-center w-10 h-10 text-[var(--color-gold-light)] hover:text-[var(--color-gold)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-gold)] transition-colors"
    >
      <Icon name="lucide:x" class="w-6 h-6" />
    </button>
  </div>

  <div class="flex-1 overflow-y-auto px-6 pt-4 pb-4">
    <nav aria-label="Mobilní navigace" class="flex flex-col">
      {mainNavigation.map((item) => (
        item.type === 'link' ? (
          <a
            href={prefixHref(item.href)}
            aria-current={activeKey === item.key ? 'page' : undefined}
            class:list={[
              'py-4 px-2 text-base font-[family-name:var(--font-display)] uppercase tracking-wider border-b border-[var(--color-gold-darkest)] transition-colors',
              activeKey === item.key
                ? 'text-[var(--color-gold-light)]'
                : 'text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]',
            ]}
          >
            {topLevelLabel(item.key, item.label)}
          </a>
        ) : (
          <details class="border-b border-[var(--color-gold-darkest)]" data-mobile-section={item.key}>
            <summary class:list={[
              'py-4 px-2 text-base font-[family-name:var(--font-display)] uppercase tracking-wider cursor-pointer flex items-center justify-between list-none',
              activeKey === item.key
                ? 'text-[var(--color-gold-light)]'
                : 'text-[var(--color-text-on-dark)]',
            ]}>
              <span>{topLevelLabel(item.key, item.label)}</span>
              <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform" />
            </summary>
            <div class="pb-4 pl-4 space-y-4">
              {item.columns.map((col, idx) => (
                <div>
                  <h4 class="font-[family-name:var(--font-display)] text-xs uppercase tracking-widest text-[var(--color-gold)] mb-2 pt-2">
                    {groupHeading(item.key, idx, col.heading)}
                  </h4>
                  <ul class="space-y-2">
                    {col.items.map((leaf) => (
                      <li>
                        <a
                          href={prefixHref(leaf.href)}
                          aria-current={isLeafActive(leaf.href) ? 'page' : undefined}
                          class:list={[
                            'block py-1.5 px-2 text-sm font-[family-name:var(--font-display)] uppercase tracking-wider transition-colors',
                            isLeafActive(leaf.href)
                              ? 'text-[var(--color-gold-light)]'
                              : 'text-[var(--color-text-on-dark)] hover:text-[var(--color-gold-light)]',
                          ]}
                        >
                          {localizedLabel(leaf)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              {item.highlight && (
                <div class="bg-[var(--color-bg-medium)] border border-[var(--color-gold-darkest)] p-3 mt-2">
                  <div class="font-[family-name:var(--font-display)] text-xs uppercase tracking-wider text-[var(--color-gold-light)] mb-1">
                    {highlightTitle(item.key, item.highlight.title)}
                  </div>
                  <p class="text-xs text-[var(--color-text-on-dark)] leading-relaxed mb-2">
                    {highlightText(item.key, item.highlight.text)}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {item.highlight.links.map((l) => (
                      <a href={prefixHref(l.href)} class="text-xs uppercase tracking-wider text-[var(--color-gold-light)] underline">
                        {localizedLabel(l)}
                      </a>
                    ))}
                  </div>
                  {item.highlight.cta && (
                    <a
                      href={prefixHref(item.highlight.cta.href)}
                      class="mt-3 block w-full text-center bg-[var(--color-gold)] text-[var(--color-bg-dark)] font-[family-name:var(--font-display)] uppercase tracking-wider text-xs py-2 px-3"
                    >
                      {highlightCtaLabel(item.key, localizedLabel(item.highlight.cta))}
                    </a>
                  )}
                </div>
              )}
            </div>
          </details>
        )
      ))}
    </nav>
  </div>

  <!-- Sticky CTA dole — Navigovat + Email + Registrovat se -->
  <div class="shrink-0 bg-[var(--color-bg-darkest)] border-t border-[var(--color-gold-darkest)] p-3 lg:hidden">
    <div class="grid grid-cols-2 gap-2 mb-2">
      <a
        href="https://www.google.com/maps/dir/?api=1&destination=49.29895232776445,16.759155153131733"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-3 py-2.5 border border-[var(--color-gold)] text-[var(--color-gold-light)] hover:bg-[var(--color-gold)] hover:text-[var(--color-bg-dark)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors"
        aria-label={t('header.cta.navigate.aria')}
      >
        <Icon name="lucide:map-pin" class="w-4 h-4" aria-hidden="true" />
        {t('header.cta.navigate')}
      </a>
      <a
        href="mailto:info@panprstenu.cz"
        class="inline-flex items-center justify-center gap-2 px-3 py-2.5 border border-[var(--color-gold)] text-[var(--color-gold-light)] hover:bg-[var(--color-gold)] hover:text-[var(--color-bg-dark)] uppercase tracking-wider text-xs font-[family-name:var(--font-display)] transition-colors"
        aria-label={t('header.cta.write.aria')}
      >
        <Icon name="lucide:mail" class="w-4 h-4" aria-hidden="true" />
        {t('header.cta.write')}
      </a>
    </div>
    <Button
      href={`/${lang}${primaryCta.href}`}
      variant="primary"
      size="md"
      class="w-full"
    >
      {t('cta.register')}
    </Button>
  </div>
</div>

<!-- Spacer pro fixed header (výška = h-20 + safe-area-inset-top na iOS notch) -->
<div class="header-spacer" aria-hidden="true"></div>

<style is:global>
  [data-header] {
    transition: background-color 300ms ease, box-shadow 300ms ease;
  }
  [data-header].is-scrolled {
    background-color: var(--color-bg-darkest);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }
  [data-mobile-menu].is-open {
    --tw-translate-x: 0;
    transform: translateX(0);
  }
  /* Megamenu — opacity transition; visibility řízena přes .hidden + .is-open */
  .mega-panel {
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .mega-panel.is-open {
    opacity: 1;
  }
  /* Chevron rotace */
  [data-mega-toggle][aria-expanded="true"] [data-mega-chevron] {
    transform: rotate(180deg);
  }
  /* Mobile accordion <details> chevron rotace */
  [data-mobile-section] summary::-webkit-details-marker { display: none; }
  [data-mobile-section][open] > summary svg {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .mega-panel,
    [data-mega-chevron],
    [data-mobile-section][open] > summary svg {
      transition: none;
    }
  }

  /* Theme toggle — moon visible in light, sun visible in dark */
  .theme-toggle .theme-toggle-sun { display: none; }
  .theme-toggle .theme-toggle-moon { display: block; }
  :root[data-theme="dark"] .theme-toggle .theme-toggle-sun { display: block; color: var(--color-gold); }
  :root[data-theme="dark"] .theme-toggle .theme-toggle-moon { display: none; }
</style>

<script>
  // Theme toggle v hlavičce — synchronizováno s panelem přístupnosti
  (function () {
    const THEME_KEY = 'pp.theme';
    const btn = document.querySelector<HTMLButtonElement>('[data-header-theme-toggle]');
    if (!btn) return;
    const labelToDark = btn.dataset.labelDark ?? 'Přepnout na tmavý režim';
    const labelToLight = btn.dataset.labelLight ?? 'Přepnout na světlý režim';

    const sync = () => {
      const current = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      const nextLabel = current === 'dark' ? labelToLight : labelToDark;
      btn.setAttribute('aria-label', nextLabel);
      btn.setAttribute('title', nextLabel);
    };
    sync();

    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem(THEME_KEY, next); } catch (e) { /* ignore */ }
      // synchronizovat aria-pressed na panelových buttonech
      document.querySelectorAll<HTMLButtonElement>('[data-theme-mode]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.themeMode === next));
      });
      // update meta theme-color pro status bar mobilů
      const metaTheme = document.getElementById('meta-theme-color');
      if (metaTheme) {
        metaTheme.setAttribute('content', next === 'light' ? '#e6e9dd' : '#0A130D');
      }
      sync();
    });
  })();
</script>

