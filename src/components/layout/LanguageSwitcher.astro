---
/**
 * LanguageSwitcher — plovoucí kulatý button vpravo nahoře.
 * Datum: 2026-05-03
 *
 * Stejný vzor jako AccessibilityToolbar a CookieConsent — kulaté tlačítko
 * (12×12, zlaté pozadí, tmavá ikona). Otevírá panel s výběrem jazyka.
 *
 * Položky odkazují na ekvivalentní cestu v jiném jazyce — host stránky
 * předá `currentPath` (Astro.url.pathname). Pokud cesta neexistuje pro daný
 * jazyk, fallback na home (/${lang}/).
 *
 * Pozice: lg+ pravý horní roh (top-4 right-4), na mobilu skrýt (drawer
 * v hamburger menu má vlastní language switching, pokud bude potřeba).
 */

import { Icon } from 'astro-icon/components';
import type { Lang } from '@i18n/ui';

interface Props {
  /** Aktuální jazyk */
  lang: Lang;
  /** Aktuální cesta včetně /lang/ prefixu (Astro.url.pathname) */
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

const languages: Array<{ code: Lang; label: string; nativeLabel: string; flag: string }> = [
  { code: 'cs', label: 'Čeština',     nativeLabel: 'Česky',       flag: '🇨🇿' },
  { code: 'en', label: 'English',     nativeLabel: 'English',     flag: '🇬🇧' },
  { code: 'de', label: 'Deutsch',     nativeLabel: 'Deutsch',     flag: '🇩🇪' },
  { code: 'sk', label: 'Slovenčina',  nativeLabel: 'Slovensky',   flag: '🇸🇰' },
  { code: 'uk', label: 'Українська',  nativeLabel: 'Українською', flag: '🇺🇦' },
];

// Cesta bez /xx/ prefixu — použijeme pro slepování s novým jazykem
const pathWithoutLang = currentPath.replace(/^\/(cs|en|de|sk|uk)/, '') || '/';
const buildHref = (target: Lang) => `/${target}${pathWithoutLang}`;

const current = languages.find((l) => l.code === lang) ?? languages[0];
---

<div
  class="language-switcher fixed z-50 right-4 top-20 print:hidden"
  data-lang-switcher
  role="region"
  aria-label="Volba jazyka"
>
  <button
    type="button"
    class="lang-toggle inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-gold)] text-[var(--color-bg-dark)] shadow-lg hover:bg-[var(--color-gold-light)] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[var(--color-gold-light)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg-dark)] transition-colors"
    aria-expanded="false"
    aria-controls="lang-panel"
    aria-label={`Změnit jazyk — aktuálně ${current.label}`}
    data-lang-open
  >
    <Icon name="lucide:languages" class="w-6 h-6" aria-hidden="true" />
  </button>

  <div
    id="lang-panel"
    class="lang-panel hidden absolute right-0 top-14 w-60 bg-[var(--color-bg-darkest)] border border-[var(--color-gold)] shadow-2xl p-3"
    role="dialog"
    aria-modal="false"
    aria-labelledby="lang-panel-title"
  >
    <div class="flex items-center justify-between mb-3">
      <h2 id="lang-panel-title" class="font-[family-name:var(--font-display)] text-sm uppercase tracking-widest text-[var(--color-gold-light)]">
        Jazyk
      </h2>
      <button
        type="button"
        class="p-1 text-[var(--color-text-on-dark-muted)] hover:text-[var(--color-gold-light)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-gold)]"
        aria-label="Zavřít volbu jazyka"
        data-lang-close
      >
        <Icon name="lucide:x" class="w-5 h-5" aria-hidden="true" />
      </button>
    </div>

    <ul class="space-y-1" role="list">
      {languages.map((l) => {
        const isActive = l.code === lang;
        return (
          <li>
            <a
              href={buildHref(l.code)}
              hreflang={l.code}
              aria-current={isActive ? 'true' : undefined}
              class:list={[
                'flex items-center gap-3 px-3 py-2 text-sm border-l-2 transition-all',
                isActive
                  ? 'border-[var(--color-gold)] bg-[var(--color-gold)]/10 text-[var(--color-gold-light)] font-semibold'
                  : 'border-transparent text-[var(--color-text-on-dark)] hover:border-[var(--color-gold)] hover:text-[var(--color-gold-light)] hover:bg-[var(--color-gold)]/5',
              ]}
            >
              <span class="text-base" aria-hidden="true">{l.flag}</span>
              <span class="flex-1">{l.nativeLabel}</span>
              {isActive && <Icon name="lucide:check" class="w-4 h-4 text-[var(--color-gold)]" aria-hidden="true" />}
            </a>
          </li>
        );
      })}
    </ul>

    <p class="text-[11px] text-[var(--color-text-on-dark-muted)] italic mt-3 pt-3 border-t border-[var(--color-gold-darkest)]/40 leading-relaxed">
      Některé části webu jsou zatím dostupné jen v češtině. Anglickou, německou a slovenskou verzi postupně doplňujeme.
    </p>
  </div>
</div>

<style is:global>
  /* Open / close panel */
  [data-lang-switcher] .lang-panel:not(.hidden) {
    animation: lang-fade-in 180ms ease-out;
  }
  @keyframes lang-fade-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  /* Mobile: kulaté tlačítko schované — hamburger ho zatím nemá v sobě.
     (Lze přidat do mobile menu jako sekci „Jazyk" později; teď držíme MVP.) */
  @media (max-width: 1023px) {
    [data-lang-switcher] {
      display: none;
    }
  }
</style>

<script>
  // Toggle panel + Esc + click-outside zavře
  (function () {
    const root = document.querySelector<HTMLElement>('[data-lang-switcher]');
    if (!root) return;
    const toggle = root.querySelector<HTMLElement>('[data-lang-open]');
    const panel = root.querySelector<HTMLElement>('.lang-panel');
    const closeBtn = root.querySelector<HTMLElement>('[data-lang-close]');
    if (!toggle || !panel) return;

    const open = () => {
      panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      panel.classList.contains('hidden') ? open() : close();
    });
    closeBtn?.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
        close();
        toggle.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (panel.classList.contains('hidden')) return;
      const t = e.target as Node | null;
      if (!t) return;
      if (!root.contains(t)) close();
    });
  })();
</script>
