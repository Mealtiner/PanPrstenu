---
/**
 * Logo — Pán Prstenů, plný SVG vektor.
 * Datum: 2026-05-02
 *
 * Logo se vykresluje jako mask-image, takže se barva přebírá z
 * `background-color` (utility/CSS proměnné). Tím se logo automaticky
 * přizpůsobí tmavému i světlému motivu (zlatá v dark, tmavá v light)
 * a v patičce/headeru jen nastavíme správný tone.
 *
 * Props:
 *   size: number — výška v px (default 44; šířka se dopočte z poměru 841.9 × 595.3)
 *   showText: boolean (default true)
 *   tone: 'gold' | 'gold-light' | 'on-dark' | 'on-light' | 'currentColor' (default 'gold-light')
 *   variant: 'horizontal' (logo + 2 řádky textu vedle, default) | 'icon-only'
 *   class: extra class
 */

interface Props {
  size?: number;
  showText?: boolean;
  tone?: 'gold' | 'gold-light' | 'on-dark' | 'on-light' | 'currentColor';
  variant?: 'horizontal' | 'icon-only';
  class?: string;
  title?: string;
}

const {
  size = 44,
  showText = true,
  tone = 'gold-light',
  variant = 'horizontal',
  class: className = '',
  title = 'Pán Prstenů — Bitva o Středozem 2026',
} = Astro.props;

const url = '/images/logo/pan-prstenu.svg';

const toneVar = {
  'gold': 'var(--color-gold)',
  'gold-light': 'var(--color-gold-light)',
  'on-dark': 'var(--color-text-on-dark)',
  'on-light': 'var(--color-text-on-light)',
  'currentColor': 'currentColor',
}[tone];

// Logo viewBox: 841.9 × 595.3 → poměr ~1.414
const RATIO = 841.9 / 595.3;
const width = Math.round(size * RATIO);
---

<div class:list={['flex items-center gap-3', className]}>
  <span
    class="logo-mark inline-block shrink-0"
    style={`width:${width}px;height:${size}px;background-color:${toneVar};-webkit-mask:url(${url}) center / contain no-repeat;mask:url(${url}) center / contain no-repeat;`}
    role="img"
    aria-label={title}
  ></span>

  {showText && variant === 'horizontal' && (
    <div class="leading-tight">
      <div class="font-[family-name:var(--font-display)] font-semibold text-[var(--color-gold-light)] text-base md:text-lg tracking-wider">
        Pán Prstenů
      </div>
      <div class="font-[family-name:var(--font-display)] text-xs text-[var(--color-text-on-dark-muted)] tracking-widest uppercase">
        Bitva o Středozem
      </div>
    </div>
  )}
</div>
