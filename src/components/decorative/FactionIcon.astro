---
/**
 * FactionIcon — silueta-ikona národa/role barvená přes mask-image.
 * Datum: 2026-05-02
 *
 * SVG soubory v /public/images/ikony-narody/{slug}.svg jsou plné silhouette
 * (fill=černá). Element používáme jako mask-image; barva se řídí
 * `background-color` (resp. utility class), takže se snadno přepíná
 * mezi tmavým a světlým motivem.
 *
 * Props:
 *   - slug: slug ikony (např. 'gondor', 'elfove', 'horale', 'hobite')
 *   - size: px nebo Tailwind class — výška/šířka prvku
 *   - tone: 'gold-light' | 'gold' | 'side-free' | 'side-evil' | 'currentColor'
 *   - class: extra třídy
 */

interface Props {
  slug: string;
  size?: number;
  tone?: 'gold-light' | 'gold' | 'side-free' | 'side-evil' | 'currentColor';
  class?: string;
  ariaLabel?: string;
}

const {
  slug,
  size = 40,
  tone = 'gold-light',
  class: className = '',
  ariaLabel,
} = Astro.props;

const url = `/images/ikony-narody/${slug}.svg`;

const toneVar = {
  'gold-light': 'var(--color-gold-light)',
  'gold': 'var(--color-gold)',
  'side-free': 'var(--color-side-free-text)',
  'side-evil': 'var(--color-side-evil-text)',
  'currentColor': 'currentColor',
}[tone];
---

<span
  class:list={['inline-block faction-icon', className]}
  style={`width:${size}px;height:${size}px;background-color:${toneVar};-webkit-mask:url(${url}) center / contain no-repeat;mask:url(${url}) center / contain no-repeat;`}
  role={ariaLabel ? 'img' : undefined}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : 'true'}
></span>
