---
/**
 * EmblemMedallion — laurový věnec se symbolem
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 10. Kruh s vavřínovými listy a symbolem
 * armády uprostřed. Hodí se na karty armád, do hero, či mezi sekce.
 *
 * Props:
 *   - icon: Iconify název (např. 'game-icons:eagle-emblem')
 *   - size: px (default 120)
 *   - tone: 'gold' (default) | 'silver' | 'dark'
 */

import { Icon } from 'astro-icon/components';
import FactionIcon from '@components/decorative/FactionIcon.astro';

interface Props {
  icon?: string;
  iconSlug?: string;
  symbol?: string;
  size?: number;
  tone?: 'gold' | 'silver' | 'dark';
  class?: string;
}

const {
  icon,
  iconSlug,
  symbol,
  size = 120,
  tone = 'gold',
  class: className = '',
} = Astro.props;

const tonePalette = {
  gold: {
    primary: 'var(--color-gold)',
    secondary: 'var(--color-gold-light)',
    bg: 'var(--color-bg-medium)',
  },
  silver: {
    primary: '#a8a290',
    secondary: '#d8d2c0',
    bg: 'var(--color-bg-medium)',
  },
  dark: {
    primary: 'var(--color-gold-darkest)',
    secondary: 'var(--color-gold-dark)',
    bg: 'var(--color-bg-darkest)',
  },
}[tone];
---

<div
  class={`relative inline-flex items-center justify-center ${className}`}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 120 120"
    xmlns="http://www.w3.org/2000/svg"
    class="absolute inset-0 w-full h-full"
  >
    <!-- Vnější kruh -->
    <circle
      cx="60"
      cy="60"
      r="56"
      fill={tonePalette.bg}
      stroke={tonePalette.primary}
      stroke-width="1.5"
    />
    <circle
      cx="60"
      cy="60"
      r="50"
      fill="none"
      stroke={tonePalette.secondary}
      stroke-width="0.5"
      opacity="0.6"
    />

    <!-- Levé vavřínové listy -->
    <g stroke={tonePalette.primary} stroke-width="1.2" fill={tonePalette.primary} opacity="0.85">
      <ellipse cx="20" cy="40" rx="2.5" ry="6" transform="rotate(-30 20 40)"/>
      <ellipse cx="14" cy="55" rx="2.5" ry="6" transform="rotate(-15 14 55)"/>
      <ellipse cx="14" cy="68" rx="2.5" ry="6" transform="rotate(15 14 68)"/>
      <ellipse cx="20" cy="80" rx="2.5" ry="6" transform="rotate(30 20 80)"/>
    </g>

    <!-- Pravé vavřínové listy (mirror) -->
    <g stroke={tonePalette.primary} stroke-width="1.2" fill={tonePalette.primary} opacity="0.85">
      <ellipse cx="100" cy="40" rx="2.5" ry="6" transform="rotate(30 100 40)"/>
      <ellipse cx="106" cy="55" rx="2.5" ry="6" transform="rotate(15 106 55)"/>
      <ellipse cx="106" cy="68" rx="2.5" ry="6" transform="rotate(-15 106 68)"/>
      <ellipse cx="100" cy="80" rx="2.5" ry="6" transform="rotate(-30 100 80)"/>
    </g>

    <!-- Horní akcent -->
    <path
      d="M55 8 L60 4 L65 8 L60 14 Z"
      fill={tonePalette.secondary}
    />

    <!-- Spodní akcent -->
    <path
      d="M55 112 L60 116 L65 112 L60 106 Z"
      fill={tonePalette.secondary}
    />
  </svg>

  <!-- Centrální obsah -->
  <div class="relative z-10 flex items-center justify-center" style={`color:${tonePalette.secondary}`}>
    {iconSlug && (
      <FactionIcon slug={iconSlug} size={Math.round(size * 0.55)} tone="currentColor" />
    )}
    {!iconSlug && icon && <Icon name={icon} style={`width:${Math.round(size * 0.4)}px;height:${Math.round(size * 0.4)}px`} />}
    {!iconSlug && !icon && symbol && (
      <span
        class="font-[family-name:var(--font-display)] font-bold uppercase"
        style={`font-size:${Math.round(size * 0.25)}px`}
      >
        {symbol}
      </span>
    )}
  </div>
</div>
