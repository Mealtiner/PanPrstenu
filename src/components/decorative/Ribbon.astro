---
/**
 * Ribbon — banner / stuha s textem
 * Datum: 2026-04-29
 *
 * Podle mockupu Image 10. Středověký banner — používá se na zvýraznění
 * (např. nadpis sekce, štítek frakce, badge "Novinka").
 *
 * Tvar:
 *
 *   ◢━━━━━━━━━━━━◣
 *  ◢   TEXT      ◣
 *   ◥━━━━━━━━━━━━◤
 *
 * Props:
 *   - tone: 'gold' (default) | 'red' | 'green'
 *   - size: 'sm' | 'md' (default) | 'lg'
 */

interface Props {
  tone?: 'gold' | 'red' | 'green';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { tone = 'gold', size = 'md', class: className = '' } = Astro.props;

const tonePalette = {
  gold: {
    bg: 'var(--color-gold)',
    bgDark: 'var(--color-gold-dark)',
    text: 'var(--color-bg-darkest)',
  },
  red: {
    bg: 'var(--color-state-danger)',
    bgDark: '#5a1414',
    text: 'var(--color-parchment-light)',
  },
  green: {
    bg: 'var(--color-side-free)',
    bgDark: '#1a2e1f',
    text: 'var(--color-parchment-light)',
  },
}[tone];

const sizeClasses = {
  sm: 'text-xs px-6 py-1.5',
  md: 'text-sm px-8 py-2',
  lg: 'text-base px-10 py-3',
}[size];
---

<div class={`relative inline-block ${className}`}>
  <!-- Hlavní pruh -->
  <span
    class={`relative block font-[family-name:var(--font-display)] uppercase tracking-widest font-semibold ${sizeClasses}`}
    style={`background:${tonePalette.bg};color:${tonePalette.text}`}
  >
    <slot />
  </span>

  <!-- Levé záhyby -->
  <span
    class="absolute left-0 top-full w-3 h-3"
    style={`background:${tonePalette.bgDark};clip-path:polygon(0 0, 100% 0, 100% 100%)`}
    aria-hidden="true"
  ></span>

  <!-- Pravé záhyby -->
  <span
    class="absolute right-0 top-full w-3 h-3"
    style={`background:${tonePalette.bgDark};clip-path:polygon(0 0, 100% 0, 0 100%)`}
    aria-hidden="true"
  ></span>
</div>
